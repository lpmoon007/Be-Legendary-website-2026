---
// Executive Immersion — "photo needed" placeholder slot, ported from the
// handoff .dc.html so each page carries a visible photography punch-list until
// real images land. Two variants: `cream` (on light sections) and `dark`
// (on the #2A0507 sections used by Expedition and Systems).
interface Props {
  title: string;
  note: string;
  height?: number;
  variant?: 'cream' | 'dark';
}
const { title, note, height = 200, variant = 'cream' } = Astro.props;

const c = variant === 'dark'
  ? { bg: 'rgba(246,239,224,0.07)', border: 'rgba(246,239,224,0.3)', eyebrow: 'rgba(217,116,63,0.85)', title: '#F6EFE0', note: 'rgba(240,228,218,0.6)' }
  : { bg: '#E4DACA', border: 'rgba(100,1,10,0.32)', eyebrow: '#A0705F', title: '#64010a', note: '#8A6A64' };
---
<div style={`width:100%;height:${height}px;background:${c.bg};border:1px dashed ${c.border};border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:24px;text-align:center;`}>
  <p style={`font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:${c.eyebrow};`}>Photo needed</p>
  <p style={`font-family:'Newsreader',serif;font-size:19px;line-height:1.25;color:${c.title};max-width:24ch;`}>{title}</p>
  <p style={`font-size:13px;line-height:1.5;color:${c.note};max-width:34ch;`}>{note}</p>
</div>
