---
// Client testimonials wall (paper section). Masonry columns handle the varied
// quote lengths cleanly. Data comes from src/lib/testimonials.ts.
import { TESTIMONIALS } from '../lib/testimonials';
export interface Props {
  heading?: string;
  eyebrow?: string;
}
const { heading = 'What leaders say after the room goes quiet.', eyebrow = 'Client praise' } = Astro.props;
---
<section class="bl-section-pad" style="background:#F4F0E7;color:#1B1810;padding:100px 32px;">
  <div style="max-width:1100px;margin:0 auto;">
    <div style="text-align:center;max-width:640px;margin:0 auto 52px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">{eyebrow}</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,4vw,44px);line-height:1.08;letter-spacing:-0.015em;color:#1B1810;">{heading}</h2>
    </div>
    <div class="bl-testimonial-cols" style="column-gap:22px;">
      {TESTIMONIALS.map((t) => (
        <figure style="break-inside:avoid;margin:0 0 22px;background:#FFFFFF;border:1px solid rgba(33,27,22,0.1);border-radius:16px;padding:28px 30px;">
          <div aria-label="Five out of five stars" style="color:#C9A24A;font-size:15px;letter-spacing:2px;margin-bottom:14px;">★★★★★</div>
          <blockquote style="margin:0 0 18px;font-family:'Newsreader',serif;font-size:18.5px;line-height:1.5;color:#211B16;">{t.quote}</blockquote>
          <figcaption style="font-size:14.5px;line-height:1.4;color:#5C544C;">
            <span style="display:block;font-weight:700;color:#1B1810;">{t.name}</span>
            <span>{t.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .bl-testimonial-cols { column-count: 3; }
  @media (max-width: 900px) { .bl-testimonial-cols { column-count: 2; } }
  @media (max-width: 600px) { .bl-testimonial-cols { column-count: 1; } }
</style>
