---
import { CTA_URL, CTA_LABEL, SLUGS } from '../lib/site';

export interface Props {
  variant?: 'full' | 'slim';
  maxWidth?: number;
  /** Slim-footer tagline (some pages override it). */
  note?: string;
}

const {
  variant = 'slim',
  maxWidth = 1140,
  note = '© 2026 Be Legendary. All rights reserved.',
} = Astro.props;
---
{variant === 'full' ? (
  <footer style="background:#100E0A;color:rgba(244,240,231,0.6);padding:56px 32px 40px;border-top:1px solid rgba(244,240,231,0.08);">
    <div class="bl-grid-collapse bl-grid-collapse--gap" style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:36px;">
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
          <img src="/assets/snail-cream.png" alt="Be Legendary" width="37" height="23" style="height:23px;width:auto;display:block;" />
          <span style="font-weight:800;letter-spacing:0.14em;font-size:13px;color:#F4F0E7;">BE LEGENDARY</span>
        </div>
        <p style="font-size:14.5px;line-height:1.55;max-width:36ch;">We rebuild the disciplines that turn a stalled executive team into one that executes. Truth over comfort, paid daily.</p>
      </div>
      <div>
        <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(244,240,231,0.4);margin-bottom:14px;">The work</p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14.5px;">
          <li><a href={SLUGS.flagModel} style="color:inherit;text-decoration:none;">The Flag Model</a></li>
          <li><a href={SLUGS.flagModel} style="color:inherit;text-decoration:none;">FlagScore</a></li>
          <li><a href={SLUGS.costCalculator} style="color:inherit;text-decoration:none;">Cost calculator</a></li>
          <li><a href={SLUGS.breakPointAssessment} style="color:inherit;text-decoration:none;">Break-point self-assessment</a></li>
          <li><a href="https://www.legendary-retreats.com" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">Legendary Retreats &#8599;</a></li>
        </ul>
      </div>
      <div>
        <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(244,240,231,0.4);margin-bottom:14px;">Company</p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14.5px;">
          <li><a href={SLUGS.about} style="color:inherit;text-decoration:none;">About James</a></li>
          <li><a href={SLUGS.resources} style="color:inherit;text-decoration:none;">Resources</a></li>
          <li><a href={SLUGS.research} style="color:inherit;text-decoration:none;">Research report</a></li>
          <li><a href={SLUGS.caseStudies} style="color:inherit;text-decoration:none;">Case studies</a></li>
          <li><a href={SLUGS.fieldNotes} style="color:inherit;text-decoration:none;">Field notes</a></li>
          <li><a href={SLUGS.library} style="color:inherit;text-decoration:none;">The Library</a></li>
          <li><a href={SLUGS.glossary} style="color:inherit;text-decoration:none;">Glossary</a></li>
        </ul>
      </div>
      <div>
        <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(244,240,231,0.4);margin-bottom:14px;">Start</p>
        <a href={CTA_URL} target="_blank" rel="noopener" style="display:inline-block;background:#C04A26;color:#fff;text-decoration:none;padding:12px 20px;border-radius:9px;font-weight:700;font-size:14px;">{CTA_LABEL}</a>
      </div>
    </div>
    <div style="max-width:1200px;margin:36px auto 0;padding-top:22px;border-top:1px solid rgba(244,240,231,0.08);font-size:12.5px;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;">
      <span>&copy; 2026 Be Legendary. All rights reserved.</span>
      <span style="display:flex;gap:16px;"><a href={SLUGS.privacy} style="color:inherit;text-decoration:none;">Privacy</a><a href={SLUGS.glossary} style="color:inherit;text-decoration:none;">Glossary</a><span>belegendary.org</span></span>
    </div>
  </footer>
) : (
  <footer style="background:#100E0A;color:rgba(244,240,231,0.6);padding:48px 32px 40px;border-top:1px solid rgba(244,240,231,0.08);">
    <div style={`max-width:${maxWidth}px;margin:0 auto;display:flex;flex-wrap:wrap;gap:18px;justify-content:space-between;align-items:center;font-size:13px;`}>
      <a href="/" style="display:flex;align-items:center;gap:9px;text-decoration:none;color:#F4F0E7;">
        <img src="/assets/snail-cream.png" alt="Be Legendary" width="37" height="23" style="height:23px;width:auto;display:block;" />
        <span style="font-weight:800;letter-spacing:0.14em;font-size:12px;">BE LEGENDARY</span>
      </a>
      <span>{note}</span>
    </div>
  </footer>
)}
