---
// "As featured in" press strip. Text wordmarks (no third-party logo files), so
// it's fast, safe, and on-brand. Works on the dark body background.
---
<section aria-label="Press" style="border-top:1px solid rgba(244,240,231,0.1);border-bottom:1px solid rgba(244,240,231,0.1);padding:24px 32px;">
  <div style="max-width:1000px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:clamp(18px,4vw,48px);flex-wrap:wrap;">
    <span style="font-size:11.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:rgba(244,240,231,0.42);">As featured in</span>
    <span style="font-family:'Newsreader',serif;font-size:clamp(17px,2.3vw,23px);color:rgba(244,240,231,0.8);letter-spacing:0.01em;">CNN</span>
    <span style="font-family:'Newsreader',serif;font-size:clamp(17px,2.3vw,23px);color:rgba(244,240,231,0.8);letter-spacing:0.01em;">CNN Money</span>
    <span style="font-family:'Newsreader',serif;font-size:clamp(17px,2.3vw,23px);color:rgba(244,240,231,0.8);letter-spacing:0.01em;">Business Insider</span>
  </div>
</section>
