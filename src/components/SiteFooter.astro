---
import { CTA_URL, CTA_LABEL, SLUGS, CHALLENGE_URL } from '../lib/site';

export interface Props {
  audience?: 'teams' | 'leaders';
  /** 'full' — 4-column footer (homepages/hubs). 'slim' — logo + toggle + copyright (content/SEO pages). */
  variant?: 'full' | 'slim';
  maxWidth?: number;
  /** Optional per-page tagline (slim variant) — replaces the default copyright line. */
  note?: string;
}

const { audience = 'teams', variant = 'full', maxWidth = 1200, note } = Astro.props;
const teamsActive = audience === 'teams';
const pillOn = 'color:#F4F0E7;background:#C04A26;font-weight:700;';
const pillOff = 'color:rgba(244,240,231,0.6);font-weight:600;';
// Site owner's rule: every page gets the full footer. We keep the `variant`
// prop for backwards-compat (pages still pass variant="slim"), but the slim
// footer is never rendered — flip this to `variant === 'slim'` to restore it.
const slim = false;

const TEAMS_COL = {
  heading: 'For Teams',
  links: [
    { label: 'How we work together', href: SLUGS.howWeWorkTogether },
    { label: 'Pricing', href: SLUGS.pricing },
    { label: 'Executive Team Building', href: SLUGS.executiveTeamBuilding },
    { label: 'Executive Team Development', href: SLUGS.executiveTeamDevelopment },
    { label: 'The Flag Model', href: SLUGS.flagModel },
    { label: 'Break-point self-assessment', href: SLUGS.breakPointAssessment },
    { label: 'Cost calculator', href: SLUGS.costCalculator },
    { label: 'Case studies', href: SLUGS.caseStudies },
    { label: 'Team LFS', href: SLUGS.teamLfs },
    { label: 'Executive Retreats', href: SLUGS.teamRetreats },
    { label: 'Executive Immersion', href: SLUGS.executiveImmersion },
    { label: 'Resources', href: SLUGS.resources },
    { label: 'EA Resources', href: SLUGS.forExecutiveAssistants },
    { label: 'Brief your principal', href: SLUGS.briefYourPrincipal },
    { label: 'Flag Model glossary', href: SLUGS.glossary },
  ],
};
const LEADERS_COL = {
  heading: 'For Leaders',
  links: [
    { label: 'Mindset Workouts', href: SLUGS.workouts },
    { label: 'Your 30-Day Challenge', href: SLUGS.challenge },
    { label: 'Roadmap to Legendary', href: SLUGS.roadmap },
    { label: "Leader's Glossary", href: SLUGS.leadersGlossary },
    { label: 'The Golden Buddha', href: SLUGS.goldenBuddha },
  ],
};
const primary = teamsActive ? TEAMS_COL : LEADERS_COL;
const secondary = teamsActive ? LEADERS_COL : TEAMS_COL;
---
{slim ? (
  <footer style="margin-top:76px;background:#15130E;color:#B7AE9C;padding:48px 32px 40px;border-top:1px solid rgba(244,240,231,0.08);">
    <div style={`max-width:${maxWidth}px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;`}>
      <a href={teamsActive ? '/' : SLUGS.leaders} style="display:flex;align-items:center;gap:11px;text-decoration:none;">
        <img src="/assets/snail-cream.png" alt="Be Legendary" width="42" height="26" style="height:26px;width:auto;display:block;" />
        <span style="font-weight:800;font-size:13px;letter-spacing:0.14em;color:#F4F0E7;">BE LEGENDARY</span>
      </a>
      <div role="tablist" aria-label="Audience" style="display:inline-flex;align-items:center;background:rgba(244,240,231,0.06);border:1px solid rgba(244,240,231,0.14);border-radius:999px;padding:3px;">
        <a href={SLUGS.teams} role="tab" aria-selected={teamsActive ? 'true' : 'false'} style={`font-size:12.5px;text-decoration:none;padding:6px 14px;border-radius:999px;${teamsActive ? pillOn : pillOff}`}>For Teams</a>
        <a href={SLUGS.leaders} role="tab" aria-selected={teamsActive ? 'false' : 'true'} style={`font-size:12.5px;text-decoration:none;padding:6px 14px;border-radius:999px;${teamsActive ? pillOff : pillOn}`}>For Leaders</a>
      </div>
    </div>
    <div style={`max-width:${maxWidth}px;margin:28px auto 0;padding-top:20px;border-top:1px solid rgba(244,240,231,0.1);font-size:12.5px;color:#6E6757;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;`}>
      <span>{note ?? '© 2026 Be Legendary. All rights reserved.'}</span>
      <span style="display:flex;gap:16px;flex-wrap:wrap;"><a href="tel:8005138759" style="color:inherit;text-decoration:none;">800-513-8759</a><a href={SLUGS.forExecutiveAssistants} style="color:inherit;text-decoration:none;">EA Resources</a><a href={SLUGS.contact} style="color:inherit;text-decoration:none;">Contact</a><a href={SLUGS.privacy} style="color:inherit;text-decoration:none;">Privacy</a><span>belegendary.org</span></span>
    </div>
  </footer>
) : (
<footer style="margin-top:76px;background:#100E0A;color:rgba(244,240,231,0.6);padding:56px 32px 40px;border-top:1px solid rgba(244,240,231,0.08);">
  <div class="bl-grid-collapse bl-grid-collapse--gap" style={`max-width:${maxWidth}px;margin:0 auto;display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:36px;`}>
    <div>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
        <img src="/assets/snail-cream.png" alt="Be Legendary" width="37" height="23" style="height:23px;width:auto;display:block;" />
        <span style="font-weight:800;letter-spacing:0.14em;font-size:13px;color:#F4F0E7;">BE LEGENDARY</span>
      </div>
      <p style="font-size:14.5px;line-height:1.55;max-width:38ch;margin-bottom:18px;">One brand, two ways in: rebuild the disciplines that make an executive team execute, and the daily reps that make a leader legendary. Truth over comfort, paid daily.</p>
      <div role="tablist" aria-label="Audience" style="display:inline-flex;align-items:center;background:rgba(244,240,231,0.06);border:1px solid rgba(244,240,231,0.12);border-radius:999px;padding:3px;">
        <a href={SLUGS.teams} role="tab" aria-selected={teamsActive ? 'true' : 'false'} style={`font-size:12.5px;text-decoration:none;padding:5px 13px;border-radius:999px;${teamsActive ? pillOn : pillOff}`}>For Teams</a>
        <a href={SLUGS.leaders} role="tab" aria-selected={teamsActive ? 'false' : 'true'} style={`font-size:12.5px;text-decoration:none;padding:5px 13px;border-radius:999px;${teamsActive ? pillOff : pillOn}`}>For Leaders</a>
      </div>
    </div>

    <div>
      <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(244,240,231,0.4);margin-bottom:14px;">{primary.heading}</p>
      <ul style="list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14.5px;">
        {primary.links.map((l) => (<li><a href={l.href} style="color:inherit;text-decoration:none;">{l.label}</a></li>))}
      </ul>
    </div>

    <div>
      <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(244,240,231,0.4);margin-bottom:14px;">{secondary.heading}</p>
      <ul style="list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14.5px;">
        {secondary.links.map((l) => (<li><a href={l.href} style="color:inherit;text-decoration:none;">{l.label}</a></li>))}
      </ul>
    </div>

    <div>
      <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(244,240,231,0.4);margin-bottom:14px;">Company</p>
      <ul style="list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14.5px;">
        <li><a href={SLUGS.aboutIndex} style="color:inherit;text-decoration:none;">About Be Legendary</a></li>
        <li><a href={SLUGS.about} style="color:inherit;text-decoration:none;">James Carter</a></li>
        <li><a href={SLUGS.press} style="color:inherit;text-decoration:none;">Press</a></li>
        <li><a href={SLUGS.contact} style="color:inherit;text-decoration:none;">Contact</a></li>
        <li><a href="tel:8005138759" style="color:inherit;text-decoration:none;">800-513-8759</a></li>
        <li><a href="https://www.linkedin.com/company/repario-and-be-legendary/" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">LinkedIn &#8599;</a></li>
        <li><a href={CHALLENGE_URL} target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">Challenge login &#8599;</a></li>
      </ul>
      <a href={CTA_URL} target="_blank" rel="noopener" style="display:inline-block;margin-top:18px;background:#C04A26;color:#fff;text-decoration:none;padding:12px 20px;border-radius:9px;font-weight:700;font-size:14px;">{CTA_LABEL}</a>
    </div>
  </div>

  <div style={`max-width:${maxWidth}px;margin:30px auto 0;padding-top:22px;border-top:1px solid rgba(244,240,231,0.08);`}>
    <p style="font-size:12.5px;line-height:1.6;color:rgba(244,240,231,0.45);max-width:82ch;">Be Legendary is an executive-team performance advisory founded by James Carter, creator of the Flag Model. Its companion product <a href="https://www.provecq.com/" target="_blank" rel="noopener" style="color:rgba(244,240,231,0.7);text-decoration:none;">Prove</a> measures who delivers &mdash; the Commitment Quotient (CQ). Corporate team-building and charity events run as <a href="https://www.buildingteams.com/" target="_blank" rel="noopener" style="color:rgba(244,240,231,0.7);text-decoration:none;">Building Teams</a>. Not affiliated with any similarly named coaching or wellness brand.</p>
  </div>

  <div style={`max-width:${maxWidth}px;margin:18px auto 0;font-size:12.5px;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;`}>
    <span>&copy; 2026 Be Legendary. All rights reserved.</span>
    <span style="display:flex;gap:16px;">
      <a href={SLUGS.privacy} style="color:inherit;text-decoration:none;">Privacy</a>
      <a href={SLUGS.glossary} style="color:inherit;text-decoration:none;">Glossary</a>
      <span>belegendary.org</span>
    </span>
  </div>
</footer>
)}
