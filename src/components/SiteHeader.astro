---
import { CTA_URL, CTA_LABEL, SLUGS } from '../lib/site';

export interface Props {
  /** Which audience tab is active — drives the toggle highlight. */
  audience?: 'teams' | 'leaders';
  /**
   * 'full' — logo + toggle + section links + CTA button (homepages, hubs).
   * 'slim' — logo + toggle + a single contextual link, no button
   *          (SEO/content/article pages). Narrower by default.
   */
  variant?: 'full' | 'slim';
  /** Right-side section links (full variant). Defaults depend on the audience.
   *  A link may carry `children` to render as a hover/focus dropdown; a child
   *  with `soon` shows as a muted "Coming" row, `divider` sets it off at the end. */
  links?: {
    label: string;
    href: string;
    external?: boolean;
    children?: { label: string; href?: string; desc?: string; external?: boolean; soon?: boolean; divider?: boolean }[];
  }[];
  /** Primary button (full variant). Defaults to the Calibration Call. Pass null to hide. */
  cta?: { label: string; href: string; external?: boolean } | null;
  /** Single right-side link (slim variant), e.g. "The Legendary Leader →". */
  contextLink?: { label: string; href: string; external?: boolean };
  maxWidth?: number;
  /** Logo target (homepages use an in-page anchor; inner pages link home). */
  logoHref?: string;
}

const TEAMS_LINKS = [
  {
    label: 'How we work together',
    href: SLUGS.howWeWorkTogether,
    children: [
      { label: 'Leadership Failure Simulation', href: SLUGS.teamLfs, desc: 'Like a flight simulator, for your leadership team' },
      { label: 'Executive Immersion', href: SLUGS.executiveImmersion, desc: 'One high-stakes day, engineered for your team' },
      { label: 'Leadership Retreat', href: SLUGS.teamRetreats, desc: 'Multi-day, fully off-site' },
      { label: 'Discipline Sprint', href: `${SLUGS.howWeWorkTogether}#discipline-sprint`, desc: 'A focused 90-day behavioral improvement' },
      { label: 'Performance Partnership', href: `${SLUGS.howWeWorkTogether}#performance-partnership`, desc: '12-month engagement, 10×-return guarantee' },
      { label: 'Pricing', href: SLUGS.pricing, desc: 'Every way in, with real prices' },
      { label: 'How we work together', href: SLUGS.howWeWorkTogether, divider: true },
    ],
  },
  { label: 'Retreats', href: SLUGS.teamRetreats },
  {
    label: 'Resources',
    href: SLUGS.resources,
    children: [
      { label: 'Field Notes', href: SLUGS.fieldNotes },
      { label: 'Research Notes', href: SLUGS.researchNotes },
      { label: 'Case studies', href: SLUGS.caseStudies },
      { label: 'All resources', href: SLUGS.resources, divider: true },
    ],
  },
  {
    label: 'About',
    href: SLUGS.aboutIndex,
    children: [
      { label: 'About Be Legendary', href: SLUGS.aboutIndex },
      { label: 'James Carter', href: SLUGS.about },
      { label: 'Press', href: SLUGS.press },
      { label: 'Contact', href: SLUGS.contact },
    ],
  },
];
const LEADERS_LINKS = [
  { label: 'Mindset Workouts', href: SLUGS.workouts },
  { label: '30-Day Challenge', href: SLUGS.challenge },
  { label: 'Glossary', href: SLUGS.leadersGlossary },
  { label: 'James', href: SLUGS.about },
];

const {
  audience = 'teams',
  variant = 'full',
  links = audience === 'leaders' ? LEADERS_LINKS : TEAMS_LINKS,
  cta = { label: CTA_LABEL, href: CTA_URL, external: true },
  contextLink,
  maxWidth = variant === 'slim' ? 1000 : 1200,
  logoHref = '/',
} = Astro.props;

// Audience toggle target routes.
const teamsActive = audience === 'teams';
const pillOn = 'color:#F4F0E7;background:#C04A26;font-weight:700;';
const pillOff = 'color:rgba(244,240,231,0.66);font-weight:600;';
const slim = variant === 'slim';
---
<header style="position:sticky;top:0;z-index:50;background:rgba(21,19,14,0.85);backdrop-filter:blur(14px);border-bottom:1px solid rgba(244,240,231,0.10);">
  <nav aria-label="Primary" style={`max-width:${maxWidth}px;margin:0 auto;padding:16px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px;`}>
    <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;">
      <a href={logoHref} style="display:flex;align-items:center;gap:11px;text-decoration:none;color:#F4F0E7;">
        <img src="/assets/snail-cream.png" alt="Be Legendary" width="45" height="28" style="height:28px;width:auto;display:block;" />
        <span style="font-weight:800;letter-spacing:0.14em;font-size:14px;">BE LEGENDARY</span>
      </a>
      <div role="tablist" aria-label="Audience" style="display:flex;align-items:center;background:rgba(244,240,231,0.06);border:1px solid rgba(244,240,231,0.12);border-radius:999px;padding:3px;">
        <a href={SLUGS.teams} role="tab" aria-selected={teamsActive ? 'true' : 'false'} style={`font-size:13px;text-decoration:none;padding:6px 14px;border-radius:999px;${teamsActive ? pillOn : pillOff}`}>For Teams</a>
        <a href={SLUGS.leaders} role="tab" aria-selected={teamsActive ? 'false' : 'true'} style={`font-size:13px;text-decoration:none;padding:6px 14px;border-radius:999px;${teamsActive ? pillOff : pillOn}`}>For Leaders</a>
      </div>
      <a href={SLUGS.search} aria-label="Search the site" title="Search" style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:999px;color:rgba(244,240,231,0.66);border:1px solid rgba(244,240,231,0.12);text-decoration:none;" onmouseover="this.style.color='#F4F0E7';this.style.borderColor='rgba(244,240,231,0.3)'" onmouseout="this.style.color='rgba(244,240,231,0.66)';this.style.borderColor='rgba(244,240,231,0.12)'">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </a>
    </div>
    {slim ? (
      <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:flex-end;">
        {contextLink && (
          <a
            href={contextLink.href}
            {...(contextLink.external ? { target: '_blank', rel: 'noopener' } : {})}
            style="color:rgba(244,240,231,0.72);text-decoration:none;font-size:14.5px;font-weight:500;"
            onmouseover="this.style.color='#F4F0E7'"
            onmouseout="this.style.color='rgba(244,240,231,0.72)'"
          >{contextLink.label}</a>
        )}
        {cta && (
          <a
            href={cta.href}
            {...(cta.external ? { target: '_blank', rel: 'noopener' } : {})}
            style="background:#C04A26;color:#fff;text-decoration:none;padding:9px 17px;border-radius:9px;font-weight:700;font-size:13.5px;white-space:nowrap;"
            onmouseover="this.style.background='#9E3A1C'"
            onmouseout="this.style.background='#C04A26'"
          >Book a call</a>
        )}
      </div>
    ) : (
      <div class="bl-nav-links" style="display:flex;align-items:center;gap:26px;font-size:14.5px;font-weight:500;color:rgba(244,240,231,0.72);">
        {links.map((l) => (
          l.children && l.children.length ? (
            <div class="bl-nav-item bl-nav-secondary">
              <a
                class="bl-nav-trigger"
                href={l.href}
                aria-haspopup="true"
                style="color:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:5px;"
                onmouseover="this.style.color='#F4F0E7'"
                onmouseout="this.style.color='rgba(244,240,231,0.72)'"
              >{l.label}<svg class="bl-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
              <div class="bl-dropdown" role="menu">
                {l.children.map((c) => (
                  c.soon ? (
                    <span class="bl-dd-soon"><span>{c.label}</span><span class="bl-dd-tag">Coming</span></span>
                  ) : (
                    <a
                      class={c.divider ? 'bl-dd-link bl-dd-all' : (c.desc ? 'bl-dd-link bl-dd-rich' : 'bl-dd-link')}
                      role="menuitem"
                      href={c.href}
                      {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
                    >{c.desc
                      ? <><span class="bl-dd-label">{c.label}</span><span class="bl-dd-desc">{c.desc}</span></>
                      : (c.divider ? `${c.label} →` : c.label)}</a>
                  )
                ))}
              </div>
            </div>
          ) : (
            <a
              class="bl-nav-secondary"
              href={l.href}
              {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
              style="color:inherit;text-decoration:none;"
              onmouseover="this.style.color='#F4F0E7'"
              onmouseout="this.style.color='rgba(244,240,231,0.72)'"
            >{l.label}</a>
          )
        ))}
        {cta && (
          <a
            href={cta.href}
            {...(cta.external ? { target: '_blank', rel: 'noopener' } : {})}
            style="background:#C04A26;color:#fff;text-decoration:none;padding:11px 20px;border-radius:9px;font-weight:700;font-size:14px;"
            onmouseover="this.style.background='#9E3A1C'"
            onmouseout="this.style.background='#C04A26'"
          >{cta.label}</a>
        )}
      </div>
    )}
  </nav>
</header>
