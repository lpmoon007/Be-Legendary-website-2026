---
// Lost Disciplines footer with Explore + Be Legendary link columns.
import { CTA_URL } from '../lib/site';
---
<footer style="background:#0a1120;">
  <div style="max-width:1160px;margin:0 auto;padding:48px 56px;">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:40px;flex-wrap:wrap;border-bottom:1px solid rgba(201,162,74,.14);padding-bottom:34px;margin-bottom:28px;">
      <div style="max-width:26em;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <img src="/assets/ldol-b-logo.png" alt="" width="28" height="28" style="height:28px;width:28px;border-radius:6px;display:block;" />
          <span style="font-family:'Hanken Grotesk',sans-serif;font-weight:600;font-size:14px;letter-spacing:.14em;color:#f4f0e6;text-transform:uppercase;">Lost Disciplines</span>
        </div>
        <p style="font-size:14px;line-height:1.6;color:#7e889e;margin:0;">Lost Disciplines of Leadership&trade; &mdash; the foundational text behind the Flag Model&trade;.</p>
      </div>
      <div style="display:flex;gap:56px;flex-wrap:wrap;">
        <div style="display:flex;flex-direction:column;gap:12px;">
          <span style="font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#5b6a86;">Explore</span>
          <a href="/lost-disciplines/the-book/" style="font-size:14px;color:#9aa6c0;text-decoration:none;">The Book</a>
          <a href="/lost-disciplines/#the-model" style="font-size:14px;color:#9aa6c0;text-decoration:none;">The Flag Model</a>
          <a href="/lost-disciplines/about-james/" style="font-size:14px;color:#9aa6c0;text-decoration:none;">About James</a>
          <a href="/lost-disciplines/praise/" style="font-size:14px;color:#9aa6c0;text-decoration:none;">Praise</a>
          <a href="/lost-disciplines/bulk-and-speaking/" style="font-size:14px;color:#9aa6c0;text-decoration:none;">Bulk &amp; Speaking</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <span style="font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#5b6a86;">Be Legendary</span>
          <a href="https://www.belegendary.org/" rel="noopener" style="font-size:14px;color:#9aa6c0;text-decoration:none;">belegendary.org</a>
          <a href={CTA_URL} target="_blank" rel="noopener" style="font-size:14px;color:#9aa6c0;text-decoration:none;">Calibration Call</a>
        </div>
      </div>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;">
      <span style="font-size:13px;color:#6f7a93;">&copy; 2026 Lost Disciplines of Leadership&trade;. All rights reserved.</span>
      <span style="font-size:13px;color:#9aa6c0;">A <strong style="color:#c9a24a;font-weight:600;">Be Legendary</strong> book &middot; <a href="https://www.belegendary.org/" rel="noopener" style="color:#9aa6c0;">belegendary.org</a></span>
    </div>
  </div>
</footer>
