---
import '../styles/global.css';
import { SITE_URL } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/flag-model/". */
  path: string;
  ogType?: 'website' | 'article';
  ogTitle?: string;
  ogDescription?: string;
  /** JSON-LD node(s). An array is wrapped into a single @graph block. */
  schema?: Record<string, any> | Record<string, any>[];
  /** Page background (most pages are ink-dark). */
  bodyBg?: string;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  ogTitle,
  ogDescription,
  schema,
  bodyBg = '#15130E',
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const shareCard = `${SITE_URL}/assets/share-card.png`;

let jsonLd: string | null = null;
if (schema) {
  const graph = Array.isArray(schema)
    ? { '@context': 'https://schema.org', '@graph': schema }
    : schema['@context']
      ? schema
      : { '@context': 'https://schema.org', ...schema };
  jsonLd = JSON.stringify(graph);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareCard} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Be Legendary" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={ogDescription ?? description} />
  <meta name="twitter:image" content={shareCard} />

  <!-- Favicons (generated from the logo mark) -->
  <link rel="icon" type="image/png" href="/assets/logo.png" />
  <link rel="apple-touch-icon" href="/assets/logo.png" />

  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
</head>
<body style={`background:${bodyBg};color:#F4F0E7;font-family:'Hanken Grotesk',sans-serif;overflow-x:hidden;`}>
  <slot />
</body>
</html>
