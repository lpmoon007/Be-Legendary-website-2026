---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { SITE_URL, ORG_NODE, PERSON_NODE, WEBSITE_NODE, WEBSITE_ID } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/flag-model/". */
  path: string;
  ogType?: 'website' | 'article' | 'profile';
  ogTitle?: string;
  ogDescription?: string;
  /** JSON-LD node(s). An array is wrapped into a single @graph block. */
  schema?: Record<string, any> | Record<string, any>[];
  /**
   * Inject the canonical site-identity graph (Organization, founder Person,
   * WebSite) + a per-page WebPage node, so every page reinforces the same
   * entities and resolves @id cross-references. The homepage defines these
   * itself, so it opts out.
   */
  siteGraph?: boolean;
  /** Emit noindex (e.g. the 404 page). */
  noindex?: boolean;
  /** Page background (most pages are ink-dark). */
  bodyBg?: string;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  ogTitle,
  ogDescription,
  schema,
  siteGraph = true,
  noindex = false,
  bodyBg = '#15130E',
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const shareCard = `${SITE_URL}/assets/share-card.png`;
const shareAlt = 'Be Legendary — the Flag Model for executive-team performance';

// Assemble the JSON-LD graph: canonical identity entities (on inner pages) +
// a WebPage node tying this page to the site + the page's own nodes.
const pageNodes = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const webPage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: ogTitle ?? title,
  description: ogDescription ?? description,
  inLanguage: 'en-US',
  isPartOf: { '@id': WEBSITE_ID },
  primaryImageOfPage: { '@type': 'ImageObject', url: shareCard },
};
const identityNodes = siteGraph ? [ORG_NODE, PERSON_NODE, WEBSITE_NODE, webPage] : [];
const graphNodes = [...identityNodes, ...pageNodes];

const jsonLd = graphNodes.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graphNodes })
  : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
  <meta name="theme-color" content="#15130E" />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareCard} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={shareAlt} />
  <meta property="og:site_name" content="Be Legendary" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={ogDescription ?? description} />
  <meta name="twitter:image" content={shareCard} />
  <meta name="twitter:image:alt" content={shareAlt} />

  <!-- Favicons / manifest (generated from the logo mark) -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

  <Analytics />
</head>
<body style={`background:${bodyBg};color:#F4F0E7;font-family:'Hanken Grotesk',sans-serif;overflow-x:hidden;`}>
  <slot />
</body>
</html>
