---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { SITE_URL, ORG_NODE, PERSON_NODE, WEBSITE_NODE, WEBSITE_ID } from '../lib/site';
// Preload only the above-the-fold fonts so the LCP text (Newsreader H1 +
// Hanken body) isn't stuck behind the full 9-weight font download. Vite
// resolves these to the hashed /_astro/ URLs at build.
import fontHeadline from '@fontsource/newsreader/files/newsreader-latin-500-normal.woff2';
import fontBody from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2';
import fontUi from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-600-normal.woff2';

export interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/flag-model/". */
  path: string;
  ogType?: 'website' | 'article' | 'profile';
  ogTitle?: string;
  ogDescription?: string;
  /** JSON-LD node(s). An array is wrapped into a single @graph block. */
  schema?: Record<string, any> | Record<string, any>[];
  /**
   * Inject the canonical site-identity graph (Organization, founder Person,
   * WebSite) + a per-page WebPage node, so every page reinforces the same
   * entities and resolves @id cross-references. The homepage defines these
   * itself, so it opts out.
   */
  siteGraph?: boolean;
  /** Emit noindex (e.g. the 404 page). */
  noindex?: boolean;
  /** Page background (most pages are ink-dark). */
  bodyBg?: string;
  /** Override the last breadcrumb crumb (defaults to the title's leading phrase). */
  breadcrumbLabel?: string;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  ogTitle,
  ogDescription,
  schema,
  siteGraph = true,
  noindex = false,
  bodyBg = '#15130E',
  breadcrumbLabel,
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const shareCard = `${SITE_URL}/assets/share-card.png`;
const shareAlt = 'Be Legendary — the Flag Model for executive-team performance';

// Assemble the JSON-LD graph: canonical identity entities (on inner pages) +
// a WebPage node tying this page to the site + the page's own nodes.
const pageNodes = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// ── Auto-inject datePublished/dateModified on Article-type nodes lacking them ──
const LAUNCH_DATE = '2026-07-06';
const buildDate = new Date().toISOString().split('T')[0];
const ARTICLE_TYPES = new Set(['Article', 'BlogPosting', 'NewsArticle', 'TechArticle', 'ScholarlyArticle']);
const isType = (t: any, set: Set<string>) =>
  typeof t === 'string' ? set.has(t) : Array.isArray(t) && t.some((x) => set.has(x));
const datedNodes = pageNodes.map((n: any) => {
  if (!isType(n['@type'], ARTICLE_TYPES)) return n;
  return {
    ...n,
    datePublished: n.datePublished ?? LAUNCH_DATE,
    dateModified: n.dateModified ?? buildDate,
  };
});

// ── Auto-derive a BreadcrumbList from the URL path when the page didn't supply one ──
const SEG_LABELS: Record<string, string> = {
  leaders: 'For Leaders',
  teams: 'For Teams',
  workouts: 'Mindset Workouts',
  retreats: 'Retreats',
};
const hasBreadcrumb = datedNodes.some((n: any) => isType(n['@type'], new Set(['BreadcrumbList'])));
const leafLabel = (breadcrumbLabel ?? (ogTitle ?? title).split(/\s+[|—–]\s+/)[0]).trim();
function deriveBreadcrumb() {
  const segs = path.split('/').filter(Boolean);
  if (!segs.length) return null; // homepage — no breadcrumb
  const items = [{ name: 'Home', item: `${SITE_URL}/` }];
  let acc = '';
  segs.forEach((seg, i) => {
    acc += `/${seg}`;
    const isLast = i === segs.length - 1;
    const name = isLast
      ? leafLabel
      : SEG_LABELS[seg] ?? seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    items.push({ name, item: `${SITE_URL}${acc}/` });
  });
  return {
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: items.map((it, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: it.name,
      item: it.item,
    })),
  };
}
const autoCrumb = !hasBreadcrumb && path !== '/' ? deriveBreadcrumb() : null;

const webPage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: ogTitle ?? title,
  description: ogDescription ?? description,
  inLanguage: 'en-US',
  isPartOf: { '@id': WEBSITE_ID },
  primaryImageOfPage: { '@type': 'ImageObject', url: shareCard },
  ...(autoCrumb ? { breadcrumb: { '@id': autoCrumb['@id'] } } : {}),
};
const identityNodes = siteGraph ? [ORG_NODE, PERSON_NODE, WEBSITE_NODE, webPage] : [];
const graphNodes = [...identityNodes, ...datedNodes, ...(autoCrumb ? [autoCrumb] : [])];

const jsonLd = graphNodes.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graphNodes })
  : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
  <meta name="theme-color" content="#15130E" />
  <link rel="canonical" href={canonical} />

  <!-- Preload critical above-the-fold fonts (LCP) -->
  <link rel="preload" href={fontHeadline} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fontUi} as="font" type="font/woff2" crossorigin />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareCard} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={shareAlt} />
  <meta property="og:site_name" content="Be Legendary" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={ogDescription ?? description} />
  <meta name="twitter:image" content={shareCard} />
  <meta name="twitter:image:alt" content={shareAlt} />

  <!-- Favicons / manifest (generated from the logo mark) -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

  <Analytics />
</head>
<body style={`background:${bodyBg};color:#F4F0E7;font-family:'Hanken Grotesk',sans-serif;overflow-x:hidden;`}>
  <slot />
</body>
</html>
