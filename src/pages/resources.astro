---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = 'Resources: Executive Team Tools & Research | Be Legendary';
const description = 'Free tools and straight answers for executive teams: the Cost of Lost Disciplines Calculator, the Flag Model, and comparisons with EOS, OKRs and 4DX.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.belegendary.org/resources/' },
  ] },
  { '@type': 'CollectionPage', '@id': 'https://www.belegendary.org/resources/#page', name: 'Resources', about: 'Tools, comparisons and research for executive teams', isPartOf: { '@type': 'Organization', name: 'Be Legendary' } },
  { '@type': 'ItemList', name: 'Be Legendary resources', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Cost of Lost Disciplines Calculator', url: 'https://www.belegendary.org/cost-of-lost-disciplines-calculator/' },
    { '@type': 'ListItem', position: 2, name: 'Break-Point Self-Assessment', url: 'https://www.belegendary.org/break-point-self-assessment/' },
    { '@type': 'ListItem', position: 3, name: 'The Flag Model', url: 'https://www.belegendary.org/flag-model/' },
    { '@type': 'ListItem', position: 4, name: 'Flag Model vs EOS and OKRs', url: 'https://www.belegendary.org/eos-okrs-didnt-change-behavior/' },
    { '@type': 'ListItem', position: 5, name: 'Field Notes', url: 'https://www.belegendary.org/field-notes/' },
    { '@type': 'ListItem', position: 6, name: 'The State of Executive Team Execution', url: 'https://www.belegendary.org/state-of-executive-team-execution/' },
  ] },
];
---
<BaseLayout title={title} description={description} path={SLUGS.resources} ogTitle="Be Legendary — Resources for executive teams" ogDescription="Free tools, framework comparisons, and research on executive-team execution." schema={schema}>

<div style="background:#15130E;color:#F4F0E7;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

  <SiteHeader audience="teams" logoHref="/" maxWidth={1140} links={[{ label: 'The Flag Model', href: SLUGS.flagModel }, { label: 'Field notes', href: SLUGS.fieldNotes }, { label: 'James', href: SLUGS.about }]} />

  <!-- HERO -->
  <header style="position:relative;max-width:1140px;margin:0 auto;padding:88px 32px 56px;">
    <div style="position:absolute;top:-100px;right:-140px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:24px;display:flex;gap:8px;align-items:center;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><span style="color:#D98A5E;">Resources</span>
    </nav>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(38px,5.6vw,70px);line-height:1.01;letter-spacing:-0.02em;max-width:18ch;color:#FBF8F1;">Tools to see what's actually happening on your team.</h1>
    <p style="margin-top:26px;font-size:clamp(18px,2.1vw,22px);line-height:1.52;max-width:58ch;color:rgba(244,240,231,0.8);">Free, no email required. Estimate the cost, learn the framework, compare it to what you already run, and recognize the patterns &mdash; before you ever book a call.</p>
  </header>

  <!-- FEATURED TOOL -->
  <section style="max-width:1140px;margin:0 auto;padding:0 32px 20px;">
    <a href={SLUGS.costCalculator} style="text-decoration:none;display:block;background:linear-gradient(150deg,#C04A26,#7E2D13);border-radius:22px;padding:46px;color:#fff;position:relative;overflow:hidden;" onmouseover="this.querySelector('.arr').style.transform='translateX(6px)'" onmouseout="this.querySelector('.arr').style.transform='translateX(0)'">
      <div style="position:absolute;top:-60px;right:-40px;width:320px;height:320px;background:radial-gradient(circle,rgba(255,255,255,0.12),transparent 65%);"></div>
      <div class="bl-grid-collapse" style="position:relative;display:grid;grid-template-columns:1.3fr 1fr;gap:30px;align-items:center;">
        <div>
          <span style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.8);">Featured tool &middot; interactive</span>
          <h2 style="margin-top:14px;font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.6vw,40px);line-height:1.06;">The Cost of Lost Disciplines Calculator</h2>
          <p style="margin-top:14px;font-size:16.5px;line-height:1.55;color:rgba(255,255,255,0.92);max-width:46ch;">Put in five numbers and see what decision chaos and misalignment are costing you &mdash; grounded in McKinsey, LSA Global and Gallup research, not ours.</p>
          <span class="arr" style="margin-top:22px;display:inline-flex;align-items:center;gap:9px;font-weight:700;font-size:16px;transition:transform .2s;">Open the calculator <span style="font-size:18px;">&rarr;</span></span>
        </div>
        <div style="background:rgba(0,0,0,0.18);border-radius:16px;padding:28px;text-align:center;">
          <p style="font-size:12.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.75);">Research baseline</p>
          <p style="font-family:'Newsreader',serif;font-size:clamp(36px,5vw,52px);line-height:1.05;margin-top:8px;">2.5&ndash;4%</p>
          <p style="font-size:14px;color:rgba(255,255,255,0.85);margin-top:6px;">of revenue lost to decision chaos &amp; misalignment</p>
        </div>
      </div>
    </a>
  </section>

  <!-- SECOND TOOL: ASSESSMENT -->
  <section style="max-width:1140px;margin:0 auto;padding:18px 32px 8px;">
    <a href={SLUGS.breakPointAssessment} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:24px;background:#1B1810;border:1px solid rgba(244,240,231,0.14);border-radius:20px;padding:34px 38px;flex-wrap:wrap;" onmouseover="this.style.borderColor='rgba(192,74,38,0.6)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.14)'">
      <div style="flex:1;min-width:280px;">
        <span style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Free tool &middot; 4 minutes</span>
        <p style="margin-top:12px;font-family:'Newsreader',serif;font-size:clamp(22px,2.6vw,28px);line-height:1.12;color:#FBF8F1;">Break-Point Self-Assessment</p>
        <p style="margin-top:10px;font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.72);max-width:54ch;">Ten honest questions reveal which of the five components your team is most likely to lose first. Instant on-screen read.</p>
      </div>
      <span style="font-weight:700;color:#E0744A;font-size:15px;white-space:nowrap;">Take the assessment &rarr;</span>
    </a>
  </section>

  <!-- TOOL: LEADERSHIP SCORECARD (individual leader) -->
  <section style="max-width:1140px;margin:0 auto;padding:18px 32px 8px;">
    <a href={SLUGS.leadershipScorecard} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:24px;background:#1B1810;border:1px solid rgba(244,240,231,0.14);border-radius:20px;padding:34px 38px;flex-wrap:wrap;" onmouseover="this.style.borderColor='rgba(192,74,38,0.6)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.14)'">
      <div style="flex:1;min-width:280px;">
        <span style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Free tool &middot; 4 minutes</span>
        <p style="margin-top:12px;font-family:'Newsreader',serif;font-size:clamp(22px,2.6vw,28px);line-height:1.12;color:#FBF8F1;">Leadership Scorecard</p>
        <p style="margin-top:10px;font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.72);max-width:54ch;">Ten questions on your own leadership &mdash; are you building your team and business, or bottlenecking them? Instant Leadership Health Score and your top three growth areas.</p>
      </div>
      <span style="font-weight:700;color:#E0744A;font-size:15px;white-space:nowrap;">Take the scorecard &rarr;</span>
    </a>
  </section>

  <!-- TOOL: LEADERSHIP COACHING QUESTIONS -->
  <section style="max-width:1140px;margin:0 auto;padding:18px 32px 8px;">
    <a href={SLUGS.coachingQuestions} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:24px;background:#1B1810;border:1px solid rgba(244,240,231,0.14);border-radius:20px;padding:34px 38px;flex-wrap:wrap;" onmouseover="this.style.borderColor='rgba(192,74,38,0.6)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.14)'">
      <div style="flex:1;min-width:280px;">
        <span style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Free cheat sheet &middot; copy-ready</span>
        <p style="margin-top:12px;font-family:'Newsreader',serif;font-size:clamp(22px,2.6vw,28px);line-height:1.12;color:#FBF8F1;">Leadership Coaching Questions</p>
        <p style="margin-top:10px;font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.72);max-width:54ch;">15 tap-to-copy prompts that coach the three traits that predict leadership &mdash; Initiative, Applied Grit, Learnability. For your next one-on-one.</p>
      </div>
      <span style="font-weight:700;color:#E0744A;font-size:15px;white-space:nowrap;">Get the questions &rarr;</span>
    </a>
  </section>

  <!-- THIRD TOOL: RESEARCH REPORT -->
  <section style="max-width:1140px;margin:0 auto;padding:18px 32px 8px;">
    <a href={SLUGS.research} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:24px;background:#1B1810;border:1px solid rgba(244,240,231,0.14);border-radius:20px;padding:34px 38px;flex-wrap:wrap;" onmouseover="this.style.borderColor='rgba(192,74,38,0.6)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.14)'">
      <div style="flex:1;min-width:280px;">
        <span style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Research report &middot; 2026</span>
        <p style="margin-top:12px;font-family:'Newsreader',serif;font-size:clamp(22px,2.6vw,28px);line-height:1.12;color:#FBF8F1;">The State of Executive Team Execution</p>
        <p style="margin-top:10px;font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.72);max-width:54ch;">20+ studies on why leadership teams fail to execute, synthesized through the five components &mdash; with every statistic sourced. Free to cite.</p>
      </div>
      <span style="font-weight:700;color:#E0744A;font-size:15px;white-space:nowrap;">Read the report &rarr;</span>
    </a>
  </section>

  <!-- RESEARCH REPORT -->
  <section style="max-width:1140px;margin:0 auto;padding:18px 32px 8px;">
    <a href={SLUGS.research} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:24px;background:#1B1810;border:1px solid rgba(244,240,231,0.14);border-radius:20px;padding:34px 38px;flex-wrap:wrap;" onmouseover="this.style.borderColor='rgba(192,74,38,0.6)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.14)'">
      <div style="flex:1;min-width:280px;">
        <span style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Research report &middot; cite &amp; link</span>
        <p style="margin-top:12px;font-family:'Newsreader',serif;font-size:clamp(22px,2.6vw,28px);line-height:1.12;color:#FBF8F1;">The State of Executive Team Execution</p>
        <p style="margin-top:10px;font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.72);max-width:56ch;">The data on why leadership teams fail to execute &mdash; McKinsey, HBR, LSA Global, Gallup &mdash; synthesized into one citable report, plus early FlagScore&trade; signals.</p>
      </div>
      <span style="font-weight:700;color:#E0744A;font-size:15px;white-space:nowrap;">Read the report &rarr;</span>
    </a>
  </section>

  <!-- LEARN THE FRAMEWORK -->
  <section style="max-width:1140px;margin:0 auto;padding:36px 32px 8px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Learn the framework</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">
      <a href={SLUGS.flagModel} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:18px;padding:32px;display:flex;flex-direction:column;min-height:190px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">The framework</span>
        <span style="margin-top:12px;font-family:'Newsreader',serif;font-size:25px;line-height:1.1;color:#FBF8F1;">The Flag Model</span>
        <span style="margin-top:12px;font-size:15px;line-height:1.55;color:rgba(244,240,231,0.72);">A flag held upright by four cables: the Decision, the Rhythm, the Standard, the Learning. Cut one and it tilts.</span>
        <span style="margin-top:auto;padding-top:16px;font-weight:700;font-size:14.5px;color:#E0744A;">Read it &rarr;</span>
      </a>
      <a href={SLUGS.fieldNotes} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:18px;padding:32px;display:flex;flex-direction:column;min-height:190px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Straight answers</span>
        <span style="margin-top:12px;font-family:'Newsreader',serif;font-size:25px;line-height:1.1;color:#FBF8F1;">Field Notes</span>
        <span style="margin-top:12px;font-size:15px;line-height:1.55;color:rgba(244,240,231,0.72);">The questions CEOs actually ask when a team stops executing &mdash; answered, and mapped to the discipline that broke.</span>
        <span style="margin-top:auto;padding-top:16px;font-weight:700;font-size:14.5px;color:#E0744A;">Browse the library &rarr;</span>
      </a>
    </div>
    <a href={SLUGS.strategyExecutionGap} style="margin-top:14px;text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:22px 26px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
      <span><span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">The Strategy Execution Gap</span><span style="display:block;margin-top:6px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Why capable teams with a sound plan still fail to execute &mdash; and the four disciplines that close it.</span></span>
      <span style="font-weight:700;font-size:14.5px;color:#E0744A;white-space:nowrap;">Read the guide &rarr;</span>
    </a>
    <a href={SLUGS.glossary} style="margin-top:14px;text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:22px 26px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
      <div>
        <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Glossary</p>
        <p style="margin-top:5px;font-size:14px;color:rgba(244,240,231,0.62);">Every term, defined plainly &mdash; the Flag Model, FlagScore, the Calibration Call, ELFS.</p>
      </div>
      <span style="font-weight:700;color:#E0744A;font-size:14px;white-space:nowrap;">Open &rarr;</span>
    </a>
  </section>

  <!-- COMPARE -->
  <section style="max-width:1140px;margin:0 auto;padding:44px 32px 8px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:8px;">Compare to what you already run</p>
    <p style="font-size:16px;line-height:1.55;color:rgba(244,240,231,0.66);max-width:60ch;margin-bottom:26px;">The Flag Model isn't a replacement for your operating system &mdash; it's the layer underneath that makes it stick. Honest, side-by-side comparisons:</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:repeat(2,1fr);gap:14px;">
      <a href={SLUGS.eosOkrs} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px 26px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <div>
          <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs EOS &amp; OKRs</p>
          <p style="margin-top:5px;font-size:14px;color:rgba(244,240,231,0.62);">Why the framework didn't change behavior.</p>
        </div>
        <span style="font-weight:700;color:#E0744A;font-size:14px;white-space:nowrap;">Read &rarr;</span>
      </a>
      <a href={SLUGS.vsEos} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px 26px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <div>
          <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs EOS &amp; Traction</p>
          <p style="margin-top:5px;font-size:14px;color:rgba(244,240,231,0.62);">The operating system vs. the disciplines that make it stick.</p>
        </div>
        <span style="font-weight:700;color:#E0744A;font-size:14px;white-space:nowrap;">Read &rarr;</span>
      </a>
      <a href={SLUGS.vsOkrs} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px 26px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <div>
          <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs OKRs</p>
          <p style="margin-top:5px;font-size:14px;color:rgba(244,240,231,0.62);">A scoreboard exposes the gap; the disciplines close it.</p>
        </div>
        <span style="font-weight:700;color:#E0744A;font-size:14px;white-space:nowrap;">Read &rarr;</span>
      </a>
      <a href={SLUGS.vsScalingUp} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px 26px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <div>
          <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs Scaling Up</p>
          <p style="margin-top:5px;font-size:14px;color:rgba(244,240,231,0.62);">The full growth playbook vs. the team behavior under Execution.</p>
        </div>
        <span style="font-weight:700;color:#E0744A;font-size:14px;white-space:nowrap;">Read &rarr;</span>
      </a>
      <a href={SLUGS.vs4dx} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px 26px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <div>
          <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs 4DX</p>
          <p style="margin-top:5px;font-size:14px;color:rgba(244,240,231,0.62);">Execution machinery vs. the disciplines underneath it.</p>
        </div>
        <span style="font-weight:700;color:#E0744A;font-size:14px;white-space:nowrap;">Read &rarr;</span>
      </a>
      <a href={SLUGS.vsFiveDysfunctions} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px 26px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <div>
          <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs the Five Dysfunctions</p>
          <p style="margin-top:5px;font-size:14px;color:rgba(244,240,231,0.62);">Team health vs. a repeatable operating system.</p>
        </div>
        <span style="font-weight:700;color:#E0744A;font-size:14px;white-space:nowrap;">Read &rarr;</span>
      </a>
      <a href={SLUGS.vsCoaching} style="text-decoration:none;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px 26px;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <div>
          <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs executive coaching</p>
          <p style="margin-top:5px;font-size:14px;color:rgba(244,240,231,0.62);">Individual development vs. team disciplines.</p>
        </div>
        <span style="font-weight:700;color:#E0744A;font-size:14px;white-space:nowrap;">Read &rarr;</span>
      </a>
    </div>
  </section>

