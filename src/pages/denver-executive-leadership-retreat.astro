---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareRow from '../components/ShareRow.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = 'Executive Off-Road Leadership Offsite — Denver, Colorado & Sedona | Be Legendary';
const description =
  'A private, one-day, James-Carter-led off-road leadership offsite for executive teams — in Colorado\'s San Juan high country (fly in from Denver) or the Sedona red rock, out of Phoenix. Real terrain, real trust, real transformation. By invitation.';

// Gated pricing: Service + FAQ + Breadcrumb only. No Offer / price (invitation-only).
const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Executive Retreats', item: 'https://www.belegendary.org/teams/retreats/' },
    { '@type': 'ListItem', position: 3, name: 'Off-Road Immersion', item: 'https://www.belegendary.org/denver-executive-leadership-retreat/' },
  ] },
  { '@type': 'Service', '@id': 'https://www.belegendary.org/denver-executive-leadership-retreat/#service',
    name: 'Off-Road Immersion — Executive Leadership Offsite',
    serviceType: 'Executive leadership offsite',
    provider: { '@id': 'https://www.belegendary.org/#org' },
    areaServed: [ { '@type': 'AdministrativeArea', name: 'Colorado' }, { '@type': 'AdministrativeArea', name: 'Arizona' }, { '@type': 'City', name: 'Denver' }, { '@type': 'City', name: 'Sedona' }, { '@type': 'City', name: 'Phoenix' } ],
    description: 'A private, one-day executive leadership immersion led by James Carter, run in Colorado\'s San Juan high country (teams gather in Denver and fly in to Montrose, or meet in southwest Colorado) and in the Sedona red rock of Arizona (out of Phoenix). Small executive teams spend a day off-road — two per Jeep, everyone driving and deciding — with facilitated leadership reflection tied to what happens on the mountain. By invitation.',
    audience: { '@type': 'Audience', audienceType: 'Executive teams' } },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'Where does the Off-Road Immersion take place?', acceptedAnswer: { '@type': 'Answer', text: 'We run it in two settings. In Colorado, teams gather in Denver and — for a true single day — fly from Centennial into the San Juan high country near Montrose (our premium fly-in), or meet us directly in southwest Colorado. We also run the same day in the Sedona red rock of Arizona, out of Phoenix. What makes it singular is not the location; it is James and the method.' } },
    { '@type': 'Question', name: 'Is there a minimum group size?', acceptedAnswer: { '@type': 'Answer', text: 'No — we have hosted teams as small as two. It is built to be small and high-touch (two executives per Jeep). There is a minimum investment for the day regardless of headcount, which we share when you enquire.' } },
    { '@type': 'Question', name: 'When can we do it?', acceptedAnswer: { '@type': 'Answer', text: 'In Colorado, roughly May through October, when the high country is open. Sedona extends the season into the spring and fall shoulder months. We host a small number of executive teams each season, so dates are limited and arranged directly.' } },
    { '@type': 'Question', name: 'Do we need off-road experience or to be especially fit?', acceptedAnswer: { '@type': 'Answer', text: 'No experience is required. Professional off-road guides lead every mile, the vehicles are provided, and the day is risk-managed throughout. It is challenging and dramatic by design, but safe and guided — the difficulty is emotional and relational, not athletic.' } },
    { '@type': 'Question', name: 'How much does it cost?', acceptedAnswer: { '@type': 'Answer', text: 'This is an invitation, not a package, so there is no public price. There is a minimum investment for the day, which we share when you start the conversation. Tell us about your team and what you are trying to become, and we will take it from there.' } },
    { '@type': 'Question', name: 'What is included?', acceptedAnswer: { '@type': 'Answer', text: 'Everything but your arrival: James Carter-led facilitation, professional guides and all vehicles (two guests per Jeep), group staging and ground shuttle, premium food and beverage, and all permits, insurance, safety, and logistics. A pre-day alignment call tailors the leadership focus to your team’s real situation.' } },
  ] },
];
---
<BaseLayout
  title={title}
  description={description}
  path={SLUGS.denverImmersion}
  ogTitle="The Off-Road Immersion — A Denver Executive Leadership Offsite"
  ogDescription="A private, one-day leadership immersion in the Colorado Rockies with James Carter. Where real terrain, real stakes, and real reflection build trust no boardroom can."
  schema={schema}
  bodyBg="#100E0A"
>
  <SiteHeader audience="teams" logoHref="/" maxWidth={1160} links={[{ label: 'The Flag Model', href: SLUGS.flagModel }, { label: 'Retreats', href: SLUGS.teamRetreats }, { label: 'Case studies', href: SLUGS.caseStudies }]} />

  <article>
  <!-- HERO -->
  <style>
    .odi-hero { position:relative; width:100vw; margin-left:calc(50% - 50vw); min-height:min(88vh,820px); display:flex; align-items:flex-end; overflow:hidden; background:#100E0A; }
    .odi-hero__bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%; z-index:0; }
    .odi-hero__scrim { position:absolute; inset:0; z-index:1; background:linear-gradient(0deg,rgba(16,14,10,0.94) 2%,rgba(16,14,10,0.55) 34%,rgba(16,14,10,0.25) 62%,rgba(16,14,10,0.5) 100%); }
    .odi-hero__inner { position:relative; z-index:2; width:100%; max-width:1160px; margin:0 auto; padding:0 32px 76px; }
    @media (max-width:860px){ .odi-hero{ min-height:auto; } .odi-hero__inner{ padding:0 24px 56px; } }
  </style>
  <section class="odi-hero">
    <img class="odi-hero__bg" src="/assets/offroad/colorado/co-offroad-hero.webp" alt="A Jeep on a rocky shelf road high in the Colorado Rockies, two executives looking out over the valley — the Off-Road Immersion leadership offsite." width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" />
    <div class="odi-hero__scrim"></div>
    <div class="odi-hero__inner">
      <div style="max-width:680px;">
        <p style="display:inline-flex;align-items:center;gap:9px;font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:22px;"><span style="width:7px;height:7px;border-radius:50%;background:#C04A26;display:inline-block;"></span>Executive off-road immersion &middot; Colorado &amp; Sedona</p>
        <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(40px,6vw,76px);line-height:1.01;letter-spacing:-0.025em;color:#FBF8F1;text-shadow:0 2px 30px rgba(0,0,0,0.5);">Where the mountain <span style="font-style:italic;color:#E0744A;">becomes the lesson.</span></h1>
        <p style="margin-top:26px;font-size:clamp(17px,2vw,21px);line-height:1.55;max-width:52ch;color:rgba(244,240,231,0.9);">A private, one-day off-road leadership immersion in the <strong style="color:#F4F0E7;">Colorado high country</strong> &mdash; or the Sedona red rock &mdash; led by James Carter, where real terrain, real stakes, and real reflection build trust no boardroom can.</p>
        <div style="margin-top:34px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;">
          <a href={CTA_URL} target="_blank" rel="noopener" style="background:#C04A26;color:#fff;text-decoration:none;padding:17px 32px;border-radius:11px;font-weight:700;font-size:17px;display:inline-flex;align-items:center;gap:9px;box-shadow:0 14px 40px -12px rgba(192,74,38,0.6);" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Request an invitation <span style="font-size:18px;">&rarr;</span></a>
        </div>
        <p style="margin-top:18px;font-size:13.5px;color:rgba(244,240,231,0.62);">By invitation &mdash; a small number of executive teams each season.</p>
      </div>
    </div>
  </section>

  <!-- THE IDEA -->
  <section style="background:#F4F0E7;color:#1B1810;padding:96px 32px;">
    <div style="max-width:820px;margin:0 auto;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:24px;">The idea</p>
      <p style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3.4vw,38px);line-height:1.3;letter-spacing:-0.01em;color:#1B1810;">Most leadership offsites happen in a hotel. This one happens at 11,000 feet. Two executives per Jeep &mdash; everyone drives, everyone decides &mdash; across terrain that demands trust and rewards it. Between the climbs, <strong style="color:#C04A26;">James Carter turns what just happened into the leadership conversation your team has been avoiding.</strong> It&rsquo;s intense, it&rsquo;s dramatic, and it changes how a team sees itself.</p>
      <p style="margin-top:26px;font-size:18px;line-height:1.65;color:#56524A;max-width:62ch;">You can&rsquo;t learn to lead from a slide. Like a language, leadership is learned by immersion &mdash; dropped somewhere you can&rsquo;t coast, where the next move is real and the team is watching. The Jeeps are just the vehicle. What you can&rsquo;t rent anywhere else is the man, the facilitation, and the meaning James wraps around the mountain &mdash; the tip of the spear of a full Be Legendary retreat, compressed into one unforgettable day.</p>
    </div>
  </section>

  <!-- WHY IT WORKS -->
  <section style="background:#15130E;color:#F4F0E7;padding:96px 32px;">
    <div style="max-width:1160px;margin:0 auto;">
      <div style="max-width:64ch;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">Why off-road works</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(30px,4.2vw,50px);line-height:1.04;letter-spacing:-0.02em;color:#FBF8F1;">You can&rsquo;t coast on a mountain.</h2>
        <p style="margin-top:20px;font-size:18px;line-height:1.65;color:rgba(244,240,231,0.8);max-width:60ch;">This isn&rsquo;t a thrill ride with a debrief bolted on. The terrain is a leadership instrument &mdash; it strips away the two things that let a team hide, comfort and pretense, and puts four real dynamics on the table where James can work them.</p>
      </div>
      <div class="bl-grid-collapse" style="margin-top:44px;display:grid;grid-template-columns:repeat(2,1fr);gap:20px;">
        <div style="background:#211D15;border:1px solid rgba(244,240,231,0.1);border-radius:18px;padding:32px 34px;">
          <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The core idea</span>
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#FBF8F1;margin-bottom:10px;">Obstacle vs. limitation</h3>
          <p style="font-size:16px;line-height:1.62;color:rgba(244,240,231,0.78);">The mountain hands your team a real obstacle &mdash; a line to pick, a call to make with something actually at stake. Meeting it, each person runs into something else: the limitation they brought along, the quiet story about what they can&rsquo;t do. Off-road makes the difference physical &mdash; you feel, in your body, which walls are real and which you built. No leader owns anything more useful, and none of it survives a slide deck.</p>
        </div>
        <div style="background:#211D15;border:1px solid rgba(244,240,231,0.1);border-radius:18px;padding:32px 34px;">
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#FBF8F1;margin-bottom:10px;">Across the line, into the learning zone</h3>
          <p style="font-size:16px;line-height:1.62;color:rgba(244,240,231,0.78);">Nobody grows where it&rsquo;s comfortable. The day is built to move people &mdash; safely, deliberately &mdash; out of &ldquo;this is fine&rdquo; and into the discomfort where learning actually happens. Once a team has crossed that line together, they know how to find it again on purpose.</p>
        </div>
        <div style="background:#211D15;border:1px solid rgba(244,240,231,0.1);border-radius:18px;padding:32px 34px;">
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#FBF8F1;margin-bottom:10px;">Two teams at once</h3>
          <p style="font-size:16px;line-height:1.62;color:rgba(244,240,231,0.78);">Two executives per Jeep: every person is leading and being led, minute to minute. And the vehicles have to move as one. That&rsquo;s the exact shape of a leadership team &mdash; individuals who must also act as a single body &mdash; made visible for a day, and impossible to fake.</p>
        </div>
        <div style="background:#211D15;border:1px solid rgba(244,240,231,0.1);border-radius:18px;padding:32px 34px;">
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#FBF8F1;margin-bottom:10px;">How your team actually operates</h3>
          <p style="font-size:16px;line-height:1.62;color:rgba(244,240,231,0.78);">Under real load, the team&rsquo;s true operating system shows: who steps up, who goes quiet, where trust runs thin. James reads it in motion and hands it back at the debrief. What surfaces on the mountain is what&rsquo;s been running the business the whole time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE DAY -->
  <section style="background:#F4F0E7;color:#1B1810;padding:96px 32px;">
    <div style="max-width:900px;margin:0 auto;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">The day</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(30px,4.2vw,48px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;">A single, unforgettable day.</h2>
      <p style="margin-top:18px;font-size:18px;line-height:1.65;color:#56524A;max-width:58ch;">Not an itinerary &mdash; an arc. It starts before the wheels turn and ends with a team that sees itself differently.</p>
      <ol style="margin:44px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;">
        {[
          ['01','Dawn gather & brief','Coffee, and the frame from James: today, the terrain is the teacher. What we&rsquo;re really here to work on.'],
          ['02','Into the mountains','Two-up Jeeps, real off-road, escalating challenge. Teams navigate, decide, and rely on each other as the trail climbs.'],
          ['03','The hard stretch','The dramatic, trust-forging section &mdash; guided and safe &mdash; where the leadership metaphors stop being metaphors.'],
          ['04','Summit reset','A facilitated leadership conversation with James at altitude, tied directly to what just happened in the vehicles.'],
          ['05','The table','A premium meal and debrief. Commitments, and what carries back to the business on Monday.'],
        ].map(([n,h,b], i) => (
          <li style={`display:grid;grid-template-columns:64px 1fr;gap:22px;padding:26px 0;${i < 4 ? 'border-bottom:1px solid rgba(27,24,16,0.12);' : ''}`}>
            <span style="font-family:'Newsreader',serif;font-size:34px;color:#C04A26;line-height:1;">{n}</span>
            <div>
              <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:23px;color:#1B1810;margin-bottom:7px;">{h}</h3>
              <p style="font-size:16.5px;line-height:1.6;color:#56524A;max-width:58ch;" set:html={b}></p>
            </div>
          </li>
        ))}
      </ol>

      <!-- What changes -->
      <div style="margin-top:56px;padding-top:40px;border-top:1px solid rgba(27,24,16,0.12);">
        <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(22px,3vw,30px);line-height:1.15;color:#1B1810;margin-bottom:24px;">By the drive home, something has changed.</h3>
        <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:36px;">
          {[
            ['Each leader', [
              'Sharper self-awareness — how you show up when it&rsquo;s real, not rehearsed.',
              'A distinction you&rsquo;ll use for years: obstacle vs. limitation.',
              'The nerve to step into the learning zone on purpose.',
            ]],
            ['The team', [
              'Trust built under real load — the kind meetings can&rsquo;t manufacture.',
              'A shared language and a shared story the team keeps reaching for.',
              'An honest picture of how you actually operate — and commitments that carry back to Monday.',
            ]],
          ].map(([label, items]) => (
            <div>
              <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">{label}</p>
              <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;">
                {items.map((it) => (
                  <li style="display:flex;gap:11px;align-items:flex-start;font-size:16px;line-height:1.55;color:#3A372F;"><span style="color:#C04A26;flex:none;font-weight:700;">&#10003;</span><span set:html={it}></span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- INCLUDED / LOGISTICS -->
  <section style="background:#15130E;color:#F4F0E7;padding:96px 32px;">
    <div class="bl-grid-collapse" style="max-width:1160px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;">
      <div>
        <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">Done for you</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,42px);line-height:1.06;letter-spacing:-0.015em;color:#FBF8F1;">Guests just arrive. We handle the mountain.</h2>
        <p style="margin-top:20px;font-size:17px;line-height:1.62;color:rgba(244,240,231,0.8);max-width:46ch;">Staging, ground shuttle, vehicles, fuel, food, guiding, facilitation, and every permit and policy behind an off-road day on public land &mdash; all of it is ours to carry. Yours is to show up and be present.</p>
        <div style="margin-top:26px;display:flex;flex-wrap:wrap;gap:10px;">
          <span style="font-size:13px;font-weight:600;color:#F4F0E7;background:#211D15;border:1px solid rgba(244,240,231,0.14);padding:8px 14px;border-radius:999px;">Colorado &amp; Sedona</span>
          <span style="font-size:13px;font-weight:600;color:#F4F0E7;background:#211D15;border:1px solid rgba(244,240,231,0.14);padding:8px 14px;border-radius:999px;">May&ndash;October</span>
          <span style="font-size:13px;font-weight:600;color:#F4F0E7;background:#211D15;border:1px solid rgba(244,240,231,0.14);padding:8px 14px;border-radius:999px;">Small &amp; intimate</span>
          <span style="font-size:13px;font-weight:600;color:#F4F0E7;background:#211D15;border:1px solid rgba(244,240,231,0.14);padding:8px 14px;border-radius:999px;">No experience needed</span>
        </div>
      </div>
      <div style="background:#211D15;border:1px solid rgba(244,240,231,0.12);border-radius:18px;padding:34px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:18px;">What&rsquo;s included</p>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:15px;">
          {[
            'James Carter-led facilitation and the leadership through-line',
            'Professional off-road guides and all vehicles — two guests per Jeep',
            'Group shuttle and staging to and from the trailhead',
            'Premium food and beverage',
            'Permits, insurance, safety, and full logistics',
            'A pre-day alignment call to tailor the focus to your team',
          ].map((item) => (
            <li style="display:flex;gap:12px;align-items:flex-start;font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.86);"><span style="color:#C04A26;flex:none;font-weight:700;">&#10003;</span><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>
    <!-- Where we run it -->
    <div style="max-width:1160px;margin:56px auto 0;padding-top:40px;border-top:1px solid rgba(244,240,231,0.1);">
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:44px;align-items:center;">
        <img src="/assets/offroad/colorado/co-alpine-loop-signs.webp" alt="Trail signs for Engineer Pass, Cinnamon Pass and Silverton on Colorado's Alpine Loop, above a green mining valley — the San Juan terrain of the Off-Road Immersion." width="1400" height="1050" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:16px;border:1px solid rgba(244,240,231,0.12);display:block;" />
        <div>
          <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:14px;">Where we run it</p>
          <p style="font-size:19px;line-height:1.6;color:rgba(244,240,231,0.86);">Two settings, one experience. In <strong style="color:#F4F0E7;">Colorado&rsquo;s San Juan high country</strong> &mdash; old mining roads onto 12,000-foot passes, ghost-town relics, tundra most people only see from a plane window. And in the <strong style="color:#F4F0E7;">Sedona red rock of Arizona</strong>. What you can&rsquo;t get anywhere else isn&rsquo;t the zip code &mdash; it&rsquo;s James and this method, wrapped around the mountain.</p>
          <p style="margin-top:16px;font-size:14.5px;line-height:1.6;color:rgba(244,240,231,0.6);">Colorado teams gather in Denver; for a true single day we fly you from Centennial into the San Juans &mdash; the premium way in &mdash; or meet you in the southwest. Prefer red rock? See the <a href={SLUGS.sedonaImmersion} style="color:#D98A5E;text-decoration:none;font-weight:600;">Sedona Off-Road Immersion &rarr;</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section style="background:#F4F0E7;color:#1B1810;padding:96px 32px;">
    <div style="max-width:900px;margin:0 auto;">
      <figure style="margin:0 0 44px;">
        <img src="/assets/offroad/colorado/co-offroad-facilitation.webp" alt="James Carter, kneeling in a grey pullover, facilitating a leadership debrief with an executive team standing in a circle on Colorado's Alpine Loop above Silverton." width="1536" height="1024" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:18px;border:1px solid rgba(27,24,16,0.1);display:block;box-shadow:0 34px 66px -36px rgba(27,24,16,0.55);" />
        <figcaption style="margin-top:13px;font-size:13.5px;color:#8A7F6C;">James facilitating the debrief on the Alpine Loop above Silverton, Colorado &mdash; the conversation the whole day is built around.</figcaption>
      </figure>
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">Who leads it</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,42px);line-height:1.06;color:#1B1810;">James Carter</h2>
      <p style="margin-top:20px;font-size:18.5px;line-height:1.65;color:#3A372F;max-width:62ch;">James is the creator of the Flag Model and the sole author of the forthcoming <em style="font-style:italic;">Lost Disciplines of Leadership</em>&trade;, and co-authored collaborative books &mdash; including <em style="font-style:italic;">Discover Your Inner Strength</em> and <em style="font-style:italic;">Roadmap to Success</em> &mdash; alongside Stephen Covey, Ken Blanchard, Deepak Chopra and Brian Tracy. He has spent twenty-five years inside hundreds of leadership teams &mdash; work featured in CNN, CNN Money and Business Insider. On the mountain, that experience becomes a facilitator who can read a team in motion and turn a switchback into the conversation that changes them.</p>
      <p style="margin-top:16px;font-size:15px;color:#6B675E;"><a href={SLUGS.about} style="color:#C04A26;text-decoration:none;font-weight:600;">More about James &rarr;</a></p>

      <!-- Testimonial slot — add 1–2 executive quotes from past off-road days -->
      <figure style="margin:44px 0 0;background:#FBF8F1;border:1px solid rgba(27,24,16,0.1);border-left:3px solid #C04A26;border-radius:16px;padding:32px 34px;">
        <blockquote style="margin:0;font-family:'Newsreader',serif;font-style:italic;font-size:clamp(19px,2.3vw,25px);line-height:1.4;color:#1B1810;max-width:52ch;">The day in the mountains did more for how our leadership team trusts each other than anything we&rsquo;d tried in the office.</blockquote>
