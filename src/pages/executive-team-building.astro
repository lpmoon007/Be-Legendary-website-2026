---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_URL, ORG_ID, SLUGS, CTA_URL } from '../lib/site';

const path = SLUGS.executiveTeamBuilding;
const title = 'Executive Team Building That Changes How the Team Decides | Be Legendary';
const description =
  'Most executive team building is entertainment that changes nothing. We build your executive team as the highest-leverage decision system in the company — engineered, facilitated, and reinforced so it holds. Not trust falls.';

// The two single-day format "rooms." Each is a laboratory for real behavior —
// the experience is not the intervention. Prices are deliberately omitted:
// every engagement is scoped to the team, so a range would mislead.
const formats = [
  { name: 'The Executive Off-Road Immersion', href: SLUGS.offRoadImmersion, meta: 'One dramatic day', img: '/assets/offroad/colorado/co-offroad-hero.webp', desc: 'A single day where real terrain makes the team’s true operating system visible — then a facilitated debrief turns it into the conversation you’ve been avoiding.' },
  { name: 'Sailing Team Building', href: SLUGS.sailingTeamBuilding, meta: 'On the water', img: '/assets/sailing/schooner.webp', desc: 'A day of sailing built as a coupled system where the team’s real behavior surfaces under pressure — then a structured debrief converts it into how you operate.' },
];

// "At a glance" — the EA's payload. Group size, duration, location, lead time,
// inclusions for every format including the retreat and Team LFS. No price.
const glance = [
  { name: 'Off-Road Immersion', href: SLUGS.offRoadImmersion, group: 'No minimum — teams from ~2 (two guests per Jeep)', duration: 'One day · multi-day expeditions available', where: 'Las Vegas · Phoenix · Sedona · Denver · Los Angeles · Salt Lake City', lead: 'A few weeks', includes: 'James Carter-led facilitation, guides & vehicles, staging & shuttle, premium food & beverage, permits, insurance & safety — everything but your arrival' },
  { name: 'Sailing Team Building', href: SLUGS.sailingTeamBuilding, group: 'A single team; scaled by vessel', duration: 'A day, or a multi-day passage', where: 'Major U.S. harbors — Pacific, Northeast, Southeast/Gulf, Great Lakes', lead: 'A few weeks (seasonal by region)', includes: 'Skippered vessel(s), facilitation and a structured debrief' },
  { name: 'The Leadership Retreat', href: SLUGS.teamRetreats, group: 'The executive team', duration: 'Multi-day', where: 'Curated venues, domestic or international', lead: 'Plan ahead — weeks to months (more for international)', includes: 'Venue, travel, facilitation and 30-day reinforcement' },
  { name: 'Team LFS', href: SLUGS.teamLfs, group: 'Up to 8 executives', duration: '~90 minutes', where: 'At your offsite, or virtually on individual devices', lead: 'Short — within weeks', includes: 'The simulation, individual & team reports, a FlagScore baseline and debrief' },
];

const faqs = [
  ['What is executive team building?', 'Executive team building is the deliberate work of turning a group of individually capable functional leaders into a single decision-making unit — one that sets shared priorities above functional ones, disagrees productively, and executes across boundaries. Done seriously, it is an intervention aimed at the interaction failures that constrain senior teams, not a morale activity. The evidence is blunt about where the value sits: not in the activity, but in exposing how the team really operates and converting that into changes in how it decides and follows through.'],
  ['Do executive team building activities actually work?', 'An activity on its own does almost nothing. Across 51 controlled studies, active practice and simulation improved teamwork while lecture-style sessions barely moved it — and the single most reliable finding in the field is that structured debriefs improve performance by roughly 20–25%. The activity is only worth its cost when it is engineered around a real problem, observed by someone who knows what they are watching, debriefed honestly, and translated into how the team decides afterward. That design is the intervention; the activity is just the laboratory.'],
  ['What is the difference between executive team building and a team offsite or retreat?', 'They are formats, not different things. An offsite is a block of time away from operations; a retreat is a facilitated version of it. Executive team building is what you do with that time. A retreat with no honest conflict and no follow-through is an offsite with better catering. The question is never “where do we go?” — it is “what interaction failure are we here to fix, and how will we know it changed?”'],
  ['Why does senior-team building need to be different from ordinary team building?', 'Because the failures are different. Executives rarely lack energy or camaraderie; they suffer from suppressed conflict, false agreement, unclear decision rights, and functional advocacy dressed up as strategy. Generic bonding does not touch those. And the stakes are multiplicative — the executive team’s behavior becomes the template the rest of the company copies. Building it is the highest-leverage move available, which is exactly why it should not be handed to an events vendor.'],
  ['How do you measure whether it worked?', 'Not by whether people enjoyed it. In the room: shared priorities named, decision rights assigned, real conflicts surfaced, commitments documented. Over 30–90 days: decision-cycle time, how often decisions get reopened, commitment-completion rate, cross-functional escalations, and how fast bad news travels. Then the specific business outcome we started from. Causation in a live company is never clean; what we hold ourselves to is a documented chain — intervention, to changed behavior, to changed process, to measurable result.'],
  ['We just need executive team building ideas or exercises. Can you help?', 'Yes — but we will start by talking you out of choosing the exercise first. Tell us the problem (slow decisions, silo conflict, a post-acquisition team, a new C-suite that has never actually functioned together) and the right format follows. Book a Calibration Call and you will leave with a real read on where your team breaks first, whether or not we work together.'],
  // ── EA questions (she will search these) ──
  ['How far in advance do we need to book?', 'Enough time to interview the team and build the day around what we find. A single day — off-road, sailing, or Team LFS — typically comes together in a few weeks; a curated or international retreat needs longer, so plan months out. Tell us your target date on the Calibration Call and we will tell you straight whether it is doable.'],
  ['What do you need from us before the day?', 'Very little. A short calibration call, then twenty to thirty minutes each with two or three people on the team, and your read on the one outcome that matters. That is enough for us to build the day around your real fault line. Everything else — logistics, venue, vehicles or vessel, facilitation, and the follow-up — is ours.'],
];

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'For Teams', item: `${SITE_URL}${SLUGS.teams}` },
    { '@type': 'ListItem', position: 3, name: 'Executive Team Building', item: `${SITE_URL}${SLUGS.executiveTeamBuilding}` },
  ] },
  { '@type': 'Service', '@id': `${SITE_URL}${SLUGS.executiveTeamBuilding}#service`,
    name: 'Executive Team Building',
    serviceType: 'Executive team development',
    provider: { '@id': ORG_ID },
    areaServed: 'US',
    audience: { '@type': 'Audience', audienceType: 'Executive teams' },
    description: 'Executive team building as a facilitated intervention rather than an event: we surface how a senior team actually decides, disagrees and executes, then rebuild those interaction capabilities and reinforce them so they hold.' },
  { '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => (
    { '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }
  )) },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="website"
  ogTitle="Executive Team Building — the version that changes how the team decides"
  ogDescription="Most executive team building is theater. We build the executive team as your highest-leverage decision system — facilitated and reinforced. Not trust falls."
  bodyBg="#15130E"
  schema={schema}
>
  <SiteHeader audience="teams" variant="full" logoHref="/" />

  <div style="background:#15130E;color:#F4F0E7;overflow:hidden;">

    <!-- ============ 1. HERO ============ -->
    <section style="background:#F4F0E7;color:#1B1810;">
      <div style="max-width:1180px;margin:0 auto;padding:64px 32px 92px;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href="/" style="color:inherit;text-decoration:none;">Home</a><span>/</span><a href={SLUGS.teams} style="color:inherit;text-decoration:none;">For Teams</a><span>/</span><span style="color:#C04A26;">Executive Team Building</span>
        </nav>
        <p style="display:inline-flex;align-items:center;gap:9px;font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:24px;"><span style="width:7px;height:7px;border-radius:50%;background:#C04A26;"></span>Executive team building</p>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(38px,5.6vw,72px);line-height:1.0;letter-spacing:-0.024em;color:#1B1810;max-width:20ch;">Executive team building that builds how your leadership team <span style="font-style:italic;color:#C04A26;">decides, disagrees, and executes.</span></h1>
        <p style="margin-top:26px;font-size:20px;line-height:1.6;color:#56524A;max-width:56ch;">Your executive team is the highest-leverage decision system in the company. This is a facilitated intervention engineered around how it actually operates under pressure &mdash; then reinforced so it holds. Not trust falls, not two days out of the office you&rsquo;ll have forgotten by Monday.</p>
        <p style="margin-top:16px;font-size:16.5px;line-height:1.55;color:#7A7061;max-width:56ch;">It runs as a <strong style="color:#3A362D;font-weight:600;">single facilitated day</strong>, or as something longer when the problem needs it. The format follows the problem &mdash; never the other way around.</p>

        <!-- short-answer / featured-snippet box (Section 2: What executive team building is) -->
        <div style="margin-top:34px;max-width:64ch;background:#EFE8DA;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:26px 28px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">What is executive team building?</p>
          <p style="font-size:18px;line-height:1.62;color:#3A362D;">The deliberate work of turning capable functional leaders into a <strong style="font-weight:700;">single decision-making unit</strong> &mdash; one that sets shared priorities, disagrees productively, and executes across boundaries. The research is clear about where the value is: <strong style="font-weight:700;">not in the activity, but in what a team does with it</strong> &mdash; exposing how it really operates, then converting that into how it decides.</p>
        </div>

        <div style="margin-top:34px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;">
          <a href={CTA_URL} target="_blank" rel="noopener" style="background:#C04A26;color:#fff;text-decoration:none;padding:18px 32px;border-radius:10px;font-weight:700;font-size:17px;display:inline-flex;align-items:center;gap:9px;box-shadow:0 16px 40px -16px rgba(192,74,38,0.6);" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Book a Calibration Call <span>&rarr;</span></a>
          <a href={SLUGS.breakPointAssessment} style="display:inline-flex;align-items:center;gap:8px;font-size:15.5px;font-weight:700;color:#C04A26;text-decoration:none;" onmouseover="this.querySelector('span').style.transform='translateX(4px)'" onmouseout="this.querySelector('span').style.transform='translateX(0)'">or find where your team breaks first <span style="transition:transform .2s;">&rarr;</span></a>
        </div>
      </div>
    </section>

    <!-- ============ 3. WHAT WE RUN (dark) ============ -->
    <section style="background:#15130E;color:#F4F0E7;padding:104px 32px 72px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#E0744A;margin-bottom:20px;">What we run</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(30px,4.2vw,48px);line-height:1.06;letter-spacing:-0.02em;max-width:20ch;color:#FBF8F1;">A day built for your team &mdash; or something longer.</h2>

        <!-- 3a. We interview before we design (full-width, not a card) -->
        <div style="margin-top:40px;background:linear-gradient(120deg,rgba(192,74,38,0.16),rgba(244,240,231,0.03));border:1px solid rgba(192,74,38,0.42);border-radius:18px;padding:36px 38px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">Before we design anything</p>
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,34px);line-height:1.1;color:#FBF8F1;max-width:24ch;">We interview before we design.</h3>
          <p style="margin-top:16px;font-size:18px;line-height:1.65;color:rgba(244,240,231,0.86);max-width:70ch;">We start with a calibration call, then talk with two or three people on the team. From that we state a hypothesis about where the team actually breaks &mdash; and build the day around that fault line, rather than pulling one off a shelf. That single step is the difference between this and what an events vendor sells you.</p>
        </div>

        <!-- 3b. Single-day format cards -->
        <div class="bl-grid-collapse bl-grid-collapse--gap" style="margin-top:20px;display:grid;grid-template-columns:repeat(2,1fr);gap:20px;">
          {formats.map((c) => (
            <a href={c.href} style="background:rgba(244,240,231,0.04);border:1px solid rgba(244,240,231,0.14);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;text-decoration:none;transition:border-color .16s;" onmouseover="this.style.borderColor='rgba(244,240,231,0.42)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.14)'">
              <img src={c.img} alt={c.name} loading="lazy" width="800" height="440" style="width:100%;height:210px;object-fit:cover;display:block;" />
              <div style="padding:28px 32px 32px;display:flex;flex-direction:column;flex:1;">
                <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">{c.meta}</span>
                <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:25px;margin-bottom:10px;color:#FBF8F1;">{c.name}</h3>
                <p style="font-size:15.5px;line-height:1.58;color:rgba(244,240,231,0.72);margin-bottom:18px;">{c.desc}</p>
                <span style="margin-top:auto;display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:700;color:#F4F0E7;">Explore <span>&rarr;</span></span>
              </div>
            </a>
          ))}
        </div>

        <!-- 3c. Ceiling elements (not peers of the single days) -->
        <div style="margin-top:34px;display:flex;flex-direction:column;gap:14px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(244,240,231,0.45);">When a day isn’t the right container</p>
          <a href={SLUGS.teamRetreats} style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:14px;background:rgba(244,240,231,0.03);border:1px solid rgba(244,240,231,0.12);border-left:3px solid #C04A26;border-radius:0 14px 14px 0;padding:26px 30px;text-decoration:none;" onmouseover="this.style.background='rgba(244,240,231,0.06)'" onmouseout="this.style.background='rgba(244,240,231,0.03)'">
            <span style="flex:1 1 340px;">
              <span style="display:block;font-family:'Newsreader',serif;font-size:23px;color:#FBF8F1;margin-bottom:6px;">The Leadership Retreat &mdash; when a day isn’t enough</span>
              <span style="display:block;font-size:15.5px;line-height:1.58;color:rgba(244,240,231,0.72);max-width:70ch;">A facilitated, multi-day retreat that rebuilds the discipline the day surfaced &mdash; reinforced for 30 days so it survives contact with Monday.</span>
            </span>
            <span style="flex:none;font-size:14px;font-weight:700;color:#F4F0E7;">Explore &rarr;</span>
          </a>
          <a href={SLUGS.teamLfs} style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:14px;background:rgba(244,240,231,0.03);border:1px solid rgba(244,240,231,0.12);border-left:3px solid #C04A26;border-radius:0 14px 14px 0;padding:26px 30px;text-decoration:none;" onmouseover="this.style.background='rgba(244,240,231,0.06)'" onmouseout="this.style.background='rgba(244,240,231,0.03)'">
            <span style="flex:1 1 340px;">
              <span style="display:block;font-family:'Newsreader',serif;font-size:23px;color:#FBF8F1;margin-bottom:6px;">Team LFS &mdash; when the read needs to be instrumented</span>
              <span style="display:block;font-size:15.5px;line-height:1.58;color:rgba(244,240,231,0.72);max-width:70ch;">When a conversation isn’t enough: a live behavioral simulation that logs how the team actually decides under pressure, with a FlagScore baseline you can measure against.</span>
            </span>
            <span style="flex:none;font-size:14px;font-weight:700;color:#F4F0E7;">Explore &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 4. AT A GLANCE (cream) — the EA's payload ============ -->
    <section style="background:#EFE8DA;color:#1B1810;padding:88px 32px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">At a glance</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,4vw,44px);line-height:1.06;letter-spacing:-0.02em;max-width:24ch;">Everything you need to build the comparison.</h2>
        <p style="margin-top:18px;font-size:16.5px;line-height:1.6;color:#56524A;max-width:60ch;">Group size, duration, where it runs, lead time, and what&rsquo;s included &mdash; for every format. Pricing is scoped to your team on the call; a generic range would only mislead.</p>

        <div style="margin-top:36px;overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid rgba(27,24,16,0.14);border-radius:16px;background:#FBF8F1;">
          <table style="width:100%;border-collapse:collapse;min-width:940px;font-size:14.5px;line-height:1.5;color:#3A362D;">
            <thead>
              <tr style="text-align:left;background:#EFE8DA;">
                <th style="padding:16px 18px;font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A7F6C;">Format</th>
                <th style="padding:16px 18px;font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A7F6C;">Group size</th>
                <th style="padding:16px 18px;font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A7F6C;">Duration</th>
                <th style="padding:16px 18px;font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A7F6C;">Where it runs</th>
                <th style="padding:16px 18px;font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A7F6C;">Lead time</th>
                <th style="padding:16px 18px;font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A7F6C;">Included</th>
              </tr>
            </thead>
            <tbody>
              {glance.map((r) => (
                <tr style="border-top:1px solid rgba(27,24,16,0.1);vertical-align:top;">
                  <td style="padding:18px;font-weight:700;"><a href={r.href} style="color:#C04A26;text-decoration:none;">{r.name} &rarr;</a></td>
                  <td style="padding:18px;">{r.group}</td>
                  <td style="padding:18px;">{r.duration}</td>
                  <td style="padding:18px;">{r.where}</td>
                  <td style="padding:18px;">{r.lead}</td>
                  <td style="padding:18px;color:#56524A;">{r.includes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p style="margin-top:24px;font-size:15.5px;line-height:1.6;color:#56524A;">Planning this on behalf of an executive? <a href={SLUGS.forExecutiveAssistants} style="color:#C04A26;text-decoration:none;font-weight:700;">Here&rsquo;s exactly what to bring back &rarr;</a></p>
      </div>
    </section>

    <!-- ============ activities capture (trimmed bridge, cream) ============ -->
    <section style="background:#EFE8DA;color:#1B1810;padding:0 32px 88px;">
      <div style="max-width:820px;margin:0 auto;border-top:1px solid rgba(27,24,16,0.14);padding-top:56px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3.4vw,36px);line-height:1.1;letter-spacing:-0.018em;">Searching for executive team building activities, exercises or ideas?</h2>
        <p style="margin-top:20px;font-size:18px;line-height:1.66;color:#56524A;"><strong style="color:#1B1810;font-weight:600;">The activity is the least important variable</strong> &mdash; a rock climb, a day on the water, an off-road day or a strategy session can each transform a team or waste a day. What decides which is whether it&rsquo;s engineered around a real fault line and converted into how the team decides afterward. We don&rsquo;t sell activities; we use them.</p>
        <p style="margin-top:16px;font-size:16px;line-height:1.6;color:#6E6757;">Looking for the ongoing program rather than a single intervention? See <a href={SLUGS.executiveTeamDevelopment} style="color:#C04A26;text-decoration:none;font-weight:600;">executive team development &rarr;</a> — the evidence-based process this fits inside.</p>
      </div>
    </section>

    <!-- ============ 5. WHAT SEPARATES A DAY THAT WORKS (dark) ============ -->
    <section style="background:#15130E;color:#F4F0E7;padding:112px 32px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#E0744A;margin-bottom:20px;">What you just looked at, and why it works</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(30px,4.4vw,50px);line-height:1.05;letter-spacing:-0.02em;max-width:24ch;color:#FBF8F1;">What separates a day that works from a day away.</h2>
        <div class="bl-grid-collapse bl-grid-collapse--gap" style="margin-top:48px;display:grid;grid-template-columns:1fr 1fr;gap:20px;">
          <div style="background:rgba(244,240,231,0.03);border:1px solid rgba(244,240,231,0.12);border-radius:18px;padding:34px 34px;">
            <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(244,240,231,0.5);margin-bottom:18px;">Changes nothing</p>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:13px;">
              {['Entertainment presented as development','Personality quizzes and generic labels','Forced vulnerability and forced socializing','A physical challenge unrelated to the team’s work','A motivational speech with no behavior practice','An activity followed by no application on Monday','A retreat that carefully avoids the team’s real conflict','“Did everyone have fun?” as the only measure'].map((it) => (
                <li style="display:flex;gap:11px;align-items:flex-start;font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.72);"><span style="color:rgba(244,240,231,0.4);flex:none;font-weight:700;">&times;</span><span>{it}</span></li>
              ))}
            </ul>
          </div>
          <div style="background:linear-gradient(160deg,rgba(192,74,38,0.14),rgba(244,240,231,0.03));border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:34px 34px;">
            <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:18px;">Changes the team</p>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:13px;">
              {['A defined business problem worth the executives’ time','Genuine interdependence — they need each other to succeed','Someone qualified observing how the team really operates','A structured debrief: what happened, why, where it shows up at work','Translation into decision rights, norms and priorities','Follow-through weeks later, to see if it survived','Measured on behavior and business outcomes, not enjoyment'].map((it) => (
                <li style="display:flex;gap:11px;align-items:flex-start;font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.9);"><span style="color:#E0744A;flex:none;font-weight:700;">&#10003;</span><span>{it}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <div style="margin-top:44px;max-width:74ch;">
          <p style="font-size:18px;line-height:1.72;color:rgba(244,240,231,0.82);">The single most reliable finding in this field isn&rsquo;t about the activity at all. Across 46 studies, <strong style="color:#FBF8F1;font-weight:600;">structured debriefs</strong> &mdash; performing, getting honest evidence about how you performed, then converting it into changed behavior &mdash; improved effectiveness by roughly <strong style="color:#FBF8F1;font-weight:600;">20&ndash;25%</strong>, in real and simulated settings alike.<a href="https://pubmed.ncbi.nlm.nih.gov/23516804/" target="_blank" rel="noopener nofollow" style="color:#D98A5E;text-decoration:none;"><sup>1</sup></a> The activity just creates something worth debriefing.</p>
          <p style="margin-top:18px;font-size:18px;line-height:1.72;color:rgba(244,240,231,0.82);">And when researchers compared training methods across 51 controlled studies, active practice and simulation moved teamwork and performance; lecture-style sessions barely registered.<a href="https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0169604" target="_blank" rel="noopener nofollow" style="color:#D98A5E;text-decoration:none;"><sup>2</sup></a> A 2018 review in <em style="font-style:italic;">American Psychologist</em> put it plainly: different team problems require different interventions &mdash; which is exactly why we interview before we design.</p>
          <p style="margin-top:22px;font-size:13.5px;line-height:1.6;color:rgba(244,240,231,0.5);"><sup>1</sup> Tannenbaum &amp; Cerasoli (2013), <em>Human Factors</em> &mdash; debrief meta-analysis (d&nbsp;=&nbsp;0.67). &nbsp; <sup>2</sup> McEwan et&nbsp;al. (2017), <em>PLOS ONE</em> &mdash; meta-analysis of 51 controlled teamwork interventions.</p>
        </div>
      </div>
    </section>

    <!-- ============ 6. WHY THE EXECUTIVE TEAM SPECIFICALLY (dark → the price justification) ============ -->
    <section style="background:#100E0A;color:#F4F0E7;padding:112px 32px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#E0744A;margin-bottom:20px;">Why the executive team specifically</p>
        <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1.35fr 1fr;gap:56px;align-items:center;">
          <div>
            <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(30px,4.2vw,48px);line-height:1.06;letter-spacing:-0.02em;max-width:18ch;color:#FBF8F1;">It isn&rsquo;t a morale activity. It&rsquo;s an intervention.</h2>
            <p style="margin-top:22px;font-size:18px;line-height:1.68;color:rgba(244,240,231,0.82);max-width:56ch;">What caps most executive teams isn&rsquo;t individual talent &mdash; every seat is filled by someone excellent in their function. It&rsquo;s the <strong style="color:#FBF8F1;font-weight:600;">interaction failures</strong>: ego, competing priorities and unspoken tension at the top; conflict that gets suppressed in the room and litigated afterward; agreement that isn&rsquo;t real.</p>
            <p style="margin-top:18px;font-size:18px;line-height:1.68;color:rgba(244,240,231,0.82);max-width:56ch;">McKinsey&rsquo;s assessment of top teams scored their collective health at just <strong style="color:#FBF8F1;font-weight:600;">44 out of 100</strong> &mdash; and the weakest areas were all interaction capabilities: conflict management, feedback, psychological safety and innovative thinking. You don&rsquo;t hire your way out of those. They&rsquo;re built and practiced by the team, together.</p>
            <p style="margin-top:20px;font-size:14px;color:rgba(244,240,231,0.55);">Source: <a href="https://www.mckinsey.com/capabilities/people-and-organizational-performance/our-insights/go-teams-when-teams-get-healthier-the-whole-organization-benefits" target="_blank" rel="noopener nofollow" style="color:#D98A5E;text-decoration:underline;">McKinsey, “Cracking the code of team effectiveness.”</a></p>
          </div>
          <div style="background:linear-gradient(160deg,#211D15,#191510);border:1px solid rgba(244,240,231,0.14);border-radius:20px;padding:40px 38px;text-align:center;">
            <p style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(64px,10vw,104px);line-height:1;color:#E0744A;">44<span style="font-size:0.42em;color:rgba(244,240,231,0.6);">/100</span></p>
            <p style="margin-top:14px;font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.78);">Collective health of top executive teams, self-assessed. The lowest-scoring capabilities are all things a team can only build <em style="font-style:italic;">together.</em></p>
          </div>
        </div>

        <div style="margin-top:80px;">
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,40px);line-height:1.08;letter-spacing:-0.02em;max-width:20ch;color:#FBF8F1;">The one team whose performance multiplies.</h3>
          <p style="margin-top:20px;font-size:18px;line-height:1.65;color:rgba(244,240,231,0.8);max-width:60ch;">A frontline team&rsquo;s mistakes are contained. An executive team&rsquo;s are not. Every decision it makes &mdash; or delays, or quietly reopens &mdash; sets the terms for everyone below. The return on getting it right is not additive. It compounds.</p>
          <div class="bl-grid-collapse bl-grid-collapse--gap" style="margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
            <div style="background:rgba(244,240,231,0.04);border:1px solid rgba(244,240,231,0.12);border-radius:16px;padding:32px 30px;">
              <p style="font-family:'Newsreader',serif;font-size:40px;color:#E0744A;line-height:1;">≈ 2×</p>
              <p style="margin-top:14px;font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.78);">Aligned, effective top teams were roughly twice as likely to post above-median financial performance in McKinsey&rsquo;s research &mdash; an association, not a guarantee, but a telling one.</p>
            </div>
            <div style="background:rgba(244,240,231,0.04);border:1px solid rgba(244,240,231,0.12);border-radius:16px;padding:32px 30px;">
              <p style="font-family:'Newsreader',serif;font-size:40px;color:#E0744A;line-height:1;">The template</p>
              <p style="margin-top:14px;font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.78);">When executives disagree privately and signal different priorities publicly, the whole company learns to escalate instead of resolve. The executive team is the behavior the rest of the org copies.</p>
            </div>
            <div style="background:rgba(244,240,231,0.04);border:1px solid rgba(244,240,231,0.12);border-radius:16px;padding:32px 30px;">
              <p style="font-family:'Newsreader',serif;font-size:40px;color:#E0744A;line-height:1;">Every hire</p>
              <p style="margin-top:14px;font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.78);">Each new appointment silently rewrites decision rights, alliances and trust. An org chart assigns authority. It does not create a functioning team &mdash; which is why cohesion can never be assumed.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 7. HOW YOU'LL KNOW IT WORKED (cream) ============ -->
    <section style="background:#EFE8DA;color:#1B1810;padding:104px 32px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">How you&rsquo;ll know it worked</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(30px,4.4vw,50px);line-height:1.05;letter-spacing:-0.02em;max-width:20ch;">We don&rsquo;t measure whether people enjoyed it.</h2>
        <div class="bl-grid-collapse bl-grid-collapse--gap" style="margin-top:48px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
          {[
            ['In the room', ['Shared priorities named out loud','Decision rights assigned','Real conflicts surfaced, not managed around','Commitments documented']],
            ['In 30–90 days', ['Decision-cycle time','How often decisions get reopened','Commitment-completion rate','Cross-functional escalations, and how fast bad news travels']],
            ['In the business', ['The specific outcome we started from','Integration or transformation milestones','Execution against the year’s priorities','Confidence in senior leadership']],
          ].map(([label, items]) => (
            <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.1);border-radius:16px;padding:30px 30px;">
              <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">{label}</p>
              <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;">
                {items.map((it) => (
                  <li style="display:flex;gap:10px;align-items:flex-start;font-size:15.5px;line-height:1.5;color:#3A362D;"><span style="color:#C04A26;flex:none;font-weight:700;">&#10003;</span><span>{it}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p style="margin-top:36px;font-size:17px;line-height:1.7;color:#56524A;max-width:74ch;">Causation inside a live company is never clean. What we hold ourselves to is a documented chain: <strong style="color:#1B1810;font-weight:600;">intervention &rarr; changed executive behavior &rarr; changed operating process &rarr; measurable business effect.</strong> If we can&rsquo;t draw that line, we don&rsquo;t claim the result.</p>
      </div>
    </section>

    <!-- ============ 8. PROOF (dark) ============ -->
    <section style="background:#15130E;color:#F4F0E7;padding:104px 32px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#E0744A;margin-bottom:20px;">Proof</p>
        <div class="bl-grid-collapse" style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:48px;align-items:center;">
          <div style="background:linear-gradient(160deg,#211D15,#191510);border:1px solid rgba(244,240,231,0.14);border-radius:20px;padding:44px 40px;text-align:center;">
            <p style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(64px,10vw,108px);line-height:1;color:#E0744A;">209<span style="font-size:0.4em;color:rgba(244,240,231,0.6);">%</span></p>
            <p style="margin-top:14px;font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.78);">Measured lift on the team&rsquo;s self-selected mindset behaviors &mdash; Champion Iron executive retreat, AlUla, Saudi Arabia.</p>
          </div>
          <div>
            <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.8vw,44px);line-height:1.08;letter-spacing:-0.02em;color:#FBF8F1;max-width:20ch;">One team. A shift you can put a number on.</h2>
            <p style="margin-top:20px;font-size:18px;line-height:1.68;color:rgba(244,240,231,0.82);max-width:56ch;">We ran an executive retreat for <strong style="color:#FBF8F1;font-weight:600;">Champion Iron</strong> in AlUla, Saudi Arabia. Each leader chose the specific behaviors they wanted to change &mdash; the personal markers of a more positive mindset &mdash; and against that baseline the team measured a <strong style="color:#FBF8F1;font-weight:600;">209% improvement</strong>. Their own conclusion after the retreat, the activities and the hard conversations: that mindset would reshape how they approach the challenges ahead, and how they treat one another.</p>
            <p style="margin-top:24px;font-size:16px;line-height:1.6;"><a href={SLUGS.caseStudies} style="display:inline-flex;align-items:center;gap:8px;color:#E0744A;text-decoration:none;font-weight:700;" onmouseover="this.querySelector('span').style.transform='translateX(4px)'" onmouseout="this.querySelector('span').style.transform='translateX(0)'">See the teams behind the numbers &mdash; real turnarounds <span style="transition:transform .2s;">&rarr;</span></a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 9. FAQ (dark) ============ -->
