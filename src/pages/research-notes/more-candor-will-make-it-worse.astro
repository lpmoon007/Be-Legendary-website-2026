      { '@type': 'CreativeWork', name: 'Task Versus Relationship Conflict, Team Performance, and Team Member Satisfaction: A Meta-Analysis', author: 'C. K. W. de Dreu and L. R. Weingart', url: 'https://pubmed.ncbi.nlm.nih.gov/12940412/' },
