const path = '/research-notes/leadership-team-aligned-not-executing/';
const title = "Your leadership team is aligned. So why isn't anything happening? | Be Legendary";
const description =
  "Executives say they're aligned, then the priorities don't move. BCG, David Livermore and 20 years of consulting all point to the same thing: alignment is the symptom, not the cause.";

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Research Notes', item: 'https://www.belegendary.org/research-notes/' },
    { '@type': 'ListItem', position: 3, name: "Your leadership team is aligned. So why isn't anything happening?", item: `https://www.belegendary.org${path}` },
  ] },
  { '@type': 'Article',
    headline: "Your leadership team is aligned. So why isn't anything happening?",
    datePublished: '2026-07-25', dateModified: '2026-07-25',
    author: { '@id': 'https://www.belegendary.org/#james' },
    publisher: { '@id': 'https://www.belegendary.org/#org' },
    mainEntityOfPage: `https://www.belegendary.org${path}`,
    description: 'Why leadership teams that genuinely agree still fail to execute — and the four disciplines that break underneath the word "alignment," drawn from BCG, David Livermore and twenty years of senior-team consulting.',
    citation: [
      { '@type': 'CreativeWork', name: 'The CEO Insomnia Index: What (and Who) Is Keeping CEOs Up at Night?', publisher: 'Boston Consulting Group', url: 'https://www.bcg.com/publications/collections/the-insomnia-index-understanding-ceo-pressure' },
      { '@type': 'CreativeWork', name: 'The surprising challenge that keeps CEOs awake at night', author: 'David Livermore', url: 'https://davidlivermore.com/2026/04/20/the-surprising-challenge-that-keeps-ceos-awake-at-night/' },
