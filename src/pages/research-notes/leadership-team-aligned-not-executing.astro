const sources = [
  { name: 'Boston Consulting Group, <em>The CEO Insomnia Index: What (and Who) Is Keeping CEOs Up at Night?</em>', meta: 'April 2026 · ~500 CEOs, $100M–$5B+ revenue', url: 'https://www.bcg.com/publications/collections/the-insomnia-index-understanding-ceo-pressure' },
