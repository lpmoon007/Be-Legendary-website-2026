    headline: 'Sprawl persists because it works at first',
    datePublished: '2026-07-25', dateModified: '2026-07-25',
    author: { '@id': 'https://www.belegendary.org/#james' },
    publisher: { '@id': 'https://www.belegendary.org/#org' },
