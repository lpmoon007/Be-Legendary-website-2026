---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareRow from '../components/ShareRow.astro';
import ArticleEndCTA from '../components/ArticleEndCTA.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = 'How to Measure Leadership Team Performance — 5 Signals';
const description =
  'Financial results are a lagging, blurry measure of a leadership team. Measure the four disciplines and the Flag instead — the observable behaviors that predict execution, tracked as a FlagScore™.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.belegendary.org/resources/' },
    { '@type': 'ListItem', position: 3, name: 'How to Measure Leadership Team Performance', item: 'https://www.belegendary.org/how-to-measure-leadership-team-performance/' },
  ] },
  { '@type': 'Article', headline: 'How to measure leadership team performance (beyond the financials)', datePublished: '2026-07-12', dateModified: '2026-07-12', author: { '@id': 'https://www.belegendary.org/#james' }, publisher: { '@id': 'https://www.belegendary.org/#org' }, mainEntityOfPage: 'https://www.belegendary.org/how-to-measure-leadership-team-performance/', description: 'Measure a leadership team on the four disciplines and the Flag — alignment, decision, rhythm, standard, learning — using observable behavioral signals, tracked as a composite FlagScore over time.' },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'How do you measure leadership team performance?', acceptedAnswer: { '@type': 'Answer', text: 'Do not rely on financial results alone — they are lagging and shaped by factors outside the team. Measure the behaviors that produce results: whether the team is aligned on a small set of priorities (the Flag), makes decisions that stick (the Decision), completes work on a cadence (the Rhythm), holds a real standard (the Standard), and learns from misses (the Learning). Score each on observable signals — decision latency, rework rate, broken commitments, priority drift — and track the composite over time.' } },
    { '@type': 'Question', name: 'What is FlagScore?', acceptedAnswer: { '@type': 'Answer', text: "FlagScore is a composite measure of a leadership team's vitals across the five components of the Flag Model: the Flag and the four disciplines that hold it up. It turns a vague sense of 'we feel stuck' into a read you can track quarter over quarter, so progress is measured rather than asserted." } },
    { '@type': 'Question', name: 'Why are financial results a poor measure of a leadership team?', acceptedAnswer: { '@type': 'Answer', text: 'Financial results are lagging indicators — they tell you what already happened, months after the behavior that caused it. They are also confounded by market conditions, pricing, and luck, so a team can post good numbers while executing poorly (and vice versa). To manage a team in time to change the outcome, you need leading indicators: the decision, rhythm, standard and learning behaviors that produce the results before they show up in the P&L.' } },
  ] },
];

const rows = [
  { c: 'The Flag (alignment)', good: 'Every member names the same 2–3 priorities without looking them up.', bad: 'Ask five people for the top priorities and get eight different answers.' },
  { c: 'The Decision', good: 'Calls get one owner and a deadline, and they stick.', bad: 'Decisions get reopened in hallways; long decision latency.' },
  { c: 'The Rhythm', good: 'Important work ships on a cadence, not just when it’s urgent.', bad: 'High rework; initiatives that start and never finish.' },
  { c: 'The Standard', good: 'A missed commitment costs something; the bar holds.', bad: 'Broken commitments carry no consequence; “done” keeps sliding.' },
  { c: 'The Learning', good: 'Misses turn into a change; the same failure doesn’t recur.', bad: 'Failures become blame; the team repeats the same mistakes.' },
];
---
<BaseLayout
  title={title}
  description={description}
  path={SLUGS.measureTeamPerformance}
  ogType="article"
  ogTitle="How to Measure Leadership Team Performance"
  ogDescription="Financials are lagging and blurry. Measure the four disciplines and the Flag — the behaviors that predict execution — as a FlagScore."
  schema={schema}
>
  <SiteHeader audience="teams" logoHref="/" />

  <article>
  <!-- HERO -->
  <header style="position:relative;max-width:920px;margin:0 auto;padding:80px 32px 40px;">
    <div style="position:absolute;top:-100px;right:-160px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.resources} style="color:inherit;text-decoration:none;">Resources</a><span>/</span><span style="color:#D98A5E;">How to Measure Leadership Team Performance</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">Guide</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(32px,5vw,58px);line-height:1.03;letter-spacing:-0.02em;color:#FBF8F1;">How to measure leadership team performance</h1>
    <p style="margin-top:18px;font-size:14px;color:rgba(244,240,231,0.55);">By <a href={SLUGS.about} style="color:#D98A5E;text-decoration:none;">James Carter</a> &middot; Updated July 2026</p>
    <div style="margin-top:30px;background:#211D15;border:1px solid rgba(192,74,38,0.35);border-left:3px solid #C04A26;border-radius:14px;padding:26px 28px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The short answer</p>
      <p class="bl-speakable" style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:#FBF8F1;">Don&rsquo;t measure a leadership team on financial results alone &mdash; those are <strong>lagging and blurry</strong>, shaped by the market as much as by the team. Measure the <strong>behaviors that produce results</strong>: whether the team is aligned on a small set of priorities (the Flag) and makes decisions that stick, finishes on a cadence, holds a real standard, and learns from misses (the four disciplines). Score each on <strong>observable signals</strong> &mdash; decision latency, rework, broken commitments, priority drift &mdash; and track the composite, a <strong>FlagScore</strong>, quarter over quarter.</p>
    </div>
  </header>

  <!-- ON THIS PAGE -->
  <nav aria-label="On this page" style="max-width:920px;margin:26px auto 0;padding:0 32px;">
    <div style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:20px 24px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:12px;">On this page</p>
      <ol style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px 22px;">
        <li><a href="#why" style="color:rgba(244,240,231,0.82);text-decoration:none;font-size:15px;border-bottom:1px solid rgba(192,74,38,0.45);padding-bottom:1px;">Why financials miss</a></li>
        <li><a href="#what" style="color:rgba(244,240,231,0.82);text-decoration:none;font-size:15px;border-bottom:1px solid rgba(192,74,38,0.45);padding-bottom:1px;">What to actually measure</a></li>
        <li><a href="#flagscore" style="color:rgba(244,240,231,0.82);text-decoration:none;font-size:15px;border-bottom:1px solid rgba(192,74,38,0.45);padding-bottom:1px;">Turning it into a number</a></li>
        <li><a href="#faq" style="color:rgba(244,240,231,0.82);text-decoration:none;font-size:15px;border-bottom:1px solid rgba(192,74,38,0.45);padding-bottom:1px;">Straight answers</a></li>
      </ol>
    </div>
  </nav>

  <!-- WHY FINANCIALS MISS -->
  <div id="why" style="max-width:920px;margin:0 auto;padding:44px 32px 8px;scroll-margin-top:90px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.2vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:16px;">Why the numbers you already have miss</h2>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:20px;">Most leaders measure their team the only way they know how: revenue, margin, the board deck. Those matter &mdash; but as a read on the <em>team</em>, they&rsquo;re both lagging and confounded. Lagging, because by the time a number moves, the behavior that caused it happened months ago. Confounded, because pricing, market, and luck can float a team that&rsquo;s executing poorly &mdash; and sink one that isn&rsquo;t. A green quarter can hide a team that&rsquo;s one departure away from stalling; a red one can hide a team that&rsquo;s actually getting healthier.</p>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);">To manage a team <em>in time to change the outcome</em>, you need leading indicators &mdash; the behaviors that produce results before they reach the P&amp;L. That&rsquo;s what the <a href={SLUGS.flagModel} style="color:#D98A5E;">Flag Model</a> makes measurable.</p>
  </div>

  <!-- WHAT TO MEASURE -->
  <div id="what" style="max-width:920px;margin:0 auto;padding:44px 32px 8px;scroll-margin-top:90px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.2vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:16px;">What to actually measure</h2>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;">A leadership team runs on five things: a Flag &mdash; the 2&ndash;3 priorities everything serves &mdash; held up by four disciplines. Each one has an <strong style="color:#F4F0E7;">observable signal</strong> you can watch without a survey. Measure these and you&rsquo;re measuring the team&rsquo;s actual capacity to execute.</p>
    <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid rgba(244,240,231,0.11);border-radius:16px;">
      <table style="width:100%;min-width:660px;border-collapse:collapse;background:#1B1810;font-size:15.5px;">
        <caption style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">Measuring leadership team performance across the five components of the Flag Model™.</caption>
        <thead>
          <tr>
            <th scope="col" style="text-align:left;padding:16px 20px;background:#211D15;font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#E0744A;border-bottom:1px solid rgba(244,240,231,0.09);">Component</th>
            <th scope="col" style="text-align:left;padding:16px 20px;background:#211D15;font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#E0744A;border-bottom:1px solid rgba(244,240,231,0.09);">What good looks like</th>
            <th scope="col" style="text-align:left;padding:16px 20px;background:#211D15;font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#E0744A;border-bottom:1px solid rgba(244,240,231,0.09);">The signal it&rsquo;s slipping</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr>
              <th scope="row" style={`text-align:left;padding:16px 20px;vertical-align:top;font-family:'Newsreader',serif;font-weight:500;font-size:17px;color:#FBF8F1;white-space:normal;${i < rows.length - 1 ? 'border-bottom:1px solid rgba(244,240,231,0.09);' : ''}`}>{r.c}</th>
              <td style={`padding:16px 20px;vertical-align:top;line-height:1.5;color:rgba(244,240,231,0.82);${i < rows.length - 1 ? 'border-bottom:1px solid rgba(244,240,231,0.09);' : ''}`}>{r.good}</td>
              <td style={`padding:16px 20px;vertical-align:top;line-height:1.5;color:rgba(244,240,231,0.82);${i < rows.length - 1 ? 'border-bottom:1px solid rgba(244,240,231,0.09);' : ''}`}>{r.bad}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- FLAGSCORE -->
  <div id="flagscore" style="max-width:920px;margin:44px auto 0;padding:0 32px;scroll-margin-top:90px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.2vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:16px;">Turning it into a number: FlagScore</h2>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:20px;">Five signals are useful, but a leadership team needs one thing a list can&rsquo;t give: a trend. <strong style="color:#F4F0E7;">FlagScore&trade;</strong> is the composite &mdash; a single read of the team&rsquo;s vitals across the Flag and the four disciplines. It turns &ldquo;we feel stuck&rdquo; into a number you can put on a page, compare to last quarter, and actually move. The point isn&rsquo;t the score itself; it&rsquo;s that <em>measured</em> beats <em>asserted</em>. A team that tracks its FlagScore knows which discipline is dragging and whether the work is landing &mdash; instead of arguing about it.</p>
    <div style="background:#F4F0E7;color:#1B1810;border-radius:18px;padding:34px;margin-top:8px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">How to start measuring this week</p>
      <ol style="margin:0;padding-left:22px;display:flex;flex-direction:column;gap:10px;font-size:16px;line-height:1.55;color:#3A372F;">
        <li><strong>Baseline it.</strong> Rate each of the five components 1&ndash;5 on the signals above &mdash; individually, before you discuss. The spread between people is itself a finding.</li>
        <li><strong>Find the lowest.</strong> The weakest discipline is where your execution actually breaks. That&rsquo;s the one to rebuild first &mdash; not all five at once.</li>
        <li><strong>Re-score quarterly.</strong> Same five, same signals, every quarter. Movement &mdash; not the absolute number &mdash; is the measure of whether the team is getting better.</li>
      </ol>
      <p style="font-size:15px;line-height:1.6;color:#5A5248;margin-top:18px;">Want the structured version? The <a href={SLUGS.breakPointAssessment} style="color:#C04A26;font-weight:600;">Break Point self-assessment</a> gives you a first read in a few minutes, and the <a href={SLUGS.teamLfs} style="color:#C04A26;font-weight:600;">team diagnostic</a> turns it into a full FlagScore for the whole team.</p>
    </div>
  </div>

  <!-- CTA -->
  <div style="max-width:920px;margin:44px auto 0;padding:0 32px;">
    <div style="background:linear-gradient(120deg,#211D15,#191610);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:38px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;">Get a real read on your team.</h2>
      <p style="margin-top:16px;font-size:17.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:60ch;">A <strong style="color:#F4F0E7;">Calibration Call</strong> is 15 minutes. You&rsquo;ll leave with a concrete read on which discipline is dragging your team&rsquo;s performance &mdash; and what a FlagScore would show &mdash; whether or not we work together.</p>
      <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:26px;display:inline-flex;align-items:center;gap:9px;background:#C04A26;color:#fff;text-decoration:none;padding:16px 30px;border-radius:11px;font-weight:700;font-size:16.5px;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Book a Calibration Call <span style="font-size:18px;">&rarr;</span></a>
    </div>
  </div>

  <!-- STRAIGHT ANSWERS -->
  <div id="faq" style="max-width:920px;margin:56px auto 0;padding:0 32px;scroll-margin-top:90px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;margin-bottom:28px;">Straight answers</h2>
    <div style="display:flex;flex-direction:column;gap:22px;">
      <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:8px;">How do you measure leadership team performance?</h3><p style="font-size:16px;line-height:1.65;color:rgba(244,240,231,0.72);">Not on financial results alone &mdash; those lag and are shaped by factors outside the team. Measure the behaviors that produce results: alignment on a few priorities (the Flag), decisions that stick, work that finishes on a cadence, a standard that holds, and learning from misses. Score each on observable signals &mdash; decision latency, rework, broken commitments, priority drift &mdash; and track the composite over time.</p></div>
      <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:8px;">What is FlagScore?</h3><p style="font-size:16px;line-height:1.65;color:rgba(244,240,231,0.72);">FlagScore is a composite measure of a leadership team&rsquo;s vitals across the five components of the Flag Model &mdash; the Flag and the four disciplines that hold it up. It turns &ldquo;we feel stuck&rdquo; into a read you can track quarter over quarter, so progress is measured rather than asserted.</p></div>
      <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:8px;">Why are financial results a poor measure of a leadership team?</h3><p style="font-size:16px;line-height:1.65;color:rgba(244,240,231,0.72);">They&rsquo;re lagging indicators &mdash; they report what already happened, long after the behavior that caused it &mdash; and they&rsquo;re confounded by market, pricing and luck. A team can post good numbers while executing badly, and vice versa. To change the outcome in time, you need the leading indicators: the decision, rhythm, standard and learning behaviors underneath the results.</p></div>
    </div>
  </div>

  <!-- RELATED -->
  <div style="max-width:920px;margin:60px auto 0;padding:0 32px 20px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Keep reading</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <a href={SLUGS.flagModel} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">The Flag Model, in full</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The five components you&rsquo;re measuring.</span>
      </a>
      <a href={SLUGS.teamLfs} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">The team diagnostic</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Turn the five signals into a full FlagScore.</span>
      </a>
      <a href={SLUGS.highPerformingTeam} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Build a high-performing leadership team</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">What the measurement is pointing you toward.</span>
      </a>
      <a href={SLUGS.research} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">The State of Executive Team Execution</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The research behind what we measure.</span>
      </a>
    </div>
  </div>
    <ArticleEndCTA maxWidth={920} />
    <ShareRow title={title} maxWidth={920} />
</article>

  <SiteFooter audience="teams" variant="slim" maxWidth={920} note="© 2026 Be Legendary. Measured beats asserted." />
</BaseLayout>
