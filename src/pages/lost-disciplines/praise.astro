---
import LdolLayout from '../../layouts/LdolLayout.astro';
import LdolHeader from '../../components/LdolHeader.astro';
import LdolFooter from '../../components/LdolFooter.astro';
import { SITE_URL } from '../../lib/site';

const title = 'Praise — Lost Disciplines of Leadership™';
const description =
  'What leaders are saying about Lost Disciplines of Leadership™ by James Carter. Endorsements are being gathered ahead of launch. A Be Legendary book.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: 'Lost Disciplines of Leadership',
    alternateName: 'Lost Disciplines of Leadership™',
    url: `${SITE_URL}/lost-disciplines/`,
    image: `${SITE_URL}/assets/ldol-cover.png`,
    bookFormat: 'https://schema.org/Hardcover',
    inLanguage: 'en',
    abstract:
      'Why capable leadership teams know what to do and still fail to do it — the execution gap — and how the Flag Model™ rebuilds the disciplines that stalled teams quietly lose: the Flag (alignment), the Decision, the Rhythm, the Standard, and the Learning, governed by Truth Over Comfort.',
    author: {
      '@type': 'Person',
      name: 'James Carter',
      url: `${SITE_URL}/lost-disciplines/about-james/`,
      jobTitle: 'Author & executive-team advisor',
      description:
        'Executive-team advisor of 25 years; co-author alongside Stephen Covey, Ken Blanchard, Deepak Chopra, and Brian Tracy; featured on CNN and in Business Insider.',
    },
    publisher: { '@type': 'Organization', name: 'Be Legendary', url: 'https://www.belegendary.org/' },
    about: ['Leadership', 'Team execution', 'Accountability', 'Organizational alignment'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Lost Disciplines of Leadership',
    url: `${SITE_URL}/lost-disciplines/`,
    logo: `${SITE_URL}/assets/ldol-b-logo.png`,
    parentOrganization: { '@type': 'Organization', name: 'Be Legendary', url: 'https://www.belegendary.org/' },
  },
];
---
<LdolLayout title={title} description={description} path="/lost-disciplines/praise/" schema={schema}>
  <LdolHeader active={null} />

  <!-- HERO -->
  <header style="background:radial-gradient(120% 120% at 80% 30%, rgba(192,74,38,.13), transparent 55%);">
    <div class="ldol-wrap" style="padding-top:96px;padding-bottom:64px;max-width:820px;text-align:center;margin:0 auto;">
      <div class="ldol-eyebrow" style="color:#C04A26;margin-bottom:26px;">Praise</div>
      <h1 class="ldol-h1" style="font-family:'Newsreader',serif;font-weight:500;font-size:60px;line-height:1.06;letter-spacing:-.015em;margin:0 0 22px;">What leaders are saying.</h1>
      <p style="font-size:18px;line-height:1.6;color:#b3a899;margin:0 auto;max-width:32em;">Endorsements for Lost Disciplines of Leadership&trade; are being gathered ahead of launch. This page is ready to fill as blurbs arrive.</p>
    </div>
  </header>

  <!-- THE BOOK BEHIND THE BLURBS -->
  <section style="background:#1a1510;">
    <div class="ldol-wrap" style="padding-top:78px;padding-bottom:40px;max-width:760px;margin:0 auto;">
      <div class="ldol-eyebrow" style="color:#c9a24a;margin-bottom:20px;">What it earns praise for</div>
      <p style="font-family:'Newsreader',serif;font-weight:400;font-size:26px;line-height:1.45;color:#f4f0e6;margin:0 0 26px;">Endorsements take time because we&rsquo;re asking working leaders to read the whole thing &mdash; not react to a subtitle.</p>
      <p style="font-size:17px;line-height:1.75;color:#b3a899;margin:0 0 22px;">Lost Disciplines of Leadership&trade; makes a specific, uncomfortable argument: capable teams don&rsquo;t stall for lack of strategy or talent. They stall because the disciplines that turn intent into action erode &mdash; quietly, one reasonable compromise at a time &mdash; until the plan outpaces the doing. The book names that erosion, and then hands you the field guide to reverse it.</p>
      <p style="font-size:17px;line-height:1.75;color:#b3a899;margin:0 0 30px;">It&rsquo;s a fable first &mdash; a leadership team you&rsquo;ll recognize &mdash; then the Flag Model&trade; laid out discipline by discipline: one Flag the team can march toward, held up by the Decision, the Rhythm, the Standard, and the Learning, all governed by Truth Over Comfort. The leaders reading it now are the ones who&rsquo;ve lived the execution gap from the inside; their names will sit beside their words here.</p>
      <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px;">
        <li style="display:flex;gap:14px;align-items:flex-start;"><span style="color:#c9a24a;font-family:'Newsreader',serif;font-style:italic;">&mdash;</span><span style="font-size:16px;color:#cdc4b6;line-height:1.55;">A vocabulary for what&rsquo;s actually wrong &mdash; so a team can name where it breaks first instead of blaming the plan.</span></li>
        <li style="display:flex;gap:14px;align-items:flex-start;"><span style="color:#c9a24a;font-family:'Newsreader',serif;font-style:italic;">&mdash;</span><span style="font-size:16px;color:#cdc4b6;line-height:1.55;">Diagnostics that make the invisible visible &mdash; which discipline has slipped, and how far.</span></li>
        <li style="display:flex;gap:14px;align-items:flex-start;"><span style="color:#c9a24a;font-family:'Newsreader',serif;font-style:italic;">&mdash;</span><span style="font-size:16px;color:#cdc4b6;line-height:1.55;">A rebuild you can run at your next offsite &mdash; not theory, but reps a team can start on Monday.</span></li>
      </ul>
    </div>
  </section>

  <!-- FEATURED BLURB PLACEHOLDER -->
  <section style="background:#14203a;">
    <div class="ldol-wrap" style="padding-top:80px;padding-bottom:80px;">
      <div style="border:1px dashed rgba(201,162,74,.3);border-radius:8px;padding:56px;text-align:center;background:rgba(201,162,74,.03);max-width:820px;margin:0 auto;">
        <div style="font-family:'Newsreader',serif;font-size:60px;color:rgba(201,162,74,.4);line-height:.6;">&ldquo;</div>
        <p style="font-family:'Newsreader',serif;font-weight:400;font-size:29px;line-height:1.4;color:#8b93a8;margin:18px 0 26px;">A featured endorsement from a marquee leader will headline this page.</p>
        <div style="font-size:14px;color:#7e889e;letter-spacing:.02em;">&mdash; Name, Title, Organization</div>
      </div>
    </div>
  </section>

  <!-- BLURB GRID PLACEHOLDERS -->
  <section style="background:#1a1510;">
    <div class="ldol-wrap" style="padding-top:72px;padding-bottom:80px;">
      <div class="ldol-collapse" style="display:grid;grid-template-columns:repeat(2,1fr);gap:22px;">
        <div style="border:1px dashed rgba(201,162,74,.28);border-radius:6px;padding:34px;background:rgba(201,162,74,.02);">
          <div style="font-family:'Newsreader',serif;font-size:40px;color:rgba(201,162,74,.35);line-height:.5;margin-bottom:16px;">&ldquo;</div>
          <p style="font-family:'Newsreader',serif;font-size:19px;line-height:1.5;color:#6f6a60;margin:0 0 22px;">Endorsement blurb from a named leader will appear here as praise comes in.</p>
          <div style="font-size:13px;color:#6f6a60;letter-spacing:.02em;">&mdash; Name, Title</div>
        </div>
        <div style="border:1px dashed rgba(201,162,74,.28);border-radius:6px;padding:34px;background:rgba(201,162,74,.02);">
          <div style="font-family:'Newsreader',serif;font-size:40px;color:rgba(201,162,74,.35);line-height:.5;margin-bottom:16px;">&ldquo;</div>
          <p style="font-family:'Newsreader',serif;font-size:19px;line-height:1.5;color:#6f6a60;margin:0 0 22px;">Endorsement blurb from a named leader will appear here as praise comes in.</p>
          <div style="font-size:13px;color:#6f6a60;letter-spacing:.02em;">&mdash; Name, Title</div>
        </div>
        <div style="border:1px dashed rgba(201,162,74,.28);border-radius:6px;padding:34px;background:rgba(201,162,74,.02);">
          <div style="font-family:'Newsreader',serif;font-size:40px;color:rgba(201,162,74,.35);line-height:.5;margin-bottom:16px;">&ldquo;</div>
          <p style="font-family:'Newsreader',serif;font-size:19px;line-height:1.5;color:#6f6a60;margin:0 0 22px;">Endorsement blurb from a named leader will appear here as praise comes in.</p>
          <div style="font-size:13px;color:#6f6a60;letter-spacing:.02em;">&mdash; Name, Title</div>
        </div>
        <div style="border:1px dashed rgba(201,162,74,.28);border-radius:6px;padding:34px;background:rgba(201,162,74,.02);">
          <div style="font-family:'Newsreader',serif;font-size:40px;color:rgba(201,162,74,.35);line-height:.5;margin-bottom:16px;">&ldquo;</div>
          <p style="font-family:'Newsreader',serif;font-size:19px;line-height:1.5;color:#6f6a60;margin:0 0 22px;">Endorsement blurb from a named leader will appear here as praise comes in.</p>
          <div style="font-size:13px;color:#6f6a60;letter-spacing:.02em;">&mdash; Name, Title</div>
        </div>
        <div style="border:1px dashed rgba(201,162,74,.28);border-radius:6px;padding:34px;background:rgba(201,162,74,.02);">
          <div style="font-family:'Newsreader',serif;font-size:40px;color:rgba(201,162,74,.35);line-height:.5;margin-bottom:16px;">&ldquo;</div>
          <p style="font-family:'Newsreader',serif;font-size:19px;line-height:1.5;color:#6f6a60;margin:0 0 22px;">Endorsement blurb from a named leader will appear here as praise comes in.</p>
          <div style="font-size:13px;color:#6f6a60;letter-spacing:.02em;">&mdash; Name, Title</div>
        </div>
        <div style="border:1px dashed rgba(201,162,74,.28);border-radius:6px;padding:34px;background:rgba(201,162,74,.02);">
          <div style="font-family:'Newsreader',serif;font-size:40px;color:rgba(201,162,74,.35);line-height:.5;margin-bottom:16px;">&ldquo;</div>
          <p style="font-family:'Newsreader',serif;font-size:19px;line-height:1.5;color:#6f6a60;margin:0 0 22px;">Endorsement blurb from a named leader will appear here as praise comes in.</p>
          <div style="font-size:13px;color:#6f6a60;letter-spacing:.02em;">&mdash; Name, Title</div>
        </div>
      </div>
      <p style="text-align:center;font-size:14px;color:#6f6a60;font-style:italic;margin:44px 0 0;">No endorsements are invented &mdash; each slot fills with a real, attributed blurb before launch.</p>
    </div>
  </section>

  <!-- MEDIA / AUTHORITY STRIP -->
  <section style="background:#0f1830;">
    <div class="ldol-wrap" style="padding-top:56px;padding-bottom:56px;text-align:center;">
      <div class="ldol-eyebrow" style="color:#7e889e;margin-bottom:26px;">James&rsquo;s work has appeared in</div>
      <div style="display:flex;align-items:center;justify-content:center;gap:52px;flex-wrap:wrap;">
        <span style="font-family:'Newsreader',serif;font-size:28px;color:#9aa6c0;">CNN</span>
        <span style="font-family:'Newsreader',serif;font-size:28px;color:#9aa6c0;">Business Insider</span>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:#f4f0e6;color:#211b16;">
    <div class="ldol-wrap" style="padding-top:80px;padding-bottom:80px;text-align:center;">
      <h2 class="ldol-h2" style="font-family:'Newsreader',serif;font-weight:500;font-size:40px;margin:0 0 14px;">Read it before the endorsements land.</h2>
      <p style="font-size:17px;color:#5c544c;margin:0 0 30px;">Join the waitlist and get the free first chapter.</p>
      <a href="/lost-disciplines/#waitlist" style="font-family:'Hanken Grotesk';font-size:15px;font-weight:600;color:#f4f0e6;background:#14203a;border-radius:3px;padding:15px 32px;display:inline-block;text-decoration:none;">Join the waitlist</a>
    </div>
  </section>

  <LdolFooter />
</LdolLayout>
