---
import { Image } from 'astro:assets';
import LdolLayout from '../../layouts/LdolLayout.astro';
import LdolHeader from '../../components/LdolHeader.astro';
import LdolFooter from '../../components/LdolFooter.astro';
import { CTA_URL, SITE_URL } from '../../lib/site';
import ldolCover from '../../assets/ldol-cover.png';

const title = 'The Book — Lost Disciplines of Leadership™ by James Carter';
const description =
  'What’s inside Lost Disciplines of Leadership™: a fable, then a field guide. The story of a stalled team, the Flag Model™ chapter by chapter — the Flag, the Decision, the Rhythm, the Standard, and the Learning — and who the book is for. A Be Legendary book.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: 'Lost Disciplines of Leadership',
    alternateName: 'Lost Disciplines of Leadership™',
    url: `${SITE_URL}/lost-disciplines/`,
    image: `${SITE_URL}/assets/ldol-cover.png`,
    bookFormat: 'https://schema.org/Hardcover',
    inLanguage: 'en',
    abstract:
      'Why capable leadership teams know what to do and still fail to do it — the execution gap — and how the Flag Model™ rebuilds the disciplines that stalled teams quietly lose: the Flag (alignment), the Decision, the Rhythm, the Standard, and the Learning, governed by Truth Over Comfort.',
    author: {
      '@type': 'Person',
      name: 'James Carter',
      url: `${SITE_URL}/lost-disciplines/about-james/`,
      jobTitle: 'Author & executive-team advisor',
      description:
        'Executive-team advisor of 25 years; co-author alongside Stephen Covey, Ken Blanchard, Deepak Chopra, and Brian Tracy; featured on CNN and in Business Insider.',
    },
    publisher: { '@type': 'Organization', name: 'Be Legendary', url: 'https://www.belegendary.org/' },
    about: ['Leadership', 'Team execution', 'Accountability', 'Organizational alignment'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Lost Disciplines of Leadership',
    url: `${SITE_URL}/lost-disciplines/`,
    logo: `${SITE_URL}/assets/ldol-b-logo.png`,
    parentOrganization: { '@type': 'Organization', name: 'Be Legendary', url: 'https://www.belegendary.org/' },
  },
];
---
<LdolLayout title={title} description={description} path="/lost-disciplines/the-book/" schema={schema}>
  <LdolHeader active="the-book" />

  <!-- HERO -->
  <header style="background:radial-gradient(120% 120% at 82% 30%, rgba(192,74,38,.14), transparent 55%);">
    <div class="ldol-wrap ldol-collapse" style="display:grid;grid-template-columns:1fr 0.72fr;gap:64px;align-items:center;padding-top:96px;padding-bottom:96px;">
      <div>
        <div class="ldol-eyebrow" style="color:#C04A26;margin-bottom:26px;">The Book</div>
        <h1 class="ldol-h1" style="font-family:'Newsreader',serif;font-weight:500;font-size:62px;line-height:1.05;letter-spacing:-.015em;color:#f4f0e6;margin:0 0 24px;">A fable, then a <span style="font-style:italic;color:#c9a24a;">field guide.</span></h1>
        <p style="font-size:19px;line-height:1.6;color:#b3a899;margin:0 0 36px;max-width:32em;">Lost Disciplines of Leadership&trade; opens with the story of a leader whose team has everything but momentum &mdash; then hands you the model to rebuild it in your own.</p>
        <a href="/lost-disciplines/#waitlist" style="font-family:'Hanken Grotesk',sans-serif;font-size:15px;font-weight:600;color:#1a1510;background:#c9a24a;border-radius:3px;padding:15px 30px;display:inline-block;text-decoration:none;">Read the first chapter free</a>
      </div>
      <div style="display:flex;justify-content:center;position:relative;">
        <div style="position:absolute;width:320px;height:320px;background:radial-gradient(circle, rgba(201,162,74,.18), transparent 68%);top:50%;left:50%;transform:translate(-50%,-50%);"></div>
        <Image src={ldolCover} alt="Lost Disciplines of Leadership book cover" width={600} format="webp" quality={82} loading="eager" fetchpriority="high" style="position:relative;width:300px;height:auto;border-radius:3px;box-shadow:0 36px 72px rgba(0,0,0,.55);transform:rotate(-2deg);" />
      </div>
    </div>
  </header>

  <!-- THE STORY -->
  <section style="background:#14203a;">
    <div class="ldol-wrap" style="padding-top:88px;padding-bottom:88px;">
      <div style="max-width:720px;">
        <div class="ldol-eyebrow" style="color:#c9a24a;margin-bottom:20px;">The Story</div>
        <p style="font-family:'Newsreader',serif;font-weight:400;font-size:29px;line-height:1.44;color:#f4f0e6;margin:0 0 24px;">Every leader in the book has read the strategy. Run the offsite. Hired the talent. And still watches the plan outpace the doing.</p>
        <p style="font-size:16.5px;line-height:1.7;color:#aeb8cf;margin:0;max-width:38em;">The fable follows one such team and the mentor who names what they&rsquo;ve quietly lost. It&rsquo;s a story first &mdash; because the execution gap is felt before it&rsquo;s diagnosed &mdash; and a working model second.</p>
      </div>
    </div>
  </section>

  <!-- THE FLAG MODEL DETAIL (flag + four) -->
  <section style="background:#f4f0e6;color:#211b16;">
    <div class="ldol-wrap" style="padding-top:92px;padding-bottom:92px;">
      <div style="max-width:680px;margin-bottom:56px;">
        <div class="ldol-eyebrow" style="color:#C04A26;margin-bottom:18px;">The Flag Model&trade;</div>
        <h2 class="ldol-h2" style="font-family:'Newsreader',serif;font-weight:500;font-size:42px;line-height:1.1;letter-spacing:-.01em;margin:0 0 16px;">A flag to march toward. Four disciplines to get there.</h2>
        <p style="font-size:17px;line-height:1.6;color:#5c544c;margin:0;">Each discipline gets its own chapter &mdash; the erosion, the diagnosis, and the rebuild &mdash; all governed by Truth Over Comfort.</p>
      </div>

      <div style="display:flex;align-items:center;gap:26px;background:#14203a;border-radius:6px;padding:34px 40px;margin-bottom:24px;flex-wrap:wrap;">
        <div style="flex-shrink:0;width:64px;height:88px;position:relative;">
          <div style="position:absolute;left:50%;top:0;width:3px;height:88px;background:#c9a24a;transform:translateX(-50%);"></div>
          <div style="position:absolute;left:calc(50% + 1.5px);top:4px;width:44px;height:30px;background:#C04A26;clip-path:polygon(0 0, 100% 50%, 0 100%);"></div>
        </div>
        <div style="min-width:260px;flex:1;">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:6px;">
            <span style="font-family:'Hanken Grotesk',sans-serif;font-size:11.5px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#c9a24a;">The Flag</span>
            <span style="font-size:13px;color:#9aa6c0;">Alignment</span>
          </div>
          <p style="font-family:'Newsreader',serif;font-size:21px;line-height:1.35;color:#f4f0e6;margin:0;">The single direction everyone can see and agrees is worth marching toward. Without it, the disciplines have nothing to serve.</p>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px;">
        <div style="display:flex;gap:26px;align-items:flex-start;background:#fff;border:1px solid rgba(33,27,22,.1);border-radius:6px;padding:30px 36px;">
          <span style="font-family:'Newsreader',serif;font-style:italic;font-size:34px;color:#c9a24a;line-height:1;flex-shrink:0;width:48px;">01</span>
          <div><div style="font-family:'Newsreader',serif;font-size:25px;margin-bottom:8px;">The Decision</div><p style="font-size:16px;line-height:1.6;color:#5c544c;margin:0;max-width:44em;">How the team commits, dissents, and moves &mdash; without relitigating what was already settled. When the decision discipline goes, every meeting reopens the last one.</p></div>
        </div>
        <div style="display:flex;gap:26px;align-items:flex-start;background:#fff;border:1px solid rgba(33,27,22,.1);border-radius:6px;padding:30px 36px;">
          <span style="font-family:'Newsreader',serif;font-style:italic;font-size:34px;color:#c9a24a;line-height:1;flex-shrink:0;width:48px;">02</span>
          <div><div style="font-family:'Newsreader',serif;font-size:25px;margin-bottom:8px;">The Rhythm</div><p style="font-size:16px;line-height:1.6;color:#5c544c;margin:0;max-width:44em;">The cadence that turns intent into repeated action &mdash; the beat a team keeps when no one is watching. Lose it and work happens in heroic bursts, then stalls.</p></div>
        </div>
        <div style="display:flex;gap:26px;align-items:flex-start;background:#fff;border:1px solid rgba(33,27,22,.1);border-radius:6px;padding:30px 36px;">
          <span style="font-family:'Newsreader',serif;font-style:italic;font-size:34px;color:#c9a24a;line-height:1;flex-shrink:0;width:48px;">03</span>
          <div><div style="font-family:'Newsreader',serif;font-size:25px;margin-bottom:8px;">The Standard</div><p style="font-size:16px;line-height:1.6;color:#5c544c;margin:0;max-width:44em;">The bar you hold when it&rsquo;s inconvenient to hold it &mdash; and the tolerance you refuse to grant. When it slips, &ldquo;good enough&rdquo; quietly becomes the ceiling.</p></div>
        </div>
        <div style="display:flex;gap:26px;align-items:flex-start;background:#fff;border:1px solid rgba(33,27,22,.1);border-radius:6px;padding:30px 36px;">
          <span style="font-family:'Newsreader',serif;font-style:italic;font-size:34px;color:#c9a24a;line-height:1;flex-shrink:0;width:48px;">04</span>
          <div><div style="font-family:'Newsreader',serif;font-size:25px;margin-bottom:8px;">The Learning</div><p style="font-size:16px;line-height:1.6;color:#5c544c;margin:0;max-width:44em;">How the team metabolizes failure into capability &mdash; instead of into blame or quiet avoidance. Without it, the same mistakes recur with new names.</p></div>
        </div>
      </div>

      <div style="display:flex;align-items:center;justify-content:center;gap:14px;margin-top:44px;flex-wrap:wrap;">
        <span class="ldol-eyebrow" style="color:#C04A26;">Governed by</span>
        <span style="font-family:'Newsreader',serif;font-style:italic;font-size:23px;color:#a87b2e;">Truth Over Comfort</span>
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section style="background:#1a1510;">
    <div class="ldol-wrap" style="padding-top:84px;padding-bottom:84px;">
      <div class="ldol-eyebrow" style="color:#c9a24a;margin-bottom:34px;">Who it&rsquo;s for</div>
      <div class="ldol-collapse" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;">
        <div style="border-top:2px solid #c9a24a;padding-top:22px;">
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:23px;margin:0 0 10px;color:#f4f0e6;">The CEO with a sound strategy</h3>
          <p style="font-size:15px;line-height:1.6;color:#a59a8d;margin:0;">Whose plan is right but whose team won&rsquo;t execute it. This names why &mdash; and what to do Monday.</p>
        </div>
        <div style="border-top:2px solid #c9a24a;padding-top:22px;">
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:23px;margin:0 0 10px;color:#f4f0e6;">The team lead rebuilding trust</h3>
          <p style="font-size:15px;line-height:1.6;color:#a59a8d;margin:0;">Who inherited a stalled group and needs a shared language for what&rsquo;s broken.</p>
        </div>
        <div style="border-top:2px solid #c9a24a;padding-top:22px;">
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:23px;margin:0 0 10px;color:#f4f0e6;">Anyone who&rsquo;s felt the gap</h3>
          <p style="font-size:15px;line-height:1.6;color:#a59a8d;margin:0;">Between what the team knows it should do and what it actually does, week after week.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:#f4f0e6;color:#211b16;">
    <div class="ldol-wrap" style="padding-top:80px;padding-bottom:80px;text-align:center;">
      <h2 class="ldol-h2" style="font-family:'Newsreader',serif;font-weight:500;font-size:40px;margin:0 0 14px;">Start with the first chapter.</h2>
      <p style="font-size:17px;color:#5c544c;margin:0 0 30px;">Free, the day it&rsquo;s ready. Join the waitlist below.</p>
      <a href="/lost-disciplines/#waitlist" style="font-family:'Hanken Grotesk',sans-serif;font-size:15px;font-weight:600;color:#f4f0e6;background:#14203a;border-radius:3px;padding:15px 32px;display:inline-block;text-decoration:none;">Join the waitlist</a>
    </div>
  </section>

  <LdolFooter />
</LdolLayout>
