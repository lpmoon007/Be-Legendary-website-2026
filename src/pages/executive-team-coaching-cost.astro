---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = 'How Much Does Executive Team Coaching Cost? (2026 Ranges)';
const description = 'Honest 2026 ranges for executive team coaching by format — offsite facilitation, ongoing engagements, individual coaching — plus what drives the price.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.belegendary.org/resources/' },
    { '@type': 'ListItem', position: 3, name: 'Executive team coaching cost', item: 'https://www.belegendary.org/executive-team-coaching-cost/' },
  ] },
  { '@type': 'Article', headline: 'How much does executive team coaching cost?', datePublished: '2026-06-19', dateModified: '2026-06-19', author: { '@id': 'https://www.belegendary.org/#james' }, publisher: { '@id': 'https://www.belegendary.org/#org' }, mainEntityOfPage: 'https://www.belegendary.org/executive-team-coaching-cost/', description: 'Honest 2026 ranges for executive team coaching and development by format, what drives the price, and how to judge value against the cost of the problem.' },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'How much does executive team coaching cost?', acceptedAnswer: { '@type': 'Answer', text: 'In 2026, costs vary widely by format. A facilitated leadership offsite typically runs from about $10,000 to $50,000+ for a senior facilitator. Ongoing executive-team engagements that include diagnostics and follow-through generally range from roughly $30,000 to $250,000+ depending on duration and scope. Individual executive coaching commonly runs $500 to $1,500+ per hour, or roughly $25,000 to $100,000+ for a multi-month engagement with a senior coach. The wide ranges reflect seniority, scope, and whether the work is a one-time event or a sustained partnership.' } },
    { '@type': 'Question', name: 'What drives the cost of executive team coaching?', acceptedAnswer: { '@type': 'Answer', text: 'Four things mostly: the seniority and track record of the practitioner; the scope (a single offsite versus a months-long engagement with diagnostics and follow-through); the depth of measurement and customization; and the size and seniority of the team involved. A higher price often reflects durability — work designed to change behavior over time costs more than a one-day event but is more likely to last.' } },
    { '@type': 'Question', name: 'Is executive team coaching worth the cost?', acceptedAnswer: { '@type': 'Answer', text: 'The honest way to judge it is against the cost of the problem, not in isolation. Research suggests misalignment and decision waste cost mid-market companies several percent of revenue a year. If an engagement meaningfully improves how a leadership team decides and executes, the return can dwarf the fee — but only if the work actually changes behavior rather than just energizing a room for a week.' } },
  ] },
];
---
<BaseLayout
  title={title}
  description={description}
  path={SLUGS.coachingCost}
  ogType="article"
  ogTitle="How much does executive team coaching cost?"
  ogDescription="Honest 2026 ranges by format, what drives the price, and how to judge value against the cost of the problem."
  schema={schema}
>
  <SiteHeader audience="teams" logoHref="/" maxWidth={880} links={[]} />

  <article>
  <header style="position:relative;max-width:880px;margin:0 auto;padding:80px 32px 40px;">
    <div style="position:absolute;top:-100px;right:-160px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.resources} style="color:inherit;text-decoration:none;">Resources</a><span>/</span><span style="color:#D98A5E;">Coaching cost</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">A buyer's guide</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(32px,5vw,56px);line-height:1.03;letter-spacing:-0.02em;color:#FBF8F1;">How much does executive team coaching cost?</h1>
    <p style="margin-top:18px;font-size:14px;color:rgba(244,240,231,0.55);">By <a href={SLUGS.about} style="color:#D98A5E;text-decoration:none;">James Carter</a> &middot; Updated June 2026</p>
    <div style="margin-top:30px;background:#211D15;border:1px solid rgba(192,74,38,0.35);border-left:3px solid #C04A26;border-radius:14px;padding:26px 28px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The short answer</p>
      <p style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:#FBF8F1;">It depends heavily on format. In 2026, a facilitated offsite typically runs <strong style="color:#FBF8F1;">$10K&ndash;$50K+</strong>; an ongoing team engagement with diagnostics and follow-through, roughly <strong style="color:#FBF8F1;">$30K&ndash;$250K+</strong>; individual executive coaching, about <strong style="color:#FBF8F1;">$500&ndash;$1,500+/hour</strong> or $25K&ndash;$100K+ for a multi-month engagement. The wide ranges reflect seniority, scope, and whether you're buying an event or a sustained change in behavior.</p>
    </div>
  </header>

  <div style="max-width:880px;margin:0 auto;padding:24px 32px 20px;">
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;">Pricing in this space is famously opaque &mdash; most firms won't name a number until they've qualified you. That's frustrating when you're just trying to budget. So here are honest, public ranges for 2026, what moves the price within them, and how to think about value. These are general market figures, not a quote.</p>

    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.1;letter-spacing:-0.015em;color:#FBF8F1;margin:44px 0 20px;">Typical ranges by format</h2>
    <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:8px;">
      <div style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:26px 28px;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;">
          <p style="font-family:'Newsreader',serif;font-size:22px;color:#FBF8F1;">Facilitated leadership offsite</p>
          <p style="font-family:'Newsreader',serif;font-size:24px;color:#E0744A;white-space:nowrap;">$10K&ndash;$50K+</p>
        </div>
        <p style="margin-top:10px;font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.74);">A one-to-three-day session run by an external facilitator. The low end is a solo facilitator and a single day; the high end reflects senior practitioners, multi-day design, and pre-work. Note: a great day still fades without follow-through.</p>
      </div>
      <div style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:26px 28px;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;">
          <p style="font-family:'Newsreader',serif;font-size:22px;color:#FBF8F1;">Ongoing team engagement</p>
          <p style="font-family:'Newsreader',serif;font-size:24px;color:#E0744A;white-space:nowrap;">$30K&ndash;$250K+</p>
        </div>
        <p style="margin-top:10px;font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.74);">A months-long engagement: diagnostic, working sessions, and follow-through to change how the team operates. Priced by duration and depth. This is where durable behavior change happens &mdash; and where the cost-per-outcome is usually best.</p>
      </div>
      <div style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:26px 28px;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;">
          <p style="font-family:'Newsreader',serif;font-size:22px;color:#FBF8F1;">Individual executive coaching</p>
          <p style="font-family:'Newsreader',serif;font-size:24px;color:#E0744A;white-space:nowrap;">$500&ndash;$1,500+/hr</p>
        </div>
        <p style="margin-top:10px;font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.74);">One-on-one coaching for a single leader &mdash; roughly $25K&ndash;$100K+ for a multi-month engagement with a senior coach. Develops the individual; note it won't, on its own, fix how the team operates together.</p>
      </div>
    </div>

    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.1;letter-spacing:-0.015em;color:#FBF8F1;margin:44px 0 20px;">What drives the price</h2>
    <ul style="margin:0 0 24px;padding-left:22px;display:flex;flex-direction:column;gap:12px;font-size:18px;line-height:1.62;color:rgba(244,240,231,0.84);">
      <li><strong style="color:#FBF8F1;">Seniority and track record</strong> of the practitioner &mdash; the biggest single factor.</li>
      <li><strong style="color:#FBF8F1;">Scope</strong> &mdash; a one-day event versus a sustained engagement with diagnostics and follow-through.</li>
      <li><strong style="color:#FBF8F1;">Measurement and customization</strong> &mdash; work built around your team's specifics costs more than an off-the-shelf program.</li>
      <li><strong style="color:#FBF8F1;">Team size and seniority</strong> &mdash; more senior, larger teams take more time and carry higher stakes.</li>
    </ul>

    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.1;letter-spacing:-0.015em;color:#FBF8F1;margin:44px 0 20px;">How to judge whether it's worth it</h2>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;">Judge the cost against the cost of the problem, not in isolation. Published research suggests misalignment and decision waste cost mid-market companies <strong style="color:#FBF8F1;">several percent of revenue a year</strong> &mdash; so for most companies the problem is far more expensive than the fix. The real risk isn't overpaying; it's paying for an event that energizes a room for a week and changes nothing. Value comes from work that actually shifts behavior over time. If you want to put a number on your own situation, our <a href={SLUGS.costCalculator} style="color:#E0744A;text-decoration:underline;">Cost of Lost Disciplines Calculator</a> estimates it from third-party research.</p>
  </div>

  <div style="max-width:880px;margin:36px auto 0;padding:0 32px;">
    <div style="background:linear-gradient(120deg,#211D15,#191610);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:38px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;">Spend the budget on the right problem.</h2>
      <p style="margin-top:16px;font-size:17.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:60ch;">Before you commit to any format, it helps to know exactly what to fix. A Calibration Call is 15 minutes &mdash; you'll leave with a concrete read on your team's first break point, whether or not we work together.</p>
      <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:26px;display:inline-flex;align-items:center;gap:9px;background:#C04A26;color:#fff;text-decoration:none;padding:16px 30px;border-radius:11px;font-weight:700;font-size:16.5px;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Book a Calibration Call <span style="font-size:18px;">&rarr;</span></a>
    </div>
  </div>

  <div style="max-width:880px;margin:60px auto 0;padding:0 32px 20px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Keep reading</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <a href={SLUGS.costCalculator} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Cost of Lost Disciplines Calculator</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Estimate what the problem is costing you.</span>
      </a>
      <a href={SLUGS.vsCoaching} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Team development vs executive coaching</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Which one your situation actually calls for.</span>
      </a>
    </div>
  </div>
  </article>

  <SiteFooter audience="teams" variant="slim" maxWidth={880} note="© 2026 Be Legendary · General market ranges, not a quote." />
</BaseLayout>
