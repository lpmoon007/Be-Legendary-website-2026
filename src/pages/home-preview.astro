---
// STAGED PREVIEW of the reframed homepage. noindex + unlinked.
// On approval: move this into index.astro, relocate the Flag Model interactive
// (FlagDiagram) onto /flag-model/, and delete this preview file.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LowCommitmentCTA from '../components/LowCommitmentCTA.astro';
import Faq from '../components/Faq.astro';
import PressStrip from '../components/PressStrip.astro';
import ResultsBand from '../components/ResultsBand.astro';
import Testimonials from '../components/Testimonials.astro';
import TrustedBy from '../components/TrustedBy.astro';
import { Image } from 'astro:assets';
import imgJames from '../assets/james.jpg';
import { CTA_URL, SLUGS } from '../lib/site';

const title = 'Be Legendary — Executive Team Performance, Retreats & Diagnostics';
const description =
  'Facilitated executive retreats built around one outcome, and a 90-minute Leadership Failure Simulation that shows how your team performs under pressure. A real result, measured.';

const faqs = [
  { q: 'What does Be Legendary actually do?', a: "We get executive teams performing. The two ways in are a facilitated executive retreat built around one outcome, and the Team Leadership Failure Simulation — a 90-minute read on how your team actually decides under pressure. Both come with a measured result. From there, some teams go deeper into a longer performance engagement." },
  { q: "We've done offsites before and nothing stuck. Why is this different?", a: "Because it is engineered around your team's real fault line, not a generic agenda, and it is reinforced for 30 days so it survives contact with Monday. We start by seeing how your team actually operates, then build the day around that, and measure what changed." },
  { q: 'What happens on a Calibration Call?', a: "It's 15 minutes. You run a short Choices exercise that surfaces priority misalignment in real time, and you leave with a concrete read on where your team stands — whether or not we work together. It's a calibration, not a pitch." },
  { q: 'How much does it cost?', a: 'Published openly: a free call and a free self-assessment; the Team LFS is $28K–$35K; retreats run $25K–$500K+ by scope; and the longer performance engagement starts from a $75K base. Every paid step credits 50% toward the next.' },
];
---
<BaseLayout title={title} description={description} path="/home-preview/" ogType="website" ogTitle="Be Legendary — executive team performance, retreats & diagnostics" ogDescription="Facilitated executive retreats and a 90-minute read on how your team performs under pressure. A real result, measured." noindex={true}>
  <SiteHeader audience="teams" variant="full" maxWidth={1200} logoHref="#top" />

  <!-- HERO (design preserved; copy reframed to product-led) -->
  <style>
    .bl-hero-full { position:relative; width:100vw; margin-left:calc(50% - 50vw); min-height:min(90vh,880px); display:flex; align-items:center; overflow:hidden; background:#100E0A; }
    .bl-hero-full__bg { position:absolute; top:0; right:0; bottom:0; width:74%; height:100%; object-fit:cover; object-position:center; -webkit-mask-image:linear-gradient(90deg, transparent 0%, #000 24%); mask-image:linear-gradient(90deg, transparent 0%, #000 24%); z-index:0; }
    .bl-hero-full__scrim { position:absolute; inset:0; z-index:1; background: linear-gradient(90deg, rgba(16,14,10,0.96) 0%, rgba(16,14,10,0.90) 26%, rgba(16,14,10,0.48) 54%, rgba(16,14,10,0.04) 76%), linear-gradient(0deg, rgba(16,14,10,0.5) 0%, rgba(16,14,10,0) 42%); }
    .bl-hero-full__inner { position:relative; z-index:2; width:100%; max-width:1200px; margin:0 auto; padding:104px 32px; }
    .bl-hero-full__copy { max-width:620px; }
    @media (max-width:860px){ .bl-hero-full{min-height:auto;} .bl-hero-full__bg{width:100%;object-position:72% center;-webkit-mask-image:none;mask-image:none;} .bl-hero-full__scrim{background:linear-gradient(180deg, rgba(16,14,10,0.93) 0%, rgba(16,14,10,0.76) 42%, rgba(16,14,10,0.52) 72%, rgba(16,14,10,0.74) 100%);} .bl-hero-full__inner{padding:72px 24px 84px;} .bl-hero-full__copy{max-width:100%;} }
  </style>
  <section id="top" class="bl-hero-full">
    <img class="bl-hero-full__bg" src="/assets/the-flag-model-hero.webp" alt="The Flag Model — a rust-red flag reading Team Alignment flown from a mast held upright by four taut cables anchored into bedrock engraved Truth Over Comfort." width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
    <div class="bl-hero-full__scrim"></div>
    <div class="bl-hero-full__inner">
      <div class="bl-hero-full__copy">
        <p style="display:inline-flex;align-items:center;gap:9px;font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:28px;"><span style="width:7px;height:7px;border-radius:50%;background:#C04A26;display:inline-block;"></span>Executive team performance</p>
        <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(38px,5.2vw,70px);line-height:1.05;letter-spacing:-0.025em;max-width:20ch;color:#FBF8F1;text-shadow:0 2px 30px rgba(0,0,0,0.35);">The executive offsite your team will remember. <span style="font-style:italic;color:#E0744A;">And the proof it worked.</span></h1>
        <p style="margin-top:30px;font-size:clamp(17px,1.95vw,22px);line-height:1.55;max-width:52ch;color:rgba(244,240,231,0.86);">We run facilitated executive retreats built around one outcome, and a 90-minute simulation that shows exactly how your team performs under pressure. Start with either. You get a real result and a measured read, not just a good day away.</p>
        <div style="margin-top:38px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;">
          <a href={SLUGS.teamRetreats} style="background:#C04A26;color:#fff;text-decoration:none;padding:17px 32px;border-radius:11px;font-weight:700;font-size:17px;display:inline-flex;align-items:center;gap:9px;box-shadow:0 14px 40px -12px rgba(192,74,38,0.6);">Plan your retreat <span style="font-size:18px;">&rarr;</span></a>
          <a href={SLUGS.teamLfs} style="border:1px solid rgba(244,240,231,0.32);color:#F4F0E7;text-decoration:none;padding:17px 28px;border-radius:11px;font-weight:600;font-size:16px;backdrop-filter:blur(2px);">See the 90-minute read</a>
        </div>
        <p style="margin-top:18px;font-size:13.5px;color:rgba(244,240,231,0.6);max-width:40ch;line-height:1.4;">You leave with a concrete read on your team — whether or not we work together.</p>
      </div>
    </div>
  </section>

  <!-- RETREAT INQUIRY FORM SLOT (James is building this; placeholder marks the position) -->
  <section style="background:#EFE8DA;color:#1B1810;padding:40px 32px;border-bottom:1px solid rgba(27,24,16,0.1);">
    <div style="max-width:1100px;margin:0 auto;border:2px dashed #C04A26;border-radius:16px;padding:34px 30px;text-align:center;background:rgba(192,74,38,0.04);">
      <p style="font-size:12.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:8px;">Retreat inquiry form — slot</p>
      <p style="font-size:16px;line-height:1.6;color:#56524A;max-width:62ch;margin:0 auto;">Your retreat-specific inquiry form drops in here, directly under the hero: team size, timeframe, destination preference, and a note. For now this is a placeholder marking the position and the width.</p>
    </div>
  </section>

  <PressStrip />

  <!-- TWO WAYS IN -->
  <section class="bl-section-pad" style="background:#F4F0E7;color:#1B1810;padding:92px 32px;">
    <div style="max-width:1200px;margin:0 auto;">
      <div style="max-width:60ch;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">Two ways in</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(30px,4.2vw,50px);line-height:1.04;letter-spacing:-0.02em;">Start with an experience, or start with the read.</h2>
        <p style="margin-top:18px;font-size:18px;line-height:1.6;color:#56524A;">Both are complete on their own, both come with a measured outcome, and every paid step credits 50% toward whatever you do next.</p>
      </div>
      <div class="bl-grid-collapse" style="margin-top:44px;display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch;">
        <!-- Retreat (primary) -->
        <article style="background:#64010a;color:#F6EFE0;border-radius:22px;padding:40px;display:flex;flex-direction:column;">
          <p style="font-size:12.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E9A98F;">The experience · what we're hired for</p>
          <h3 style="margin-top:14px;font-family:'Newsreader',serif;font-weight:500;font-size:30px;line-height:1.08;color:#FBF3E7;">An Executive Retreat</h3>
          <p style="margin-top:14px;font-size:16.5px;line-height:1.6;color:rgba(246,239,224,0.86);">A facilitated, multi-day offsite engineered around one outcome and reinforced for 30 days so it holds. We have done this for executive teams hundreds of times. The activity is the least important part; what makes it work is that it is built around your real fault line and converted into how you operate.</p>
          <div style="margin-top:auto;padding-top:26px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
            <a href={SLUGS.teamRetreats} style="background:#F6EFE0;color:#64010a;text-decoration:none;padding:14px 26px;border-radius:999px;font-weight:800;font-size:15px;">Plan your retreat &rarr;</a>
            <a href={SLUGS.executiveImmersion} style="color:#F0D9D2;text-decoration:none;font-weight:700;font-size:14.5px;">or a single engineered day &rarr;</a>
          </div>
        </article>
        <!-- LFS (the read) -->
        <article style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.10);border-radius:22px;padding:40px;display:flex;flex-direction:column;">
          <p style="font-size:12.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A8578;">The read · 90 minutes</p>
          <h3 style="margin-top:14px;font-family:'Newsreader',serif;font-weight:500;font-size:30px;line-height:1.08;color:#1B1810;">The Team LFS</h3>
          <p style="margin-top:6px;font-family:'Newsreader',serif;font-style:italic;font-size:16px;color:#9E3A1C;">A live simulation your team will actually enjoy.</p>
          <p style="margin-top:14px;font-size:16px;line-height:1.6;color:#56524A;">The Leadership Failure Simulation puts your executives through a live crisis built from your own company's reality, and logs how they actually decide, coordinate and hold a standard under pressure. You walk out with individual and team reports and a FlagScore baseline. Engaging in the room, and real data on the page.</p>
          <div style="margin-top:auto;padding-top:26px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
            <a href={SLUGS.teamLfs} style="color:#C04A26;text-decoration:none;font-weight:700;font-size:15.5px;">See how the read works &rarr;</a>
            <a href={SLUGS.executiveTeamAssessment} style="color:#8A6A64;text-decoration:none;font-weight:700;font-size:14.5px;">compare all our assessment tools &rarr;</a>
          </div>
        </article>
      </div>
      <p style="margin-top:22px;font-size:15px;line-height:1.6;color:#6B5A54;max-width:72ch;">Not ready to book either? Start free: the <a href={SLUGS.breakPointAssessment} style="color:#C04A26;text-decoration:underline;">4-minute Break-Point Self-Assessment</a>, or a 15-minute <a href={CTA_URL} style="color:#C04A26;text-decoration:underline;">Calibration Call</a>.</p>
    </div>
  </section>

  <section style="background:#15130E;color:#F4F0E7;"><ResultsBand variant="dark" maxWidth={1080} /></section>

  <!-- THE METHOD (framework teaser — the interactive Flag Model moves to /flag-model/) -->
  <section class="bl-section-pad" style="background:#15130E;color:#F4F0E7;padding:92px 32px;border-top:1px solid rgba(244,240,231,0.08);">
    <div class="bl-grid-collapse" style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;">
      <div>
        <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">The method behind it</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,44px);line-height:1.05;letter-spacing:-0.02em;color:#FBF8F1;">Built on the Flag Model, not a borrowed framework.</h2>
        <p style="margin-top:20px;font-size:17px;line-height:1.62;color:rgba(244,240,231,0.8);max-width:52ch;">Every retreat and every read measures the same five things: the Flag — your 2 to 3 priorities — and the four disciplines that hold it up, the Decision, the Rhythm, the Standard and the Learning. It is an original, named, measurable model for the AI era, not a repackaged framework from a pre-AI world.</p>
        <a href={SLUGS.flagModel} style="margin-top:24px;display:inline-flex;align-items:center;gap:9px;background:#C04A26;color:#fff;text-decoration:none;padding:15px 28px;border-radius:11px;font-weight:700;font-size:16px;">Explore the Flag Model <span>&rarr;</span></a>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        {[['The Flag','Your 2–3 priorities, defined precisely enough to test any decision against.'],['The Decision','A call gets made, sticks, and does not route back to the CEO.'],['The Rhythm','Work gets finished, not just started.'],['The Standard','A missed commitment gets named in the room.'],['The Learning','The team changes because of its misses.'],['FlagScore','The composite read that moves quarter over quarter.']].map(([h,b]) => (
          <div style="background:rgba(244,240,231,0.04);border:1px solid rgba(244,240,231,0.12);border-radius:14px;padding:20px 20px;">
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;color:#FBF3E7;margin-bottom:6px;">{h}</h3>
            <p style="font-size:13.5px;line-height:1.5;color:rgba(244,240,231,0.72);">{b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DEPTH: the honest bit, demoted below the offer and reworded to invite -->
  <section class="bl-section-pad" style="background:#F4F0E7;color:#1B1810;padding:92px 32px;">
    <div style="max-width:900px;margin:0 auto;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:24px;">Where it can go</p>
      <p style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3.4vw,38px);line-height:1.28;letter-spacing:-0.01em;color:#1B1810;">A retreat or a read is a strong start. For the teams that want the whole system rebuilt and held, the work becomes a <span style="color:#C04A26;">performance engagement</span>: we install the disciplines over time and measure the result quarter over quarter, with success fees tied to a documented return. You can begin with one day and decide from there.</p>
      <a href={SLUGS.howWeWorkTogether} style="margin-top:28px;display:inline-flex;align-items:center;gap:8px;color:#C04A26;text-decoration:none;font-weight:700;font-size:16px;">See how we work together &rarr;</a>
    </div>
  </section>

  <!-- AUTHORITY (condensed; full books/credentials section preserved from the current page) -->
  <section class="bl-section-pad" style="background:#15130E;color:#F4F0E7;padding:92px 32px;">
    <div class="bl-grid-collapse" style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:0.85fr 1.15fr;gap:56px;align-items:center;">
      <div style="aspect-ratio:4/5;border-radius:20px;overflow:hidden;border:1px solid rgba(244,240,231,0.12);background:#100E0A;">
        <Image src={imgJames} alt="James Carter, founder of Be Legendary and creator of the Flag Model" width={760} format="webp" quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 28%;display:block;" />
      </div>
      <div>
        <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">Who runs the work</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,44px);line-height:1.06;letter-spacing:-0.015em;color:#FBF8F1;">James Carter</h2>
        <p style="margin-top:22px;font-size:18px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:54ch;">Twenty-five years inside hundreds of leadership teams. Creator of the Flag Model, sole author of the forthcoming <em style="font-style:italic;">Lost Disciplines of Leadership</em>, and a co-author alongside Stephen Covey, Ken Blanchard, Deepak Chopra and Brian Tracy. Work featured in CNN, CNN Money and Business Insider.</p>
        <p style="margin-top:18px;font-size:14.5px;color:rgba(244,240,231,0.55);">(Full credentials + the books grid carry over from the current page.) <a href={SLUGS.about} style="color:#E0744A;text-decoration:none;">More about James &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bl-section-pad" style="background:#15130E;color:#F4F0E7;padding:92px 32px;">
    <div style="max-width:900px;margin:0 auto;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">The questions CEOs actually ask</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(30px,4.2vw,48px);line-height:1.04;letter-spacing:-0.02em;margin-bottom:36px;">Answered, plainly.</h2>
      <Faq faqs={faqs} />
    </div>
  </section>

  <TrustedBy />
  <Testimonials />

  <!-- FINAL CTA -->
  <section id="book" style="background:linear-gradient(180deg,#1B1810,#15130E);color:#F4F0E7;padding:112px 32px;text-align:center;position:relative;">
    <div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(192,74,38,0.22),transparent 55%);pointer-events:none;"></div>
    <div style="position:relative;max-width:780px;margin:0 auto;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(34px,5.4vw,60px);line-height:1.02;letter-spacing:-0.025em;color:#FBF8F1;">Give your team a day that <span style="font-style:italic;color:#E0744A;">actually moves them.</span></h2>
      <p style="margin-top:24px;font-size:19px;line-height:1.58;color:rgba(244,240,231,0.78);max-width:52ch;margin-left:auto;margin-right:auto;">Plan a retreat, or run the 90-minute read. Either way you leave with a concrete picture of your team — whether or not we work together.</p>
      <div style="margin-top:36px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href={SLUGS.teamRetreats} style="display:inline-flex;align-items:center;gap:10px;background:#C04A26;color:#fff;text-decoration:none;padding:18px 36px;border-radius:12px;font-weight:700;font-size:18px;box-shadow:0 18px 50px -14px rgba(192,74,38,0.65);">Plan your retreat <span style="font-size:20px;">&rarr;</span></a>
        <a href={CTA_URL} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;border:1px solid rgba(244,240,231,0.32);color:#F4F0E7;text-decoration:none;padding:18px 32px;border-radius:12px;font-weight:600;font-size:17px;">Book a 15-minute call</a>
      </div>
    </div>
  </section>

  <div style="background:#15130E;padding:0 0 8px;"><LowCommitmentCTA maxWidth={820} /></div>

  <SiteFooter audience="teams" />
</BaseLayout>
