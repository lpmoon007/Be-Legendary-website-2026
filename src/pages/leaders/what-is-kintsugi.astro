---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareRow from '../../components/ShareRow.astro';
import ArticleEndCTA from '../../components/ArticleEndCTA.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../lib/site';

const path = SLUGS.whatIsKintsugi;
const title = 'What Is Kintsugi? The Art of Gilding What Broke You';
const description =
  'Kintsugi is the Japanese art of mending broken pottery with gold, valuing the repair above the original. Its meaning as a mindset and link to wabi-sabi.';

const canonical = new URL(path, SITE_URL).href;

// Article + DefinedTerm + FAQPage — schema types preserved from the design,
// enriched with entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'What Is Kintsugi? The Art of Gilding What Broke You',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['kintsugi', 'wabi-sabi', 'resilience'],
    description:
      'What kintsugi is, its meaning as a mindset, its link to wabi-sabi, and how leaders use it.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'DefinedTerm',
    '@id': `${canonical}#term`,
    name: 'Kintsugi',
    description:
      "Kintsugi is the Japanese art of repairing broken pottery by mending the cracks with lacquer dusted or mixed with gold, so the restored piece is considered more beautiful and valuable than the unbroken original. As a mindset it means treating your fractures — failures, setbacks, scars — as the places worth gilding rather than hiding.",
    inDefinedTermSet: 'Be Legendary',
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is kintsugi?', acceptedAnswer: { '@type': 'Answer', text: "Kintsugi is the Japanese art of repairing broken pottery by filling the cracks with gold. Rather than disguising the break, it highlights it in precious metal, so the mended piece is valued more than it was before it broke. The word translates roughly as 'golden joinery.'" } },
      { '@type': 'Question', name: 'What is the meaning of kintsugi as a philosophy?', acceptedAnswer: { '@type': 'Answer', text: "As a philosophy, kintsugi says that damage and repair are part of an object's history to be honored, not hidden. Applied to people, it means your failures and hardest moments aren't flaws to conceal — they can become the most valuable, distinctive parts of who you are. What broke you, mended honestly, can be worth more than the version that never cracked." } },
      { '@type': 'Question', name: 'How is kintsugi related to wabi-sabi?', acceptedAnswer: { '@type': 'Answer', text: "Wabi-sabi is the broader Japanese aesthetic of finding beauty in imperfection, impermanence and incompleteness. Kintsugi is one practice that expresses it: the crack is not just tolerated but celebrated in gold. Wabi-sabi is the worldview; kintsugi is the worldview made visible in a repaired bowl." } },
      { '@type': 'Question', name: 'How do you practice kintsugi as a mindset?', acceptedAnswer: { '@type': 'Answer', text: "Start by naming a crack — a failure or scar you usually hide — and asking what it gave you that the unbroken version never could. Then practice 'New Eyes': look for the gold in others' flaws before your own. It is a repeatable rep, not a one-time reframe." } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="What Is Kintsugi? The Art of Gilding What Broke You"
  ogDescription="Mended with gold, the bowl is worth more than whole. The Japanese art — and the mindset behind it."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;">
    <article>
      <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">What Is Kintsugi</span>
        </nav>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;max-width:18ch;">What is kintsugi?</h1>
        <div style="margin-top:28px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The short answer</p>
          <p style="font-size:18px;line-height:1.6;color:#2E2A22;">Kintsugi is the Japanese art of <strong style="font-weight:700;">repairing broken pottery with gold</strong>, so the mended piece is valued more than the unbroken original. As a mindset, it means treating your cracks — failures, setbacks, scars — not as damage to hide, but as the very places worth gilding. What broke you can become the most valuable thing about you.</p>
        </div>
      </header>

      <section style="max-width:820px;margin:48px auto 0;padding:0 32px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">The art</p>
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="margin-bottom:22px;">When a bowl breaks in Japan, one tradition refuses to disguise the repair. The cracks are filled with lacquer dusted with <strong>gold</strong> — <em style="font-style:italic;">kintsugi,</em> "golden joinery." The break becomes the most striking thing about the piece, and the bowl is considered more precious mended than it ever was whole.</p>
          <p>Its cousin is <em style="font-style:italic;">wabi-sabi</em> — the love and appreciation of a thing <strong>because</strong> of its imperfections, not in spite of them. The chipped mug with a story. The misshapen cookie that somehow tastes better. Wabi-sabi is the worldview; kintsugi is that worldview made visible in a repaired bowl.</p>
        </div>
      </section>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">The mindset</p>
          <p style="margin-bottom:22px;">Apply it to a person and it stops being about pottery. The failure you'd bury, the scar you downplay, the season that nearly broke you — kintsugi says those are not defects to conceal. Mended honestly, they can become the most valuable, distinctive parts of who you are.</p>
          <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">Broken is not the opposite of beautiful. The gold goes exactly where the crack is.</p>
          <p>We call the skill of seeing it <em style="font-style:italic;">New Eyes</em> — looking at what everyone sees and noticing the gold no one else does. It's easiest to practice on other people first, then hardest and most important to turn inward.</p>
        </div>
      </section>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;text-align:center;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">Practice it — free</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF8F1;max-width:24ch;margin:0 auto 16px;">Put New Eyes on your own cracks.</h2>
          <p style="font-size:17px;line-height:1.6;color:rgba(244,240,231,0.78);max-width:48ch;margin:0 auto 28px;">The Kintsugi mindset workout is a free, ten-minute guided rep — first on the people around you, then on yourself.</p>
          <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;">
            <a href={workoutPath('kintsugi-wabi-sabi')} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">Do the Kintsugi workout <span>&rarr;</span></a>
            <a href={workoutPath('the-golden-buddha')} style="border:1px solid rgba(244,240,231,0.3);color:#F4F0E7;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;">Now turn it inward: The Golden Buddha</a>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:56px auto 0;padding:0 32px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#1B1810;margin-bottom:28px;">Straight answers</h2>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">What does kintsugi mean as a philosophy?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">That damage and repair are part of a thing's history to be honored, not hidden. Applied to people: your hardest moments aren't flaws to conceal — mended honestly, they can become the most valuable parts of who you are.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">How is kintsugi related to wabi-sabi?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Wabi-sabi is the broader aesthetic of finding beauty in imperfection and impermanence. Kintsugi is one practice that expresses it — the crack celebrated in gold. Worldview and practice.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">How do you practice it on yourself?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Name a crack you usually hide and ask what it gave you that the unbroken version never could. Then look for the gold in others' flaws before your own. It's a rep you repeat, not a one-time reframe — which is what the <a href={workoutPath('kintsugi-wabi-sabi')} style="color:#C04A26;text-decoration:underline;">workout</a> builds.</p></div>
        </div>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px 20px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Keep going</p>
        <div class="bl-cards-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
          <a href={SLUGS.goldenBuddhaStory} style="text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:22px 22px;display:block;"><span style="display:block;font-family:'Newsreader',serif;font-size:19px;color:#1B1810;margin-bottom:6px;">The Golden Buddha story</span><span style="display:block;font-size:14px;line-height:1.5;color:#6B6358;">The gold was always under the clay.</span></a>
          <a href={SLUGS.whatIsMisogi} style="text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:22px 22px;display:block;"><span style="display:block;font-family:'Newsreader',serif;font-size:19px;color:#1B1810;margin-bottom:6px;">What is a misogi?</span><span style="display:block;font-size:14px;line-height:1.5;color:#6B6358;">One hard thing a year that resets you.</span></a>
          <a href={SLUGS.leadersGlossary} style="text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:22px 22px;display:block;"><span style="display:block;font-family:'Newsreader',serif;font-size:19px;color:#1B1810;margin-bottom:6px;">The Leader's glossary</span><span style="display:block;font-size:14px;line-height:1.5;color:#6B6358;">Every term, defined in one place.</span></a>
        </div>
      </section>
      <ArticleEndCTA maxWidth={820} />
      <ShareRow title={title} maxWidth={820} />
</article>
  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
