---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareRow from '../../components/ShareRow.astro';
import ArticleEndCTA from '../../components/ArticleEndCTA.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS } from '../../lib/site';

const path = SLUGS.leadershipQualities;
const title = 'Leadership Qualities: The Traits That Matter | Be Legendary';
const description =
  'The leadership qualities that actually matter — with real examples of what each looks like under pressure. Beyond the buzzwords, and how to build them.';

const canonical = new URL(path, SITE_URL).href;

// Article + FAQPage — schema types preserved from the design,
// enriched with entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'Leadership Qualities: The Traits That Actually Matter',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['leadership qualities', 'leadership traits', 'qualities of a good leader'],
    description:
      'The leadership qualities that matter most, with examples of what each looks like under pressure, and how they’re built.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What are the most important leadership qualities?', acceptedAnswer: { '@type': 'Answer', text: "The qualities that matter most are self-awareness, integrity, courage, humility, decisiveness, empathy and resilience. What separates a real quality from a buzzword is whether it holds up under pressure — integrity is easy when it's free and meaningful only when it costs you. Underneath all of them is a settled sense of self that doesn't need constant validation, which is what keeps the other qualities steady when it's hard." } },
      { '@type': 'Question', name: 'Can leadership qualities be developed?', acceptedAnswer: { '@type': 'Answer', text: "Yes. Leadership qualities are trainable the way strength is — through deliberate, uncomfortable reps followed by real recovery, done consistently. Awareness, courage and the rest grow when practiced, especially in the moments they're hardest to access." } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Leadership Qualities: The Traits That Actually Matter (With Examples)"
  ogDescription="The traits great leaders share — and what each looks like when it costs something."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;">
    <article>
      <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">Leadership Qualities</span>
        </nav>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;max-width:20ch;">The leadership qualities that actually matter — and what each looks like under pressure.</h1>
        <div style="margin-top:28px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The short answer</p>
          <p style="font-size:18px;line-height:1.6;color:#2E2A22;">The qualities that matter most — self-awareness, integrity, courage, humility, decisiveness, empathy, resilience — all share one test: <em style="font-style:italic;">do they hold up when it costs you something?</em> Integrity is free when it's easy and real only when it's expensive. Underneath every quality is a settled self that doesn't need constant validation.</p>
        </div>
      </header>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="display:flex;flex-direction:column;gap:12px;">
          <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:12px;padding:22px 24px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:6px;">Self-awareness</h3><p style="font-size:15px;line-height:1.55;color:#56524A;"><em style="font-style:italic;">Looks like:</em> catching your own defensiveness in a meeting and naming it, instead of letting it drive the decision.</p></div>
          <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:12px;padding:22px 24px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:6px;">Integrity</h3><p style="font-size:15px;line-height:1.55;color:#56524A;"><em style="font-style:italic;">Looks like:</em> keeping the promise that got expensive — telling the hard truth to a client when a lie would've been easier and paid better.</p></div>
          <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:12px;padding:22px 24px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:6px;">Courage</h3><p style="font-size:15px;line-height:1.55;color:#56524A;"><em style="font-style:italic;">Looks like:</em> making the unpopular call, or having the conversation you've avoided for a month, before it's forced on you.</p></div>
          <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:12px;padding:22px 24px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:6px;">Humility</h3><p style="font-size:15px;line-height:1.55;color:#56524A;"><em style="font-style:italic;">Looks like:</em> saying "I was wrong" in the room where you said the wrong thing — and meaning it.</p></div>
          <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:12px;padding:22px 24px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:6px;">Resilience</h3><p style="font-size:15px;line-height:1.55;color:#56524A;"><em style="font-style:italic;">Looks like:</em> taking the hit, feeling it honestly, and still showing up steady for the team the next morning.</p></div>
        </div>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:0 0 22px;padding-left:22px;border-left:3px solid #C04A26;">A quality you only have when it's easy isn't a quality. It's a preference.</p>
          <p>Notice the pattern: every one of these shows its real face under pressure, and every one is downstream of the same root — the ability to see yourself clearly, choose your response, and act on it when it costs something. Train that root and the whole list grows together. That's why the work isn't memorizing traits; it's building the foundation they all stand on.</p>
        </div>
      </section>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;text-align:center;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">Build the root — free</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF8F1;max-width:24ch;margin:0 auto 16px;">Qualities are trained, not listed.</h2>
          <p style="font-size:17px;line-height:1.6;color:rgba(244,240,231,0.78);max-width:48ch;margin:0 auto 28px;">The free Mindset Workouts train the foundation every leadership quality stands on — awareness, beliefs, courage. Take one rep today.</p>
          <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;">
            <a href={SLUGS.workouts} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">Enter the gym — free <span>&rarr;</span></a>
            <a href={SLUGS.legendsJourney} style="border:1px solid rgba(244,240,231,0.3);color:#F4F0E7;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;">Find where you are</a>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:56px auto 0;padding:0 32px 20px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#1B1810;margin-bottom:28px;">Straight answers</h2>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">What's the single most important quality?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Self-awareness. It's the one that unlocks the rest — you can't practice integrity, courage or humility if you can't first see your own reactions clearly. It's the first of the ABCs: Awareness, Beliefs, Courage.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Can these qualities really be developed?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Yes — the way strength is: deliberate, uncomfortable reps, real recovery, done consistently. They grow most when practiced in the exact moments they're hardest to reach.</p></div>
        </div>
      </section>
      <!-- internal-linking: keep-reading rail -->
      <section style="max-width:860px;margin:8px auto 0;padding:0 32px 76px;">
        <p style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Keep reading</p>
        <div style="display:grid;gap:12px;">
          <a href="/leaders/what-makes-a-good-leader/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">What makes a good leader</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/what-is-leadership/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">What is leadership, really?</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/improve-leadership-skills/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">How to improve your leadership skills</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
        </div>
      </section>
      <ArticleEndCTA maxWidth={820} />
      <ShareRow title={title} maxWidth={820} />
</article>
  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
