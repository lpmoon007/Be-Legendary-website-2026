---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareRow from '../../components/ShareRow.astro';
import ArticleEndCTA from '../../components/ArticleEndCTA.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS } from '../../lib/site';

const path = SLUGS.whereExecutivesRecharge;
const title = 'Where Do Executives Go to Recharge? | Be Legendary';
const description =
  "Where do high-level executives actually go to recharge? Not spas — experiential immersions that reset the mind, not just the body. Here's the real answer.";

const canonical = new URL(path, SITE_URL).href;

// Article + FAQPage — schema types preserved from the design, enriched with
// entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'Where Do Executives Go to Recharge?',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['executive recharge', 'transformational retreat', 'Shakubuku'],
    description:
      'Where high-level executives go to recharge, and why the most effective option changes the mind rather than just resting the body.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Where do high-level executives go to recharge?', acceptedAnswer: { '@type': 'Answer', text: "Increasingly, to experiential immersions in the physical world rather than spas or resorts. Be Legendary runs Shakubuku — invite-only multi-day adventures in the backcountry, off-road, or on open water — which CNN Money described as where high-level executives go to recharge. The point isn't rest; it's returning changed." } },
      { '@type': 'Question', name: 'Why not just take a vacation?', acceptedAnswer: { '@type': 'Answer', text: "A vacation restores your energy but leaves your mindset untouched, so the depletion returns. Executives who feel flat rather than merely tired need a reset that reaches the emotional and spiritual level — something a lounge chair can't provide. That's why immersion, not relaxation, is what actually recharges a leader who has everything and still feels empty." } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Where Do Executives Go to Recharge?"
  ogDescription="Not a spa. An immersion that changes you, not just rests you."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;">
    <article>
      <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">Where Executives Recharge</span>
        </nav>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;max-width:20ch;">Where do executives actually go to recharge?</h1>
    <p style="margin-top:16px;font-size:14px;color:#6E6757;">By <a href={SLUGS.about} style="color:#C04A26;text-decoration:none;">James Carter</a> &middot; Founder, Be Legendary</p>
        <div style="margin-top:28px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The short answer</p>
          <p class="bl-speakable" style="font-size:18px;line-height:1.6;color:#2E2A22;">The ones who come back genuinely restored don't go to a spa — they go somewhere real. Experiential immersions in the physical world reset the mind, not just the body. Be Legendary's version, <strong style="font-weight:700;">Shakubuku</strong>, is what <em style="font-style:italic;">CNN Money called "where high-level executives go to recharge."</em></p>
        </div>
      </header>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="margin-bottom:22px;">If you're the kind of leader who has the beach house and still feels depleted, you already know the lounge chair isn't the answer. Rest restores energy. It doesn't touch the deeper thing — the sense that you've been running on a role, not a self.</p>
          <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">You don't recharge a leader by resting them. You recharge them by reminding them who they are.</p>
          <p>That's why the executives who take this seriously choose immersion over relaxation: a few days somewhere the title doesn't work, the phone doesn't reach, and the body has to show up. They come back not merely rested — <em style="font-style:italic;">changed.</em></p>
        </div>
      </section>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="background:#15130E;border-radius:16px;overflow:hidden;">
          <div style="height:220px;background-image:url('/assets/cs-everglades.webp');background-size:cover;background-position:center;"></div>
          <div style="padding:28px 30px;">
            <p style="font-family:'Newsreader',serif;font-weight:400;font-style:italic;font-size:22px;line-height:1.4;color:#FBF8F1;margin-bottom:14px;">"Roles disappear. All that matters is that we have to come together to survive."</p>
            <p style="font-size:13.5px;color:#8C8473;">— James Carter, on Shakubuku · <span style="color:#B7AE9C;">Featured on CNN, CNN Money, Business Insider &amp; Business Destinations.</span></p>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;text-align:center;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">Start before you fly anywhere</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF8F1;max-width:22ch;margin:0 auto 16px;">Feel the reset in ten minutes — free.</h2>
          <p style="font-size:17px;line-height:1.6;color:rgba(244,240,231,0.78);max-width:48ch;margin:0 auto 28px;">A single Mindset Workout gives you a taste of the shift Shakubuku goes deep on. If it moves something, the immersion will make sense.</p>
          <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;">
            <a href={SLUGS.workouts} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">Try a Mindset Workout — free <span>&rarr;</span></a>
            <a href={`${SLUGS.leaders}#shakubuku`} style="border:1px solid rgba(244,240,231,0.3);color:#F4F0E7;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;">What is Shakubuku?</a>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:56px auto 0;padding:0 32px 90px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#1B1810;margin-bottom:28px;">Straight answers</h2>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Why not just take a vacation?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">A vacation restores energy but leaves your mindset untouched, so the depletion comes back. Leaders who feel flat rather than merely tired need a reset that reaches the emotional and spiritual level — something a lounge chair can't provide.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Is it just for burnout?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">No. Many who go aren't burned out at all — they're successful, restless, and sense there's another level in them. It's as much about becoming as recovering.</p></div>
        </div>
      </section>
      <!-- internal-linking: keep-reading rail -->
      <section style="max-width:860px;margin:8px auto 0;padding:0 32px 76px;">
        <p style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Keep reading</p>
        <div style="display:grid;gap:12px;">
          <a href="/leaders/wilderness-therapy-for-executives/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">Wilderness therapy for executives</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/executive-burnout-retreat/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">The executive burnout retreat</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/stress-management-retreat/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">A stress-management retreat for executives</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
        </div>
      </section>
      <ArticleEndCTA maxWidth={820} />
      <ShareRow title={title} maxWidth={820} />
</article>
  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
