    <section id="james" style="background:#EFE8DA;color:#1B1810;padding:112px 32px;">
      <div class="bl-grid-collapse bl-grid-collapse--gap" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:0.8fr 1.2fr;gap:60px;align-items:center;">
        <div style="aspect-ratio:4/5;border-radius:16px;overflow:hidden;border:1px solid rgba(27,24,16,0.12);background:#E7DECB;">
