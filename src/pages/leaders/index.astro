---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath, CTA_URL } from '../../lib/site';

const path = SLUGS.leaders;
const title = "For Leaders — You can't outperform your current mindset | Be Legendary";
const description =
  "Becoming legendary isn't a single leap — it's reps. Start with one free guided Mindset Workout, feel the first shift today, and climb toward Shakubuku. Personal development for the successful, restless leader. From Be Legendary and James Carter.";

// Readiness track (Door 1 · Earn it). Rendered statically from the design's data.
const trackRaw = [
  { num: '01', label: 'Go For It', done: true },
  { num: '02', label: 'See Your Shell', done: false },
  { num: '03', label: 'Beliefs', done: false },
  { num: '04', label: 'Courage', done: false },
  { num: '★', label: 'Shakubuku Invite', done: false, goal: true },
];
const track = trackRaw.map((t, i, arr) => ({
  num: t.num,
  label: t.label,
  dotBg: t.done || t.goal ? '#C04A26' : 'transparent',
  dotBorder: t.done || t.goal ? '#C04A26' : 'rgba(244,240,231,0.32)',
  dotColor: t.done || t.goal ? '#F4F0E7' : '#B7AE9C',
  labelColor: t.goal ? '#E0744A' : t.done ? '#F4F0E7' : '#8C8473',
  lineColor: i === arr.length - 1 ? 'transparent' : 'rgba(244,240,231,0.18)',
}));

// Example Shakubuku four-dimension profile.
const dims = [
  { name: 'Physical', label: 'Demanding', pct: '80%' },
  { name: 'Emotional', label: 'High', pct: '90%' },
  { name: 'Spiritual', label: 'High', pct: '85%' },
  { name: 'Mental', label: 'Moderate', pct: '55%' },
];

// FAQ — drives both the visible section and the FAQPage schema.
const faqs = [
  {
    q: 'What is a Mindset Workout?',
    a: "A short, guided rep — about ten minutes — built on the ABCs of the legendary mindset: Awareness, Beliefs, Courage. You get a video, a purpose, a story, reflection questions and a small real-world Misogi challenge. It's free to start, and it's how you take the first shift on your own time.",
  },
  {
    q: 'What is Shakubuku?',
    a: 'Shakubuku means “to awaken a person to their inherent greatness.” It’s a multi-day, invite-only adventure immersion in the physical world — off-road, backcountry, open water — with the route kept a mystery so experience, not preparation, does the teaching. Spiritual, not religious, and emotional, lived through the body. By application; from $15,000 per person, all-inclusive.',
  },
  {
    q: 'How do I get into a Shakubuku?',
    a: "Two doors. Earn it — work the Mindset Workouts; readiness builds across four dimensions and the invitation to apply becomes yours. Or challenge it — if you already know you're ready, apply now and make your case. Groups are small and curated, matched to each adventure's demands.",
  },
  {
    q: 'Who is the Leaders side of Be Legendary for?',
    a: "The successful, restless individual leader — a founder or executive who has already arrived and senses there's another level in them. It's self-funded personal development, not HR-driven training.",
  },
  {
    q: 'How does this relate to Be Legendary for teams?',
    a: "Same brand, one entity, two audiences. Be Legendary helps executive teams execute through the Flag Model; the Leaders side is the home for the individual leader's personal growth. A team is only as strong as the leader behind it — the toggle up top takes you across.",
  },
];

// JSON-LD page nodes. Identity (Org/Person/WebSite/WebPage) is injected by
// BaseLayout via siteGraph; here we recreate the page-specific nodes, wiring
// provider/author to the canonical @ids.
const schema = [
  {
    '@type': 'Course',
    name: 'Mindset Workouts',
    provider: { '@id': ORG_ID },
    description:
      'Free, short, self-guided reps on the ABCs of the legendary mindset — the front door for individual leaders.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', category: 'free' },
  },
  {
    '@type': 'Service',
    '@id': `${SITE_URL}/#shakubuku`,
    name: 'Shakubuku',
    provider: { '@id': ORG_ID },
    serviceType: 'Transformational executive retreat',
    description:
      'A multi-day, invite-only adventure immersion in the physical world that awakens leaders to their inherent greatness. By application; from $15,000 per person, all-inclusive.',
    offers: { '@type': 'Offer', price: '15000', priceCurrency: 'USD' },
  },
  {
    '@type': 'Service',
    name: 'The Legendary Leader',
    provider: { '@id': ORG_ID },
    serviceType: 'Private whole-person development program',
    description:
      'A six-month private program with four dedicated coaches — physical, mental, emotional, spiritual — built around a Shakubuku.',
    offers: { '@type': 'Offer', availability: 'https://schema.org/LimitedAvailability' },
  },
  {
    '@type': 'DefinedTerm',
    '@id': `${SITE_URL}/#shakubuku-term`,
    name: 'Shakubuku',
    description:
      'To awaken a person to their inherent greatness; a swift spiritual, non-religious and emotional shift lived through the body.',
    inDefinedTermSet: 'Be Legendary',
  },
  {
    '@type': 'DefinedTerm',
    name: 'Legendary Operating System (LOS)',
    description:
      'The beliefs a leader was handed early and never chose — the code that runs them until they see it, challenge it, and rewrite it.',
    inDefinedTermSet: 'Be Legendary',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="website"
  ogTitle="You can't outperform your current mindset. So let's change it."
  ogDescription="One free Mindset Workout at a time. The on-ramp to Shakubuku, for the leader who has already arrived and senses another level."
  bodyBg="#15130E"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="full"
    logoHref="#top"
    links={[
      { label: 'Mindset Workouts', href: SLUGS.workouts },
      { label: 'Shakubuku', href: '#shakubuku' },
      { label: 'The Climb', href: '#climb' },
      { label: 'James', href: '#james' },
    ]}
  />

  <div style="background:#15130E;color:#F4F0E7;overflow:hidden;">
    <div id="top"></div>

    <!-- ============ HERO · CENTERED MANIFESTO ============ -->
    <section style="position:relative;background:#F4F0E7;color:#1B1810;">
      <div style="max-width:1040px;margin:0 auto;padding:104px 32px 0;text-align:center;">
        <p style="display:inline-flex;align-items:center;gap:9px;font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:26px;"><span style="width:7px;height:7px;border-radius:50%;background:#C04A26;"></span>Good to great starts with one rep</p>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(42px,6.2vw,80px);line-height:1.0;letter-spacing:-0.024em;color:#1B1810;max-width:15ch;margin:0 auto;">You can't outperform your current mindset. <span style="font-style:italic;color:#C04A26;">So let's change it</span> — one workout at a time.</h1>
        <p style="margin-top:28px;font-size:20px;line-height:1.6;color:#56524A;max-width:52ch;margin-left:auto;margin-right:auto;">Becoming legendary isn't a single leap — it's reps. Start with one guided Mindset Workout and feel the first shift today.</p>
        <div style="margin-top:34px;display:flex;flex-direction:column;align-items:center;gap:14px;">
          <a href="#workouts" style="background:#C04A26;color:#fff;text-decoration:none;padding:18px 34px;border-radius:10px;font-weight:700;font-size:17px;display:inline-flex;align-items:center;gap:9px;box-shadow:0 16px 40px -14px rgba(192,74,38,0.7);" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Start your first workout <span>&rarr;</span></a>
          <a href={CTA_URL} target="_blank" rel="noopener" style="font-size:14.5px;font-weight:600;color:#8A7F6C;text-decoration:none;border-bottom:1px solid rgba(138,127,108,0.4);padding-bottom:2px;" onmouseover="this.style.color='#1B1810'" onmouseout="this.style.color='#8A7F6C'">or book a Legendary Intent Call &rarr;</a>
          <p style="font-size:13px;color:#8A7F6C;">No cost. No pitch. About 10 minutes.</p>
        </div>

        <!-- open-loop teaser: Workout 01 with locked A·B·C ladder -->
        <div style="margin-top:52px;display:inline-flex;flex-direction:column;align-items:center;gap:18px;background:#15130E;border-radius:16px;padding:26px 34px 28px;box-shadow:0 26px 60px -30px rgba(26,23,18,0.55);">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Mindset Workout 01 · Awareness</span>
          <div style="display:flex;align-items:center;gap:10px;">
            <span style="width:44px;height:44px;border-radius:999px;background:#C04A26;color:#fff;font-family:'Newsreader',serif;font-size:19px;display:flex;align-items:center;justify-content:center;">A</span>
            <span style="width:26px;height:1px;background:rgba(244,240,231,0.24);"></span>
            <span style="width:44px;height:44px;border-radius:999px;border:1px solid #4A463B;color:#8C8473;font-family:'Newsreader',serif;font-size:19px;display:flex;align-items:center;justify-content:center;">B</span>
            <span style="width:26px;height:1px;background:rgba(244,240,231,0.24);"></span>
            <span style="width:44px;height:44px;border-radius:999px;border:1px solid #4A463B;color:#8C8473;font-family:'Newsreader',serif;font-size:19px;display:flex;align-items:center;justify-content:center;">C</span>
          </div>
          <p style="font-size:14.5px;color:rgba(244,240,231,0.72);margin:0;max-width:34ch;line-height:1.5;">Start with <span style="color:#E7E0D2;">Awareness</span>. Beliefs and Courage unlock as you go — that's the climb to Shakubuku.</p>
        </div>

        <!-- scroll cue -->
        <div style="margin-top:44px;padding-bottom:44px;">
          <a href="#climb" style="display:inline-flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:#8A7F6C;" onmouseover="this.style.color='#C04A26'" onmouseout="this.style.color='#8A7F6C'">
            <span style="font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;">See the climb</span>
            <span style="font-size:22px;line-height:1;">&darr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ THE CLIMB (value ladder) ============ -->
    <section id="climb" style="background:#EFE8DA;color:#1B1810;padding:104px 32px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">The climb</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(30px,4.2vw,46px);line-height:1.08;letter-spacing:-0.015em;max-width:16ch;">You don't start at the summit. You warm up to it.</h2>
        <p style="margin-top:18px;font-size:18px;line-height:1.65;color:#56524A;max-width:44ch;">Each step earns the next. Start where you are, feel real change, and go as far as you decide to — all the way to Shakubuku and beyond, if that's the leader you're becoming.</p>
        <div class="bl-grid-collapse bl-grid-collapse--gap" style="margin-top:48px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
          <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.11);border-radius:16px;padding:26px 24px;display:flex;flex-direction:column;">
            <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;margin-bottom:12px;">Step 1 · Start free</span>
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:23px;margin-bottom:10px;">Mindset Workouts</h3>
            <p style="font-size:15px;line-height:1.55;color:#56524A;margin-bottom:16px;">Self-guided reps on the ABCs. The first shift, on your own time.</p>
            <span style="margin-top:auto;font-family:'Newsreader',serif;font-size:19px;color:#C04A26;">Free to start</span>
          </div>
          <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.11);border-radius:16px;padding:26px 24px;display:flex;flex-direction:column;">
            <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;margin-bottom:12px;">Step 2 · Go deeper</span>
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:23px;margin-bottom:10px;">Natural Leader</h3>
            <p style="font-size:15px;line-height:1.55;color:#56524A;margin-bottom:16px;">A 6-month cohort to make the mindset stick, together.</p>
            <span style="margin-top:auto;font-family:'Newsreader',serif;font-size:19px;">$6,500</span>
          </div>
          <div style="background:#15130E;color:#F4F0E7;border-radius:16px;padding:26px 24px;display:flex;flex-direction:column;box-shadow:0 24px 50px -22px rgba(26,23,18,0.55);">
            <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">Step 3 · The summit</span>
            <h3 style="font-family:'Newsreader',serif;font-weight:400;font-style:italic;font-size:25px;margin-bottom:10px;color:#FBF8F1;">Shakubuku</h3>
            <p style="font-size:15px;line-height:1.55;color:rgba(244,240,231,0.72);margin-bottom:16px;">The adventure immersion that makes you a different leader.</p>
            <span style="margin-top:auto;font-family:'Newsreader',serif;font-size:19px;">From $15,000</span>
          </div>
          <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.11);border-radius:16px;padding:26px 24px;display:flex;flex-direction:column;">
            <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;margin-bottom:12px;">Step 4 · All in</span>
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:23px;margin-bottom:10px;"><a href={SLUGS.legendaryLeader} style="color:inherit;text-decoration:none;">The Legendary Leader</a></h3>
            <p style="font-size:15px;line-height:1.55;color:#56524A;margin-bottom:16px;">Whole-person, four coaches, six months, private.</p>
            <span style="margin-top:auto;font-family:'Newsreader',serif;font-size:19px;">By application</span>
          </div>
        </div>
        <p style="margin-top:24px;font-size:14.5px;line-height:1.6;color:#8A7F6C;max-width:48ch;">Most leaders begin at Step 1 and let the work pull them upward. You never have to leap — you just take the next rep.</p>
      </div>
    </section>

    <!-- ============ EARN YOUR SHAKUBUKU ============ -->
    <section id="shakubuku" style="background:#15130E;color:#F4F0E7;padding:112px 32px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#E0744A;margin-bottom:20px;">Earn your spot — or challenge it</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4.6vw,50px);line-height:1.06;letter-spacing:-0.02em;max-width:15ch;color:#FBF8F1;">You don't buy your way into a Shakubuku. <span style="font-style:italic;color:#E0744A;">You earn your way in.</span></h2>
        <p style="margin-top:22px;font-size:18.5px;line-height:1.65;color:rgba(244,240,231,0.8);max-width:46ch;">Every Shakubuku is small and carefully curated — we build each group around the adventure and its demands across four dimensions: physical, mental, emotional, spiritual. The workouts are how you prepare, and how we come to know who you are. Stay with the path and you earn an invitation to apply. Or, if you already know you're ready — challenge it.</p>

        <!-- readiness track -->
        <div style="margin-top:52px;border:1px solid rgba(244,240,231,0.14);border-radius:16px;padding:34px 38px;background:rgba(244,240,231,0.02);">
          <div style="display:flex;align-items:flex-start;">
            {track.map((t) => (
              <div style="display:flex;align-items:center;flex:1;min-width:0;">
                <div style="display:flex;flex-direction:column;align-items:center;text-align:center;flex:1;min-width:0;">
                  <div style={`width:46px;height:46px;border-radius:999px;background:${t.dotBg};border:1px solid ${t.dotBorder};color:${t.dotColor};display:flex;align-items:center;justify-content:center;font-family:'Newsreader',serif;font-size:18px;margin-bottom:12px;`}>{t.num}</div>
                  <span style={`font-size:12.5px;font-weight:600;color:${t.labelColor};line-height:1.3;`}>{t.label}</span>
                </div>
                <div style={`height:1px;background:${t.lineColor};flex:0 0 22px;margin-top:-22px;`}></div>
              </div>
            ))}
          </div>
        </div>

        <!-- two doors -->
        <div class="bl-grid-collapse bl-grid-collapse--gap" style="margin-top:40px;display:grid;grid-template-columns:1fr 1fr;gap:24px;">
          <div style="background:rgba(244,240,231,0.04);border:1px solid rgba(244,240,231,0.14);border-radius:16px;padding:38px 36px;">
            <p style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;margin-bottom:16px;">Door 1 · Earn it</p>
            <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;line-height:1.15;margin-bottom:14px;color:#FBF8F1;">Start the workouts. Let your invitation come to you.</h3>
            <p style="font-size:16px;line-height:1.6;color:rgba(244,240,231,0.72);margin-bottom:24px;">Begin with Workout 01. Each rep builds your readiness across the four dimensions and shows us how you show up. Stay with it, and the invitation to apply is yours.</p>
            <a href={workoutPath('go-for-it')} style="display:inline-flex;align-items:center;gap:8px;background:#C04A26;color:#fff;padding:14px 24px;border-radius:10px;font-weight:700;font-size:15px;text-decoration:none;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Begin Workout 01 <span>&rarr;</span></a>
          </div>
          <div style="background:rgba(244,240,231,0.04);border:1px solid rgba(244,240,231,0.14);border-radius:16px;padding:38px 36px;">
            <p style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;margin-bottom:16px;">Door 2 · Challenge it</p>
            <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;line-height:1.15;margin-bottom:14px;color:#FBF8F1;">Already know you're ready? Don't wait. Make your case.</h3>
            <p style="font-size:16px;line-height:1.6;color:rgba(244,240,231,0.72);margin-bottom:24px;">Skip the line and apply now. Tell us who you are and why this is your moment. We curate carefully and we'll tell you straight — but we've never punished courage.</p>
            <a href={CTA_URL} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;background:transparent;border:1px solid rgba(244,240,231,0.4);color:#F4F0E7;padding:14px 24px;border-radius:10px;font-weight:700;font-size:15px;text-decoration:none;" onmouseover="this.style.borderColor='#F4F0E7'" onmouseout="this.style.borderColor='rgba(244,240,231,0.4)'">Challenge it — apply now <span>&rarr;</span></a>
          </div>
        </div>

        <!-- curation / four dimensions -->
        <div class="bl-grid-collapse bl-grid-collapse--gap" style="margin-top:40px;border-top:1px solid rgba(244,240,231,0.14);padding-top:44px;display:grid;grid-template-columns:0.85fr 1.15fr;gap:48px;align-items:center;">
          <div>
            <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:30px;line-height:1.14;margin-bottom:14px;color:#FBF8F1;">No two Shakubukus are the same.</h3>
            <p style="font-size:16px;line-height:1.65;color:rgba(244,240,231,0.72);">One might run emotional-high and spiritual-high in the backcountry; another is built for business owners with the intensity mostly within your control. Your workouts reveal your readiness — and we match you to the adventure you've earned.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:16px;">
            {dims.map((d) => (
              <div>
                <div style="display:flex;justify-content:space-between;font-size:13.5px;color:rgba(244,240,231,0.85);margin-bottom:7px;"><span style="font-weight:600;">{d.name}</span><span style="color:#8C8473;">{d.label}</span></div>
                <div style="height:7px;background:rgba(244,240,231,0.1);border-radius:999px;overflow:hidden;"><div style={`width:${d.pct};height:100%;background:#C04A26;`}></div></div>
              </div>
            ))}
            <p style="font-size:11.5px;letter-spacing:0.05em;color:#6E6757;margin-top:4px;text-transform:uppercase;">Example profile — a single Shakubuku's demands</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ WHAT SHAKUBUKU ACTUALLY IS ============ -->
    <section style="background:#F4F0E7;color:#1B1810;padding:112px 32px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">What Shakubuku actually is</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(30px,4.2vw,46px);line-height:1.08;letter-spacing:-0.015em;max-width:18ch;">A mystery adventure in the physical world — not a stage, not a slide deck.</h2>
        <p style="margin-top:22px;font-size:18px;line-height:1.65;color:#56524A;max-width:46ch;">Shakubuku means <em style="font-style:italic;">"to awaken a person to their inherent greatness."</em> It's spiritual — not religious — and emotional, lived through the body. You choose the start and end; the middle stays secret, so experience does the teaching.</p>
        <div class="bl-grid-collapse bl-grid-collapse--gap" style="margin-top:50px;display:grid;grid-template-columns:repeat(3,1fr);gap:36px;">
          <div style="border-top:2px solid #C04A26;padding-top:20px;">
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;margin-bottom:10px;">The route is a mystery</h3>
            <p style="font-size:16px;line-height:1.6;color:#56524A;">You pick the start and end point. Everything in between stays secret — because experience only teaches when you can't prepare for it.</p>
          </div>
          <div style="border-top:2px solid #C04A26;padding-top:20px;">
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;margin-bottom:10px;">The physical world does the work</h3>
            <p style="font-size:16px;line-height:1.6;color:#56524A;">Rubicon off-road, San Juan winter survival, Virgin Islands sailing, Utah canyoneering — each one unique. A spiritual and emotional journey made real through the body.</p>
          </div>
          <div style="border-top:2px solid #C04A26;padding-top:20px;">
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;margin-bottom:10px;">A small, curated group</h3>
            <p style="font-size:16px;line-height:1.6;color:#56524A;">By application, in small groups matched to each adventure's four-dimension intensity. All-inclusive from $15,000 per person, excluding travel.</p>
