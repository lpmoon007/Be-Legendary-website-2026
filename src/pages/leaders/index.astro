    <!-- ============ THE METHOD / IP ============ -->
    <section style="background:#F4F0E7;color:#1B1810;padding:112px 32px;">
      <div style="max-width:1180px;margin:0 auto;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">The method behind the shift</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(30px,4.2vw,46px);line-height:1.08;letter-spacing:-0.015em;max-width:18ch;color:#1B1810;">Everyone else hands you a competency model. We change you at the level of identity.</h2>
        <div class="bl-grid-collapse bl-grid-collapse--gap" style="margin-top:50px;display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(27,24,16,0.12);border:1px solid rgba(27,24,16,0.12);border-radius:16px;overflow:hidden;">
          <div style="background:#F4F0E7;padding:34px 30px;display:flex;flex-direction:column;">
