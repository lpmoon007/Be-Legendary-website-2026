            <a href={workoutPath('go-for-it')} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;box-shadow:0 14px 34px -14px rgba(192,74,38,0.7);" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Start your first workout <span>&rarr;</span></a>
            <a href={SLUGS.workouts} style="display:inline-flex;align-items:center;gap:7px;font-size:15px;font-weight:700;color:#C04A26;text-decoration:none;" onmouseover="this.querySelector('span').style.transform='translateX(4px)'" onmouseout="this.querySelector('span').style.transform='translateX(0)'">Browse all workouts <span style="transition:transform .2s;">&rarr;</span></a>
          </div>
          <p style="margin-top:16px;font-size:13px;color:#8A7F6C;">Workout library coming — video &amp; content in production.</p>
          <div style="margin-top:20px;padding-top:18px;border-top:1px solid rgba(27,24,16,0.12);display:flex;flex-wrap:wrap;gap:8px 22px;">
            <span style="font-size:12.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;">Read first</span>
            <a href={SLUGS.mindset} style="font-size:14.5px;font-weight:600;color:#C04A26;text-decoration:none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">The Mindset of a Legend &rarr;</a>
            <a href={SLUGS.legendaryIntent} style="font-size:14.5px;font-weight:600;color:#C04A26;text-decoration:none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">Define your Legendary Intent &rarr;</a>
