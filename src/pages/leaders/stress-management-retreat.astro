---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareRow from '../../components/ShareRow.astro';
import ArticleEndCTA from '../../components/ArticleEndCTA.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS } from '../../lib/site';

const path = SLUGS.stressManagementRetreat;
const title = 'Stress Management Retreats for Executives (Beyond the Spa)';
const description =
  "A stress management retreat for executives that treats the cause, not just the symptom. Why relaxation alone doesn't hold, and what actually does.";

const canonical = new URL(path, SITE_URL).href;

// Article + FAQPage — schema types preserved from the design, enriched with
// entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'Stress Management Retreats for Executives (Beyond the Spa)',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['stress management retreat', 'executive stress', 'executive recharge'],
    description:
      'Why executive stress needs a reset that reaches the mindset, not just relaxation, and how an immersion addresses the cause.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is a stress management retreat for executives?', acceptedAnswer: { '@type': 'Answer', text: "It's a dedicated reset for senior leaders carrying chronic stress. The effective ones go beyond spa relaxation: they address the source — the mindset, beliefs and pace driving the stress — so the relief lasts. Be Legendary's Shakubuku works a leader across four dimensions (physical, mental, emotional, spiritual) so they return genuinely reset, not just briefly rested." } },
      { '@type': 'Question', name: 'Does relaxation actually reduce executive stress long-term?', acceptedAnswer: { '@type': 'Answer', text: 'Temporarily. Relaxation lowers the symptom for a while but leaves the underlying drivers — the beliefs and standards generating the stress — untouched, so it returns. Durable stress reduction for leaders comes from changing how you relate to pressure, paired with real, deliberate recovery, practiced consistently.' } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Stress Management Retreats for Executives (Beyond the Spa)"
  ogDescription="Managing executive stress isn't about less. It's about the right stress, then real recovery."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;">
    <article>
      <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">Stress Management Retreat</span>
        </nav>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;max-width:20ch;">A stress management retreat that treats the cause, not the symptom.</h1>
        <div style="margin-top:28px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The short answer</p>
          <p class="bl-speakable" style="font-size:18px;line-height:1.6;color:#2E2A22;">A stress management retreat for executives is a reset for leaders carrying chronic pressure. The ones that <em style="font-style:italic;">last</em> go past spa relaxation and address the source — the beliefs, standards and pace generating the stress. Manage the cause, and the symptom stops coming back.</p>
        </div>
      </header>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="margin-bottom:22px;">Relaxation feels like the answer because stress feels like too much pressure. But for most senior leaders the stress isn't coming from the workload — it's coming from the <em style="font-style:italic;">standards</em> underneath it: the belief that it all rests on you, that slowing down is failing, that your worth is the output. A massage doesn't touch that. By Monday, it's back.</p>
          <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">You don't manage executive stress with less. You manage it by changing your relationship to pressure — then recovering for real.</p>
          <p>That's the counterintuitive part: the reset that works isn't more comfort, it's the right kind of challenge in a place that changes your perspective, paired with deliberate recovery. Do that and you come back with a different relationship to the thing that was crushing you.</p>
        </div>
      </section>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="background:#15130E;border-radius:16px;overflow:hidden;">
          <div style="height:220px;background-image:url('/assets/cs-alaska.webp');background-size:cover;background-position:center;"></div>
          <div style="padding:28px 30px;">
            <p style="font-family:'Newsreader',serif;font-weight:400;font-style:italic;font-size:22px;line-height:1.4;color:#FBF8F1;margin-bottom:14px;">"Roles disappear. All that matters is that we have to come together to survive."</p>
            <p style="font-size:13.5px;color:#8C8473;">— James Carter, on Shakubuku · <span style="color:#B7AE9C;">CNN Money: "where high-level executives go to recharge."</span></p>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;text-align:center;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">Start free, from your desk</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF8F1;max-width:24ch;margin:0 auto 16px;">Feel the shift in ten minutes.</h2>
          <p style="font-size:17px;line-height:1.6;color:rgba(244,240,231,0.78);max-width:48ch;margin:0 auto 28px;">One free Mindset Workout changes how you meet pressure today — a taste of what a full Shakubuku immersion goes deep on.</p>
          <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;">
            <a href={SLUGS.workouts} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">Try a Mindset Workout — free <span>&rarr;</span></a>
            <a href={`${SLUGS.leaders}#shakubuku`} style="border:1px solid rgba(244,240,231,0.3);color:#F4F0E7;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;">What is Shakubuku?</a>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:56px auto 0;padding:0 32px 90px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#1B1810;margin-bottom:28px;">Straight answers</h2>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Does relaxation reduce executive stress long-term?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Only temporarily. It lowers the symptom for a while but leaves the drivers — the beliefs and standards generating the stress — untouched, so it returns. Durable relief comes from changing how you relate to pressure, plus real recovery, practiced consistently.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Is this therapy?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">No. It's leadership development and personal growth, not clinical treatment. If you're dealing with a mental-health condition, work with a licensed professional — this complements that, it doesn't replace it.</p></div>
        </div>
      </section>
      <!-- internal-linking: keep-reading rail -->
      <section style="max-width:860px;margin:8px auto 0;padding:0 32px 76px;">
        <p style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Keep reading</p>
        <div style="display:grid;gap:12px;">
          <a href="/leaders/executive-burnout-retreat/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">The executive burnout retreat</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/wilderness-therapy-for-executives/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">Wilderness therapy for executives</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/where-executives-recharge/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">Where executives actually recharge</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
        </div>
      </section>
      <ArticleEndCTA maxWidth={820} />
      <ShareRow title={title} maxWidth={820} />
</article>
  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
