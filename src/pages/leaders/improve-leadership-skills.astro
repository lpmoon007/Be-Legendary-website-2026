---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareRow from '../../components/ShareRow.astro';
import ArticleEndCTA from '../../components/ArticleEndCTA.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS } from '../../lib/site';

const path = SLUGS.improveLeadershipSkills;
const title = 'How to Improve Your Leadership Skills (Start With Mindset)';
const description =
  "How to improve your leadership skills, honestly: you don't bolt skills onto the same mindset — you change the mindset underneath. Free Mindset Workouts.";

const canonical = new URL(path, SITE_URL).href;

// Article + FAQPage — schema types preserved from the design,
// enriched with entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'How to Improve Your Leadership Skills (It Starts With Mindset)',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['how to improve leadership skills', 'leadership development', 'executive mindset'],
    description:
      'Why improving leadership skills starts with mindset, and a free, workout-based way to build the leader underneath the skill set.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do you improve your leadership skills?', acceptedAnswer: { '@type': 'Answer', text: "Start with the mindset underneath the skills, not the skills themselves. Communication, decisiveness and presence are outputs of how you see yourself and the world — you can't outperform your current mindset. Improve that through small, consistent reps (apply stress, then recover), and the visible skills follow. Bolting techniques onto an unchanged mindset rarely sticks." } },
      { '@type': 'Question', name: 'What is the most important leadership skill?', acceptedAnswer: { '@type': 'Answer', text: "Self-awareness — the ability to see the beliefs and reactions running you on autopilot. Every other skill, from communication to decision-making, improves once you can catch and choose your own responses. It's the first of the ABCs: Awareness, Beliefs, Courage." } },
      { '@type': 'Question', name: 'Can leadership skills actually be developed?', acceptedAnswer: { '@type': 'Answer', text: "Yes — the same way physical strength is: deliberate, uncomfortable reps followed by real recovery, done consistently. Be Legendary's free Mindset Workouts are built on that model, training awareness, beliefs and courage a few minutes at a time." } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="How to Improve Your Leadership Skills (It Starts With Mindset)"
  ogDescription="You can't outperform your current mindset. Improve that, and the skills follow."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;">
    <article>
      <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">Improve Leadership Skills</span>
        </nav>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;max-width:22ch;">How to improve your leadership skills — the honest version.</h1>
        <div style="margin-top:28px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The short answer</p>
          <p class="bl-speakable" style="font-size:18px;line-height:1.6;color:#2E2A22;">You don't improve leadership by stacking techniques on top of the same mindset. Communication, decisiveness, presence — those are <em style="font-style:italic;">outputs</em> of how you see yourself and the world. Change the mindset underneath and the skills follow. You can't outperform your current mindset, so that's where the real work starts.</p>
        </div>
      </header>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">Why the courses don't stick</p>
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="margin-bottom:22px;">You've done the workshops. Read the books. Maybe you can even recite the frameworks. And yet under pressure you default to the same reactions — because a technique laid over an unchanged mindset is a veneer, and veneers crack exactly when it matters.</p>
          <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">Skills are what a leader does. Mindset is who a leader is. Train the second and the first takes care of itself.</p>
          <p>So the fastest way to better leadership skills isn't another course — it's building the leader underneath them. And that's built like any strength: small, deliberate reps that stretch you, followed by real recovery, done consistently.</p>
        </div>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.12;color:#1B1810;margin-bottom:20px;">Start with the ABCs.</h2>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;">
          <div style="background:#15130E;color:#F4F0E7;border-radius:14px;padding:24px 24px;"><span style="font-family:'Newsreader',serif;font-size:30px;color:#E0744A;">A</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:19px;margin:8px 0;color:#FBF8F1;">Awareness</h3><p style="font-size:14.5px;line-height:1.55;color:rgba(244,240,231,0.75);">See the beliefs and reactions running you on autopilot. Every other skill improves once you can catch your own.</p></div>
          <div style="background:#15130E;color:#F4F0E7;border-radius:14px;padding:24px 24px;"><span style="font-family:'Newsreader',serif;font-size:30px;color:#E0744A;">B</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:19px;margin:8px 0;color:#FBF8F1;">Beliefs</h3><p style="font-size:14.5px;line-height:1.55;color:rgba(244,240,231,0.75);">Rewrite the ones quietly limiting you — the code you never actually chose.</p></div>
          <div style="background:#15130E;color:#F4F0E7;border-radius:14px;padding:24px 24px;"><span style="font-family:'Newsreader',serif;font-size:30px;color:#E0744A;">C</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:19px;margin:8px 0;color:#FBF8F1;">Courage</h3><p style="font-size:14.5px;line-height:1.55;color:rgba(244,240,231,0.75);">Act on it when it counts. Awareness and belief mean nothing without the rep.</p></div>
        </div>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;text-align:center;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">The gym is free</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF8F1;max-width:24ch;margin:0 auto 16px;">Stop reading about leadership. Take one rep.</h2>
          <p style="font-size:17px;line-height:1.6;color:rgba(244,240,231,0.78);max-width:48ch;margin:0 auto 28px;">Be Legendary's Mindset Workouts train the ABCs a few minutes at a time — free, no course to buy. Do one today and you've already started improving the thing under every skill.</p>
          <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;">
            <a href={SLUGS.workouts} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">Enter the gym — free <span>&rarr;</span></a>
            <a href={SLUGS.legendsJourney} style="border:1px solid rgba(244,240,231,0.3);color:#F4F0E7;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;">Find where you are</a>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:56px auto 0;padding:0 32px 20px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#1B1810;margin-bottom:28px;">Straight answers</h2>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">What's the most important leadership skill?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Self-awareness. The ability to catch the beliefs and reactions running you on autopilot is the one that unlocks all the others — communication, decisiveness, presence. It's the first of the ABCs.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Can leadership actually be developed, or are you born with it?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Developed — the same way strength is: deliberate, uncomfortable reps, real recovery, done consistently. Nobody is born decisive under fire; they train it.</p></div>
        </div>
      </section>
      <!-- internal-linking: keep-reading rail -->
      <section style="max-width:860px;margin:8px auto 0;padding:0 32px 76px;">
        <p style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Keep reading</p>
        <div style="display:grid;gap:12px;">
          <a href="/leaders/leadership-qualities/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">The qualities that define strong leaders</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/what-makes-a-good-leader/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">What makes a good leader</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/what-is-leadership/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">What is leadership, really?</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
        </div>
      </section>
      <ArticleEndCTA maxWidth={820} />
      <ShareRow title={title} maxWidth={820} />
</article>
  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
