---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS } from '../../lib/site';

const path = SLUGS.leadVsLag;
const title = 'Lead vs Lag Measures: Track What You Control | Be Legendary';
const description =
  'A lag measure is the outcome you want; a lead measure is the daily input you control that drives it. The difference, examples, and why leaders who track lead measures actually move the number. From Be Legendary.';

const canonical = new URL(path, SITE_URL).href;

// Article + DefinedTerm + FAQPage — schema types preserved from the design,
// enriched with entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'Lead vs Lag Measures: Track What You Control',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['lead measures', 'lag measures', 'performance metrics'],
    description:
      'The difference between lead and lag measures, examples, and why tracking lead measures moves the outcome.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'DefinedTerm',
    '@id': `${canonical}#term`,
    name: 'Lead measure',
    description:
      "A lead measure is a daily input you directly control that predicts and drives a desired outcome. Unlike a lag measure, which reports a result after the fact, a lead measure is both predictive and influenceable, making it the thing worth tracking day to day.",
    inDefinedTermSet: 'Be Legendary',
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is the difference between a lead and a lag measure?', acceptedAnswer: { '@type': 'Answer', text: "A lag measure is the outcome you ultimately want — revenue, weight lost, a promotion — and you only see it after the fact, when it's too late to change. A lead measure is a daily input you directly control that drives that outcome, like calls made, workouts done, or reps completed. Lag measures tell you where you ended up; lead measures are the levers you can actually pull today." } },
      { '@type': 'Question', name: 'Why should I track lead measures instead of outcomes?', acceptedAnswer: { '@type': 'Answer', text: "Because you can't do an outcome — you can only do the inputs that produce it. Staring at the outcome creates anxiety without direction; tracking the lead measure gives you a clear, controllable action every day. Move the lead measure consistently and the lag measure follows." } },
      { '@type': 'Question', name: 'What is an example of a lead measure for a personal habit?', acceptedAnswer: { '@type': 'Answer', text: "If the outcome (lag) is 'get healthier,' a lead measure is 'do one squat when I brush my teeth' or 'walk after lunch.' You control it fully, you can check it off the same day, and doing it repeatedly bends the outcome. That is exactly what a 30-day behavior challenge tracks." } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Lead vs Lag Measures: Track What You Control"
  ogDescription="The outcome is a lag measure. The daily input you control is the lead measure. Track the one you can govern."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;">
    <article>
      <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">Lead vs Lag Measures</span>
        </nav>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;max-width:20ch;">Lead vs lag measures</h1>
        <div style="margin-top:28px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The short answer</p>
          <p style="font-size:18px;line-height:1.6;color:#2E2A22;">A <strong style="font-weight:700;">lag measure</strong> is the outcome you want — revenue, weight lost, the promotion — visible only after the fact. A <strong style="font-weight:700;">lead measure</strong> is a daily input you directly control that drives that outcome. You can't <em style="font-style:italic;">do</em> an outcome; you can only do the inputs. So track the lead measure — the lever you can pull today.</p>
        </div>
      </header>

      <section style="max-width:820px;margin:48px auto 0;padding:0 32px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div style="background:#F4F0E7;border-radius:16px;padding:28px 30px;">
            <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:12px;">Lag measure</p>
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#1B1810;margin-bottom:12px;">The result</h3>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;font-size:15.5px;line-height:1.5;color:#56524A;">
              <li>Reports what already happened</li>
              <li>You can't change it directly</li>
              <li>Slow to move, easy to obsess over</li>
              <li><em style="font-style:italic;">"Lose 15 pounds." "Hit $2M." "Get promoted."</em></li>
            </ul>
          </div>
          <div style="background:#15130E;border-radius:16px;padding:28px 30px;">
            <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">Lead measure</p>
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#FBF8F1;margin-bottom:12px;">The input</h3>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">
              <li>Predicts the outcome</li>
              <li>You control it, 100%</li>
              <li>Checkable today, every day</li>
              <li style="color:#F4F0E7;"><em style="font-style:italic;">"One squat at the sink." "Five calls." "One rep."</em></li>
            </ul>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:48px auto 0;padding:0 32px;">
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="margin-bottom:22px;">Two things make a measure a true lead measure: it's <strong>predictive</strong> (moving it moves the outcome) and it's <strong>influenceable</strong> (you can act on it directly). The outcome fails both tests day to day — which is why staring at it produces anxiety, not progress. The input passes both, which is why it produces momentum.</p>
          <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">You never have a bad day at the number you control. You just have the rep, or you don't — and over thirty days, the reps write the outcome for you.</p>
          <p>This is the same logic that runs underneath our executive-team work, where the <a href={SLUGS.flagModel} style="color:#C04A26;text-decoration:underline;">Flag Model</a> holds teams to the disciplines they control rather than the results they can only hope for. Lead measures scale from one person and one squat all the way up to a leadership team and its rhythm.</p>
        </div>
      </section>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;text-align:center;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">Pick one lead measure — free</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF8F1;max-width:26ch;margin:0 auto 16px;">Run one input for thirty days and watch the outcome bend.</h2>
          <p style="font-size:17px;line-height:1.6;color:rgba(244,240,231,0.78);max-width:48ch;margin:0 auto 28px;">The 30-Day Challenge is built on exactly this: choose a single lead measure you fully control, and we track the input with you — one text a day.</p>
          <a href={SLUGS.challenge} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">Start your 30-day challenge <span>&rarr;</span></a>
        </div>
      </section>

      <section style="max-width:820px;margin:56px auto 0;padding:0 32px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#1B1810;margin-bottom:28px;">Straight answers</h2>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Why track lead measures instead of the outcome?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Because you can't <em style="font-style:italic;">do</em> an outcome — only the inputs that produce it. The outcome creates pressure without direction; the lead measure gives you a clear, controllable action today. Move it consistently and the result follows.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">What's a personal example?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">If the lag is "get healthier," a lead measure is "one squat when I brush my teeth." You control it fully, check it off the same day, and repeating it bends the outcome. See <a href={SLUGS.habitStacking} style="color:#C04A26;text-decoration:underline;">habit stacking</a> for how to anchor it.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Do lag measures still matter?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Yes — they're how you know if you're aimed right. Check the lag occasionally to confirm the lead measure is the correct lever; act on the lead measure daily. Direction from the lag, action from the lead.</p></div>
        </div>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px 20px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Keep going</p>
        <div class="bl-cards-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
          <a href={SLUGS.howToBuildHabit} style="text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:22px 22px;display:block;"><span style="display:block;font-family:'Newsreader',serif;font-size:19px;color:#1B1810;margin-bottom:6px;">How to build a habit that sticks</span><span style="display:block;font-size:14px;line-height:1.5;color:#6B6358;">Measure the input, not the outcome.</span></a>
          <a href={SLUGS.implementationIntentions} style="text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:22px 22px;display:block;"><span style="display:block;font-family:'Newsreader',serif;font-size:19px;color:#1B1810;margin-bottom:6px;">Implementation intentions</span><span style="display:block;font-size:14px;line-height:1.5;color:#6B6358;">Pre-decide the input you'll run.</span></a>
          <a href={SLUGS.flagModel} style="text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:22px 22px;display:block;"><span style="display:block;font-family:'Newsreader',serif;font-size:19px;color:#1B1810;margin-bottom:6px;">The Flag Model</span><span style="display:block;font-size:14px;line-height:1.5;color:#6B6358;">Lead measures for a whole leadership team.</span></a>
        </div>
      </section>
    </article>
  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
