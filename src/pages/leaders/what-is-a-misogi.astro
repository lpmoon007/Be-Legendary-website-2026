---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareRow from '../../components/ShareRow.astro';
import ArticleEndCTA from '../../components/ArticleEndCTA.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../lib/site';

const path = SLUGS.whatIsMisogi;
const title = 'What Is a Misogi? The Challenge That Changes Your Year';
const description =
  'A misogi is one hard challenge a year with a real chance of failure — done for who it makes you, not for show. The rules, and how to design your own.';

const canonical = new URL(path, SITE_URL).href;

// Article + DefinedTerm + FAQPage — schema types preserved from the design,
// enriched with entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'What Is a Misogi? The Challenge That Changes Your Year',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['misogi', 'misogi challenge', 'personal challenge'],
    description:
      'What a misogi is, the rules that define it, ideas for designing one, and how leaders use an annual misogi to grow.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'DefinedTerm',
    '@id': `${canonical}#term`,
    name: 'Misogi',
    description:
      "A misogi is one deliberately hard challenge undertaken once a year, designed with a roughly 50% chance of failure, done privately for the growth it produces rather than for recognition. Adapted from a Japanese Shinto purification ritual into a modern practice for building courage and identity.",
    inDefinedTermSet: 'Be Legendary',
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is a misogi?', acceptedAnswer: { '@type': 'Answer', text: "A misogi is one deliberately hard challenge you take on once a year, designed so you have roughly a 50% chance of failing. It's done privately — for who it makes you, not for anyone watching. The term comes from a Japanese Shinto purification ritual and has been adapted into a modern practice for building courage, resilience and a bigger sense of self." } },
      { '@type': 'Question', name: 'What are the rules of a misogi?', acceptedAnswer: { '@type': 'Answer', text: "Three rules. First, it should be hard enough that you have about a 50% chance of failure — if success is guaranteed, it isn't a misogi. Second, don't die (and don't get hurt) — the risk is to your comfort and ego, not your body. Third, no audience — you do it for the internal change, not for a story or a post. One misogi per year is the traditional cadence." } },
      { '@type': 'Question', name: 'What are some misogi ideas?', acceptedAnswer: { '@type': 'Answer', text: "A misogi is personal, but examples include: rucking or hiking a distance far beyond your training, a long cold-water swim, a multi-day solo in the wilderness, learning and performing something publicly that terrifies you, or a demanding physical feat like a 30-plus mile day. The best misogi is one only you would find genuinely daunting — it should scare you, not just tire you." } },
      { '@type': 'Question', name: 'Where does the word misogi come from?', acceptedAnswer: { '@type': 'Answer', text: "Misogi (禊) is a Japanese Shinto practice of ritual purification, traditionally by standing under a cold waterfall or in cold water. The modern personal-challenge version keeps the spirit — a deliberate, cleansing ordeal that resets who you are — while applying it to a once-a-year test of your own design." } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="What Is a Misogi? The Challenge That Changes Your Year"
  ogDescription="One hard thing, once a year, ~50% chance you fail. Here's how to design yours."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;">
    <article>
      <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">What Is a Misogi</span>
        </nav>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;max-width:18ch;">What is a misogi?</h1>
        <div style="margin-top:28px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The short answer</p>
          <p style="font-size:18px;line-height:1.6;color:#2E2A22;">A misogi is <strong style="font-weight:700;">one deliberately hard challenge you take on once a year</strong>, designed with roughly a 50% chance of failure, done privately — for who it makes you, not for anyone watching. The word comes from a Japanese purification ritual; the modern practice keeps the spirit: a cleansing ordeal that resets who you are.</p>
        </div>
      </header>

      <!-- THE THREE RULES -->
      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">The three rules</p>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <div style="display:flex;gap:18px;align-items:flex-start;background:#15130E;color:#F4F0E7;border-radius:14px;padding:24px 26px;"><span style="font-family:'Newsreader',serif;font-size:28px;color:#E0744A;flex:none;line-height:1.1;">1</span><div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:5px;">~50% chance you fail</h3><p style="font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.78);">If success is guaranteed, it isn't a misogi. It has to be genuinely uncertain — hard enough that you might not make it.</p></div></div>
          <div style="display:flex;gap:18px;align-items:flex-start;background:#15130E;color:#F4F0E7;border-radius:14px;padding:24px 26px;"><span style="font-family:'Newsreader',serif;font-size:28px;color:#E0744A;flex:none;line-height:1.1;">2</span><div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:5px;">Don't die</h3><p style="font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.78);">The risk is to your comfort and ego — not your body. Design it to be daunting, not dangerous.</p></div></div>
          <div style="display:flex;gap:18px;align-items:flex-start;background:#15130E;color:#F4F0E7;border-radius:14px;padding:24px 26px;"><span style="font-family:'Newsreader',serif;font-size:28px;color:#E0744A;flex:none;line-height:1.1;">3</span><div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:5px;">No audience</h3><p style="font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.78);">You do it for the internal change, not the story or the post. One misogi per year is the traditional cadence.</p></div></div>
        </div>
      </section>

      <!-- WHY IT WORKS -->
      <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="margin-bottom:22px;">The point of a misogi isn't the feat. It's what carries into the other 364 days. When you've done one genuinely hard thing you weren't sure you could, the everyday challenges — the hard conversation, the big bet, the honest look in the mirror — shrink to their real size.</p>
          <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">You spend one day proving what you're capable of, so you spend the rest of the year living like someone who knows.</p>
        </div>
      </section>

      <!-- SOFT CTA → design your misogi workout -->
      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;text-align:center;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">Design yours — free</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF8F1;max-width:24ch;margin:0 auto 16px;">Ready to design your own misogi?</h2>
          <p style="font-size:17px;line-height:1.6;color:rgba(244,240,231,0.78);max-width:48ch;margin:0 auto 28px;">Our free guided workout walks you through choosing a misogi that's hard, safe, and truly yours — in about ten minutes.</p>
          <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;">
            <a href={workoutPath('design-your-misogi')} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">Design your misogi <span>&rarr;</span></a>
            <a href={`${SLUGS.leaders}#shakubuku`} style="border:1px solid rgba(244,240,231,0.3);color:#F4F0E7;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;">The ultimate misogi: Shakubuku</a>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section style="max-width:820px;margin:56px auto 0;padding:0 32px 90px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#1B1810;margin-bottom:28px;">Straight answers</h2>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">What are some misogi ideas?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">It's personal, but examples: rucking far past your training, a long cold-water swim, a multi-day solo in the wilderness, publicly performing something that terrifies you, or a 30+ mile day. The best one is what <em style="font-style:italic;">only you</em> would find daunting — it should scare you, not just tire you.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Where does the word come from?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Misogi (禊) is a Japanese Shinto purification practice, traditionally standing under a cold waterfall. The modern version keeps the spirit — a deliberate, cleansing ordeal that resets who you are — applied as a once-a-year test of your own design.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">How is a misogi different from a New Year's resolution?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">A resolution is a habit you hope to sustain. A misogi is a single, defining ordeal with a real chance of failure. One reshapes your routine; the other reshapes your self-image in a day.</p></div>
        </div>
      </section>
      <ArticleEndCTA maxWidth={820} />
      <ShareRow title={title} maxWidth={820} />
</article>
  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
