---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { Image } from 'astro:assets';
import shakubukuField from '../../assets/shakubuku-field.jpg';
import { SITE_URL, ORG_ID, SLUGS } from '../../lib/site';

const path = SLUGS.legendaryLeader;
const title = 'The Legendary Leader — The Individual Executive Retreat';
const description =
  'The Legendary Leader is the one retreat built for a single executive, not a team — a Shakubuku run by our sister brand Legendary Retreats, across four dimensions: body, mind, heart and spirit. By invitation.';

const canonical = new URL(path, SITE_URL).href;

// The retreat is run by the sister brand, so applying goes to Legendary Retreats.
const RETREAT_APPLY = 'https://www.legendary-retreats.com/luxury-executive-retreat/';

// JSON-LD: the design's Service + FAQPage, enriched so the org/founder graph
// resolves by @id (provider → ORG_ID).
const schema = [
  {
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: 'The Legendary Leader',
    provider: { '@id': ORG_ID },
    serviceType: 'Individual executive retreat',
    description:
      'An individual executive retreat for a single leader — a Shakubuku, the multi-day adventure immersion run by sister brand Legendary Retreats, working the leader across four dimensions: body, mind, heart and spirit. By invitation.',
    offers: { '@type': 'Offer', availability: 'https://schema.org/LimitedAvailability', url: `${SITE_URL}/leaders/the-legendary-leader/` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is The Legendary Leader program?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "It is the one retreat built for a single executive, not a team: a Shakubuku — the multi-day adventure immersion run by Be Legendary's sister brand, Legendary Retreats — that works you across all four dimensions at once, physical, mental, emotional and spiritual. It's for the leader who wants to be changed as a whole person, not taught a single skill. By invitation.",
        },
      },
      {
        '@type': 'Question',
        name: 'Why all four dimensions?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Because a leader is not one dimension. Most development touches only the mind. The retreat works the body, mind, heart and spirit at once, so the change reaches the whole person and holds across your life rather than fading like a workshop.',
        },
      },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="website"
  ogTitle="The Legendary Leader — the individual executive retreat"
  ogDescription="The one retreat built for a single leader — a Shakubuku run by Legendary Retreats, across all four dimensions."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="full"
    logoHref={SLUGS.leaders}
    cta={{ label: 'Request an invitation', href: RETREAT_APPLY, external: true }}
  />

  <div style="background:#EFE8DA;color:#1B1810;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <!-- HERO -->
    <section style="position:relative;max-width:1080px;margin:0 auto;padding:72px 32px 0;">
      <div style="position:absolute;top:-60px;right:-140px;width:520px;height:520px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">The Legendary Leader</span>
      </nav>
      <p style="display:inline-flex;align-items:center;gap:9px;font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:24px;"><span style="width:7px;height:7px;border-radius:50%;background:#C04A26;"></span>The individual retreat · by invitation</p>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(40px,5.6vw,70px);line-height:1.0;letter-spacing:-0.022em;color:#1B1810;max-width:15ch;">One leader. One retreat. <span style="font-style:italic;color:#C04A26;">The whole you.</span></h1>
      <p style="margin-top:24px;font-size:19px;line-height:1.6;color:#2E2A22;max-width:50ch;">Everything else develops a part of you. The Legendary Leader is the one retreat we build for a single executive, not a team — a <a href="https://www.legendary-retreats.com/" target="_blank" rel="noopener" style="color:#C04A26;text-decoration:underline;">Shakubuku</a>, the adventure immersion run by our sister brand, Legendary Retreats, that changes all of you at once: body, mind, heart and spirit.</p>
      <div style="margin-top:32px;display:flex;align-items:center;gap:18px;flex-wrap:wrap;">
        <a href={RETREAT_APPLY} target="_blank" rel="noopener" style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;box-shadow:0 14px 40px -12px rgba(192,74,38,0.6);" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Request an invitation <span>&rarr;</span></a>
        <a href="#four" style="color:#C04A26;text-decoration:none;font-weight:700;font-size:15px;">The four dimensions &darr;</a>
      </div>
    </section>

    <!-- FOUR DIMENSIONS -->
    <section id="four" style="max-width:1080px;margin:80px auto 0;padding:0 32px;">
      <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">One leader, four dimensions</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.8vw,42px);line-height:1.08;color:#1B1810;max-width:20ch;">A leader is not one dimension. Why develop like they are?</h2>
      <p style="margin-top:18px;font-size:17.5px;line-height:1.65;color:#56524A;max-width:56ch;">Most programs work on the mind and leave the rest to chance. This retreat works all four at once — and growth in one dimension reinforces the others, so the change holds across your whole life, not just a weekend.</p>
      <div style="margin-top:44px;display:grid;grid-template-columns:repeat(2,1fr);gap:16px;">
        <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:16px;padding:30px 32px;"><p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Physical</p><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:24px;color:#1B1810;margin-bottom:10px;">The body that carries it all</h3><p style="font-size:15.5px;line-height:1.6;color:#56524A;">Energy, resilience, presence. The vehicle every other kind of strength runs on — trained, not neglected.</p></div>
        <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:16px;padding:30px 32px;"><p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Mental</p><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:24px;color:#1B1810;margin-bottom:10px;">The mind that decides</h3><p style="font-size:15.5px;line-height:1.6;color:#56524A;">Clarity, focus, the beliefs you lead from. You can't outperform your current mindset — so we change it.</p></div>
        <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:16px;padding:30px 32px;"><p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Emotional</p><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:24px;color:#1B1810;margin-bottom:10px;">The heart that connects</h3><p style="font-size:15.5px;line-height:1.6;color:#56524A;">Emotional strength — the great equalizer. Steadiness under stress, and the courage to be seen.</p></div>
        <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:16px;padding:30px 32px;"><p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Spiritual</p><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:24px;color:#1B1810;margin-bottom:10px;">The meaning that pulls you</h3><p style="font-size:15.5px;line-height:1.6;color:#56524A;">Purpose beyond the title — spiritual, not religious. The reason the whole climb is worth it.</p></div>
      </div>
    </section>

    <!-- THE RETREAT IS A SHAKUBUKU -->
    <section style="max-width:1080px;margin:80px auto 0;padding:0 32px;">
      <div style="border-radius:20px;overflow:hidden;position:relative;min-height:340px;">
        <Image src={shakubukuField} alt="The San Juan Mountains, a Shakubuku setting" width={2049} height={1536} format="webp" quality={82} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
        <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(21,19,14,0.9) 30%,rgba(21,19,14,0.35));"></div>
        <div style="position:relative;padding:48px 46px;max-width:34ch;">
          <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#E0744A;margin-bottom:16px;">The retreat itself</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,38px);line-height:1.12;color:#FBF8F1;margin-bottom:16px;">It is a Shakubuku.</h2>
          <p style="font-size:16.5px;line-height:1.65;color:rgba(244,240,231,0.85);">The retreat is a single invite-only adventure immersion — Shakubuku, run by our sister brand, <a href="https://www.legendary-retreats.com/" target="_blank" rel="noopener" style="color:#F4F0E7;text-decoration:underline;">Legendary Retreats</a> — the experience that changes you in the physical world. It's the one retreat we build for a single leader rather than a team: the route a mystery, the stakes real, the shift made permanent.</p>
          <a href={SLUGS.whatIsShakubuku} style="margin-top:22px;display:inline-flex;align-items:center;gap:8px;color:#F4F0E7;font-weight:700;font-size:15px;text-decoration:none;">What is Shakubuku? <span>&rarr;</span></a>
        </div>
      </div>
    </section>

    <!-- INVESTMENT + CTA -->
    <section style="max-width:1080px;margin:64px auto 0;padding:0 32px 90px;">
      <div class="bl-grid-collapse" style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:20px;padding:44px 46px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;">
        <div>
          <p style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#8A7F6C;margin-bottom:6px;">Investment</p>
          <p style="font-family:'Newsreader',serif;font-size:40px;color:#1B1810;line-height:1;">By application</p>
          <p style="margin-top:14px;font-size:16px;line-height:1.6;color:#56524A;max-width:36ch;">One leader, one Shakubuku — the only retreat we run for an individual, not a team. By invitation: a short conversation tells us both whether this is your moment, and the investment is discussed on acceptance.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <a href={RETREAT_APPLY} target="_blank" rel="noopener" style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:700;font-size:16px;text-align:center;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Request an invitation</a>
          <a href={`${SLUGS.leaders}#climb`} style="border:1px solid rgba(27,24,16,0.26);color:#1B1810;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;text-align:center;">See the whole climb</a>
        </div>
      </div>
    </section>

  </div>

  <SiteFooter audience="leaders" variant="full" />
</BaseLayout>
