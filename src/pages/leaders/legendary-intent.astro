---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SLUGS, PERSON_ID, ORG_ID } from '../../lib/site';

const title = 'Legendary Intent: Your One-Line Leadership Filter';
const description = "Your Legendary Intent is a single sentence that declares how you'll make a difference — the filter through which you see every opportunity. Write yours.";

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'For Leaders', item: 'https://www.belegendary.org/leaders/' },
    { '@type': 'ListItem', position: 3, name: 'Legendary Intent', item: 'https://www.belegendary.org/leaders/legendary-intent/' },
  ] },
  { '@type': 'Article', headline: 'Legendary Intent: your one-line leadership filter', datePublished: '2026-06-27', dateModified: '2026-06-27', author: { '@id': PERSON_ID }, publisher: { '@id': ORG_ID }, mainEntityOfPage: 'https://www.belegendary.org/leaders/legendary-intent/', description: "A single sentence, modeled on the military's Commander's Intent, that declares how you will make a difference and filters every opportunity." },
  { '@type': 'HowTo', name: 'How to write your Legendary Intent', description: 'A short exercise to distill your core belief into a single guiding sentence.', step: [
    { '@type': 'HowToStep', position: 1, name: 'List your beliefs', text: 'Write down what you believe matters most — as many as come to mind.' },
    { '@type': 'HowToStep', position: 2, name: 'Cut to the core', text: 'Cross off 25% of the list. Then 25% of what remains. Then 25% again, until one to three beliefs are left.' },
    { '@type': 'HowToStep', position: 3, name: 'Choose one', text: 'From your gut, select the single most important belief.' },
    { '@type': 'HowToStep', position: 4, name: 'Complete the sentence', text: "Finish: 'If I accomplish nothing else in this life, I will ___.' That sentence is your Legendary Intent." },
  ] },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'What is a Legendary Intent?', acceptedAnswer: { '@type': 'Answer', text: "A Legendary Intent is a single sentence that declares how you will make a difference in the world. Modeled on the military concept of Commander's Intent, it acts as a filter — a set of goggles through which you view every situation — so you consistently notice and act on the opportunities that matter most to you." } },
    { '@type': 'Question', name: 'How do I write my Legendary Intent?', acceptedAnswer: { '@type': 'Answer', text: "List your beliefs, then repeatedly cut the list by about a quarter until one to three remain, and choose the single most important. Then complete the sentence: 'If I accomplish nothing else in this life, I will ___.' Refine it over time; it rarely comes out perfect on the first try." } },
  ] },
  { '@type': 'VideoObject', name: 'Legendary Intent — short version', description: 'James Carter introduces Legendary Intent: a single sentence, modeled on Commander’s Intent, that filters every opportunity.', thumbnailUrl: 'https://www.belegendary.org/assets/james.jpg', uploadDate: '2019', embedUrl: 'https://player.vimeo.com/video/313070575', contentUrl: 'https://vimeo.com/313070575', author: { '@id': PERSON_ID }, publisher: { '@id': ORG_ID } },
  { '@type': 'VideoObject', name: 'Legendary Intent — full walkthrough', description: 'James Carter walks through how to write your Legendary Intent, step by step.', thumbnailUrl: 'https://www.belegendary.org/assets/james.jpg', uploadDate: '2019', embedUrl: 'https://player.vimeo.com/video/313486697', contentUrl: 'https://vimeo.com/313486697', author: { '@id': PERSON_ID }, publisher: { '@id': ORG_ID } },
];
---
<BaseLayout
  title={title}
  description={description}
  path={SLUGS.legendaryIntent}
  ogType="article"
  ogTitle="Legendary Intent — your one-line leadership filter"
  ogDescription="A single sentence that declares how you'll make a difference, and filters every opportunity through it."
  schema={schema}
>
  <SiteHeader audience="leaders" variant="slim" logoHref={SLUGS.leaders} contextLink={{label:'The Legendary Leader →', href: SLUGS.legendaryLeader}} />

  <article>
  <header style="position:relative;max-width:880px;margin:0 auto;padding:80px 32px 36px;">
    <div style="position:absolute;top:-100px;right:-160px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.library} style="color:inherit;text-decoration:none;">The Library</a><span>/</span><span style="color:#D98A5E;">Legendary Intent</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">The tool</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(34px,5.2vw,60px);line-height:1.03;letter-spacing:-0.02em;color:#FBF8F1;">Your Legendary Intent</h1>
    <p style="margin-top:18px;font-size:14px;color:rgba(244,240,231,0.55);">By <a href={SLUGS.about} style="color:#D98A5E;text-decoration:none;">James Carter</a> &middot; Updated June 2026</p>
    <div style="margin-top:30px;background:#211D15;border:1px solid rgba(192,74,38,0.35);border-left:3px solid #C04A26;border-radius:14px;padding:26px 28px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The short version</p>
      <p style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:#FBF8F1;">Your <strong style="color:#FBF8F1;">Legendary Intent</strong> is one sentence that declares how you'll make a difference. Borrowed from the military's <em style="font-style:italic;">Commander's Intent</em>, it becomes a filter &mdash; goggles you wear through every day &mdash; so the opportunities that match your deepest belief stop slipping past you. It's how the <a href={SLUGS.mindset} style="color:#E0744A;text-decoration:underline;">mindset</a> gets a steering wheel.</p>
    </div>
  </header>

  <!-- VIDEO: short -->
  <div style="max-width:880px;margin:0 auto;padding:8px 32px 8px;">
    <div style="aspect-ratio:16/9;border-radius:16px;overflow:hidden;border:1px solid rgba(244,240,231,0.12);background:#000;">
      <iframe src="https://player.vimeo.com/video/313070575?title=0&byline=0&portrait=0" loading="lazy" style="width:100%;height:100%;border:0;display:block;" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="Legendary Intent — short version"></iframe>
    </div>
    <p style="margin-top:12px;font-size:14px;color:rgba(244,240,231,0.55);">The two-minute version. Prefer the full walkthrough? <a href="#long-version" style="color:#E0744A;text-decoration:underline;">It's further down.</a></p>
  </div>

  <div style="max-width:880px;margin:0 auto;padding:36px 32px 8px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.1;color:#FBF8F1;">Borrowed from the battlefield</h2>
    <p style="margin-top:16px;font-size:18.5px;line-height:1.72;color:rgba(244,240,231,0.84);">The military runs on a concept called <strong style="color:#FBF8F1;">Commander's Intent</strong>: a plain statement of the mission's purpose, so that when the plan falls apart &mdash; and it always does &mdash; every soldier still knows what success looks like and can act without waiting for orders. It's the one thing that survives contact with reality.</p>
    <p style="margin-top:18px;font-size:18.5px;line-height:1.72;color:rgba(244,240,231,0.84);">Your life needs the same thing. A <strong style="color:#FBF8F1;">Legendary Intent</strong> is your personal version: a single sentence that says how you intend to make a difference, clear enough to guide you when the day gets noisy and the plan goes sideways.</p>

    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.1;color:#FBF8F1;margin:44px 0 16px;">Why one sentence changes what you see</h2>
    <p style="font-size:18.5px;line-height:1.72;color:rgba(244,240,231,0.84);">Remember the moon-walking bear &mdash; how focus makes us miss what's right in front of us? Your Legendary Intent flips that mechanism in your favor. It creates a deliberate <em style="font-style:italic;">selective attention</em> around your core belief: a semi-permanent filter, like goggles, that makes the opportunities matching your intent suddenly impossible to miss. You don't try harder to notice. You change what you're tuned to.</p>

    <!-- THE EXERCISE -->
    <div style="margin:40px 0 0;background:#211D15;border:1px solid rgba(244,240,231,0.12);border-radius:18px;padding:34px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:16px;">The exercise &middot; ~5 minutes</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(22px,2.8vw,30px);line-height:1.1;color:#FBF8F1;">How to write yours</h2>
      <ol style="margin:18px 0 0;padding-left:22px;display:flex;flex-direction:column;gap:14px;font-size:17px;line-height:1.6;color:rgba(244,240,231,0.84);">
        <li><strong style="color:#FBF8F1;">List your beliefs.</strong> On paper, write what you believe matters most. Don't edit &mdash; just get them down.</li>
        <li><strong style="color:#FBF8F1;">Cut to the core.</strong> Cross off 25% of the list. Then 25% of what's left. Then 25% again &mdash; until one to three beliefs remain.</li>
        <li><strong style="color:#FBF8F1;">Choose one.</strong> From your gut, pick the single most important belief standing.</li>
        <li><strong style="color:#FBF8F1;">Complete the sentence.</strong> Finish this, out loud: <em style="font-style:italic;">&ldquo;If I accomplish nothing else in this life, I will ___.&rdquo;</em> One rule: <strong style="color:#FBF8F1;">it can't be about your family or friends.</strong> That's the easy answer, and you're more complicated than that &mdash; this is about the difference only <em style="font-style:italic;">you</em> are here to make.</li>
      </ol>
      <p style="margin-top:18px;font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.7);">It won't be perfect the first time &mdash; mine wasn't. This is a declaration of how you'll make a difference; give it the time it deserves and refine it over weeks, not minutes.</p>
    </div>

    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.1;color:#FBF8F1;margin:44px 0 16px;">What it looks like in the wild</h2>
    <p style="font-size:18.5px;line-height:1.72;color:rgba(244,240,231,0.84);">An executive I worked with kept circling one core belief: <strong style="color:#FBF8F1;">joy.</strong> Her Legendary Intent became &mdash; <em style="font-style:italic;">&ldquo;to create joy in the lives of those around her.&rdquo;</em> She decided that if those words were on her headstone, she'd be content.</p>
    <p style="margin-top:18px;font-size:18.5px;line-height:1.72;color:rgba(244,240,231,0.84);">Then she used it as a filter. She'd noticed neither she nor her team laughed much at work &mdash; so her daily mission became simple: find a way to make someone laugh. Within a few months the culture of her office had changed completely. Everyone was taking cues from her. One sentence, worn like goggles, rewired a whole team.</p>

    <!-- VIDEO: long -->
    <div id="long-version" style="margin:44px 0 0;scroll-margin-top:88px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;margin-bottom:18px;">The full walkthrough</h2>
      <div style="aspect-ratio:16/9;border-radius:16px;overflow:hidden;border:1px solid rgba(244,240,231,0.12);background:#000;">
        <iframe src="https://player.vimeo.com/video/313486697?title=0&byline=0&portrait=0" loading="lazy" style="width:100%;height:100%;border:0;display:block;" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="Legendary Intent — full walkthrough"></iframe>
      </div>
    </div>
  </div>

  <!-- BUSINESS APPLICATION -->
  <div style="max-width:880px;margin:44px auto 0;padding:0 32px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:14px;">The same move, for a company</p>
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.1;color:#FBF8F1;">Begin with the end in mind &mdash; and watch the answers change</h2>
    <p style="margin-top:16px;font-size:18.5px;line-height:1.72;color:rgba(244,240,231,0.84);">A Legendary Intent works on an executive team, too &mdash; and it's one of the most powerful things we do. Most companies plan <em style="font-style:italic;">incrementally:</em> &ldquo;We're at $100M &mdash; how do we get to $110M next year?&rdquo; The question itself caps the answer. Ask a bigger one &mdash; &ldquo;How do we get from $100M to <strong style="color:#FBF8F1;">$500M in five years?</strong>&rdquo; &mdash; and something changes in the room.</p>
    <div style="margin:24px 0 0;border-radius:14px;overflow:hidden;border:1px solid rgba(244,240,231,0.12);">
      <img src="/assets/legendary-intent-slide.png" alt="The size of the question sets the ceiling on the answer: incremental planning ('how do we go from $100M to $110M next year?') leads to stagnation, while a Legendary Intent ('how do we get to $500M in five years?') grows awareness, challenges beliefs, and demands courage." width="1920" height="1080" loading="lazy" style="width:100%;height:auto;display:block;">
    </div>
    <p style="margin-top:22px;font-size:18.5px;line-height:1.72;color:rgba(244,240,231,0.84);">Watch the ABCs fire in sequence: the bigger question <strong style="color:#FBF8F1;">grows awareness</strong> (new options appear that 10% growth never surfaced), it <strong style="color:#FBF8F1;">challenges beliefs</strong> (&ldquo;that can't be done&rdquo; &mdash; <em style="font-style:italic;">why not?</em>), and then it demands <strong style="color:#FBF8F1;">courage</strong> (are we willing to commit to something that big?). When an executive team starts <em style="font-style:italic;">talking</em> this way, it starts <em style="font-style:italic;">believing</em> this way &mdash; and everything changes. This isn't a workshop exercise; it's how we've helped companies grow beyond what they thought was possible.</p>
  </div>

  <!-- SOFT BRIDGE -->
  <div style="max-width:880px;margin:40px auto 0;padding:0 32px;">
    <div style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px;">
      <p style="font-size:16.5px;line-height:1.66;color:rgba(244,240,231,0.78);">Your Legendary Intent is the personal version of a shared north star. When an executive <em style="font-style:italic;">team</em> needs that same clarity &mdash; two or three priorities precise enough to steer every decision &mdash; that's the Flag at the center of the <a href={SLUGS.flagModel} style="color:#E0744A;text-decoration:underline;">Flag Model&trade;</a>. Start with your own sentence. It's free, and it's yours.</p>
    </div>
  </div>

  <!-- RELATED -->
  <div style="max-width:880px;margin:56px auto 0;padding:0 32px 20px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">More from the Library</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <a href={SLUGS.mindset} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">The Mindset of a Legend</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The ABCs your intent is built on.</span>
      </a>
      <a href={SLUGS.roadmap} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">The Roadmap to Legendary</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Where the intent takes you, stage by stage.</span>
      </a>
    </div>
  </div>
  </article>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
