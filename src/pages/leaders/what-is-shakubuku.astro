---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../lib/site';

const path = SLUGS.whatIsShakubuku;
const title = 'What Is Shakubuku? The Sudden Awakening to Who You Are';
const description =
  'Shakubuku means to awaken a person to their inherent greatness — a sudden, radical shift in how you see yourself, and how Be Legendary uses it.';

const canonical = new URL(path, SITE_URL).href;

// Article + DefinedTerm + FAQPage — schema types preserved from the design,
// enriched with entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'What Is Shakubuku? The Sudden Awakening to Who You Really Are',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['shakubuku', 'transformation', 'self-image'],
    description:
      'The meaning and origin of shakubuku, and how Be Legendary uses it as its flagship experience.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'DefinedTerm',
    '@id': `${canonical}#term`,
    name: 'Shakubuku',
    description:
      "Shakubuku is a sudden, radical shift in how you see yourself — an awakening to your own inherent greatness. The word has Buddhist roots meaning to awaken a person; Be Legendary uses it as the name of its flagship, by-application experience: a multi-day immersion in the physical world engineered to change a leader's self-image permanently.",
    inDefinedTermSet: 'Be Legendary',
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is shakubuku?', acceptedAnswer: { '@type': 'Answer', text: 'Shakubuku is a sudden, radical shift in how you see yourself — a life-changing epiphany that awakens you to your own inherent greatness. The word has roots in Buddhism, where it refers to awakening a person directly rather than gradually. It describes the moment your self-image changes for good, not a slow accumulation of insight.' } },
      { '@type': 'Question', name: 'Where does the word shakubuku come from?', acceptedAnswer: { '@type': 'Answer', text: 'It comes from Japanese Buddhism, describing a direct method of awakening. In popular culture it was memorably described as a sudden, radical shift in perspective — a jolt that changes your reality. Be Legendary uses it in that spirit: an awakening to your inherent greatness.' } },
      { '@type': 'Question', name: 'How does Be Legendary use shakubuku?', acceptedAnswer: { '@type': 'Answer', text: 'Shakubuku is Be Legendary’s flagship, by-application experience: a multi-day immersion in the physical world, engineered to change a leader’s self-image permanently through lived experience rather than information. It is also the centerpiece of The Legendary Leader, a longer whole-person program built around it.' } },
      { '@type': 'Question', name: 'Why does change require experience instead of information?', acceptedAnswer: { '@type': 'Answer', text: 'Because information reaches the mind but rarely the self-image. Reading about courage doesn’t make you feel courageous; doing a hard thing you weren’t sure you could does. Experience reaches the root — it shows you who you are rather than telling you, which is why a permanent shift usually has to be lived.' } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="What Is Shakubuku? The Sudden Awakening to Who You Really Are"
  ogDescription="A radical shift in how you see yourself — an awakening to your own inherent greatness. What it means."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;">
    <article>
      <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">What Is Shakubuku</span>
        </nav>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;max-width:18ch;">What is shakubuku?</h1>
        <div style="margin-top:28px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The short answer</p>
          <p style="font-size:18px;line-height:1.6;color:#2E2A22;">Shakubuku is a <strong style="font-weight:700;">sudden, radical shift in how you see yourself</strong> — an awakening to your own inherent greatness. The word has Buddhist roots meaning to awaken a person. At Be Legendary it's also the name of our flagship, by-application experience: a multi-day immersion in the physical world, built to change a leader's self-image for good.</p>
        </div>
      </header>

      <section style="max-width:820px;margin:48px auto 0;padding:0 32px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">The word</p>
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="margin-bottom:22px;">Most change is gradual — a little more insight, a little more discipline, accumulated over years. <em style="font-style:italic;">Shakubuku</em> names the other kind: the jolt. A single experience so vivid that afterward you simply can't see yourself the old way. The term comes from Buddhism, where it describes awakening a person directly, and it entered wider culture as a phrase for a sudden, radical shift in perspective — a life-changing epiphany.</p>
          <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">To awaken a person to their inherent greatness.</p>
        </div>
      </section>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Why it has to be lived</p>
          <p style="margin-bottom:22px;">You can't be talked into a shakubuku. Information reaches the mind but rarely the self-image — reading about courage doesn't make you feel courageous. Doing a genuinely hard thing you weren't sure you could does. Experience reaches the root: it <em style="font-style:italic;">shows</em> you who you are instead of telling you, and what it shows can't be un-seen.</p>
          <p>That's why the deepest version of it is a <a href={SLUGS.whatIsMisogi} style="color:#C04A26;text-decoration:underline;">misogi</a> taken to its limit — one ordeal, real stakes, lived in the physical world, that resets what you believe you're capable of.</p>
        </div>
      </section>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;text-align:center;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">The flagship · by application</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF8F1;max-width:26ch;margin:0 auto 16px;">Shakubuku is Be Legendary's flagship experience.</h2>
          <p style="font-size:17px;line-height:1.6;color:rgba(244,240,231,0.78);max-width:50ch;margin:0 auto 28px;">A multi-day immersion in the physical world, engineered to change your self-image permanently — and the centerpiece of The Legendary Leader, our whole-person program built around it.</p>
          <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;">
            <a href={SLUGS.legendaryLeader} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">Explore The Legendary Leader <span>&rarr;</span></a>
            <a href={`${SLUGS.leaders}#shakubuku`} style="border:1px solid rgba(244,240,231,0.3);color:#F4F0E7;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;">How it fits the path</a>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:56px auto 0;padding:0 32px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#1B1810;margin-bottom:28px;">Straight answers</h2>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Where does the word come from?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">From Japanese Buddhism, describing a direct method of awakening. In popular culture it's been described as a sudden, radical shift in perspective — a jolt that changes your reality. Be Legendary uses it in that spirit: an awakening to your inherent greatness.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">How is it different from a leadership retreat?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Most retreats inform and inspire, then fade. Shakubuku is engineered to change your self-image through lived experience, so the shift holds after you go home. It's designed to reach the root, not the notebook.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">How do I prepare for that kind of shift?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Start with the reps. The free <a href={workoutPath('mindset-of-a-legend')} style="color:#C04A26;text-decoration:underline;">Mindset of a Legend</a> workout and the <a href={SLUGS.challenge} style="color:#C04A26;text-decoration:underline;">30-Day Challenge</a> build the awareness, belief, and courage that a shakubuku then breaks wide open.</p></div>
        </div>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px 20px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Keep going</p>
        <div class="bl-cards-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
          <a href={SLUGS.whatIsMisogi} style="text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:22px;display:block;"><span style="display:block;font-family:'Newsreader',serif;font-size:19px;color:#1B1810;margin-bottom:6px;">What is a misogi?</span><span style="display:block;font-size:14px;line-height:1.5;color:#6B6358;">One ordeal a year that resets you.</span></a>
          <a href={SLUGS.abcsOfMindset} style="text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:22px;display:block;"><span style="display:block;font-family:'Newsreader',serif;font-size:19px;color:#1B1810;margin-bottom:6px;">The ABCs of a legendary mindset</span><span style="display:block;font-size:14px;line-height:1.5;color:#6B6358;">Awareness, Beliefs, Courage.</span></a>
          <a href={SLUGS.leadersGlossary} style="text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:22px;display:block;"><span style="display:block;font-family:'Newsreader',serif;font-size:19px;color:#1B1810;margin-bottom:6px;">The Leader's glossary</span><span style="display:block;font-size:14px;line-height:1.5;color:#6B6358;">Every term, defined in one place.</span></a>
        </div>
      </section>
    </article>
  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
