---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareRow from '../../components/ShareRow.astro';
import ArticleEndCTA from '../../components/ArticleEndCTA.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS } from '../../lib/site';

const path = SLUGS.whatIsLeadership;
const title = "What Is Leadership? A Definition That Isn't Hollow";
const description =
  "What is leadership, really? Not authority or a title — it's the ability to take people somewhere they couldn't reach alone, starting with leading yourself.";

const canonical = new URL(path, SITE_URL).href;

// Article + DefinedTerm + FAQPage — schema types preserved from the design,
// enriched with entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: "What Is Leadership? A Definition That Isn't Hollow",
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['what is leadership', 'leadership definition', 'leadership vs management'],
    description:
      'A clear definition of leadership, how it differs from management, and why it begins with leading yourself.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'DefinedTerm',
    '@id': `${canonical}#term`,
    name: 'Leadership',
    description:
      'Leadership is the capacity to take people somewhere they would not reach on their own — through influence, example and shared purpose rather than authority. It begins with self-leadership: the ability to govern your own mindset, beliefs and actions before asking others to follow.',
    inDefinedTermSet: 'Be Legendary',
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is leadership?', acceptedAnswer: { '@type': 'Answer', text: "Leadership is the capacity to take people somewhere they wouldn't reach on their own — through influence, example and shared purpose rather than position or authority. Real leadership begins with self-leadership: you can only take others as far as you've been able to lead yourself. It is less a role you're given than a way of being others choose to follow." } },
      { '@type': 'Question', name: 'What is the difference between leadership and management?', acceptedAnswer: { '@type': 'Answer', text: "Management is about systems, processes and getting known work done reliably — planning, organizing, controlling. Leadership is about people and direction: creating a vision, aligning others to it, and inspiring the change to reach it. Organizations need both, but they aren't the same. You manage tasks; you lead people." } },
      { '@type': 'Question', name: 'Where does leadership begin?', acceptedAnswer: { '@type': 'Answer', text: "With leading yourself. Before you can take a team somewhere, you have to govern your own mindset, beliefs and reactions — because people follow who you are being, not just what you say. Self-leadership is the foundation everything else is built on." } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="What Is Leadership? A Definition That Isn't Hollow"
  ogDescription="Leadership is taking people somewhere they wouldn't reach alone — starting with yourself."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;">
    <article>
      <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
        <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><span style="color:#C04A26;">What Is Leadership</span>
        </nav>
        <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#1B1810;max-width:18ch;">What is leadership?</h1>
        <div style="margin-top:28px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The short answer</p>
          <p class="bl-speakable" style="font-size:18px;line-height:1.6;color:#2E2A22;">Leadership is the capacity to <strong style="font-weight:700;">take people somewhere they wouldn't reach on their own</strong> — through influence, example and shared purpose, not position or authority. And it begins with self-leadership: you can only take others as far as you've learned to lead yourself.</p>
        </div>
      </header>

      <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
        <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
          <p style="margin-bottom:22px;">Most definitions of leadership are either circular ("leaders lead") or a pile of adjectives. Here's a cleaner test: leadership happened if a group got somewhere it wouldn't have reached without you — and chose to, rather than was forced to. Authority can compel compliance. Only leadership earns the willing part.</p>
          <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">You manage tasks. You lead people. And you can't lead anyone further than you've led yourself.</p>
          <p>That last clause is the part most leadership content skips. Before the vision-casting and the alignment, there's a quieter requirement: you have to be able to govern your own mind, beliefs and reactions. People follow who you're <em style="font-style:italic;">being,</em> not just what you announce. Which means the real starting line of leadership isn't a team at all — it's yourself.</p>
        </div>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.12;color:#1B1810;margin-bottom:20px;">Leadership vs. management.</h2>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:14px;padding:24px 26px;"><p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:8px;">Management</p><p style="font-size:15.5px;line-height:1.6;color:#3A362E;">Systems and processes — planning, organizing, controlling. Getting known work done reliably. You manage <em style="font-style:italic;">tasks.</em></p></div>
          <div style="background:#15130E;color:#F4F0E7;border-radius:14px;padding:24px 26px;"><p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;margin-bottom:8px;">Leadership</p><p style="font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.82);">People and direction — vision, alignment, inspiring change. Taking a group somewhere new. You lead <em style="font-style:italic;">people.</em></p></div>
        </div>
        <p style="margin-top:16px;font-size:15.5px;color:#56524A;">Organizations need both. The best leaders can manage; the best managers can lead. But they're different capacities, and conflating them is why so much "leadership training" is really just process training.</p>
      </section>

      <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;text-align:center;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">Start where leadership starts — free</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF8F1;max-width:24ch;margin:0 auto 16px;">Lead yourself first.</h2>
          <p style="font-size:17px;line-height:1.6;color:rgba(244,240,231,0.78);max-width:48ch;margin:0 auto 28px;">The free Mindset Workouts train self-leadership — awareness, beliefs, courage — the foundation everything else is built on. Ten minutes to begin.</p>
          <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;">
            <a href={SLUGS.workouts} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">Enter the gym — free <span>&rarr;</span></a>
            <a href={SLUGS.leaders} style="border:1px solid rgba(244,240,231,0.3);color:#F4F0E7;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;">See the whole idea</a>
          </div>
        </div>
      </section>

      <section style="max-width:820px;margin:56px auto 0;padding:0 32px 20px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#1B1810;margin-bottom:28px;">Straight answers</h2>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">What's the difference between leadership and management?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">Management is systems and processes — planning, organizing, controlling to get known work done. Leadership is people and direction — vision, alignment, and inspiring change. You manage tasks; you lead people. Organizations need both.</p></div>
          <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#1B1810;margin-bottom:8px;">Where does leadership begin?</h3><p style="font-size:16px;line-height:1.65;color:#56524A;">With leading yourself. Before you can take a team somewhere, you have to govern your own mindset and reactions — because people follow who you're being, not just what you say.</p></div>
        </div>
      </section>
      <!-- internal-linking: keep-reading rail -->
      <section style="max-width:860px;margin:8px auto 0;padding:0 32px 76px;">
        <p style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Keep reading</p>
        <div style="display:grid;gap:12px;">
          <a href="/leaders/what-makes-a-good-leader/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">What makes a good leader</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/leadership-qualities/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">The qualities that define strong leaders</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
          <a href="/leaders/improve-leadership-skills/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:12px;padding:18px 22px;">
            <span style="font-family:'Newsreader',serif;font-size:19px;color:#1B1810;line-height:1.25;">How to improve your leadership skills</span>
            <span style="color:#C04A26;font-weight:700;font-size:16px;">&rarr;</span>
          </a>
        </div>
      </section>
      <ArticleEndCTA maxWidth={820} />
      <ShareRow title={title} maxWidth={820} />
</article>
  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
