---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MwComplete from '../../../components/MwComplete.astro';
import MwCommitment from '../../../components/MwCommitment.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../../lib/site';

const path = workoutPath('villain-or-hero');
const title =
  'Villain or Hero — a Mindset Workout on your story';
const description =
  'Excavate the beliefs behind your proudest and worst moments, see why the same act can be villainous or heroic, and choose your one hero action. E + R = O.';

const canonical = new URL(path, SITE_URL).href;

// JSON-LD: the design's LearningResource + FAQPage (entity @ids added), plus a
// HowTo built from the "Time for Action" one-hero-action rep.
const schema = [
  {
    '@type': 'LearningResource',
    '@id': `${canonical}#learningresource`,
    name: 'Villain or Hero — Capstone Mindset Workout',
    learningResourceType: 'Guided mindset workout',
    teaches:
      'Identity, belief and perspective: the story you tell about yourself, and how the same behavior can be villainous or heroic depending on the frame (E + R = O)',
    timeRequired: 'PT20M',
    isAccessibleForFree: true,
    author: { '@id': PERSON_ID },
    provider: { '@id': ORG_ID },
    description:
      'A capstone workout that excavates the beliefs behind your proudest and least-proud moments, teaches why perspective determines villain or hero, and ends in one chosen hero action.',
  },
  {
    '@type': 'HowTo',
    '@id': `${canonical}#howto`,
    name: 'Choose your one hero action',
    description:
      'Pick a single scene this week where you’ll consciously choose the hero’s response, and name the frame you’ll hold.',
    totalTime: 'PT10M',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Pick one scene',
        text: 'Choose a single scene this week — not ten — where you’ll consciously choose the hero’s response.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Name the frame',
        text: 'Name the frame you’ll hold while everyone else sees what they see. Same event, different response, different movie.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Act and log',
        text: 'Make the one hero move — for example, use empathy for someone you’ll see that day — then come back and log the rep.',
      },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What does E + R = O mean?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Event plus Response equals Outcome. You rarely control the events in your life, but you control your response — and your response is driven by the story you tell yourself. Change the story, you change the response, and you change the outcome. In this workout, your response is what decides whether you play the villain or the hero.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can you be both a villain and a hero in the same moment?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes — because villain and hero are matters of perspective, not just behavior. The exact same action can be heroic from one vantage point and villainous from another. A parent speeding a badly injured child to the hospital is a hero to that child and a reckless danger to every driver they pass. The behavior is identical; only the frame differs. Recognizing this frees a leader to choose their response consciously rather than be trapped by a single story.',
        },
      },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Villain or Hero — A Capstone Mindset Workout"
  ogDescription="Can you be both villain and hero in the exact same moment? The answer changes how you lead."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <article>
    <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><a href={SLUGS.workouts} style="color:inherit;text-decoration:none;">Workouts</a><span>/</span><span style="color:#C04A26;">Villain or Hero</span>
      </nav>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:20px;">
        <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;">Capstone Workout · Emotional + Spiritual</span>
        <span style="width:4px;height:4px;border-radius:50%;background:#B4A98E;"></span>
        <span style="font-size:11.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A7F6C;">~20 min</span>
      </div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(40px,7vw,80px);line-height:0.98;letter-spacing:-0.025em;color:#1B1810;">Are you a villain <span style="color:#C04A26;font-style:italic;">or</span> a hero?</h1>
      <p style="margin-top:24px;font-size:19px;line-height:1.6;color:#2E2A22;max-width:52ch;">The deepest rep in the gym. You'll excavate the beliefs behind your proudest and least-proud moments, then face a question most people get wrong — one that changes how you lead once you see it.</p>
      <p style="margin-top:16px;font-size:14.5px;color:#8A7F6C;">Pulls together <a href={workoutPath('whats-your-story')} style="color:#C04A26;text-decoration:none;font-weight:600;">What's Your Story</a>, <a href={workoutPath('choices')} style="color:#C04A26;text-decoration:none;font-weight:600;">Choices</a>, and the ABCs. Warm up with those first if you haven't.</p>
    </header>

    <!-- VIDEO SLOT -->
    <div style="max-width:820px;margin:40px auto 0;padding:0 32px;">
      <div style="position:relative;aspect-ratio:16/9;border-radius:16px;overflow:hidden;border:1px solid rgba(27,24,16,0.12);">
        <iframe src="https://www.youtube.com/embed/dTuRy0tmjGU" title="Villain or Hero" loading="lazy" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0;"></iframe>
      </div>
    </div>

    <!-- YOUR MOVIE -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">Part 1 · Your movie</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;line-height:1.15;color:#1B1810;margin-bottom:14px;">You are the star of your own movie.</h2>
      <div style="font-size:18px;line-height:1.7;color:#2E2A22;">
        <p style="margin-bottom:18px;">Drama, comedy, action? What's the soundtrack? Who are your co-stars — and are they cheering for you, or jeering? Every person you meet is a co-star in your movie, and you're one in theirs. Your audience is watching over your shoulder right now.</p>
        <p style="font-family:'Newsreader',serif;font-style:italic;font-size:23px;line-height:1.4;color:#1B1810;margin:26px 0;padding-left:22px;border-left:3px solid #C04A26;">The most important story you will ever tell is the story you tell to yourself, about yourself.</p>
        <p>And here's the part that matters: it is <em style="font-style:italic;">your</em> responsibility to make your movie great — to choose the scenes that make you a villain or a hero. No one else can direct it. That's not a burden; it's the whole freedom.</p>
      </div>
    </section>

    <!-- VILLAIN REFLECTION -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:36px 38px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#8C8473;margin-bottom:14px;">Part 2 · The villain</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:27px;line-height:1.18;color:#FBF8F1;margin-bottom:8px;">Recall one of your <span style="font-style:italic;">least</span> proud moments.</h2>
        <p style="font-size:16px;line-height:1.6;color:rgba(244,240,231,0.7);margin-bottom:22px;">A time you did the wrong thing. Sit in it honestly — this is where the muscle gets worked.</p>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="font-size:13px;color:#8C8473;font-family:'Newsreader',serif;flex:none;width:110px;">Who / what</span><span style="font-size:16px;color:#E7E0D2;">Who were you with, and what happened?</span></div>
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="font-size:13px;color:#8C8473;font-family:'Newsreader',serif;flex:none;width:110px;">The feeling</span><span style="font-size:16px;color:#E7E0D2;">What did you feel at the time — and afterward?</span></div>
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="font-size:13px;color:#8C8473;font-family:'Newsreader',serif;flex:none;width:110px;">The belief</span><span style="font-size:16px;color:#E7E0D2;">What do you believe is true about your villainous self? <em style="font-style:italic;color:#E0744A;">Does that belief serve you?</em></span></div>
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="font-size:13px;color:#8C8473;font-family:'Newsreader',serif;flex:none;width:110px;">The value</span><span style="font-size:16px;color:#E7E0D2;">What core value is it tied to?</span></div>
        </div>
      </div>
    </section>

    <!-- HERO REFLECTION -->
    <section style="max-width:820px;margin:24px auto 0;padding:0 32px;">
      <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:18px;padding:36px 38px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">Part 3 · The hero</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:27px;line-height:1.18;color:#1B1810;margin-bottom:8px;">Now recall one of your <span style="font-style:italic;">most</span> proud moments.</h2>
        <p style="font-size:16px;line-height:1.6;color:#56524A;margin-bottom:22px;">A time you did the right thing. Notice how differently your body holds this one.</p>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="font-size:13px;color:#8A7F6C;font-family:'Newsreader',serif;flex:none;width:110px;">Who / what</span><span style="font-size:16px;color:#2E2A22;">Who were you with, and what happened?</span></div>
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="font-size:13px;color:#8A7F6C;font-family:'Newsreader',serif;flex:none;width:110px;">The feeling</span><span style="font-size:16px;color:#2E2A22;">What did you feel at the time — and afterward?</span></div>
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="font-size:13px;color:#8A7F6C;font-family:'Newsreader',serif;flex:none;width:110px;">The belief</span><span style="font-size:16px;color:#2E2A22;">What do you believe is true about your heroic self? <em style="font-style:italic;color:#C04A26;">Does that belief serve you?</em></span></div>
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="font-size:13px;color:#8A7F6C;font-family:'Newsreader',serif;flex:none;width:110px;">The value</span><span style="font-size:16px;color:#2E2A22;">What core value is it tied to?</span></div>
        </div>
      </div>
    </section>

    <!-- E + R = O -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">Part 4 · The formula</p>
      <div style="background:#211D15;border:1px solid rgba(192,74,38,0.35);border-radius:18px;padding:36px 40px;text-align:center;">
        <p style="font-family:'Newsreader',serif;font-size:clamp(30px,5vw,44px);line-height:1;color:#FBF8F1;">E <span style="color:#8C8473;">+</span> R <span style="color:#8C8473;">=</span> O</p>
        <p style="margin-top:14px;font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#8C8473;">Event <span style="color:#6E6757;">+</span> Response <span style="color:#6E6757;">=</span> Outcome</p>
        <p style="margin-top:18px;font-size:16.5px;line-height:1.6;color:rgba(244,240,231,0.82);max-width:48ch;margin-left:auto;margin-right:auto;">You rarely control the event. You always control the response — and your response is what casts you as the villain or the hero of the scene. Same event, different response, different movie.</p>
      </div>
    </section>

    <!-- THE QUESTION + REVEAL -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">Part 5 · The question</p>
      <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:40px 42px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.6vw,38px);line-height:1.14;color:#FBF8F1;max-width:20ch;">Can you be both villain <span style="font-style:italic;color:#E0744A;">and</span> hero in the exact same moment?</h2>
        <p style="margin-top:18px;font-size:17px;line-height:1.65;color:rgba(244,240,231,0.8);max-width:52ch;">Not two different moments. The <em style="font-style:italic;">same</em> one — the same behavior, unchanged. Most people say no. Sit with it before you look. What would make the answer yes?</p>
        <button id="vh-reveal-btn" type="button" style="margin-top:22px;cursor:pointer;font-family:'Hanken Grotesk',sans-serif;font-weight:700;font-size:15px;padding:13px 24px;border-radius:10px;border:1px solid rgba(224,116,74,0.5);background:#C04A26;color:#fff;">Show the answer</button>
        <div id="vh-reveal-panel" style="overflow:hidden;transition:max-height .4s ease,opacity .3s;max-height:0;opacity:0;">
          <div style="border-top:1px solid rgba(244,240,231,0.16);margin-top:24px;padding-top:24px;">
            <p style="font-family:'Newsreader',serif;font-style:italic;font-size:clamp(22px,3vw,30px);line-height:1.3;color:#E0744A;margin-bottom:18px;">Yes. Absolutely yes — because it's all about perspective.</p>
            <p style="font-size:17px;line-height:1.7;color:rgba(244,240,231,0.86);margin-bottom:18px;">When the behavior is identical, the only thing that changes is the frame it's seen through. My daughter is seriously injured and I'm racing her to the hospital, flying through traffic. To her, to me, I am a <strong style="font-weight:700;color:#FBF8F1;">hero</strong> — doing whatever it takes. To every driver I blow past, I'm a <strong style="font-weight:700;color:#FBF8F1;">maniac</strong> about to get someone killed. Same car, same speed, same moment. Hero and villain at once.</p>
            <p style="font-size:17px;line-height:1.7;color:rgba(244,240,231,0.86);">That's the whole point. Villain and hero were never just about the behavior — they're about the story being told about it, and from where. Once you see that, you stop being trapped by any single story of yourself, and you get to choose the response — and the frame — on purpose.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- YES AND -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">Part 6 · Yes, and…</p>
      <div style="font-size:18px;line-height:1.7;color:#2E2A22;">
        <p>The improviser's rule rewrites the formula: E + R = O, where the response is always <em style="font-style:italic;">"Yes, and…"</em> Instead of resisting the event or shutting down the other person, you accept what's real and build on it. It's how a hero responds — not by controlling the scene, but by adding to it.</p>
      </div>
    </section>

    <!-- TIME FOR ACTION -->
    <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
      <div style="background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:36px 38px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Time for action</span>
          <span style="font-size:12px;color:#8C8473;">your one hero action · this week</span>
        </div>
        <p style="font-family:'Newsreader',serif;font-weight:400;font-size:27px;line-height:1.25;color:#FBF8F1;margin-bottom:16px;">What is your <span style="font-style:italic;color:#E0744A;">one</span> action as a hero?</p>
        <p style="font-size:16.5px;line-height:1.65;color:rgba(244,240,231,0.78);margin-bottom:18px;">Not ten. One. Pick a single scene this week where you'll consciously choose the hero's response — and name the frame you'll hold while everyone else sees what they see.</p>
        <div style="background:rgba(244,240,231,0.05);border-radius:12px;padding:16px 18px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8C8473;margin-bottom:6px;">A commitment you could make</p>
          <p style="font-size:15.5px;line-height:1.55;color:#E7E0D2;">"On my drive into work each day, instead of my normal routine, I will identify one way to use empathy for someone I'll see that day."</p>
        </div>
      </div>
    </section>

    <!-- COMPLETE + TRACK -->
    <MwComplete
      workoutId="villain-or-hero"
      dim="Emotional"
      dimLabel="Emotional"
      notePlaceholder="My one hero action this week is…"
    />

    <MwCommitment
      workoutId="villain-or-hero"
      dim="Emotional"
      dimLabel="Emotional"
      c1="When I'm about to cast someone as the villain, instead of writing them off, ||I will name one reason a good person might do what they did."
      c2="When I get in my car to head home, instead of stewing, ||I will name one hero move I made today."
      c3="When I feel wronged, instead of telling the villain story, ||I will do one small hero action."
      willPh="do one hero action"
    />

    <!-- NEXT / BRIDGE -->
    <section style="max-width:1000px;margin:52px auto 0;padding:0 32px 90px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <a href={workoutPath('whats-your-story')} style="display:flex;flex-direction:column;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:16px;padding:28px 30px;">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">Warm up first</span>
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:22px;color:#1B1810;margin-bottom:8px;">What's Your Story</h3>
          <p style="font-size:14.5px;line-height:1.55;color:#56524A;">The lighter warmup that leads into this — find the story running you.</p>
        </a>
        <a href={`${SLUGS.leaders}#shakubuku`} style="display:flex;flex-direction:column;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:16px;padding:28px 30px;">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">The summit</span>
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:22px;color:#1B1810;margin-bottom:8px;">Earn your Shakubuku</h3>
          <p style="font-size:14.5px;line-height:1.55;color:#56524A;">The workouts are how you prepare — and how we come to know you.</p>
        </a>
      </div>
    </section>
    </article>

  </div>

  <SiteFooter audience="leaders" variant="slim" />

  <script>
    (function () {
      const btn = document.getElementById('vh-reveal-btn');
      const panel = document.getElementById('vh-reveal-panel');
      let open = false;
      if (btn && panel) {
        btn.addEventListener('click', function () {
          open = !open;
          if (open) {
            panel.style.maxHeight = '600px';
            panel.style.opacity = '1';
            btn.textContent = 'Hide the answer';
            btn.style.background = 'transparent';
            btn.style.color = '#E0744A';
          } else {
            panel.style.maxHeight = '0';
            panel.style.opacity = '0';
            btn.textContent = 'Show the answer';
            btn.style.background = '#C04A26';
            btn.style.color = '#fff';
          }
        });
      }
    })();
  </script>
</BaseLayout>
