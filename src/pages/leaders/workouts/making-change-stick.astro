---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MwRelated from '../../../components/MwRelated.astro';
import MwComplete from '../../../components/MwComplete.astro';
import MwCommitment from '../../../components/MwCommitment.astro';
import { SITE_URL, ORG_ID, SLUGS, workoutPath } from '../../../lib/site';

const path = workoutPath('making-change-stick');
const title = 'Making Change Stick — a 9-Part Workout on Leading Change';
const description =
  'A nine-part series on making change stick, applying the Switch framework (Chip & Dan Heath) through the ABCs of a legendary mindset. Each part a full rep.';

const canonical = new URL(path, SITE_URL).href;

// JSON-LD: the design's Course + FAQPage (verbatim Q&A), enriched with the
// canonical Organization @id. (No single "Time for Action" block on this series
// page, so no HowTo is added.)
const schema = [
  {
    '@type': 'Course',
    '@id': `${canonical}#course`,
    name: 'Making Change Stick',
    provider: { '@id': ORG_ID },
    description:
      'A nine-part workout series on leading change that lasts, applying the Switch framework through the ABCs of the legendary mindset.',
    isAccessibleForFree: true,
    about: ['change management', 'leading change', 'habit formation'],
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', category: 'free' },
    hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT15M' },
  },
  {
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Why is change so hard to make stick?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Because change asks three different things at once: the rational mind needs clear direction, the emotional self needs motivation, and the surrounding environment needs to make the new behavior easy. Miss any one and change reverts. What looks like resistance is usually a lack of clarity, a lack of feeling, or a path that quietly pushes people back to the old way.',
        },
      },
    ],
  },
];

// The nine parts (ported from the design's DCLogic data array).
const open = 0; // first part open by default
const parts = [
  {
    title: 'Bright Spots', abc: 'Awareness', sw: 'Direct the mind', sub: "Focus on what's already working",
    teach: `When change feels overwhelming, the instinct is to catalog everything that's broken. Flip it: hunt for the bright spots — the places, people or moments where it's already going right, even a little — and ask "what's working there, and how do we do more of it?"`,
    why: `Problem-focus drains energy; a bright spot is proof the change is already possible for you, which makes it faster to grow than to invent from nothing. It also flips you from self-criticism to curiosity about yourself.`,
    example: `Someone trying to be more patient stopped cataloguing every time they snapped and instead studied the days they stayed calm — what was different? — then built more of those conditions in.`,
    rep: `Find one bright spot in a situation you've been treating as a problem, and deliberately do more of exactly that this week.`,
  },
  {
    title: 'Tweak the Environment', abc: 'Awareness', sw: 'Shape the path', sub: 'Make the right thing the easy thing',
    teach: `Behavior is downstream of environment far more than we admit. Rather than relying on willpower or reminders, change the surroundings so the desired behavior becomes the path of least resistance — and the old behavior takes real effort.`,
    why: `What looks like a people problem is often a situation problem. When you fix the environment, you don't have to fix the person — the new behavior happens almost by default, and it holds when your attention moves on.`,
    example: `Want deep work mornings? Put your phone in another room and block the calendar the night before. You didn't get more disciplined — you made distraction inconvenient.`,
    rep: `Change one thing in your environment this week that makes your desired behavior automatic and the old one a hassle.`,
  },
  {
    title: 'Find the Feeling', abc: 'Beliefs', sw: 'Move the heart', sub: 'Connect the heart, not just the head',
    teach: `Knowing you should change is not enough to make you change — you move when you feel something. Facts inform your rider; feeling moves your elephant. Find the emotional truth underneath the change you want in yourself, and start there, not from the logic of why you "should."`,
    why: `You've talked yourself into a change a hundred times with airtight reasoning and still done nothing. Analysis creates agreement with yourself; only emotion creates action. Miss the feeling and your own logic never gets used.`,
    example: `"I should exercise" changed nothing for years. The morning I pictured not being able to keep up with my kids — that got me out the door.`,
    rep: `For a change you've been "should-ing" yourself toward, write the one sentence that makes it truly felt, not just understood — and read it back to yourself.`,
  },
  {
    title: 'Shrink the Change', abc: 'Beliefs', sw: 'Move the heart', sub: 'Make the first step too small to fail',
    teach: `A goal too big paralyzes — the gap between here and there feels uncrossable, so the elephant refuses to move. Shrink the change until the first step feels almost too easy to skip. Momentum, not size, is what carries you.`,
    why: `Small, visible wins build the belief that change is possible, and belief is the fuel. Each completed step shrinks the fear and grows the identity of someone who follows through.`,
    example: `The debt-payoff method that works isn't the mathematically optimal one — it's paying the smallest balance first, because the early win keeps people going.`,
    rep: `Take the change you've been avoiding, cut the first step in half, then in half again — and do that tiny version today.`,
  },
  {
    title: 'Grow the Identity', abc: 'Beliefs', sw: 'Move the heart', sub: "Become the person, don't just build the habit",
    teach: `A change sticks when it becomes part of who you are, not just what you do. Stop chasing the behavior and cultivate the identity underneath it — "I'm the kind of person who…" — and hold a growth mindset: this is hard because it's new, not because you can't.`,
    why: `Habits driven by willpower or reward fade when either runs out. Behavior anchored to identity survives the slip, because a lapse becomes "not like me" instead of "proof I failed." Identity is the most durable place to hang a change.`,
    example: `"I'm trying to quit" keeps the smoker a smoker who's resisting. "I'm not a smoker" ends it — the identity did what the willpower couldn't.`,
    rep: `Finish the sentence "I'm becoming the kind of person who…" and take one action from that identity today.`,
  },
  {
    title: 'Build Habits', abc: 'Courage', sw: 'Shape the path', sub: 'Put success on autopilot',
    teach: `Willpower is a battery that drains through the day. Habits and action triggers — "when X happens, I will do Y" — make the right move happen without a decision. You're not trying harder; you're designing the moment so the behavior is automatic.`,
    why: `Every decision you can turn into a habit is one you no longer have to win. Leaders who run on triggers conserve their scarce willpower for the choices that actually require it.`,
    example: `"When I sit down at my desk, I write the one thing that must happen today before I open email." The trigger — sitting down — does the remembering.`,
    rep: `Set one action trigger this week in the exact form: "When ___ happens, I will ___."`,
  },
  {
    title: 'Script the Moves', abc: 'Courage', sw: 'Direct the mind', sub: '80% of the result from 20% of the action',
    teach: `Ambiguity is the enemy of action. "Be more strategic" or "communicate better" gives the rider nowhere to step. Script the specific moves — the concrete behaviors that matter most — so there's no interpretation left to stall on.`,
    why: `What looks like resistance is often a lack of clarity. When the next move is unambiguous, people do it; when it's vague, they freeze and call it overwhelm. Scripting removes the paralysis of too many choices.`,
    example: `"Eat healthier" fails. "Buy 1% milk instead of whole" succeeded — one scripted move that shifted an entire population's fat intake.`,
    rep: `Turn one vague intention of your own into a scripted, specific move — so concrete you couldn't talk yourself out of it.`,
  },
  {
    title: 'Point to the Destination', abc: 'Courage', sw: 'Direct the mind', sub: 'Paint a destination worth the climb',
    teach: `You need to see where you're going and why it's worth it — a vivid "destination postcard" of your own future in sensory, specific terms. Clarity about the finish pulls you forward when the middle gets hard and your motivation dips.`,
    why: `A goal in numbers motivates your rider; a picture motivates your elephant. When both can see the same destination, they stop fighting and start pulling together — and you self-correct toward it without white-knuckling every step.`,
    example: `"Get in shape" moved me for a week. "A year from now I hike the rim-to-rim with my daughter and keep up easily" — that I could see, and it pulled.`,
    rep: `Write the one-line destination postcard for a change you're making — vivid enough that you can picture the day you're living it.`,
  },
  {
    title: 'Rally the Herd', abc: 'Courage', sw: 'Shape the path', sub: 'Put yourself in the herd going where you want to go',
    teach: `Behavior is contagious — you become like the people you spend time with, whether you chose them for that or not. So change is less about willpower and more about proximity: surround yourself with people already living the change, and let belonging pull you where pressure can't.`,
    why: `You can white-knuckle against your environment for a while, but the herd almost always wins in the end. Pick the herd on purpose and it stops being a fight — the new normal becomes simply what's around you.`,
    example: `The fastest way to run more isn't discipline — it's joining people for whom a morning run is just what Tuesday looks like. Their normal becomes yours.`,
    rep: `Put yourself near one person or group already living the change you want — join, message, or show up somewhere this week.`,
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="website"
  ogTitle="Making Change Stick — a nine-part workout series"
  ogDescription="Why change is hard, and the nine moves that make it stick — for you and the people you lead."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <article>
    <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><a href={SLUGS.workouts} style="color:inherit;text-decoration:none;">Workouts</a><span>/</span><span style="color:#C04A26;">Making Change Stick</span>
      </nav>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:20px;">
        <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;">Workout Series · 9 parts</span>
        <span style="width:4px;height:4px;border-radius:50%;background:#B4A98E;"></span>
        <span style="font-size:11.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A7F6C;">Awareness · Beliefs · Courage</span>
      </div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(40px,6vw,68px);line-height:1.0;letter-spacing:-0.022em;color:#1B1810;">Making change stick.</h1>
      <p style="margin-top:24px;font-size:19px;line-height:1.6;color:#2E2A22;max-width:54ch;">Change is hard for a reason: it asks three different things at once. The thinking mind needs <em style="font-style:italic;">clarity</em>. The feeling self needs <em style="font-style:italic;">motivation</em>. And the world around you needs to make the new way <em style="font-style:italic;">easy</em>. Miss one, and you snap back.</p>
      <p style="margin-top:16px;font-size:17px;line-height:1.6;color:#2E2A22;max-width:54ch;">Nine moves, in three acts. Work one a week, or read them straight through. Each is a full workout — open any part below.</p>
      <p style="margin-top:16px;font-size:14.5px;color:#8A7F6C;">Applies the <em style="font-style:italic;">Switch: How to Change Things When Change Is Hard</em> framework by Chip &amp; Dan Heath, run through the ABCs of the legendary mindset.</p>
    </header>

    <!-- THREE ACTS -->
    <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:14px;padding:22px 22px;"><span style="font-family:'Newsreader',serif;font-size:26px;color:#E0744A;">A</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;margin:6px 0;color:#FBF8F1;">Awareness</h3><p style="font-size:13.5px;line-height:1.5;color:rgba(244,240,231,0.72);">Direct the mind. Give the change a clear script and a clear destination.</p></div>
        <div style="background:#15130E;color:#F4F0E7;border-radius:14px;padding:22px 22px;"><span style="font-family:'Newsreader',serif;font-size:26px;color:#E0744A;">B</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;margin:6px 0;color:#FBF8F1;">Beliefs</h3><p style="font-size:13.5px;line-height:1.5;color:rgba(244,240,231,0.72);">Move the heart. People change when they feel something, not when they're told.</p></div>
        <div style="background:#15130E;color:#F4F0E7;border-radius:14px;padding:22px 22px;"><span style="font-family:'Newsreader',serif;font-size:26px;color:#E0744A;">C</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;margin:6px 0;color:#FBF8F1;">Courage</h3><p style="font-size:13.5px;line-height:1.5;color:rgba(244,240,231,0.72);">Shape the path. Make the first step small and the environment do the work.</p></div>
      </div>
    </section>

    <!-- NINE PARTS — ACCORDION -->
    <section style="max-width:820px;margin:40px auto 0;padding:0 32px;">
      <div style="display:flex;flex-direction:column;gap:12px;">
        {parts.map((p, i) => {
          const isOpen = open === i;
          return (
            <div data-mcs-card style={`border-radius:16px;overflow:hidden;border:1px solid ${isOpen ? 'rgba(192,74,38,0.45)' : 'rgba(27,24,16,0.12)'};background:${isOpen ? '#FBF8F1' : '#F4F0E7'};transition:border-color .18s;`}>
              <button data-mcs-btn type="button" style="width:100%;display:flex;align-items:center;gap:16px;background:none;border:none;cursor:pointer;text-align:left;padding:22px 26px;font-family:'Hanken Grotesk',sans-serif;">
                <span data-mcs-num style={`font-family:'Newsreader',serif;font-size:26px;color:${isOpen ? '#C04A26' : '#B4A98E'};flex:none;width:34px;`}>{String(i + 1)}</span>
                <span style="flex:1;min-width:0;">
                  <span style="display:block;font-family:'Newsreader',serif;font-size:22px;line-height:1.15;color:#1B1810;">{p.title}</span>
                  <span style="display:block;font-size:13px;color:#9A8E78;margin-top:3px;">{p.sub}</span>
                </span>
                <span style="flex:none;display:flex;align-items:center;gap:12px;">
                  <span data-mcs-tag style={`font-size:10.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:${isOpen ? '#C04A26' : '#8A7F6C'};background:${isOpen ? 'rgba(192,74,38,0.1)' : 'rgba(27,24,16,0.05)'};padding:5px 10px;border-radius:999px;white-space:nowrap;`}>{p.abc}</span>
                  <span data-mcs-icon style={`flex:none;font-size:24px;font-weight:300;color:#C04A26;transition:transform .25s;transform:rotate(${isOpen ? '45deg' : '0deg'});`}>+</span>
                </span>
              </button>
              <div data-mcs-panel style={`overflow:hidden;transition:max-height .35s ease,opacity .3s;max-height:${isOpen ? '900px' : '0'};opacity:${isOpen ? '1' : '0'};`}>
                <div style="padding:0 26px 28px 76px;">
                  <p style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">{p.abc} · {p.sw}</p>
                  <p style="font-size:17px;line-height:1.7;color:#2E2A22;margin-bottom:18px;">{p.teach}</p>
                  <p style="font-size:16px;line-height:1.65;color:#56524A;margin-bottom:20px;"><strong style="color:#1B1810;font-weight:700;">Why it matters:</strong> {p.why}</p>
                  <div style="background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:16px 20px;margin-bottom:18px;">
                    <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A7F6C;margin-bottom:6px;">In practice</p>
                    <p style="font-size:15.5px;line-height:1.6;color:#2E2A22;">{p.example}</p>
                  </div>
                  <div style="background:#15130E;border-radius:12px;padding:18px 20px;">
                    <p style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:6px;">Your rep this week</p>
                    <p style="font-size:15.5px;line-height:1.55;color:#E7E0D2;">{p.rep}</p>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- COMPLETE + TRACK -->
    <section id="complete" style="max-width:820px;margin:44px auto 0;padding:0 32px 40px;">
      <MwComplete
        workoutId="making-change-stick"
        dim="Mental"
        dimLabel="Mental"
        notePlaceholder="The change I'm making stick, and my first small step…"
        doneHead="Series logged. Change is a practice."
      />

      <MwCommitment
        workoutId="making-change-stick"
        dim="Mental"
        dimLabel="Mental"
        c1="When I finish brushing my teeth, instead of moving on, ||I will do one rep of the habit I'm building."
        c2="When I sit down at my desk, instead of opening email, ||I will name today's one small step out loud."
        c3="When I miss a day, instead of quitting, ||I will just restart the next morning — no story about it."
        willPh="do one rep of the new habit"
      />
    </section>
    </article>

  </div>

  <MwRelated current="making-change-stick" />

  <SiteFooter audience="leaders" variant="slim" />

  <script>
    (function () {
      const cards = Array.from(document.querySelectorAll('[data-mcs-card]'));
      let open = 0;
      function style(card, isOpen) {
        card.style.border = '1px solid ' + (isOpen ? 'rgba(192,74,38,0.45)' : 'rgba(27,24,16,0.12)');
        card.style.background = isOpen ? '#FBF8F1' : '#F4F0E7';
        const num = card.querySelector('[data-mcs-num]');
        if (num) num.style.color = isOpen ? '#C04A26' : '#B4A98E';
        const tag = card.querySelector('[data-mcs-tag]');
        if (tag) { tag.style.color = isOpen ? '#C04A26' : '#8A7F6C'; tag.style.background = isOpen ? 'rgba(192,74,38,0.1)' : 'rgba(27,24,16,0.05)'; }
        const icon = card.querySelector('[data-mcs-icon]');
        if (icon) icon.style.transform = 'rotate(' + (isOpen ? '45deg' : '0deg') + ')';
        const panel = card.querySelector('[data-mcs-panel]');
        if (panel) { panel.style.maxHeight = isOpen ? '900px' : '0'; panel.style.opacity = isOpen ? '1' : '0'; }
      }
      cards.forEach(function (card, i) {
        const btn = card.querySelector('[data-mcs-btn]');
        if (btn) btn.addEventListener('click', function () {
          open = (open === i) ? -1 : i;
          cards.forEach(function (c, j) { style(c, open === j); });
        });
      });
    })();
  </script>
</BaseLayout>
