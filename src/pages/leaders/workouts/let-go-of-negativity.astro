---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MwRelated from '../../../components/MwRelated.astro';
import MwComplete from '../../../components/MwComplete.astro';
import MwCommitment from '../../../components/MwCommitment.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../../lib/site';

const path = workoutPath('let-go-of-negativity');
const title = "Let Go of Negativity — put down what you've been carrying";
const description =
  "The grudge, the story, the resentment you're still holding isn't punishing anyone but you. Name one and set it down — it's been carrying you. Free.";

const canonical = new URL(path, SITE_URL).href;

// JSON-LD: the design's LearningResource enriched with entity @ids, plus a
// HowTo built from the "Time for Action" rep so the workout surfaces as a task.
const schema = [
  {
    '@type': 'LearningResource',
    '@id': `${canonical}#learningresource`,
    name: 'Let Go of Negativity',
    learningResourceType: 'Mindset warmup and workout',
    teaches: 'Releasing grudges, resentment, and negative stories',
    educationalLevel: 'Executive / founder',
    isAccessibleForFree: true,
    timeRequired: 'PT10M',
    author: { '@id': PERSON_ID },
    provider: { '@id': ORG_ID },
  },
  {
    '@type': 'HowTo',
    '@id': `${canonical}#howto`,
    name: 'Catch the tape, then choose the other story',
    description:
      "A daily rep for releasing resentment: catch the old story when it starts to play, deliberately tell the other true version, and let the rest go.",
    totalTime: 'PT10M',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Catch the tape',
        text: "Each day, when the old resentment starts to play — and it will — catch it.",
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Choose the other story',
        text: 'Deliberately tell the other true version instead. Write the eviction notice if it helps: name it, name the lesson.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Let the rest go',
        text: 'Put the rest down. Do it daily and the tape gets quieter, because you stop feeding it.',
      },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Let Go of Negativity — put down what you've been carrying"
  ogDescription="The resentment you're holding isn't punishing anyone but you. Set one down."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <header style="max-width:1000px;margin:0 auto;padding:52px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:24px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><a href={SLUGS.workouts} style="color:inherit;text-decoration:none;">Mindset Workouts</a><span>/</span><span style="color:#C04A26;">Let Go of Negativity</span>
      </nav>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:22px;">
        <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Emotional</span>
        <span style="width:4px;height:4px;border-radius:50%;background:#6E6757;"></span>
        <span style="font-size:11.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8C8473;">Warmup · ~3 min</span>
      </div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(40px,6.6vw,74px);line-height:0.98;letter-spacing:-0.025em;color:#1B1810;">Let Go of Negativity</h1>
      <p style="margin-top:24px;font-size:19px;line-height:1.6;color:#56524A;max-width:52ch;">You're carrying something. A grudge, a story about how you were wronged, a resentment you've rehearsed so many times it feels like fact. Here's the trap: it isn't punishing them. <em style="font-style:italic;color:#C04A26;">It's been carrying you.</em></p>
    </header>

    <section style="max-width:760px;margin:44px auto 0;padding:0 32px;">
      <p style="font-size:19px;line-height:1.65;color:#3A362E;margin-bottom:22px;">Resentment feels like strength — like you're holding someone accountable. But the person you're angry at is asleep tonight while you run the tape again. You're paying rent on a room they moved out of years ago. The story you keep telling isn't the truth; it's a <em style="font-style:italic;">choice</em>, made so many times it stopped feeling like one.</p>
      <figure style="margin:0 0 24px;border-left:3px solid #C04A26;padding:6px 0 6px 26px;">
        <blockquote style="font-family:'Newsreader',serif;font-style:italic;font-size:clamp(21px,2.7vw,28px);line-height:1.36;color:#1B1810;">Holding a grudge is letting someone live rent-free in your head. Letting go isn't forgiveness for them. It's eviction, for you.</blockquote>
      </figure>
      <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.12);border-radius:16px;padding:28px 30px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Warmup · one reflection</p>
        <p style="font-size:18px;line-height:1.6;color:#1B1810;">Name one thing you're still carrying — a person, a slight, a story. Just name it, out loud. Notice how automatically the whole narrative loads. That automatic loading is the weight.</p>
      </div>
    </section>

    <!-- GO DEEPER -->
    <section style="max-width:760px;margin:34px auto 0;padding:0 32px;">
      <div id="go-deep-prompt" style="display:block;">
        <button id="go-deep-btn" type="button" style="width:100%;cursor:pointer;background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(224,116,74,0.4);border-radius:16px;padding:26px 30px;text-align:left;font-family:'Hanken Grotesk',sans-serif;" onmouseover="this.style.borderColor='rgba(224,116,74,0.75)'" onmouseout="this.style.borderColor='rgba(224,116,74,0.4)'">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;">
            <div>
              <span style="display:block;font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:8px;">The workout · ~10 min + optional 30 days</span>
              <span style="display:block;font-family:'Newsreader',serif;font-size:23px;color:#FBF8F1;line-height:1.2;">Want to go deeper and actually set it down?</span>
            </div>
            <span style="flex:none;font-size:26px;color:#E0744A;">&darr;</span>
          </div>
        </button>
      </div>
    </section>

    <div id="go-deep-content" style="display:none;">
      <section style="max-width:760px;margin:40px auto 0;padding:0 32px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">The workout · rewrite the story</p>
        <div style="font-size:18px;line-height:1.72;color:#3A362E;">
          <p style="margin-bottom:20px;">You can't delete a memory, but you can change the <em style="font-style:italic;">story</em> you tell about it — and the story is where the weight lives. Two people get passed over for the same promotion. One tells the story "I was betrayed" and carries it for a decade. The other tells the story "that's the day I decided to bet on myself" and builds a company. Same facts. Different rent.</p>
          <p style="margin-bottom:20px;">Letting go isn't pretending it didn't happen, and it isn't excusing them. It's refusing to keep paying. You acknowledge the hurt was real, you take whatever the lesson was, and you <strong style="color:#1B1810;">put the rest down</strong> — because your hands are needed for what's ahead, not for gripping what's behind.</p>
        </div>
      </section>

      <section style="max-width:760px;margin:40px auto 0;padding:0 32px;">
        <div style="border-top:1px solid rgba(27,24,16,0.14);padding-top:34px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">Reflect</p>
          <div style="display:flex;flex-direction:column;gap:18px;">
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">1</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">What has this grudge actually cost you — in energy, in sleep, in who you've become while carrying it?</p></div>
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">2</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">If the story could serve you instead of weigh on you, what's the other true way to tell it?</p></div>
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">3</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">What would you do with the energy you'd get back if you set it down today?</p></div>
          </div>
        </div>
      </section>

      <section style="max-width:760px;margin:38px auto 0;padding:0 32px;">
        <div style="background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:34px 36px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;"><span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Time for Action</span><span style="font-size:12px;color:#8C8473;">one rep · daily</span></div>
          <p style="font-family:'Newsreader',serif;font-weight:400;font-size:26px;line-height:1.25;color:#FBF8F1;margin-bottom:14px;">Catch the tape. Then choose the other story.</p>
          <p style="font-size:16px;line-height:1.62;color:rgba(244,240,231,0.78);">Each day, when the old resentment starts to play — and it will — catch it, and deliberately tell the other true version instead. Write the eviction notice if it helps: name it, name the lesson, and let the rest go. Do it daily and the tape gets quieter, because you stop feeding it.</p>
        </div>
      </section>

      <MwComplete
        workoutId="let-go-of-negativity"
        dim="Emotional"
        dimLabel="Emotional"
        notePlaceholder="The story I'm setting down is…"
        doneHead="Set down."
        doneBody="Your hands are free for what's ahead. Keep evicting the tape when it tries to move back in."
        nextHref={workoutPath('count-your-blessings')}
        nextCta="Refill the space · Count Your Blessings"
      />

      <MwCommitment
        workoutId="let-go-of-negativity"
        dim="Emotional"
        dimLabel="Emotional"
        c1="When I catch myself replaying an old grievance, instead of feeding it, ||I will take one breath and set it down."
        c2="When I brush my teeth at night, instead of rehearsing what upset me, ||I will name one thing I'm choosing to release."
        c3="When I feel the pull to vent, instead of typing it, ||I will put the phone down for ten seconds."
        willPh="set one story down"
      />
    </div>

  </div>

  <div style="max-width:820px;margin:36px auto 0;padding:0 32px;">
    <a href={SLUGS.gratitude} style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:rgba(180,138,217,0.1);border:1px solid rgba(180,138,217,0.35);border-radius:16px;padding:26px 30px;flex-wrap:wrap;" onmouseover="this.style.borderColor='rgba(180,138,217,0.7)'" onmouseout="this.style.borderColor='rgba(180,138,217,0.35)'">
      <div style="flex:1;min-width:260px;">
        <p style="font-family:'Newsreader',serif;font-size:21px;color:#FBF8F1;line-height:1.15;">Refill the space with gratitude.</p>
        <p style="margin-top:7px;font-size:14.5px;line-height:1.5;color:rgba(244,240,231,0.7);">Once you&rsquo;ve set the negativity down, level up the antidote &mdash; our short gratitude course.</p>
      </div>
      <span style="font-weight:700;color:#C79BE6;font-size:15px;white-space:nowrap;">Level Up Your Gratitude &rarr;</span>
    </a>
  </div>

  <MwRelated current="let-go-of-negativity" />

  <SiteFooter audience="leaders" variant="slim" />

  <script>
    (function () {
      const btn = document.getElementById('go-deep-btn');
      const prompt = document.getElementById('go-deep-prompt');
      const content = document.getElementById('go-deep-content');
      if (btn && prompt && content) {
        btn.addEventListener('click', function () {
          prompt.style.display = 'none';
          content.style.display = 'block';
        });
      }
    })();
  </script>
</BaseLayout>
