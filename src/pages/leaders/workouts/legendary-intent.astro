---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MwComplete from '../../../components/MwComplete.astro';
import MwCommitment from '../../../components/MwCommitment.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../../lib/site';

const path = workoutPath('legendary-intent');
const title = 'The Legendary Intent Workout | Mindset Gym';
const description =
  "Finish one sentence — 'If I accomplish nothing else, I will ___' — and you have a filter that makes a thousand decisions. Decide who you intend to be.";

const canonical = new URL(path, SITE_URL).href;

// JSON-LD: the design's LearningResource enriched with entity @ids, a HowTo
// (the "Time for Action" daily filter rep), and a DefinedTerm for the concept.
const schema = [
  {
    '@type': 'LearningResource',
    '@id': `${canonical}#learningresource`,
    name: 'Legendary Intent — your one-line leadership filter',
    learningResourceType: 'Mindset warmup and workout',
    teaches: 'Defining a single guiding intent that filters decisions',
    educationalLevel: 'Executive / founder',
    isAccessibleForFree: true,
    timeRequired: 'PT10M',
    author: { '@id': PERSON_ID },
    provider: { '@id': ORG_ID },
  },
  {
    '@type': 'HowTo',
    '@id': `${canonical}#howto`,
    name: 'Run your day through your intent',
    description:
      'A daily rep in leading on purpose: keep your one-line intent where you can see it, test the day’s biggest decision against it before you act, and repeat until it becomes the way you decide.',
    totalTime: 'PT10M',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: "Put your intent where you'll see it",
        text: "Write your one-line intent and place it where you'll read it each morning.",
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Test the biggest decision',
        text: 'Pick the day’s biggest decision and consciously ask whether it serves the intent before you act.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Repeat daily',
        text: 'Do it every day until the filter stops being a card on your desk and becomes the way you decide.',
      },
    ],
  },
  {
    '@type': 'DefinedTerm',
    '@id': `${canonical}#term`,
    name: 'Legendary Intent',
    description:
      'A Legendary Intent is a single guiding line — the one thing you refuse to leave undone — that works as a decision filter. Unlike a goal (which gets crossed off) or a mission statement (which changes nothing), an intent is short enough to hold in your head mid-meeting and testable enough that a real decision can pass or fail it.',
    inDefinedTermSet: 'Be Legendary',
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Legendary Intent — your one-line leadership filter"
  ogDescription="If I accomplish nothing else in this life, I will ___. Decide who you intend to be."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <header style="max-width:1000px;margin:0 auto;padding:52px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:24px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><a href={SLUGS.workouts} style="color:inherit;text-decoration:none;">Mindset Workouts</a><span>/</span><span style="color:#C04A26;">Legendary Intent</span>
      </nav>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:22px;">
        <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0A34A;">Mental</span>
        <span style="width:4px;height:4px;border-radius:50%;background:#6E6757;"></span>
        <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#B48AD9;">Spiritual</span>
        <span style="width:4px;height:4px;border-radius:50%;background:#6E6757;"></span>
        <span style="font-size:11.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8C8473;">Warmup · ~3 min</span>
      </div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(42px,7vw,78px);line-height:0.98;letter-spacing:-0.025em;color:#1B1810;">Legendary Intent</h1>
      <p style="margin-top:24px;font-size:19px;line-height:1.6;color:#56524A;max-width:52ch;">Most leaders have a to-do list a mile long and no single line at the top of it that decides the rest. This is that line — one sentence that filters a thousand choices, so you stop reacting to the day and start <em style="font-style:italic;color:#C04A26;">leading it.</em></p>
    </header>

    <section style="max-width:760px;margin:44px auto 0;padding:0 32px;">
      <figure style="margin:0 0 24px;border-left:3px solid #C04A26;padding:10px 0 10px 26px;">
        <blockquote style="font-family:'Newsreader',serif;font-style:italic;font-size:clamp(23px,3.2vw,34px);line-height:1.28;color:#1B1810;">"If I accomplish nothing else in this life, I will ______________."</blockquote>
      </figure>
      <p style="font-size:19px;line-height:1.65;color:#3A362E;margin-bottom:22px;">Finish that sentence honestly and you've written your Legendary Intent. Not a goal — goals get crossed off. Not a mission statement — those live on walls and change nothing. An <strong style="color:#1B1810;">intent</strong> is the one thing you refuse to leave undone, the standard you'd hold even if no one ever saw it. Once it's clear, the hard calls get easier: does this serve the intent, or not?</p>
      <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.12);border-radius:16px;padding:28px 30px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Warmup · one reflection</p>
        <p style="font-size:18px;line-height:1.6;color:#1B1810;">Say it out loud, filling the blank with the first thing that's actually true: <em style="font-style:italic;">"If I accomplish nothing else in this life, I will ___."</em> Don't polish it. Just notice what came out — that's the raw material.</p>
      </div>
    </section>

    <section style="max-width:760px;margin:34px auto 0;padding:0 32px;">
      <div id="go-deep-prompt" style="display:block;">
        <button id="go-deep-btn" type="button" style="width:100%;cursor:pointer;background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(224,116,74,0.4);border-radius:16px;padding:26px 30px;text-align:left;font-family:'Hanken Grotesk',sans-serif;" onmouseover="this.style.borderColor='rgba(224,116,74,0.75)'" onmouseout="this.style.borderColor='rgba(224,116,74,0.4)'">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;">
            <div>
              <span style="display:block;font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:8px;">The workout · ~10 min + optional 30 days</span>
              <span style="display:block;font-family:'Newsreader',serif;font-size:23px;color:#FBF8F1;line-height:1.2;">Want to go deeper and sharpen it into a filter?</span>
            </div>
            <span style="flex:none;font-size:26px;color:#E0744A;">&darr;</span>
          </div>
        </button>
      </div>
    </section>

    <div id="go-deep-content" style="display:none;">
      <section style="max-width:760px;margin:40px auto 0;padding:0 32px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">The workout · make it a filter</p>
        <div style="font-size:18px;line-height:1.72;color:#3A362E;">
          <p style="margin-bottom:20px;">A raw intent is a feeling. A useful one is a <strong style="color:#1B1810;">filter</strong> — short enough to hold in your head mid-meeting, specific enough to answer a real question. "Be a good leader" filters nothing. "Leave every person better than I found them" filters everything: this hire, this feedback, this email you're about to fire off at 11pm.</p>
          <p style="margin-bottom:20px;">Sharpen yours in three passes. <strong style="color:#1B1810;">Cut it to one line</strong> you could say from memory. <strong style="color:#1B1810;">Make it testable</strong> — could a decision actually pass or fail it? <strong style="color:#1B1810;">Make it yours</strong> — not the impressive version, the true one. When it's right, you'll feel a small click: that's the tuning fork.</p>
        </div>
      </section>

      <section style="max-width:760px;margin:40px auto 0;padding:0 32px;">
        <div style="border-top:1px solid rgba(27,24,16,0.14);padding-top:34px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">Reflect</p>
          <div style="display:flex;flex-direction:column;gap:18px;">
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">1</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">Write your intent in one line you could recite with your eyes closed. Read it back — does it sound like <em style="font-style:italic;">you</em>, or like a LinkedIn post?</p></div>
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">2</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">Take a real decision on your plate right now. Run it through the line. Does it pass or fail? If the line can't tell you, sharpen it.</p></div>
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">3</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">Where are you currently spending time and energy that your intent would quietly veto?</p></div>
          </div>
        </div>
      </section>

      <section style="max-width:760px;margin:38px auto 0;padding:0 32px;">
        <div style="background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:34px 36px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;"><span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Time for Action</span><span style="font-size:12px;color:#8C8473;">one rep · daily</span></div>
          <p style="font-family:'Newsreader',serif;font-weight:400;font-size:26px;line-height:1.25;color:#FBF8F1;margin-bottom:14px;">Run one real decision through your intent — every day.</p>
          <p style="font-size:16px;line-height:1.62;color:rgba(244,240,231,0.78);">Put your one line where you'll see it each morning. Then pick the day's biggest decision and consciously test it against the intent before you act. Do it daily and the filter stops being a card on your desk and becomes the way you actually decide.</p>
        </div>
      </section>

      <MwComplete
        workoutId="legendary-intent"
        dim="Spiritual"
        dimLabel="Mental & Spiritual"
        notePlaceholder="My Legendary Intent, in one line, is…"
        doneHead="Intent — set."
        doneBody="You have a line at the top of the list now. Let it make the hard calls for you."
        nextHref={workoutPath('find-your-why')}
        nextCta="Go deeper on purpose · Find Your Why"
      />

      <MwCommitment
        workoutId="legendary-intent"
        dim="Spiritual"
        dimLabel="Mental & Spiritual"
        c1="When I open my laptop, instead of the inbox, ||I will read my Legendary Intent once."
        c2="When I face a hard call, instead of deciding fast, ||I will ask 'does this serve my intent?' once."
        c3="When I brush my teeth in the morning, instead of zoning out, ||I will say my intent out loud."
        willPh="read my intent once"
      />
    </div>

  </div>

  <SiteFooter audience="leaders" variant="slim" />

  <script>
    (function () {
      const btn = document.getElementById('go-deep-btn');
      const prompt = document.getElementById('go-deep-prompt');
      const content = document.getElementById('go-deep-content');
      if (btn && prompt && content) {
        btn.addEventListener('click', function () {
          prompt.style.display = 'none';
          content.style.display = 'block';
        });
      }
    })();
  </script>
</BaseLayout>
