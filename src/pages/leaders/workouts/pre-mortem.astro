---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MwComplete from '../../../components/MwComplete.astro';
import MwCommitment from '../../../components/MwCommitment.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../../lib/site';

const path = workoutPath('pre-mortem');
const title = 'Mindset Workout: Pre-Mortem & Backcasting — See the Failure Before It Happens | Be Legendary';
const description =
  'Two foresight tools in one workout. Pre-mortem: imagine the project has failed and work backward to what killed it. Backcasting: imagine it succeeded and work backward to what you did right. See the future clearly, then change the present. From Be Legendary.';

const canonical = new URL(path, SITE_URL).href;

// JSON-LD: the design's LearningResource + FAQPage (verbatim Q&A), enriched with
// entity @ids, plus a HowTo built from the Reflect + Time-for-Action reps.
const schema = [
  {
    '@type': 'LearningResource',
    '@id': `${canonical}#learningresource`,
    name: 'Pre-Mortem & Backcasting — Mindset Workout',
    learningResourceType: 'Guided mindset workout',
    teaches:
      'Foresight: imagine failure (pre-mortem) and success (backcasting) to change what you do now',
    timeRequired: 'PT12M',
    isAccessibleForFree: true,
    author: { '@id': PERSON_ID },
    provider: { '@id': ORG_ID },
    description:
      'A foresight workout combining the pre-mortem (Gary Klein) and backcasting (John B. Robinson) to surface risks and success factors before you act.',
  },
  {
    '@type': 'HowTo',
    '@id': `${canonical}#howto`,
    name: 'Run a pre-mortem and a backcast, then take one move',
    description:
      'Pick something that matters, imagine it failed, imagine it succeeded, then act on the single most important risk to defuse or move to start.',
    totalTime: 'PT12M',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Pre-mortem',
        text: 'A year from now this failed. Name the three most believable reasons why.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Backcast',
        text: 'A year from now it succeeded beyond what you hoped. Name the three things you did that made the difference.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Take one move',
        text: 'Of those six, pick the one risk to defuse or move to start, and make it real before the week is out.',
      },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a pre-mortem?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "A pre-mortem is a foresight exercise, developed by psychologist Gary Klein, in which you imagine that a plan has already failed — then work backward to explain what went wrong. Because it gives people permission to voice doubts as certainties, it surfaces risks that optimism and groupthink normally hide, while there's still time to prevent them.",
        },
      },
      {
        '@type': 'Question',
        name: 'What is backcasting, and how is it different from a pre-mortem?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Backcasting, coined by John B. Robinson in 1982, is the mirror image: you assume you've reached your goal, then look back at everything you did right to get there. A pre-mortem imagines failure to surface risks; backcasting imagines success to surface the path. Used together, one shows you what to avoid and the other shows you what to do.",
        },
      },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Pre-Mortem & Backcasting — A Mindset Workout on Foresight"
  ogDescription="Imagine you failed. Now imagine you won. Work backward from both — and change the present."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <article>
    <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><a href={SLUGS.workouts} style="color:inherit;text-decoration:none;">Workouts</a><span>/</span><span style="color:#C04A26;">Pre-Mortem &amp; Backcasting</span>
      </nav>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:20px;">
        <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;">Workout · Awareness (Mental)</span>
        <span style="width:4px;height:4px;border-radius:50%;background:#B4A98E;"></span>
        <span style="font-size:11.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A7F6C;">~12 min</span>
      </div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(38px,6vw,66px);line-height:1.0;letter-spacing:-0.022em;color:#1B1810;">Prevent your next failure.</h1>
      <p style="margin-top:22px;font-size:19px;line-height:1.6;color:#2E2A22;max-width:52ch;">Most leaders plan forward and get blindsided. This workout runs time backward — twice. First you imagine you <em style="font-style:italic;">failed</em> and ask what killed you. Then you imagine you <em style="font-style:italic;">won</em> and ask what you did right. Both change what you do today.</p>
      <div style="margin-top:26px;background:#F4F0E7;border-left:3px solid #C04A26;border-radius:0 12px 12px 0;padding:18px 22px;max-width:52ch;">
        <p style="font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A7F6C;margin-bottom:6px;">What this protects</p>
        <p style="font-size:16px;line-height:1.6;color:#2E2A22;">You, from avoidable failure — and the version of you that gets blindsided because optimism buried the risk. Run it often and you stop being surprised by the things you could have seen coming.</p>
      </div>
    </header>

    <!-- VIDEO SLOT -->
    <div style="max-width:820px;margin:40px auto 0;padding:0 32px;">
      <div style="position:relative;aspect-ratio:16/9;border-radius:16px;overflow:hidden;background:repeating-linear-gradient(135deg,#211D15,#211D15 13px,#262116 13px,#262116 26px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;border:1px solid rgba(27,24,16,0.12);">
        <span style="width:66px;height:66px;border-radius:999px;background:rgba(192,74,38,0.94);display:flex;align-items:center;justify-content:center;color:#fff;font-size:22px;padding-left:5px;">&#9658;</span>
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#8A7F6C;background:rgba(244,240,231,0.85);padding:7px 12px;border-radius:8px;text-align:center;max-width:80%;">video slot — Pre-Mortem intro (drop in your hosted embed)</span>
      </div>
    </div>

    <!-- WHY -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">Why this works</p>
      <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
        <p style="margin-bottom:22px;">When you ask a team "what could go wrong?" they hedge — nobody wants to be the pessimist. But when you say "it's a year from now and this <em style="font-style:italic;">failed</em> — what happened?", the doubts pour out. Certainty gives permission that speculation doesn't. That's the psychologist Gary Klein's pre-mortem, and it surfaces the risks optimism buries.</p>
        <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">Hindsight is 20/20. A pre-mortem borrows it — before you need it.</p>
        <p>Backcasting flips the lens. Instead of forecasting forward from today's constraints, you stand in the finished success and look back at the path. It frees you from "what's realistic now" and reveals the moves that actually got you there. One tool shows you the cliffs; the other shows you the trail.</p>
      </div>
    </section>

    <!-- TWO LENSES -->
    <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div style="background:#15130E;color:#F4F0E7;border-radius:16px;padding:28px 28px;">
          <p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:10px;">Lens 1 · Pre-mortem</p>
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:23px;color:#FBF8F1;margin-bottom:12px;">"It failed. What killed it?"</h3>
          <p style="font-size:15px;line-height:1.6;color:rgba(244,240,231,0.78);">It's a year out. The thing you care about most has collapsed. Write the obituary — the real reasons, the ones you can already half-see. Each one is a risk you can defuse now.</p>
        </div>
        <div style="background:#F4F0E7;border:1px solid rgba(27,24,16,0.12);border-radius:16px;padding:28px 28px;">
          <p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:10px;">Lens 2 · Backcasting</p>
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:23px;color:#1B1810;margin-bottom:12px;">"It worked. What did I do right?"</h3>
          <p style="font-size:15px;line-height:1.6;color:#56524A;">Same year out. It succeeded beyond expectation. Look back and trace the path — the decisions, habits and bets that got you there. Each one is a move you can start now.</p>
        </div>
      </div>
    </section>

    <!-- REFLECT -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <div style="border-top:1px solid rgba(27,24,16,0.14);padding-top:40px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:22px;">Reflect · pick something that matters and run both</p>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div style="display:flex;gap:16px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:22px;color:#C04A26;flex:none;line-height:1.3;">1</span><p style="font-size:18px;line-height:1.55;color:#1B1810;"><strong style="font-weight:700;">Pre-mortem:</strong> a year from now this failed. Name the three most believable reasons why.</p></div>
          <div style="display:flex;gap:16px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:22px;color:#C04A26;flex:none;line-height:1.3;">2</span><p style="font-size:18px;line-height:1.55;color:#1B1810;"><strong style="font-weight:700;">Backcast:</strong> a year from now it succeeded beyond what you hoped. What are the three things you did that made the difference?</p></div>
          <div style="display:flex;gap:16px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:22px;color:#C04A26;flex:none;line-height:1.3;">3</span><p style="font-size:18px;line-height:1.55;color:#1B1810;">Of those six, which <em style="font-style:italic;">one</em> — a risk to defuse or a move to start — would you act on this week?</p></div>
        </div>
      </div>
    </section>

    <!-- TIME FOR ACTION -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <div style="background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:36px 38px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Time for action</span>
          <span style="font-size:12px;color:#8C8473;">this week</span>
        </div>
        <p style="font-family:'Newsreader',serif;font-weight:400;font-size:27px;line-height:1.25;color:#FBF8F1;margin-bottom:16px;">Take your one move — and make it real before the week is out.</p>
        <p style="font-size:16.5px;line-height:1.65;color:rgba(244,240,231,0.78);">Defuse the risk or take the first step of the path. Then, if you lead a team, run the pre-mortem <em style="font-style:italic;">with</em> them on your next big bet — "it's failed, what happened?" — and watch what surfaces.</p>
      </div>
    </section>

    <!-- COMPLETE + TRACK -->
    <MwComplete
      workoutId="pre-mortem"
      dim="Mental"
      dimLabel="Mental"
      notePlaceholder="The one risk or move I'll act on this week…"
    />

    <MwCommitment
      workoutId="pre-mortem"
      dim="Mental"
      dimLabel="Mental"
      c1="When I start a new plan, instead of diving in, ||I will name the one way it could fail first."
      c2="When I pour my coffee, instead of listing tasks, ||I will ask 'if this week flops, why?' once."
      c3="When I'm about to commit, instead of assuming it works, ||I will write one move to prevent the worst case."
      willPh="name one way it could fail"
    />

    <!-- NEXT -->
    <section style="max-width:1000px;margin:52px auto 0;padding:0 32px 90px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <a href={workoutPath('big-rocks')} style="display:flex;flex-direction:column;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:16px;padding:28px 30px;">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">Related</span>
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:22px;color:#1B1810;margin-bottom:8px;">Big Rocks</h3>
          <p style="font-size:14.5px;line-height:1.55;color:#56524A;">Once you know the moves, put them in the jar first.</p>
        </a>
        <a href={SLUGS.workouts} style="display:flex;flex-direction:column;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:16px;padding:28px 30px;">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">Keep going</span>
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:22px;color:#1B1810;margin-bottom:8px;">Browse all workouts</h3>
          <p style="font-size:14.5px;line-height:1.55;color:#56524A;">Pick your next rep by dimension.</p>
        </a>
      </div>
    </section>
    </article>

  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
