---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MwComplete from '../../../components/MwComplete.astro';
import MwCommitment from '../../../components/MwCommitment.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../../lib/site';

const path = workoutPath('5-whys');
const title = 'Mindset Workout: The 5 Whys — Find the Real Problem | Be Legendary';
const description =
  "Ask why five times — pointed inward. The surface reaction gives way to the belief underneath it. A root-cause workout for emotional strength, from James Carter's contribution to Discover Your Inner Strength. From Be Legendary.";

const canonical = new URL(path, SITE_URL).href;

// JSON-LD: the design's LearningResource (enriched with entity @ids) + a HowTo
// built from the "Time for action" rep, plus the design's FAQPage Q&A.
const schema = [
  {
    '@type': 'LearningResource',
    '@id': `${canonical}#learningresource`,
    name: 'The 5 Whys — Mindset Workout',
    learningResourceType: 'Guided mindset workout',
    teaches:
      'Root-cause awareness: ask why five times to get past the symptom to the real problem',
    timeRequired: 'PT8M',
    isAccessibleForFree: true,
    author: { '@id': PERSON_ID },
    provider: { '@id': ORG_ID },
    description:
      'A root-cause workout from the Toyota Production System (Sakichi Toyoda): ask why five times to reach the cause worth fixing.',
  },
  {
    '@type': 'HowTo',
    '@id': `${canonical}#howto`,
    name: 'Ask why five times, inward, to reach the belief',
    description:
      'Take one thing that got to you recently and ask why five times, pointed at your own reaction, until you reach the belief underneath it.',
    totalTime: 'PT10M',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Name the reaction',
        text: 'Take one thing that got to you recently — a reaction that felt too big, a fear that keeps returning, a criticism that stung longer than it should have. Write it down.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Ask why, five times, inward',
        text: 'Ask why it got to you, then ask why of that answer, and repeat — no flinching — about five times, until you move past the easy story to the belief running the reaction.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Sit with the root',
        text: 'Sit with the belief you reached. Naming it is where the strength starts.',
      },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the 5 Whys technique?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The 5 Whys is a root-cause method developed by Sakichi Toyoda and used in the Toyota Production System. You state a problem, ask why it happened, then ask why of that answer, and repeat about five times. Each why peels back a layer of symptom until you reach the underlying cause that, if fixed, prevents the problem from recurring.',
        },
      },
      {
        '@type': 'Question',
        name: 'Why does asking why five times work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Because the first explanation is almost always a symptom, not a cause. Fixing the symptom brings the problem back. Each successive why moves from what happened toward why the system allowed it, until you hit something you can actually change at the root.',
        },
      },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="The 5 Whys — A Mindset Workout on Root Cause"
  ogDescription="The first answer is a symptom. Ask why five times and you reach the thing worth fixing."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <article>
    <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><a href={SLUGS.workouts} style="color:inherit;text-decoration:none;">Workouts</a><span>/</span><span style="color:#C04A26;">The 5 Whys</span>
      </nav>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:20px;">
        <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;">Workout · Emotional Resilience</span>
        <span style="width:4px;height:4px;border-radius:50%;background:#B4A98E;"></span>
        <span style="font-size:11.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A7F6C;">~8 min</span>
      </div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(40px,7vw,76px);line-height:1.0;letter-spacing:-0.022em;color:#1B1810;">Discover Your Inner Strength</h1>
      <p style="margin-top:22px;font-size:19px;line-height:1.6;color:#2E2A22;max-width:52ch;">The first answer to “why did that get to me?” is almost always a surface story. Ask <em style="font-style:italic;">why</em> five times — pointed at your own reaction — and the surface gives way to the belief underneath. That belief is where your emotional strength is either built or leaking.</p>
    </header>

    <!-- VIDEO -->
    <div style="max-width:820px;margin:40px auto 0;padding:0 32px;">
      <div style="position:relative;aspect-ratio:16/9;border-radius:16px;overflow:hidden;border:1px solid rgba(27,24,16,0.12);">
        <iframe src="https://www.youtube.com/embed/vlsa_RZO3z4" title="The 5 Whys" loading="lazy" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0;"></iframe>
      </div>
    </div>

    <!-- WHAT INNER STRENGTH IS -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">What inner strength actually is</p>
      <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
        <p style="margin-bottom:22px;">There are many kinds of strength. The one this workout builds is <strong style="font-weight:700;">emotional</strong> strength — the capacity to perform under stress, to stay a rock for the people counting on you while everything shakes. It's the quiet strength that decides who you are in the moment that matters most.</p>
        <p style="margin-bottom:22px;">And here's the hard truth from twenty-five years of watching leaders in crisis: emotional strain is the great equalizer. No one is immune. A sudden loss, a long illness, a business that cracks, a season you didn't see coming — life happens to us whether we're ready or not. Most of us <em style="font-style:italic;">assume</em> we have the strength. We don't actually find out until we're already in it.</p>
        <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">You cannot build the wall while the flood is rising. Inner strength is built before you need it — or it isn't there when you do.</p>
        <p>That's the whole reason this is a <em style="font-style:italic;">workout</em> and not a rescue. Emotional strength trains like any other kind: worked under load, grown in recovery, built rep by rep in ordinary weeks so it's standing when an extraordinary one arrives. You don't rise to the level of the crisis; you fall to the level of the strength you built beforehand.</p>
      </div>
    </section>

    <!-- ORIGIN -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">Turn the tool inward</p>
      <div style="font-size:19px;line-height:1.72;color:#2E2A22;">
        <p style="margin-bottom:22px;">The 5 Whys was built by Sakichi Toyoda for the Toyota factory floor: when a machine stopped, you asked why five times until you reached a cause you could fix for good. It works just as well on a stalled deal or a recurring team problem — but that's not what this workout is for.</p>
        <p style="margin-bottom:22px;">In my contribution to <em style="font-style:italic;">Discover Your Inner Strength</em>, I turned the same five whys <em style="font-style:italic;">inward</em> — at emotional reactions instead of broken machines. Because emotional strength is the great equalizer: everyone gets strained eventually, and most people don't find out whether they built the strength until they're already in the crisis. The 5 Whys is how you find the belief doing the leaking — before life tests it.</p>
        <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#1B1810;margin:34px 0;padding-left:22px;border-left:3px solid #C04A26;">Manage the reaction and it returns tomorrow. Reach the belief underneath it, and something actually changes.</p>
        <p>The thing that “got to you” today — the criticism, the slight, the fear — is a machine that stopped. Ask why, five times down, and you'll meet the belief running the whole reaction.</p>
      </div>
    </section>

    <!-- WORKED EXAMPLE -->
    <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
      <div style="background:#15130E;color:#F4F0E7;border-radius:18px;padding:34px 36px;">
        <p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:18px;">Watch it go down five layers — inward</p>
        <div style="display:flex;flex-direction:column;gap:0;">
          <div style="display:flex;gap:14px;padding:11px 0;border-bottom:1px solid rgba(244,240,231,0.1);"><span style="font-family:'Newsreader',serif;color:#8C8473;flex:none;width:64px;">Trigger</span><span style="font-size:16px;color:#E7E0D2;">That piece of criticism wrecked my whole day.</span></div>
          <div style="display:flex;gap:14px;padding:11px 0;border-bottom:1px solid rgba(244,240,231,0.1);"><span style="font-family:'Newsreader',serif;color:#E0744A;flex:none;width:64px;">Why 1</span><span style="font-size:16px;color:#E7E0D2;">Because it felt unfair. <span style="color:#8C8473;">(the easy story)</span></span></div>
          <div style="display:flex;gap:14px;padding:11px 0;border-bottom:1px solid rgba(244,240,231,0.1);"><span style="font-family:'Newsreader',serif;color:#E0744A;flex:none;width:64px;">Why 2</span><span style="font-size:16px;color:#E7E0D2;">Because I needed them to see me as excellent.</span></div>
          <div style="display:flex;gap:14px;padding:11px 0;border-bottom:1px solid rgba(244,240,231,0.1);"><span style="font-family:'Newsreader',serif;color:#E0744A;flex:none;width:64px;">Why 3</span><span style="font-size:16px;color:#E7E0D2;">Because if they don't, I feel like I'm failing.</span></div>
          <div style="display:flex;gap:14px;padding:11px 0;border-bottom:1px solid rgba(244,240,231,0.1);"><span style="font-family:'Newsreader',serif;color:#E0744A;flex:none;width:64px;">Why 4</span><span style="font-size:16px;color:#E7E0D2;">Because I've always had to earn approval to feel okay.</span></div>
          <div style="display:flex;gap:14px;padding:11px 0;"><span style="font-family:'Newsreader',serif;color:#C04A26;flex:none;width:64px;">Why 5</span><span style="font-size:16px;color:#FBF8F1;"><strong style="font-weight:700;">I believe my worth is my performance.</strong> <span style="color:#8C8473;">(the root)</span></span></div>
        </div>
        <p style="margin-top:18px;font-size:15px;line-height:1.6;color:rgba(244,240,231,0.72);">“Don't let criticism get to me” is willpower against a symptom. Loosening the belief that worth equals performance — that's where the strength actually comes from.</p>
      </div>
    </section>

    <!-- TIME FOR ACTION -->
    <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
      <div style="background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:36px 38px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Time for action</span>
          <span style="font-size:12px;color:#8C8473;">right now · then this week</span>
        </div>
        <p style="font-family:'Newsreader',serif;font-weight:400;font-size:27px;line-height:1.25;color:#FBF8F1;margin-bottom:16px;">Take one thing that got to you recently. Ask why, five times, inward.</p>
        <p style="font-size:16.5px;line-height:1.65;color:rgba(244,240,231,0.78);">A reaction that felt too big, a fear that keeps returning, a criticism that stung longer than it should have. Write it, then five whys — no flinching — until you reach the belief. Sit with the root; naming it is where the strength starts. <span style="color:#8C8473;">(The same five whys work on any recurring business problem, too — point them outward when you need to.)</span></p>
      </div>
    </section>

    <!-- COMPLETE + TRACK -->
    <div id="complete">
      <MwComplete
        workoutId="5-whys"
        dim="Emotional"
        dimLabel="Emotional"
        notePlaceholder="The belief I reached at the root, and what I saw in it…"
      />

      <MwCommitment
        workoutId="5-whys"
        dim="Emotional"
        dimLabel="Emotional"
        c1="When I catch myself annoyed, instead of reacting, ||I will ask 'why?' once before I respond."
        c2="When I write my to-do list, instead of just listing tasks, ||I will ask why the top one matters."
        c3="When I brush my teeth, instead of zoning out, ||I will ask 'why did that bother me?' about one thing from yesterday."
        willPh="ask 'why?' once"
      />
    </div>

    <!-- NEXT -->
    <section style="max-width:1000px;margin:52px auto 0;padding:0 32px 90px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <a href={workoutPath('pre-mortem')} style="display:flex;flex-direction:column;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:16px;padding:28px 30px;">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">Related · Awareness</span>
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:22px;color:#1B1810;margin-bottom:8px;">Pre-Mortem &amp; Backcasting</h3>
          <p style="font-size:14.5px;line-height:1.55;color:#56524A;">Root-cause the future: see the failure before it happens.</p>
        </a>
        <a href={SLUGS.workouts} style="display:flex;flex-direction:column;text-decoration:none;background:#F4F0E7;border:1px solid rgba(27,24,16,0.1);border-radius:16px;padding:28px 30px;">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A7F6C;margin-bottom:10px;">Keep going</span>
          <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:22px;color:#1B1810;margin-bottom:8px;">Browse all workouts</h3>
          <p style="font-size:14.5px;line-height:1.55;color:#56524A;">Pick your next rep by dimension.</p>
        </a>
      </div>
    </section>
    </article>

  </div>

  <SiteFooter audience="leaders" variant="slim" />
</BaseLayout>
