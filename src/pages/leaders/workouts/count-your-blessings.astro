---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MwComplete from '../../../components/MwComplete.astro';
import MwCommitment from '../../../components/MwCommitment.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../../lib/site';

const path = workoutPath('count-your-blessings');
const title = 'Count Your Blessings — gratitude is your free antidote | Be Legendary';
const description =
  "A Mindset Warmup that opens into a Workout. It's impossible to be angry and grateful at the same time — gratitude is the free antidote to the poison of resentment and fear. Build it like a muscle. Free, with a bridge to the Level Up Your Gratitude course.";

const canonical = new URL(path, SITE_URL).href;

// JSON-LD: the design's LearningResource (enriched with entity @ids) + a HowTo
// built from the "Time for Action" daily rep.
const schema = [
  {
    '@type': 'LearningResource',
    '@id': `${canonical}#learningresource`,
    name: 'Count Your Blessings — gratitude is your free antidote',
    learningResourceType: 'Mindset warmup and workout',
    teaches: 'Building gratitude as a practice and antidote to negative emotion',
    educationalLevel: 'Executive / founder',
    isAccessibleForFree: true,
    timeRequired: 'PT10M',
    author: { '@id': PERSON_ID },
    provider: { '@id': ORG_ID },
  },
  {
    '@type': 'HowTo',
    '@id': `${canonical}#howto`,
    name: 'Keep your antidote loaded — and use it',
    description:
      'Each day, do one deliberate rep of gratitude and reach for your loaded antidote on purpose the moment negative emotion hits.',
    totalTime: 'PT10M',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Do one deliberate rep',
        text: 'Each day, do one deliberate rep: name three good things in the morning, or say one gratitude out loud to a person who earned it.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Load your antidote',
        text: 'Have one specific thing you are grateful for ready to reach for the instant the poison — anger, resentment, fear — hits.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Use it on purpose',
        text: 'When the poison hits, reach for your antidote on purpose. It is very hard to stay negative when you are looking for the good — but only if you actually practice it.',
      },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Count Your Blessings — gratitude is your free antidote"
  ogDescription="It's impossible to be angry and grateful at the same time. Build gratitude like a muscle."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <header style="max-width:1000px;margin:0 auto;padding:52px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A7F6C;margin-bottom:24px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href={SLUGS.leaders} style="color:inherit;text-decoration:none;">For Leaders</a><span>/</span><a href={SLUGS.workouts} style="color:inherit;text-decoration:none;">Mindset Workouts</a><span>/</span><span style="color:#C04A26;">Count Your Blessings</span>
      </nav>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:22px;">
        <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Emotional</span>
        <span style="width:4px;height:4px;border-radius:50%;background:#6E6757;"></span>
        <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0A34A;">Mental</span>
        <span style="width:4px;height:4px;border-radius:50%;background:#6E6757;"></span>
        <span style="font-size:11.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8C8473;">Warmup · ~3 min</span>
      </div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(42px,7vw,78px);line-height:0.98;letter-spacing:-0.025em;color:#1B1810;">Count Your Blessings</h1>
      <p style="margin-top:24px;font-size:19px;line-height:1.6;color:#56524A;max-width:52ch;">Here's a fact you can test right now: it is <em style="font-style:italic;color:#C04A26;">impossible</em> to be angry and grateful at the same moment. Fearful and grateful. Resentful and grateful. Gratitude is your <strong style="color:#1B1810;">free antidote</strong> to the poison you carry all day — and you're 100% in control of the dose.</p>
    </header>

    <!-- WARMUP -->
    <div style="max-width:760px;margin:44px auto 0;padding:0 32px;">
      <div style="aspect-ratio:16/9;border-radius:16px;overflow:hidden;border:1px solid rgba(244,240,231,0.1);background:repeating-linear-gradient(135deg,#211D15,#211D15 13px,#262116 13px,#262116 26px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;">
        <span style="width:62px;height:62px;border-radius:999px;background:rgba(192,74,38,0.94);display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;padding-left:4px;">&#9658;</span>
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#B7AE9C;background:rgba(21,19,14,0.8);padding:7px 12px;border-radius:8px;text-align:center;max-width:82%;">video slot — "The Science of Happiness: An Experiment in Gratitude" (drop in the hosted link)</span>
      </div>
    </div>

    <section style="max-width:760px;margin:36px auto 0;padding:0 32px;">
      <p style="font-size:19px;line-height:1.65;color:#3A362E;margin-bottom:22px;">Gratitude has a reputation as a soft, greeting-card thing. It isn't. Jeremy Adam Smith calls it a tool: <em style="font-style:italic;">"a bright red paintbrush we apply to otherwise-invisible blessings"</em> — clean water, health, enough to eat, the people who show up. It's not about pretending things are fine. It's about seeing the good that never makes it onto your list of problems to solve.</p>
      <figure style="margin:0 0 26px;border-left:3px solid #C04A26;padding:6px 0 6px 26px;">
        <blockquote style="font-family:'Newsreader',serif;font-style:italic;font-size:clamp(21px,2.7vw,28px);line-height:1.36;color:#1B1810;">The struggle ends when the gratitude begins.</blockquote>
        <figcaption style="margin-top:10px;font-size:14px;color:#8A7F6C;">— Neale Donald Walsch</figcaption>
      </figure>
      <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.12);border-radius:16px;padding:28px 30px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Warmup · one reflection</p>
        <p style="font-size:18px;line-height:1.6;color:#1B1810;">Three good things. Right now, name three from today — no matter how small, and especially the invisible ones you'd never list. That's it. That's the warmup, and it already changed your state.</p>
      </div>
    </section>

    <!-- GO DEEPER -->
    <section style="max-width:760px;margin:34px auto 0;padding:0 32px;">
      <div id="go-deep-prompt" style="display:block;">
        <button id="go-deep-btn" type="button" style="width:100%;cursor:pointer;background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(224,116,74,0.4);border-radius:16px;padding:26px 30px;text-align:left;font-family:'Hanken Grotesk',sans-serif;" onmouseover="this.style.borderColor='rgba(224,116,74,0.75)'" onmouseout="this.style.borderColor='rgba(224,116,74,0.4)'">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;">
            <div>
              <span style="display:block;font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:8px;">The workout · ~10 min + optional 30 days</span>
              <span style="display:block;font-family:'Newsreader',serif;font-size:23px;color:#FBF8F1;line-height:1.2;">Want to go deeper and do some reps on this?</span>
            </div>
            <span style="flex:none;font-size:26px;color:#E0744A;">&darr;</span>
          </div>
        </button>
      </div>
    </section>

    <!-- WORKOUT -->
    <div id="go-deep-content" style="display:none;">
      <section style="max-width:760px;margin:40px auto 0;padding:0 32px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">The workout · gratitude is a muscle</p>
        <div style="font-size:18px;line-height:1.72;color:#3A362E;">
          <p style="margin-bottom:20px;">Robert Emmons studied over a thousand people, ages 8 to 80. Those who practiced gratitude consistently reported <strong style="color:#1B1810;">stronger immune systems, lower blood pressure, better sleep, more joy and optimism</strong> — and, tellingly, they were more generous, more forgiving, and less lonely. Gratitude is a relationship-strengthening emotion: it forces you to see how you've been supported. And it's a <em style="font-style:italic;">skill</em> — even a natural pessimist builds it with reps.</p>
        </div>
      </section>

      <!-- honest caveat: when gratitude is a BAD choice -->
      <section style="max-width:760px;margin:28px auto 0;padding:0 32px;">
        <div style="background:#1B1810;border:1px solid rgba(244,240,231,0.14);border-radius:16px;padding:28px 30px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#B48AD9;margin-bottom:12px;">The honest part · when gratitude is a bad choice</p>
          <p style="font-size:16.5px;line-height:1.68;color:rgba(244,240,231,0.82);">Gratitude is not always the right move, and anyone who tells you to "just be grateful" through real grief is selling something. In loss, sorrow is the healthy thing — forcing an "attitude of gratitude" over honest pain is manipulation of your own feelings. Anger, fear, frustration are good emotions felt with intelligence; there are no peaks without valleys. If it feels forced, stop. Feel it fully first. <strong style="color:#1B1810;">Then</strong> the practice is there when you're ready — on your terms, not anyone else's.</p>
        </div>
      </section>

      <section style="max-width:760px;margin:40px auto 0;padding:0 32px;">
        <div style="border-top:1px solid rgba(27,24,16,0.14);padding-top:34px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">Reflect — deeper</p>
          <div style="display:flex;flex-direction:column;gap:18px;">
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">1</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">What's the daily situation that most reliably drips the poison — anger, resentment, fear — into your day?</p></div>
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">2</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">What's your antidote — one specific thing you're grateful for, ready to reach for the instant that poison hits?</p></div>
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">3</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">Try the subtraction: picture your life <em style="font-style:italic;">without</em> one thing you take for granted. Feel how fast the gratitude returns.</p></div>
          </div>
        </div>
      </section>

      <!-- TIME FOR ACTION (not Misogi) -->
      <section style="max-width:760px;margin:38px auto 0;padding:0 32px;">
        <div style="background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:34px 36px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;"><span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Time for Action</span><span style="font-size:12px;color:#8C8473;">one rep · daily</span></div>
          <p style="font-family:'Newsreader',serif;font-weight:400;font-size:26px;line-height:1.25;color:#FBF8F1;margin-bottom:14px;">Keep your antidote loaded — and use it.</p>
          <p style="font-size:16px;line-height:1.62;color:rgba(244,240,231,0.78);">Each day, do one deliberate rep: three good things in the morning, or one gratitude said out loud to a person who earned it. When the poison hits, reach for your antidote on purpose. It's very hard to stay negative when you're looking for the good — but only if you actually practice it.</p>
        </div>
      </section>

      <!-- bridge to the course -->
      <section style="max-width:760px;margin:28px auto 0;padding:0 32px;">
        <a href={SLUGS.gratitude} style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-decoration:none;background:rgba(180,138,217,0.1);border:1px solid rgba(180,138,217,0.35);border-radius:16px;padding:26px 30px;flex-wrap:wrap;" onmouseover="this.style.borderColor='rgba(180,138,217,0.7)'" onmouseout="this.style.borderColor='rgba(180,138,217,0.35)'">
          <div>
            <p style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#B48AD9;margin-bottom:6px;">Ready for the full ascent?</p>
            <p style="font-size:17px;line-height:1.4;color:#2E2A22;">This warmup is the door. <strong style="color:#1B1810;">Level Up Your Gratitude</strong> is the room — a deeper course that's really about leveling <em style="font-style:italic;">you.</em></p>
          </div>
          <span style="display:inline-flex;align-items:center;gap:8px;color:#B48AD9;font-weight:700;font-size:15px;white-space:nowrap;">Explore the course <span>&rarr;</span></span>
        </a>
      </section>

      <MwComplete
        workoutId="count-your-blessings"
        dim="Emotional"
        dimLabel="Emotional & Mental"
        notePlaceholder="My antidote, ready to reach for, is…"
        doneHead="Antidote — loaded."
        doneBody="You're 100% in control of the dose. Keep the practice going — the struggle ends when the gratitude begins."
        nextHref={SLUGS.gratitude}
        nextCta="Go deeper · Level Up Your Gratitude"
      />

      <MwCommitment
        workoutId="count-your-blessings"
        dim="Emotional"
        dimLabel="Emotional & Mental"
        c1="When I sit down to eat lunch, instead of reaching for my phone, ||I will name one thing I'm grateful for right now."
        c2="When I feel a complaint forming, instead of voicing it, ||I will name one good thing about the same situation."
        c3="When I brush my teeth at night, instead of replaying what went wrong, ||I will name one small win from today."
        willPh="name one thing I'm grateful for"
      />
    </div>

  </div>

  <SiteFooter audience="leaders" variant="slim" />

  <script>
    (function () {
      const btn = document.getElementById('go-deep-btn');
      const prompt = document.getElementById('go-deep-prompt');
      const content = document.getElementById('go-deep-content');
      if (btn && prompt && content) {
        btn.addEventListener('click', function () {
          prompt.style.display = 'none';
          content.style.display = 'block';
        });
      }
    })();
  </script>
</BaseLayout>
