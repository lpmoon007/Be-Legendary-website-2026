---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MwComplete from '../../../components/MwComplete.astro';
import MwCommitment from '../../../components/MwCommitment.astro';
import { Image } from 'astro:assets';
import kintsugiCover from '../../../assets/kintsugi-cover.jpg';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, workoutPath } from '../../../lib/site';

const path = workoutPath('kintsugi-wabi-sabi');
const title = 'Kintsugi & Wabi-Sabi — loving the imperfect, on purpose';
const description =
  "Kintsugi mends what's broken with gold; Wabi-Sabi loves a thing for its flaws, not in spite of them. Put on New Eyes and find it in others, then yourself.";

const canonical = new URL(path, SITE_URL).href;

// JSON-LD: the design's LearningResource enriched with entity @ids, a HowTo
// (the "Time for Action" New Eyes rep), and a DefinedTerm for the concept.
const schema = [
  {
    '@type': 'LearningResource',
    '@id': `${canonical}#learningresource`,
    name: 'Kintsugi & Wabi-Sabi — loving the imperfect',
    learningResourceType: 'Mindset warmup and workout',
    teaches: 'Appreciating and loving imperfection in others and oneself (Wabi-Sabi / Kintsugi)',
    educationalLevel: 'Executive / founder',
    isAccessibleForFree: true,
    timeRequired: 'PT10M',
    author: { '@id': PERSON_ID },
    provider: { '@id': ORG_ID },
  },
  {
    '@type': 'HowTo',
    '@id': `${canonical}#howto`,
    name: 'Put on New Eyes',
    description:
      'A daily rep in Wabi-Sabi: find one earned imperfection in someone, name the gold you see in it out loud to them, and repeat until you see everyone — including yourself — that way.',
    totalTime: 'PT10M',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Put on New Eyes',
        text: 'Look at someone and find one earned imperfection — a scar, a gray hair, a tremor — that tells you what a life was spent on.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Name the gold out loud',
        text: 'Say it to them directly — name the strength that lives in the crack — and watch what it does.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Do it daily',
        text: 'Repeat every day until you retrain how you see everyone, including the person in the mirror.',
      },
    ],
  },
  {
    '@type': 'DefinedTerm',
    '@id': `${canonical}#term`,
    name: 'Kintsugi & Wabi-Sabi',
    description:
      'Kintsugi is the Japanese practice of mending a broken bowl with gold, making it more precious for having been broken and repaired. Its cousin Wabi-Sabi is the love and appreciation of a thing because of its imperfections, not in spite of them. Applied to people, it means seeing earned flaws as gold veins that reveal what a life was spent on.',
    inDefinedTermSet: 'Be Legendary',
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Kintsugi & Wabi-Sabi — loving the imperfect, on purpose"
  ogDescription="Love something because of its imperfections, not in spite of them. New Eyes for the people around you."
  bodyBg="#EFE8DA"
  schema={schema}
>
  <SiteHeader
    audience="leaders"
    variant="slim"
    logoHref={SLUGS.leaders}
    contextLink={{ label: 'The Legendary Leader →', href: SLUGS.legendaryLeader }}
  />

  <div style="background:#EFE8DA;color:#1B1810;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <!-- ============ HERO (real bowl image) ============ -->
    <div style="position:relative;max-width:1000px;margin:0 auto;padding:32px 32px 0;">
      <div style="position:relative;border-radius:20px;overflow:hidden;border:1px solid rgba(244,240,231,0.12);">
        <Image src={kintsugiCover} alt="A blue ceramic bowl repaired with veins of gold — Kintsugi" width={1200} height={900} format="webp" quality={82} loading="eager" fetchpriority="high" style="width:100%;height:clamp(240px,42vw,420px);object-fit:cover;display:block;" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(21,19,14,0.1),rgba(21,19,14,0.82));"></div>
        <div style="position:absolute;bottom:0;left:0;right:0;padding:36px 34px;">
          <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:14px;">
            <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Emotional</span>
            <span style="width:4px;height:4px;border-radius:50%;background:#B7AE9C;"></span>
            <span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#B48AD9;">Spiritual</span>
            <span style="width:4px;height:4px;border-radius:50%;background:#B7AE9C;"></span>
            <span style="font-size:11.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#D7CFBE;">Warmup · ~3 min</span>
          </div>
          <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(38px,6.5vw,68px);line-height:0.98;letter-spacing:-0.02em;color:#1B1810;">Broken is not the opposite of beautiful.</h1>
        </div>
      </div>
    </div>

    <!-- ============ WARMUP (always visible) ============ -->
    <section style="max-width:760px;margin:36px auto 0;padding:0 32px;">
      <p style="font-size:19px;line-height:1.65;color:#3A362E;margin-bottom:22px;">When a bowl breaks in Japan, one practice doesn't hide the repair — it mends the cracks with <strong style="color:#1B1810;">gold.</strong> That's <em style="font-style:italic;">Kintsugi.</em> The bowl becomes more precious broken-and-mended than it ever was whole. Its cousin, <em style="font-style:italic;">Wabi-Sabi,</em> is the practice — even the devotion — of loving something <strong style="color:#1B1810;">because</strong> of its imperfections, not in spite of them.</p>

      <p style="margin-bottom:22px;"><a href={SLUGS.whatIsKintsugi} style="display:inline-flex;align-items:center;gap:8px;font-size:15.5px;font-weight:700;color:#C04A26;text-decoration:none;" onmouseover="this.querySelector('span:last-child').style.transform='translateX(4px)'" onmouseout="this.querySelector('span:last-child').style.transform='translateX(0)'"><span>New to the idea? What is Kintsugi?</span><span style="transition:transform .2s;">&rarr;</span></a></p>

      <p style="font-size:19px;line-height:1.65;color:#3A362E;margin-bottom:26px;">For tens of thousands of years we looked up and saw sparkling diamonds. Then in 1933 an engineer named Karl Jansky, chasing radio static, realized he was hearing the hum of the black hole at the center of our galaxy. After that, astronomers looked up with <em style="font-style:italic;">New Eyes</em> — and saw quasars, pulsars, the afterglow of the Big Bang. Same sky. New Eyes. <strong style="color:#1B1810;">The biggest breakthroughs come from looking at what everyone sees and seeing what no one has.</strong></p>

      <figure style="margin:0 0 26px;border-left:3px solid #C04A26;padding:6px 0 6px 26px;">
        <blockquote style="font-family:'Newsreader',serif;font-style:italic;font-size:clamp(21px,2.7vw,28px);line-height:1.36;color:#1B1810;">Wabi-Sabi is the love and appreciation of a thing because of its flaws. New Eyes are how you learn to see it.</blockquote>
      </figure>

      <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.12);border-radius:16px;padding:28px 30px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Warmup · one reflection</p>
        <p style="font-size:18px;line-height:1.6;color:#1B1810;">Name one imperfect thing you love <em style="font-style:italic;">because</em> of its flaw — the chipped mug with a story, the torn end of the baguette, the misshapen cookie that somehow tastes better. Sit with why the flaw is the reason. That's Wabi-Sabi. That's the whole warmup.</p>
      </div>
    </section>

    <!-- ============ GO DEEPER TOGGLE ============ -->
    <section style="max-width:760px;margin:34px auto 0;padding:0 32px;">
      <div id="go-deep-prompt" style="display:block;">
        <button id="go-deep-btn" type="button" style="width:100%;cursor:pointer;background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(224,116,74,0.4);border-radius:16px;padding:26px 30px;text-align:left;font-family:'Hanken Grotesk',sans-serif;" onmouseover="this.style.borderColor='rgba(224,116,74,0.75)'" onmouseout="this.style.borderColor='rgba(224,116,74,0.4)'">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;">
            <div>
              <span style="display:block;font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:8px;">The workout · ~10 min + optional 30 days</span>
              <span style="display:block;font-family:'Newsreader',serif;font-size:23px;color:#FBF8F1;line-height:1.2;">Want to go deeper and do some reps on this?</span>
            </div>
            <span style="flex:none;font-size:26px;color:#E0744A;">&darr;</span>
          </div>
        </button>
      </div>
    </section>

    <!-- ============ WORKOUT (revealed) ============ -->
    <div id="go-deep-content" style="display:none;">
      <section style="max-width:760px;margin:40px auto 0;padding:0 32px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">The workout · New Eyes on people</p>
        <div style="font-size:18px;line-height:1.72;color:#3A362E;">
          <p style="margin-bottom:20px;">Here's where it goes from pretty idea to real work. Turn the New Eyes on <em style="font-style:italic;">people.</em> A mother's gray hair and the stretch marks she earned bringing children into the world. The scar from a cancer surgery someone survived. The tremor in the hands of a mentor who's given fifty years to their craft. These aren't blemishes to look past — they're <strong style="color:#1B1810;">gold veins.</strong> Earned imperfections that tell you exactly what a life was spent on.</p>
          <p style="margin-bottom:20px;">Most of us are trained to do the opposite — to notice the flaw and quietly discount the person. Wabi-Sabi is the discipline of the reverse: to see the crack and love the person <em style="font-style:italic;">more</em>, because now you can see what it cost them. Do that for the people around you long enough, and something happens you didn't expect — you finally extend the same grace to your own cracks. The practice starts outward and comes home.</p>
        </div>
      </section>

      <!-- gallery -->
      <section style="max-width:900px;margin:32px auto 0;padding:0 32px;">
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
          <div style="border-radius:12px;overflow:hidden;border:1px solid rgba(244,240,231,0.12);"><img src="/assets/kintsugi-1.jpg" alt="Kintsugi bowl mended with gold" width={770} height={400} loading="lazy" style="width:100%;height:200px;object-fit:cover;display:block;"></div>
          <div style="border-radius:12px;overflow:hidden;border:1px solid rgba(244,240,231,0.12);"><img src="/assets/kintsugi-grigia.jpg" alt="Grey Kintsugi vessel with gold seams" width={1920} height={1440} loading="lazy" style="width:100%;height:200px;object-fit:cover;display:block;"></div>
          <div style="border-radius:12px;overflow:hidden;border:1px solid rgba(244,240,231,0.12);"><img src="/assets/kintsugi-metamorphosis.jpg" alt="Paige Bradley's Metamorphosis — a cracked figure lit from within" width={558} height={375} loading="lazy" style="width:100%;height:200px;object-fit:cover;display:block;"></div>
        </div>
        <p style="margin-top:12px;font-size:13px;color:#8A7F6C;">Left &amp; center: Kintsugi — the repair made precious. Right: Paige Bradley's <em style="font-style:italic;">Metamorphosis</em> — the light escapes through the cracks.</p>
      </section>

      <!-- reflect -->
      <section style="max-width:760px;margin:40px auto 0;padding:0 32px;">
        <div style="border-top:1px solid rgba(27,24,16,0.14);padding-top:34px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">Reflect — deeper</p>
          <div style="display:flex;flex-direction:column;gap:18px;">
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">1</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">Picture someone you lead. What's one "imperfection" of theirs you've quietly marked against them — that's actually an earned gold vein?</p></div>
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">2</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">What does that crack tell you they survived, or gave, or built? What did it cost them?</p></div>
            <div style="display:flex;gap:14px;align-items:flex-start;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;flex:none;line-height:1.4;">3</span><p style="font-size:17.5px;line-height:1.5;color:#1B1810;">Now turn it on yourself: which of your own cracks have you been hiding that someone else would call gold?</p></div>
          </div>
        </div>
      </section>

      <!-- misogi -->
      <section style="max-width:760px;margin:38px auto 0;padding:0 32px;">
        <div style="background:linear-gradient(180deg,#211D15,#1A160F);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:34px 36px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;"><span style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;">Time for Action</span><span style="font-size:12px;color:#8C8473;">New Eyes · daily</span></div>
          <p style="font-family:'Newsreader',serif;font-weight:400;font-size:26px;line-height:1.25;color:#FBF8F1;margin-bottom:14px;">Each day, tell one person the gold you see in their crack.</p>
          <p style="font-size:16px;line-height:1.62;color:rgba(244,240,231,0.78);">Put on New Eyes and find one earned imperfection in someone — then <em style="font-style:italic;">say it out loud to them.</em> "The way you're so careful now — that's the year you had, isn't it." Watch what it does. Do it daily and you'll retrain how you see everyone, including the person in the mirror. It's very hard to stay negative when you find something to love at every turn.</p>
        </div>
      </section>

      <MwComplete
        workoutId="kintsugi-wabi-sabi"
        dim="Emotional"
        dimLabel="Emotional & Spiritual"
        notePlaceholder="The gold vein I'll name out loud is…"
        doneHead="New Eyes — on."
        doneBody="You've started seeing gold where you used to see cracks. Keep the New Eyes on — in others, and in yourself."
        nextHref={workoutPath('the-golden-buddha')}
        nextCta="Now turn it inward · The Golden Buddha"
      />

      <MwCommitment
        workoutId="kintsugi-wabi-sabi"
        dim="Emotional"
        dimLabel="Emotional & Spiritual"
        c1="When I catch a flaw in someone, instead of judging, ||I will name one strength that lives right next to it."
        c2="When I replay a mistake, instead of cringing, ||I will name the one thing it taught me."
        c3="When I pour my coffee, instead of listing what's broken, ||I will name one crack in my story that made me stronger."
        willPh="name the gold in one crack"
      />
    </div>

  </div>

  <SiteFooter audience="leaders" variant="slim" />

  <script>
    (function () {
      const btn = document.getElementById('go-deep-btn');
      const prompt = document.getElementById('go-deep-prompt');
      const content = document.getElementById('go-deep-content');
      if (btn && prompt && content) {
        btn.addEventListener('click', function () {
          prompt.style.display = 'none';
          content.style.display = 'block';
        });
      }
    })();
  </script>
</BaseLayout>
