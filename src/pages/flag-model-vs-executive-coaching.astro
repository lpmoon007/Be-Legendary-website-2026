---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareRow from '../components/ShareRow.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = "Flag Model vs Executive Coaching | Be Legendary";
const description = "Executive coaching develops the individual leader. The Flag Model develops how the team decides and executes together — different problems. You need both.";

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.belegendary.org/resources/' },
    { '@type': 'ListItem', position: 3, name: 'Flag Model vs executive coaching', item: 'https://www.belegendary.org/flag-model-vs-executive-coaching/' },
  ] },
  { '@type': 'Article', headline: 'Flag Model vs Executive Coaching', datePublished: '2026-01-15', dateModified: '2026-06-16', author: { '@id': 'https://www.belegendary.org/#james' }, publisher: { '@id': 'https://www.belegendary.org/#org' }, mainEntityOfPage: 'https://www.belegendary.org/flag-model-vs-executive-coaching/', description: "How the Flag Model's team disciplines differ from and complement one-on-one executive coaching." },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'What is the difference between executive coaching and the Flag Model?', acceptedAnswer: { '@type': 'Answer', text: 'Executive coaching develops an individual leader — their judgment, blind spots, communication and confidence, usually one-on-one. The Flag Model develops the team as a unit — how it decides, focuses, holds standards and learns together. Coaching improves the player; the Flag Model improves how the players play together. A team of well-coached individuals can still execute poorly as a group.' } },
    { '@type': 'Question', name: 'Can executive coaching fix a dysfunctional leadership team?', acceptedAnswer: { '@type': 'Answer', text: "Rarely on its own. Coaching each executive can raise individual performance, but team dysfunction lives in the spaces between people — unclear decision rights, no shared standard, commitments that don't stick. Those are team-level disciplines that one-on-one coaching doesn't directly install. You usually need both: coaching for the individual, the Flag Model for the system." } },
    { '@type': 'Question', name: 'Do I need a coach or a team consultant?', acceptedAnswer: { '@type': 'Answer', text: "If the issue is a specific leader's growth, a coach is the right call. If the issue is that a capable group of leaders can't decide, finish, or hold each other accountable together, that's a team-discipline problem the Flag Model addresses. Many executive teams run both in parallel." } },
  ] },
];
---
<BaseLayout
  title={title}
  description={description}
  path={SLUGS.vsCoaching}
  ogType="article"
  ogTitle="Flag Model vs executive coaching — individual growth vs team disciplines"
  ogDescription="Coaching sharpens the individual leader. The Flag Model fixes how the team operates together. Different problems."
  schema={schema}
>
  <SiteHeader audience="teams" logoHref="/" maxWidth={920} links={[]} />

  <article>
  <!-- HERO -->
  <header style="position:relative;max-width:920px;margin:0 auto;padding:80px 32px 40px;">
    <div style="position:absolute;top:-100px;right:-160px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.resources} style="color:inherit;text-decoration:none;">Resources</a><span>/</span><span style="color:#D98A5E;">Flag Model vs executive coaching</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">Comparison</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(32px,5vw,56px);line-height:1.03;letter-spacing:-0.02em;color:#FBF8F1;">The Flag Model™ vs executive coaching</h1>
    <p style="margin-top:18px;font-size:14px;color:rgba(244,240,231,0.55);">By <a href={SLUGS.about} style="color:#D98A5E;text-decoration:none;">James Carter</a> &middot; Updated June 2026</p>
    <div style="margin-top:30px;background:#211D15;border:1px solid rgba(192,74,38,0.35);border-left:3px solid #C04A26;border-radius:14px;padding:26px 28px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The short answer</p>
      <p style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:#FBF8F1;">Executive coaching develops the <strong>individual leader</strong> &mdash; judgment, blind spots, confidence, usually one-on-one. The Flag Model develops the <strong>team as a unit</strong> &mdash; how it decides, focuses, holds standards and learns together. They solve different problems. Investing in your people is never wrong; just know that a team of brilliantly coached individuals can still execute poorly <em>together</em>, because team dysfunction lives in the space between them.</p>
    </div>
  </header>

  <!-- HERO-AFFIRM -->
  <div style="max-width:920px;margin:0 auto;padding:24px 32px 8px;">
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);">Bringing in coaching says something good about you: you invest in growth, and you're willing to be coached yourself. That's the mark of a leader worth following. The distinction worth drawing is simply one of altitude &mdash; coaching works on the individual; some problems only live at the level of the team.</p>
  </div>

  <!-- TABLE -->
  <div style="max-width:920px;margin:0 auto;padding:36px 32px 8px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.2vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:24px;">Two different altitudes</h2>
    <div style="display:flex;flex-direction:column;gap:14px;">
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:0.8fr 1fr 1fr;gap:18px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:26px;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(244,240,231,0.45);align-self:center;">Who it develops</p>
        <div><p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#E0744A;margin-bottom:8px;">Executive coaching</p><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">One leader at a time &mdash; their growth, judgment and blind spots.</p></div>
        <div><p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#E0744A;margin-bottom:8px;">The Flag Model</p><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">The team as a unit &mdash; how it decides and executes together.</p></div>
      </div>
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:0.8fr 1fr 1fr;gap:18px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:26px;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(244,240,231,0.45);align-self:center;">Where the problem lives</p>
        <div><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">Inside the person &mdash; a habit, a fear, a skill to build.</p></div>
        <div><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">Between people &mdash; decision rights, standards, commitments that don't stick.</p></div>
      </div>
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:0.8fr 1fr 1fr;gap:18px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:26px;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(244,240,231,0.45);align-self:center;">Reach for it when</p>
        <div><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">A specific leader needs to grow into a bigger role.</p></div>
        <div><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">Capable leaders can't decide, finish, or hold each other accountable as a group.</p></div>
      </div>
    </div>
  </div>

  <!-- THE GAP -->
  <div style="max-width:920px;margin:0 auto;padding:44px 32px 8px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.2vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:16px;">The trap of coaching your way out of a team problem</h2>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:20px;">It's a natural move: the team is struggling, so you get each leader a coach. Six months later every individual is sharper &mdash; and the team still can't make a decision stick, still lets initiatives sprawl, still avoids the hard conversation. That's because the dysfunction was never inside any one person. It lived in the <em>system</em>: no shared decision protocol, no agreed standard of &ldquo;done,&rdquo; no learning loop. Coaching can't install what belongs to the group.</p>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);">The Flag Model works at that altitude. It gives the team the disciplines it can only hold collectively &mdash; the Decision, the Rhythm, the Standard, the Learning &mdash; so individually strong leaders finally perform like a strong team.</p>
  </div>

  <!-- STACK -->
  <div style="max-width:920px;margin:32px auto 0;padding:0 32px;">
    <div style="background:#F4F0E7;color:#1B1810;border-radius:18px;padding:34px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Best together</p>
      <p style="font-size:18px;line-height:1.62;color:#3A372F;">The strongest results come from running both at once: coaching to raise each leader's ceiling, the Flag Model to align how they operate as a team. In fact, the disciplines often surface exactly which leader would benefit most from coaching &mdash; and coaching lands faster when the team's operating rules are clear. They reinforce each other.</p>
    </div>
  </div>

  <!-- CTA -->
  <div style="max-width:920px;margin:36px auto 0;padding:0 32px;">
    <div style="background:linear-gradient(120deg,#211D15,#191610);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:38px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;">Find out if it's a person or a system.</h2>
      <p style="margin-top:16px;font-size:17.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:60ch;">A <strong style="color:#F4F0E7;">Calibration Call</strong> is 15 minutes. You'll leave knowing whether your team needs coaching, team disciplines, or both &mdash; whether or not we work together.</p>
      <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:26px;display:inline-flex;align-items:center;gap:9px;background:#C04A26;color:#fff;text-decoration:none;padding:16px 30px;border-radius:11px;font-weight:700;font-size:16.5px;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Book a Calibration Call <span style="font-size:18px;">&rarr;</span></a>
    </div>
  </div>

  <!-- RELATED -->
  <div style="max-width:920px;margin:60px auto 0;padding:0 32px 20px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Keep reading</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <a href={SLUGS.vsFiveDysfunctions} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs the Five Dysfunctions</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Team health vs. a repeatable operating system.</span>
      </a>
      <a href={SLUGS.flagModel} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">The Flag Model, in full</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The four disciplines a team can only hold together.</span>
      </a>
    </div>
  </div>
    <ShareRow title={title} maxWidth={920} />
</article>

  <SiteFooter audience="teams" variant="slim" maxWidth={920} note="© 2026 Be Legendary. The Flag Model works alongside coaching." />
</BaseLayout>
