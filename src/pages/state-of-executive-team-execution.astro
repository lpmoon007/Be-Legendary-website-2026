        <button type="button" id="cite-copy" style="flex:none;background:#C04A26;color:#fff;border:none;cursor:pointer;padding:14px 20px;border-radius:10px;font-weight:700;font-size:14.5px;font-family:'Hanken Grotesk',sans-serif;white-space:nowrap;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Copy citation</button>
