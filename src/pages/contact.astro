---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SLUGS, CTA_URL, HUBSPOT, CONTACT_EMAIL } from '../lib/site';

const title = 'Contact Be Legendary | Talk to us, no call required';
const description =
  'Reach Be Legendary without booking a call: send a message, email jcarter@belegendary.org, or phone 800-513-8759. Prefer to talk it through? Book a free calibration call.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://www.belegendary.org/contact/' },
  ] },
  { '@type': 'ContactPage', '@id': 'https://www.belegendary.org/contact/#page', name: 'Contact Be Legendary',
    mainEntity: { '@type': 'Organization', name: 'Be Legendary', email: CONTACT_EMAIL, telephone: '+1-800-513-8759' } },
];
---
<BaseLayout title={title} description={description} path={SLUGS.contact} ogType="website" ogTitle="Contact Be Legendary" ogDescription="Send a message, email, or call — booking a call is optional, not the only way in." schema={schema}>

<div style="background:#15130E;color:#F4F0E7;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

  <SiteHeader audience="teams" logoHref="/" />

  <!-- HERO -->
  <header style="position:relative;max-width:1080px;margin:0 auto;padding:84px 32px 44px;">
    <div style="position:absolute;top:-100px;right:-140px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:24px;display:flex;gap:8px;align-items:center;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><span style="color:#D98A5E;">Contact</span>
    </nav>
    <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#E0744A;margin-bottom:18px;">Contact</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(38px,5.6vw,68px);line-height:1.02;letter-spacing:-0.02em;max-width:17ch;color:#FBF8F1;">Have a question? Just ask &mdash; no call required.</h1>
    <p style="margin-top:24px;font-size:clamp(18px,2.1vw,22px);line-height:1.52;max-width:56ch;color:rgba(244,240,231,0.8);">Send a message, email, or pick up the phone. A calibration call is there when you want it, but it&rsquo;s not the only way to reach us.</p>
  </header>

  <!-- BODY: form + direct channels -->
  <section style="max-width:1080px;margin:0 auto;padding:8px 32px 92px;">
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1.15fr 0.85fr;gap:40px;align-items:start;">

      <!-- Message form: native, posts to the HubSpot Forms API (no embed, no HubSpot
           branding). Fields match the "Be Legendary Contact Form" (bad3be34) exactly. -->
      <div style="background:#F4F0E7;color:#1B1810;border-radius:20px;padding:38px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(22px,2.8vw,30px);line-height:1.12;color:#1B1810;">Send us a message</h2>
        <p style="margin-top:12px;font-size:15.5px;line-height:1.55;color:#4A473F;max-width:44ch;">Tell us what&rsquo;s going on with your team or what you&rsquo;d like to know. We read every message and reply personally &mdash; usually within one business day.</p>

        <form id="bl-contact" data-portal={HUBSPOT.portalId} data-guid={HUBSPOT.contactFormGuid} data-contact={CONTACT_EMAIL} style="margin-top:22px;display:flex;flex-direction:column;gap:14px;">
          <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
            <label style="font-size:13px;font-weight:600;color:#4A473F;display:flex;flex-direction:column;gap:6px;">First name
              <input name="firstname" type="text" required autocomplete="given-name" style="padding:13px 15px;border-radius:10px;border:1px solid rgba(27,24,16,0.22);background:#FFFDF9;color:#1B1810;font-size:16px;font-family:'Hanken Grotesk',sans-serif;outline:none;" />
            </label>
            <label style="font-size:13px;font-weight:600;color:#4A473F;display:flex;flex-direction:column;gap:6px;">Last name
              <input name="lastname" type="text" required autocomplete="family-name" style="padding:13px 15px;border-radius:10px;border:1px solid rgba(27,24,16,0.22);background:#FFFDF9;color:#1B1810;font-size:16px;font-family:'Hanken Grotesk',sans-serif;outline:none;" />
            </label>
          </div>
          <label style="font-size:13px;font-weight:600;color:#4A473F;display:flex;flex-direction:column;gap:6px;">Work email
            <input name="email" type="email" required autocomplete="email" style="padding:13px 15px;border-radius:10px;border:1px solid rgba(27,24,16,0.22);background:#FFFDF9;color:#1B1810;font-size:16px;font-family:'Hanken Grotesk',sans-serif;outline:none;" />
          </label>
          <label style="font-size:13px;font-weight:600;color:#4A473F;display:flex;flex-direction:column;gap:6px;">Phone
            <input name="phone" type="tel" required autocomplete="tel" style="padding:13px 15px;border-radius:10px;border:1px solid rgba(27,24,16,0.22);background:#FFFDF9;color:#1B1810;font-size:16px;font-family:'Hanken Grotesk',sans-serif;outline:none;" />
          </label>
          <label style="font-size:13px;font-weight:600;color:#4A473F;display:flex;flex-direction:column;gap:6px;">What&rsquo;s going on with your team?
            <textarea name="tell_us_about_your_event" rows="4" required style="padding:13px 15px;border-radius:10px;border:1px solid rgba(27,24,16,0.22);background:#FFFDF9;color:#1B1810;font-size:16px;font-family:'Hanken Grotesk',sans-serif;outline:none;resize:vertical;"></textarea>
          </label>
          <p class="bl-contact-err" style="margin:0;font-size:13px;color:#C04A26;min-height:18px;visibility:hidden;"></p>
          <button type="submit" class="bl-tap" style="background:#C04A26;color:#fff;border:none;cursor:pointer;padding:15px 18px;border-radius:11px;font-weight:700;font-size:16px;font-family:'Hanken Grotesk',sans-serif;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Send message</button>
          <noscript><p style="margin:4px 0 0;font-size:14px;color:#4A473F;">The form needs JavaScript. Email <a href={`mailto:${CONTACT_EMAIL}`} style="color:#C04A26;">{CONTACT_EMAIL}</a> or call 800-513-8759.</p></noscript>
        </form>
        <div class="bl-contact-sent" style="display:none;margin-top:22px;">
          <p style="font-family:'Newsreader',serif;font-size:24px;color:#1B1810;">Message sent.</p>
          <p style="margin-top:8px;font-size:15.5px;line-height:1.55;color:#4A473F;">We read every message and reply personally &mdash; usually within one business day.</p>
        </div>
      </div>

      <!-- Direct channels -->
      <div style="display:flex;flex-direction:column;gap:16px;">
        <a href={`mailto:${CONTACT_EMAIL}`} style="text-decoration:none;display:block;background:#1B1810;border:1px solid rgba(244,240,231,0.14);border-radius:16px;padding:24px 26px;color:#F4F0E7;" onmouseover="this.style.borderColor='rgba(192,74,38,0.55)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.14)'">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Email</p>
          <p style="margin-top:8px;font-size:17px;color:#FBF8F1;">{CONTACT_EMAIL}</p>
          <p style="margin-top:6px;font-size:14px;color:rgba(244,240,231,0.6);">Straight to the team. We reply within a business day.</p>
        </a>

        <a href="tel:8005138759" style="text-decoration:none;display:block;background:#1B1810;border:1px solid rgba(244,240,231,0.14);border-radius:16px;padding:24px 26px;color:#F4F0E7;" onmouseover="this.style.borderColor='rgba(192,74,38,0.55)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.14)'">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Phone</p>
          <p style="margin-top:8px;font-size:17px;color:#FBF8F1;">800-513-8759</p>
          <p style="margin-top:6px;font-size:14px;color:rgba(244,240,231,0.6);">Mon&ndash;Fri. Leave a message and we&rsquo;ll call back.</p>
        </a>

        <div style="background:linear-gradient(150deg,#1B1810,#100E0A);border:1px solid rgba(244,240,231,0.12);border-radius:16px;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Prefer to talk?</p>
          <p style="margin-top:8px;font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.8);">Book a free 15-minute calibration call &mdash; a real read on where your team stands, whether or not we work together.</p>
          <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:16px;display:inline-block;background:#C04A26;color:#fff;text-decoration:none;padding:12px 20px;border-radius:10px;font-weight:700;font-size:14.5px;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Book a calibration call &rarr;</a>
        </div>
      </div>

    </div>
  </section>

  <SiteFooter audience="teams" />

</div>

<!-- Native contact form → HubSpot Forms API (no embed, no HubSpot branding).
     Posts exactly the fields on the "Be Legendary Contact Form" (bad3be34), plus
     the GA ids for HubSpot → GA4 attribution. Requires reCAPTCHA OFF on that form
     (same API-submit path as every other form on the site). Confirms success only
     on res.ok — never a false "sent" while the lead is lost. -->
<script is:inline>
  (function () {
    var form = document.getElementById('bl-contact');
    if (!form) return;
    var err = form.querySelector('.bl-contact-err');
    var sent = document.querySelector('.bl-contact-sent');
    var EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
    var portal = form.dataset.portal, guid = form.dataset.guid, contact = form.dataset.contact;
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var f = {
        firstname: form.firstname.value.trim(),
        lastname: form.lastname.value.trim(),
        email: form.email.value.trim(),
        phone: form.phone.value.trim(),
        tell_us_about_your_event: form.tell_us_about_your_event.value.trim(),
      };
      if (!f.firstname || !f.lastname || !f.phone || !f.tell_us_about_your_event || !EMAIL_RE.test(f.email)) {
        err.textContent = 'Please complete every field with a valid email.';
        err.style.visibility = 'visible';
        return;
      }
      var ga = (window.blGetGaIds && window.blGetGaIds()) || {};
      var fields = Object.keys(f).map(function (k) { return { name: k, value: f[k] }; });
      if (ga.client_id) fields.push({ name: 'ga_client_id', value: ga.client_id });
      if (ga.session_id) fields.push({ name: 'ga_session_id', value: ga.session_id });
      var ok = false;
      try {
        var res = await fetch('https://api.hsforms.com/submissions/v3/integration/submit/' + portal + '/' + guid, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fields: fields, context: { pageUri: location.href, pageName: document.title } }),
        });
        ok = res.ok;
      } catch (e2) { ok = false; }
      if (!ok) {
        err.innerHTML = 'Couldn’t send just now. <a href="mailto:' + contact + '" style="color:#C04A26;text-decoration:underline;">Email us</a> and we’ll pick it up.';
        err.style.visibility = 'visible';
        return;
      }
      form.style.display = 'none';
      if (sent) sent.style.display = 'block';
      if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead', { form: 'contact' });
    });
  })();
</script>
</BaseLayout>
