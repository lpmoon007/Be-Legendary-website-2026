---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BreakPointAssessment from '../components/BreakPointAssessment.astro';
import { SLUGS } from '../lib/site';

const title = 'Executive Team Break-Point Self-Assessment | Be Legendary';
const description = 'Free Break-Point Self-Assessment: ten honest questions reveal where your executive team is most likely to break first. Instant on-screen result.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.belegendary.org/resources/' },
    { '@type': 'ListItem', position: 3, name: 'Break-Point Self-Assessment', item: 'https://www.belegendary.org/break-point-self-assessment/' },
  ] },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'How do I know where my executive team will break first?', acceptedAnswer: { '@type': 'Answer', text: 'Score your team honestly across the five components of the Flag Model — the Flag (alignment), the Decision, the Rhythm, the Standard and the Learning. The lowest-scoring discipline is the one most likely to break first under pressure. This free ten-question self-assessment produces that read in about four minutes.' } },
    { '@type': 'Question', name: 'What are the five components a leadership team can lose?', acceptedAnswer: { '@type': 'Answer', text: 'The Flag (shared priorities), the Decision (the team can commit and a call sticks), the Rhythm (work gets finished, not just started), the Standard (the team holds each other to the bar), and the Learning (the team examines misses and corrects). Teams rarely fail at all five — they fail at one first.' } },
  ] },
];
---
<BaseLayout title={title} description={description} path={SLUGS.breakPointAssessment} ogTitle="Where will your executive team break first? Free self-assessment" ogDescription="Ten questions. Five components. One honest read on where your leadership team breaks first." schema={schema}>
  <SiteHeader audience="teams" logoHref="/" />

  <header style="position:relative;max-width:980px;margin:0 auto;padding:76px 32px 30px;">
    <div style="position:absolute;top:-100px;right:-140px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:24px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.resources} style="color:inherit;text-decoration:none;">Resources</a><span>/</span><span style="color:#D98A5E;">Break-Point Self-Assessment</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">Free &middot; 4 minutes &middot; no email to see your result</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(34px,5.2vw,62px);line-height:1.02;letter-spacing:-0.02em;max-width:18ch;color:#FBF8F1;">Where will your executive team break first?</h1>
    <p style="margin-top:24px;font-size:clamp(17px,2vw,21px);line-height:1.54;max-width:60ch;color:rgba(244,240,231,0.82);">Ten honest questions across the five components that hold a leadership team upright. Answer for the team as it actually operates &mdash; not as you hope it does. You'll get your break-point on screen, immediately.</p>
  </header>

  <BreakPointAssessment />

  <SiteFooter audience="teams" variant="slim" maxWidth={980} note="© 2026 Be Legendary · Your answers stay in your browser until you choose to send them." />
</BaseLayout>
