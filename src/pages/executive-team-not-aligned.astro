---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareRow from '../components/ShareRow.astro';
import ArticleEndCTA from '../components/ArticleEndCTA.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = "Executive Team Not Aligned on Priorities? | Be Legendary";
const description = "When each leader names different top priorities, the problem isn't disagreement — they were never defined precisely enough to test a decision against.";

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Field Notes', item: 'https://www.belegendary.org/field-notes/' },
    { '@type': 'ListItem', position: 3, name: 'Executive team not aligned on priorities', item: 'https://www.belegendary.org/executive-team-not-aligned/' },
  ] },
  { '@type': 'Article', headline: "My executive team isn't aligned on priorities. Why?", datePublished: '2026-06-19', dateModified: '2026-06-19', author: { '@id': 'https://www.belegendary.org/#james' }, publisher: { '@id': 'https://www.belegendary.org/#org' }, mainEntityOfPage: 'https://www.belegendary.org/executive-team-not-aligned/', description: "When each leader would name different top priorities, the problem isn't disagreement — it's that the priorities were never defined precisely enough to test a decision against." },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: "Why isn't my executive team aligned on priorities?", acceptedAnswer: { '@type': 'Answer', text: "Usually because the priorities were never defined precisely enough to test a decision against. When the top priorities are vague — 'grow revenue,' 'improve the product' — every leader fills the gap with their own function's reading, so each would name a different list. Alignment isn't agreement in a meeting; it's a shared set of 2-3 priorities specific enough that anyone can check a tradeoff against them." } },
    { '@type': 'Question', name: 'How do I get my leadership team aligned?', acceptedAnswer: { '@type': 'Answer', text: 'Define 2-3 priorities precisely enough that a leader could use them to settle a real tradeoff without you in the room. Then pressure-test them: ask each executive privately for the top three and compare. The gaps reveal exactly where the alignment is an illusion. Alignment holds when the priorities can adjudicate a decision, not just inspire one.' } },
    { '@type': 'Question', name: 'What does it mean when leaders give different top priorities?', acceptedAnswer: { '@type': 'Answer', text: "It means the Flag — the shared center the whole team is supposed to serve — has gone fuzzy and is being shredded by exceptions. Each function makes a reasonable case for its own priority because nothing precise exists to rank them. It's a sign the alignment discipline has drifted, and it can be rebuilt." } },
  ] },
];
---
<BaseLayout title={title} description={description} path={SLUGS.notAligned} ogType="article" ogTitle="My executive team isn't aligned on priorities. Why?" ogDescription="If two leaders would name different top priorities, the Flag has gone fuzzy. Here's how alignment is rebuilt." schema={schema}>
  <SiteHeader audience="teams" logoHref="/" maxWidth={880} links={[]} />

  <article>
  <header style="position:relative;max-width:880px;margin:0 auto;padding:80px 32px 40px;">
    <div style="position:absolute;top:-100px;right:-160px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.fieldNotes} style="color:inherit;text-decoration:none;">Field notes</a><span>/</span><span style="color:#D98A5E;">Not aligned on priorities</span>
    </nav>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(32px,5vw,56px);line-height:1.03;letter-spacing:-0.02em;color:#FBF8F1;">My executive team isn't aligned on priorities. Why?</h1>
    <p style="margin-top:18px;font-size:14px;color:rgba(244,240,231,0.55);">By <a href={SLUGS.about} style="color:#D98A5E;text-decoration:none;">James Carter</a> &middot; Updated June 2026</p>
    <div style="margin-top:30px;background:#211D15;border:1px solid rgba(192,74,38,0.35);border-left:3px solid #C04A26;border-radius:14px;padding:26px 28px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The short answer</p>
      <p class="bl-speakable" style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:#FBF8F1;">Because the priorities were never defined precisely enough to settle a decision. When the top priorities are vague, every leader fills the gap with their own function's reading &mdash; so ask each for the top three and you'll get different lists. This is the Flag: the center the whole team is meant to serve. Alignment isn't agreement in a meeting; it's <strong style="color:#FBF8F1;">2&ndash;3 priorities specific enough that anyone can test a tradeoff against them</strong> without you in the room.</p>
    </div>
  </header>

  <div style="max-width:880px;margin:0 auto;padding:24px 32px 20px;">
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;">Here's the test that exposes it. Ask each of your leaders, privately, to write down the company's top three priorities. You expect overlap. What you usually get is five different lists that rhyme but don't match &mdash; and each person is genuinely convinced theirs is the real one.</p>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;">The reframe most leaders miss: <strong style="color:#FBF8F1;">this isn't disagreement &mdash; it's vagueness.</strong> Nobody is fighting the priorities. They simply weren't defined sharply enough to rank against each other, so each function reads them through its own lens and acts accordingly. Sales optimizes for the quarter, product for the roadmap, ops for stability &mdash; all reasonable, all pulling apart.</p>
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.1;letter-spacing:-0.015em;color:#FBF8F1;margin:44px 0 20px;">Why alignment drifts</h2>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;"><strong style="color:#FBF8F1;">The Flag is a slogan, not a test.</strong> &ldquo;Grow revenue&rdquo; can't adjudicate a real tradeoff. A priority that can't settle a decision isn't a priority &mdash; it's a banner.</p>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;"><strong style="color:#FBF8F1;">Exceptions shred it.</strong> Every &ldquo;just this once&rdquo; that violates the priority teaches the team the priority is negotiable. After enough of them, no one knows what actually ranks.</p>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;"><strong style="color:#FBF8F1;">Alignment is confused with consensus.</strong> Everyone nodded in the offsite, so you assumed alignment. But nodding is agreement on the words; alignment is agreement on what they mean when they collide with a hard choice.</p>
  </div>

  <div style="max-width:880px;margin:24px auto 0;padding:0 32px;">
    <div style="background:#F4F0E7;color:#1B1810;border-radius:18px;padding:34px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">The fix: a Flag you can test against</p>
      <p style="font-size:18px;line-height:1.62;color:#3A372F;">Define 2&ndash;3 priorities precise enough that a leader could use them to settle a real tradeoff alone. Then stress-test: hand the team an actual conflict &mdash; a resourcing call, a deadline vs. quality choice &mdash; and see whether the priorities resolve it. If they do, you have a Flag. If the room splits, you've found exactly where the alignment was an illusion &mdash; and that's the work.</p>
    </div>
  </div>

  <div style="max-width:880px;margin:36px auto 0;padding:0 32px;">
    <div style="background:linear-gradient(120deg,#211D15,#191610);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:38px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;">See if the Flag is your team's first break point.</h2>
      <p style="margin-top:16px;font-size:17.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:60ch;">A Calibration Call is 15 minutes. You'll run a short exercise that surfaces priority misalignment in real time &mdash; and leave knowing where your team stands, whether or not we work together.</p>
      <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:26px;display:inline-flex;align-items:center;gap:9px;background:#C04A26;color:#fff;text-decoration:none;padding:16px 30px;border-radius:11px;font-weight:700;font-size:16.5px;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Book a Calibration Call <span style="font-size:18px;">&rarr;</span></a>
    </div>
  </div>

  <div style="max-width:880px;margin:60px auto 0;padding:0 32px 20px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Keep reading</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <a href={SLUGS.whyNotExecuting} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Why isn't my executive team executing?</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The four disciplines, and which one breaks first.</span>
      </a>
      <a href={SLUGS.flagModel} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">The Flag Model, in full</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The Flag is the center the four cables hold upright.</span>
      </a>
    </div>
  </div>
    <ArticleEndCTA maxWidth={920} />
    <ShareRow title={title} maxWidth={920} />
</article>

  <SiteFooter audience="teams" variant="slim" maxWidth={880} note="© 2026 Be Legendary. Field notes on executive-team execution." />
</BaseLayout>
