---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = 'Case Studies: Executive Team Turnarounds | Be Legendary';
const description = 'Real executive-team turnarounds: a $350M construction group that unified seven rival firms, a family wine maker that ended the blame game, and more.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Case Studies', item: 'https://www.belegendary.org/case-studies/' },
  ] },
  { '@type': 'CollectionPage', '@id': 'https://www.belegendary.org/case-studies/#page', name: 'Case Studies', about: 'Executive-team turnarounds guided by Be Legendary', isPartOf: { '@type': 'Organization', name: 'Be Legendary' } },
  { '@type': 'ItemList', name: 'Be Legendary executive-team case studies', itemListElement: [
    { '@type': 'ListItem', position: 1, item: { '@type': 'CreativeWork', name: 'How James Carter helped Eagle Manufacturing Group unify seven rival firms', about: 'Eagle Manufacturing Group (formerly US Holdings), a $350M construction holding company, unified seven competing firms into one and grew to $1.2B in revenue within two years with zero layoffs, through a multi-year Performance Partnership with James Carter — attributed by former CEO Ronn Page.', creator: { '@id': 'https://www.belegendary.org/#org' } } },
    { '@type': 'ListItem', position: 2, item: { '@type': 'CreativeWork', name: 'The owner who ended the blame game and tripled the company', about: 'A family-owned wine manufacturer went from $3.5M to $10M in revenue within a year and reached $15M once the disciplines were re-established.', creator: { '@id': 'https://www.belegendary.org/#org' } } },
    { '@type': 'ListItem', position: 3, item: { '@type': 'CreativeWork', name: 'Reuniting an executive team and 23 regional directors', about: 'A national franchise rebuilt trust between its executive team and 23 regional directors through a facilitated three-day conference during a crisis.', creator: { '@id': 'https://www.belegendary.org/#org' } } },
    { '@type': 'ListItem', position: 4, item: { '@type': 'CreativeWork', name: 'The honest call about who fits', about: 'An enterprise-software executive team of five worked through six months of retreats and coaching to resolve a fit issue and rebuild as a team.', creator: { '@id': 'https://www.belegendary.org/#org' } } },
    { '@type': 'ListItem', position: 5, item: { '@type': 'CreativeWork', name: 'Five former rivals, one fiscal branch', about: 'A federal agency branch running a $1B budget forged five previously competing sub-branches into one leadership team; the agency expanded the work to two further layers.', creator: { '@id': 'https://www.belegendary.org/#org' } } },
  ] },
  { '@type': 'Review', itemReviewed: { '@id': 'https://www.belegendary.org/#org' },
    author: { '@type': 'Person', name: 'Ronn Page', jobTitle: 'former CEO, Eagle Manufacturing Group' },
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    reviewBody: 'James helped us turn seven groups of rivals into one leadership team. By the time US Holdings became Eagle Manufacturing Group and I moved from COO to CEO, we were no longer seven companies protecting our own territory. We were one company working toward the same outcome.' },
  { '@type': 'Organization', name: 'Eagle Manufacturing Group', alternateName: 'US Holdings', description: 'A construction holding company that unified seven competing firms into one, growing from $350M to $1.2B in revenue in a Performance Partnership with James Carter of Be Legendary.' },
];
---
<BaseLayout title={title} description={description} path={SLUGS.caseStudies} ogType="website" ogTitle="Case studies — executive teams that chose to change" ogDescription="Real turnarounds, led by the executives who had the courage to look honestly at their teams." schema={schema}>
  <SiteHeader audience="teams" logoHref="/" />

  <header style="position:relative;max-width:1080px;margin:0 auto;padding:84px 32px 56px;">
    <div style="position:absolute;top:-100px;right:-140px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:24px;display:flex;gap:8px;align-items:center;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><span style="color:#D98A5E;">Case studies</span>
    </nav>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(36px,5.4vw,68px);line-height:1.02;letter-spacing:-0.02em;max-width:18ch;color:#FBF8F1;">The leaders made the call. We helped them land it.</h1>
    <p style="margin-top:26px;font-size:clamp(18px,2.1vw,22px);line-height:1.52;max-width:60ch;color:rgba(244,240,231,0.8);">Every turnaround below started the same way: an executive looked honestly at a team that wasn't working and chose to do something about it. That choice is the hero of each story. Our job was to stand beside them and help the disciplines hold. The flagship case below is named and attributed; the others are anonymized at the clients&rsquo; request.</p>
  </header>

  <section style="background:#F4F0E7;color:#1B1810;padding:84px 32px;">
    <div style="max-width:1080px;margin:0 auto;">
      <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:24px;">
        <span style="font-size:12.5px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#C04A26;">Eagle Manufacturing Group &middot; construction holding company</span>
        <span style="font-size:12.5px;font-weight:600;color:#6B675E;">Named &middot; used with permission</span>
      </div>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,44px);line-height:1.08;letter-spacing:-0.015em;max-width:24ch;">The COO who turned seven rivals into one company.</h2>
      <div class="bl-grid-collapse" style="margin-top:28px;display:grid;grid-template-columns:1.4fr 1fr;gap:44px;align-items:start;">
        <div>
          <p style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A8578;margin-bottom:8px;">The courageous call</p>
          <p style="font-size:17.5px;line-height:1.66;color:#3A372F;">A holding company of seven separate construction firms was sliding toward insolvency &mdash; not for lack of talent, but because the structure rewarded competition over collaboration. Two of the seven company presidents were, on paper, each other's largest competitor. The COO saw the real ceiling and made the hard decision: unify the group under one set of books, one brand, one team. Then he brought James in &mdash; on a pay-for-performance blend, a small monthly fee plus bonuses tied to the numbers, so everyone had a stake in the outcome.</p>
          <p style="margin-top:18px;font-size:17.5px;line-height:1.66;color:#3A372F;">The work was the human side. James supported the people executing the merger of seven accounting systems &mdash; helping them do it faster and better, streamlining communication, resolving the conflicts that erupt when rivals are asked to become teammates, and making sure the team paused to celebrate the wins.</p>
        </div>
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:18px;padding:30px;">
          <p style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">Within two years</p>
          <div style="display:flex;flex-direction:column;gap:18px;">
            <div><p style="font-family:'Newsreader',serif;font-size:34px;line-height:1;color:#1B1810;">$1.2B</p><p style="margin-top:6px;font-size:14px;color:#6B675E;">revenue, up from $350M</p></div>
            <div><p style="font-family:'Newsreader',serif;font-size:34px;line-height:1;color:#1B1810;">7 &rarr; 1</p><p style="margin-top:6px;font-size:14px;color:#6B675E;">sets of books, fully streamlined; one rebranded company</p></div>
            <div><p style="font-family:'Newsreader',serif;font-size:34px;line-height:1;color:#1B1810;">0</p><p style="margin-top:6px;font-size:14px;color:#6B675E;">layoffs &mdash; non-performing sites closed, every willing employee relocated</p></div>
          </div>
        </div>
      </div>

      <!-- Named, attributed flagship quote — endorses the deep, multi-year work -->
      <figure style="margin:48px 0 0;border-top:1px solid rgba(27,24,16,0.12);padding-top:38px;">
        <blockquote style="margin:0;font-family:'Newsreader',serif;font-style:italic;font-size:clamp(19px,2.3vw,26px);line-height:1.45;color:#1B1810;max-width:62ch;">&ldquo;The seven companies were led by exceptionally smart, capable people&hellip; In the beginning, they hated James. He challenged how they communicated, how they made decisions, and how they saw one another. He did not try to outsmart them or impose some academic management theory. He earned their respect by understanding the work, confronting the real conflicts, and helping them produce results&hellip; James helped us turn seven groups of rivals into one leadership team. By the time US Holdings became Eagle Manufacturing Group and I moved from COO to CEO, we were no longer seven companies protecting our own territory. We were one company working toward the same outcome.&rdquo;</blockquote>
        <figcaption style="margin-top:22px;font-size:14.5px;color:#5C544C;"><strong style="color:#1B1810;">Ronn Page</strong> &middot; former CEO, Eagle Manufacturing Group<br><span style="font-size:13px;color:#8A7F6C;">A founding client, speaking to origin-era work with James that predates the Flag Model. Used with permission; Ronn Page has since passed away.</span></figcaption>
      </figure>
    </div>
  </section>

  <section style="background:#15130E;color:#F4F0E7;padding:84px 32px;">
    <div style="max-width:1080px;margin:0 auto;">
      <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:24px;">
        <span style="font-size:12.5px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;">Wine manufacturer &middot; family-owned &middot; $3.5M</span>
        <span style="font-size:12.5px;font-weight:600;color:rgba(244,240,231,0.5);">Turnaround</span>
      </div>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,44px);line-height:1.08;letter-spacing:-0.015em;max-width:26ch;color:#FBF8F1;">The owner who ended the blame game &mdash; and tripled the company.</h2>
      <div class="bl-grid-collapse" style="margin-top:28px;display:grid;grid-template-columns:1.4fr 1fr;gap:44px;align-items:start;">
        <div>
          <p style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(244,240,231,0.45);margin-bottom:8px;">The courageous call</p>
          <p style="font-size:17.5px;line-height:1.66;color:rgba(244,240,231,0.84);">The owner knew he had the right people. What he didn't have was a team. Sales blamed admin, admin blamed manufacturing, manufacturing blamed shipping &mdash; a vicious circle while the company watched every penny and inched toward insolvency. Rather than replace people, he made the harder choice: bring them together. With almost no operating cash, he and James worked on a pay-for-performance blend so the risk was shared.</p>
          <p style="margin-top:18px;font-size:17.5px;line-height:1.66;color:rgba(244,240,231,0.84);">The result came fast &mdash; profitability and growth inside a year. Then a telling proof point: during a year when the engagement paused, the company stalled. When the disciplines came back, so did the growth.</p>
        </div>
        <div style="background:#211D15;border:1px solid rgba(244,240,231,0.12);border-radius:18px;padding:30px;">
          <p style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#E0744A;margin-bottom:18px;">The trajectory</p>
          <div style="display:flex;flex-direction:column;gap:18px;">
            <div><p style="font-family:'Newsreader',serif;font-size:34px;line-height:1;color:#FBF8F1;">$3.5M &rarr; $10M</p><p style="margin-top:6px;font-size:14px;color:rgba(244,240,231,0.6);">revenue within the first year &mdash; and more profitable</p></div>
            <div><p style="font-family:'Newsreader',serif;font-size:34px;line-height:1;color:#FBF8F1;">$15M</p><p style="margin-top:6px;font-size:14px;color:rgba(244,240,231,0.6);">reached after the disciplines were re-established</p></div>
            <div><p style="font-family:'Newsreader',serif;font-size:20px;line-height:1.2;color:#FBF8F1;font-style:italic;">Stalled when the work stopped. Grew when it resumed.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="background:#F4F0E7;color:#1B1810;padding:84px 32px;">
    <div style="max-width:1080px;margin:0 auto;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">More teams that chose to change</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,40px);line-height:1.08;letter-spacing:-0.015em;max-width:22ch;">Trust, rebuilt under real pressure.</h2>
      <div class="bl-grid-collapse" style="margin-top:36px;display:grid;grid-template-columns:repeat(2,1fr);gap:20px;">
        <article style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:18px;padding:30px;display:flex;flex-direction:column;">
          <span style="font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A8578;">National franchise &middot; COO</span>
          <h3 style="margin-top:12px;font-family:'Newsreader',serif;font-weight:500;font-size:22px;line-height:1.14;">Reuniting an exec team and 23 regional directors.</h3>
          <p style="margin-top:14px;font-size:15px;line-height:1.6;color:#56524A;">Trust between the executive team and 23 regional directors had broken down amid miscommunication and perceived divides. We designed a three-day conference, in a period of real crisis, to re-establish trust and a way to work through the hard things together &mdash; with ongoing coaching for the COO since.</p>
        </article>
        <article style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:18px;padding:30px;display:flex;flex-direction:column;">
          <span style="font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A8578;">Enterprise software &middot; President &amp; CEO</span>
          <h3 style="margin-top:12px;font-family:'Newsreader',serif;font-weight:500;font-size:22px;line-height:1.14;">The honest call about who fits.</h3>
          <p style="margin-top:14px;font-size:15px;line-height:1.6;color:#56524A;">Over six months of retreats and individual coaching with an executive team of five, it became clear &mdash; to everyone &mdash; that one leader wasn't a fit for the group. The CEO handled it with grace: an amicable parting, and a new hire chosen for fit, brought in with our help.</p>
        </article>
      </div>
      <p style="margin-top:26px;font-size:15px;line-height:1.6;color:#56524A;">Looking for the immersive retreat stories &mdash; the auto retailer, the San Juans, the Everglades, the federal fiscal branch, Alaska? They&rsquo;re in <a href="#retreat-case-studies" style="color:#C04A26;font-weight:600;text-decoration:none;border-bottom:1px solid rgba(192,74,38,0.35);">Retreat Case Studies</a> below.</p>
    </div>
  </section>

  <!-- RETREAT CASE STUDIES — deep-link target for /teams/retreats/ ("#retreat-case-studies"). Kept
       visually and narratively distinct from the coaching turnarounds above so the two don't blur. -->
  <section id="retreat-case-studies" style="scroll-margin-top:90px;background:#15130E;color:#F4F0E7;padding:84px 32px;">
    <div style="max-width:1080px;margin:0 auto;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#E0744A;margin-bottom:18px;">Retreat Case Studies</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,40px);line-height:1.08;letter-spacing:-0.015em;max-width:24ch;color:#FBF8F1;">Experiences engineered to change a team — and measured after.</h2>
      <p style="margin-top:20px;font-size:17px;line-height:1.6;color:rgba(244,240,231,0.72);max-width:64ch;">Bespoke and signature retreats where the environment does the teaching. Each was designed backward from a specific outcome, then tracked with our behavioral habit tracker for 30 days. Clients anonymized; engagement details shared with permission.</p>

      <div class="bl-grid-collapse" style="margin-top:36px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">

        <a href={SLUGS.caseAutoRetailer} style="display:flex;flex-direction:column;background:#FBF8F1;color:#1B1810;border:1px solid rgba(244,240,231,0.1);border-radius:18px;padding:30px;text-decoration:none;transition:transform .16s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
          <span style="font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A8578;">Bespoke &middot; Off-road &middot; Auto retailer</span>
          <h3 style="margin-top:12px;font-family:'Newsreader',serif;font-weight:500;font-size:22px;line-height:1.14;">Five-star egos, one fractured team, a minivan they'll never forget.</h3>
          <p style="margin-top:14px;font-size:15px;line-height:1.6;color:#56524A;flex-grow:1;">Five all-stars poached from rivals, fighting for turf, remade into one team through a retreat built entirely around vehicles, empathy, and shared adversity.</p>
          <span style="margin-top:18px;display:inline-flex;align-items:center;gap:10px;"><span style="font-family:'Newsreader',serif;font-size:26px;color:#C04A26;">178%</span><span style="font-size:13px;color:#8A8578;">teaming gain &middot; 30 days</span></span>
          <span style="margin-top:14px;font-size:13px;font-weight:700;color:#C04A26;">Read the case study &rarr;</span>
        </a>

        <a href={SLUGS.caseSanJuan} style="display:flex;flex-direction:column;background:#FBF8F1;color:#1B1810;border:1px solid rgba(244,240,231,0.1);border-radius:18px;padding:30px;text-decoration:none;transition:transform .16s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
          <span style="font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A8578;">Bespoke &middot; Winter survival &middot; Biomedical</span>
          <h3 style="margin-top:12px;font-family:'Newsreader',serif;font-weight:500;font-size:22px;line-height:1.14;">Two camps, one mountain, and our biggest change ever.</h3>
          <p style="margin-top:14px;font-size:15px;line-height:1.6;color:#56524A;flex-grow:1;">A team split into two warring camps over work ethic, reunited by an avalanche-survival scenario in Colorado's San Juan Mountains.</p>
          <span style="margin-top:18px;display:inline-flex;align-items:center;gap:10px;"><span style="font-family:'Newsreader',serif;font-size:26px;color:#C04A26;">268%</span><span style="font-size:13px;color:#8A8578;">behavioral gain &middot; 30 days</span></span>
          <span style="margin-top:14px;font-size:13px;font-weight:700;color:#C04A26;">Read the case study &rarr;</span>
        </a>

        <a href={SLUGS.caseEverglades} style="display:flex;flex-direction:column;background:#FBF8F1;color:#1B1810;border:1px solid rgba(244,240,231,0.1);border-radius:18px;padding:30px;text-decoration:none;transition:transform .16s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
          <span style="font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A8578;">Signature &middot; Everglades &middot; Professional services</span>
          <h3 style="margin-top:12px;font-family:'Newsreader',serif;font-weight:500;font-size:22px;line-height:1.14;">A pile of trash, a floating island, a team that stopped seeing scarcity.</h3>
          <p style="margin-top:14px;font-size:15px;line-height:1.6;color:#56524A;flex-grow:1;">A CIO's team learned to maximize the resources they already had through a shelter-box survival simulation deep in the Everglades.</p>
          <span style="margin-top:18px;display:inline-flex;align-items:center;gap:10px;"><span style="font-family:'Newsreader',serif;font-size:26px;color:#C04A26;">113%</span><span style="font-size:13px;color:#8A8578;">abundance-mindset gain</span></span>
          <span style="margin-top:14px;font-size:13px;font-weight:700;color:#C04A26;">Read the case study &rarr;</span>
        </a>

        <a href={SLUGS.caseFederalFiscal} style="display:flex;flex-direction:column;background:#FBF8F1;color:#1B1810;border:1px solid rgba(244,240,231,0.1);border-radius:18px;padding:30px;text-decoration:none;transition:transform .16s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
          <span style="font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A8578;">Retreat series &middot; Federal agency &middot; $1B budget</span>
          <h3 style="margin-top:12px;font-family:'Newsreader',serif;font-weight:500;font-size:22px;line-height:1.14;">Five former rivals, one fiscal branch.</h3>
          <p style="margin-top:14px;font-size:15px;line-height:1.6;color:#56524A;flex-grow:1;">Five executives from four formerly competing branches, virtual across every time zone, forged into one team &mdash; through a retreat in each leader's own time zone.</p>
          <span style="margin-top:18px;display:inline-flex;align-items:center;gap:10px;"><span style="font-family:'Newsreader',serif;font-size:26px;color:#C04A26;">+2</span><span style="font-size:13px;color:#8A8578;">org layers added after</span></span>
          <span style="margin-top:14px;font-size:13px;font-weight:700;color:#C04A26;">Read the case study &rarr;</span>
        </a>

        <a href={SLUGS.caseAlaska} style="display:flex;flex-direction:column;background:#FBF8F1;color:#1B1810;border:1px solid rgba(244,240,231,0.1);border-radius:18px;padding:30px;text-decoration:none;transition:transform .16s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
          <span style="font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A8578;">Bespoke &middot; Fortune 100 &middot; Vulnerability</span>
          <h3 style="margin-top:12px;font-family:'Newsreader',serif;font-weight:500;font-size:22px;line-height:1.14;">The most polished team in the building. And the most alone.</h3>
          <p style="margin-top:14px;font-size:15px;line-height:1.6;color:#56524A;flex-grow:1;">A Fortune 100 team's professional armor dissolved in a staged Alaska survival scenario &mdash; into the closest executive group we've seen in 25 years.</p>
          <span style="margin-top:18px;display:inline-flex;align-items:center;gap:10px;"><span style="font-family:'Newsreader',serif;font-size:18px;font-style:italic;color:#C04A26;">Bonds intact today</span></span>
          <span style="margin-top:14px;font-size:13px;font-weight:700;color:#C04A26;">Read the case study &rarr;</span>
        </a>

      </div>
    </div>
  </section>

  <section style="background:linear-gradient(180deg,#1B1810,#15130E);color:#F4F0E7;padding:110px 32px;text-align:center;position:relative;">
    <div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(192,74,38,0.22),transparent 55%);pointer-events:none;"></div>
    <div style="position:relative;max-width:720px;margin:0 auto;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(30px,4.8vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#FBF8F1;">Every one of these started with one honest conversation.</h2>
      <p style="margin-top:22px;font-size:18px;line-height:1.58;color:rgba(244,240,231,0.78);max-width:48ch;margin-left:auto;margin-right:auto;">Yours can too. A Calibration Call is 15 minutes &mdash; and you'll leave with a concrete read on your team whether or not we work together.</p>
