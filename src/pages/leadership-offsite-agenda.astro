---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareRow from '../components/ShareRow.astro';
import ArticleEndCTA from '../components/ArticleEndCTA.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = 'Leadership Offsite Agenda Template & Example';
const description =
  'A leadership offsite agenda template you can copy — a proven two-day structure built around one outcome, the hard conversation, and a plan that sticks.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.belegendary.org/resources/' },
    { '@type': 'ListItem', position: 3, name: 'Leadership Offsite Agenda Template', item: 'https://www.belegendary.org/leadership-offsite-agenda/' },
  ] },
  { '@type': 'Article', headline: 'Leadership offsite agenda template (with a two-day example)', datePublished: '2026-07-09', dateModified: '2026-07-09', author: { '@id': 'https://www.belegendary.org/#james' }, publisher: { '@id': 'https://www.belegendary.org/#org' }, mainEntityOfPage: 'https://www.belegendary.org/leadership-offsite-agenda/', description: 'A copy-ready leadership offsite agenda: reset the Flag, hold the hard conversation, turn it into owned decisions, and plan the 30-day reinforcement.' },
  { '@type': 'HowTo', name: 'How to structure a leadership offsite agenda', description: 'The five blocks a leadership offsite agenda must run, in order, so the offsite ends in owned decisions and a plan that survives the drive home.', totalTime: 'P2D', step: [
    { '@type': 'HowToStep', position: 1, name: 'Name the one outcome', url: 'https://www.belegendary.org/leadership-offsite-agenda/#template', text: 'Before you drop times into a calendar, finish the sentence: “This offsite worked if, thirty days later, ___ is different.” The facilitator — not the CEO — frames that outcome and why now.' },
    { '@type': 'HowToStep', position: 2, name: 'Reset the Flag', url: 'https://www.belegendary.org/leadership-offsite-agenda/#template', text: 'Agree the two or three priorities everything serves for the next quarter. If the team can’t name them together, that gap is the offsite.' },
    { '@type': 'HowToStep', position: 3, name: 'Hold the honest conversation', url: 'https://www.belegendary.org/leadership-offsite-agenda/#template', text: 'Take on the one topic the team talks around and never through. Facilitated, on purpose, with the CEO as a participant — not the referee.' },
    { '@type': 'HowToStep', position: 4, name: 'Turn talk into owned decisions', url: 'https://www.belegendary.org/leadership-offsite-agenda/#template', text: 'Close each open issue: one owner, one deadline, and the obligation to defend it. A conversation with no decision is just a nicer meeting.' },
    { '@type': 'HowToStep', position: 5, name: 'Build the 30-day reinforcement', url: 'https://www.belegendary.org/leadership-offsite-agenda/#template', text: 'The block almost every agenda skips — and the one that decides whether any of it survives. Name who checks what, when, and in which meeting, before anyone leaves.' },
  ] },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'What should a leadership offsite agenda include?', acceptedAnswer: { '@type': 'Answer', text: 'A strong leadership offsite agenda has five blocks: (1) name the single outcome the offsite must produce; (2) reset alignment on the two or three priorities that matter; (3) hold the honest conversation the team usually avoids, with a facilitator; (4) turn that conversation into decisions with an owner and a deadline each; and (5) build the 30-day reinforcement plan before anyone leaves. Meals and logistics fill the gaps — they are not the agenda.' } },
    { '@type': 'Question', name: 'How long should a leadership offsite be?', acceptedAnswer: { '@type': 'Answer', text: 'Two to three days for most executive teams: an arrival-and-reset evening, a full working day, and a half day to commit and plan reinforcement. A single day can work if the outcome is one decision; anything past three days hits diminishing returns unless it is a deliberately immersive experience.' } },
    { '@type': 'Question', name: 'What is the biggest mistake in an offsite agenda?', acceptedAnswer: { '@type': 'Answer', text: 'Skipping the reinforcement block. Most agendas end with energy and good intentions and no mechanism, so the work fades within a week. A leadership offsite only sticks if every decision leaves with an owner, a deadline, a place it will be checked, and a 30-day rhythm to hold it.' } },
  ] },
];
---
<BaseLayout
  title={title}
  description={description}
  path={SLUGS.offsiteAgenda}
  ogType="article"
  ogTitle="Leadership Offsite Agenda Template & Example"
  ogDescription="A copy-ready two-day agenda built around one outcome, the honest conversation, and the reinforcement most agendas skip."
  schema={schema}
>
  <SiteHeader audience="teams" logoHref="/" />

  <article>
  <!-- HERO -->
  <header style="position:relative;max-width:920px;margin:0 auto;padding:80px 32px 40px;">
    <div style="position:absolute;top:-100px;right:-160px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.resources} style="color:inherit;text-decoration:none;">Resources</a><span>/</span><span style="color:#D98A5E;">Leadership Offsite Agenda Template</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">Template</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(32px,5vw,58px);line-height:1.03;letter-spacing:-0.02em;color:#FBF8F1;">Leadership offsite agenda template</h1>
    <p style="margin-top:18px;font-size:14px;color:rgba(244,240,231,0.55);">By <a href={SLUGS.about} style="color:#D98A5E;text-decoration:none;">James Carter</a> &middot; Updated July 2026</p>
    <div style="margin-top:30px;background:#211D15;border:1px solid rgba(192,74,38,0.35);border-left:3px solid #C04A26;border-radius:14px;padding:26px 28px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The short answer</p>
      <p class="bl-speakable" style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:#FBF8F1;">A leadership offsite agenda should run five blocks, in order: <strong>name the one outcome</strong>, <strong>reset the Flag</strong> (the 2&ndash;3 priorities everything serves), <strong>hold the honest conversation</strong> the team avoids, <strong>turn it into owned decisions</strong> (owner + deadline), and <strong>build the 30-day reinforcement</strong> before anyone leaves. Below is a copy-ready two-day version &mdash; adapt the blocks, not the order.</p>
    </div>
  </header>

  <!-- ON THIS PAGE -->
  <nav aria-label="On this page" style="max-width:920px;margin:26px auto 0;padding:0 32px;">
    <div style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:20px 24px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:12px;">On this page</p>
      <ol style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px 22px;">
        <li><a href="#template" style="color:rgba(244,240,231,0.82);text-decoration:none;font-size:15px;border-bottom:1px solid rgba(192,74,38,0.45);padding-bottom:1px;">The two-day template</a></li>
        <li><a href="#adapt" style="color:rgba(244,240,231,0.82);text-decoration:none;font-size:15px;border-bottom:1px solid rgba(192,74,38,0.45);padding-bottom:1px;">Adapt it to your time</a></li>
        <li><a href="#faq" style="color:rgba(244,240,231,0.82);text-decoration:none;font-size:15px;border-bottom:1px solid rgba(192,74,38,0.45);padding-bottom:1px;">Straight answers</a></li>
      </ol>
    </div>
  </nav>

  <!-- PRINCIPLE -->
  <div style="max-width:920px;margin:0 auto;padding:24px 32px 8px;">
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);">An agenda isn&rsquo;t a schedule of activities &mdash; it&rsquo;s the path to one outcome. Before you drop times into a calendar, finish this sentence: <em style="color:#F4F0E7;">&ldquo;This offsite worked if, thirty days later, ___ is different.&rdquo;</em> Then build backward. The template below is the structure we use; if you want the thinking behind each block, start with <a href={SLUGS.howToPlanRetreat} style="color:#D98A5E;">how to plan a leadership retreat</a>.</p>
  </div>

  <!-- THE TEMPLATE -->
  <div id="template" style="max-width:920px;margin:32px auto 0;padding:0 32px;scroll-margin-top:90px;">
    <div style="background:#F4F0E7;color:#1B1810;border-radius:18px;padding:34px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:6px;">Copy this &mdash; two-day agenda</p>
      <p style="font-size:15px;line-height:1.6;color:#5A5248;margin-bottom:26px;">For a leadership team of 5&ndash;12. Times are a guide; protect the blocks in bold.</p>

      <p style="font-family:'Newsreader',serif;font-size:22px;color:#1B1810;margin:0 0 6px;">Day 1 &mdash; Arrive &amp; reset <span style="font-size:15px;color:#8A7F6C;">(afternoon / evening)</span></p>
      <ul style="list-style:none;padding:0;margin:0 0 26px;display:flex;flex-direction:column;gap:12px;">
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">4:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;">Arrive, settle in, phones away. No content yet &mdash; just decompress from the day job.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">5:30</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;"><strong>Frame the one outcome.</strong> The facilitator (not the CEO) states what this offsite must produce, and why now.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">6:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;"><strong>Lightning round.</strong> Each person names, in one sentence, the single thing they most want resolved before they go home. No debate &mdash; just get it on the table.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">7:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;">Dinner. No agenda. This is where trust starts &mdash; protect it.</span></li>
      </ul>

      <p style="font-family:'Newsreader',serif;font-size:22px;color:#1B1810;margin:0 0 6px;">Day 2 &mdash; The work <span style="font-size:15px;color:#8A7F6C;">(full day)</span></p>
      <ul style="list-style:none;padding:0;margin:0 0 26px;display:flex;flex-direction:column;gap:12px;">
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">8:30</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;"><strong>Reset the Flag.</strong> Agree the 2&ndash;3 priorities everything serves for the next quarter. If you can&rsquo;t name them together, that&rsquo;s the offsite.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">10:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;"><strong>The honest conversation.</strong> The one topic the team talks around and never through. Facilitated, on purpose, with the CEO as a participant &mdash; not the referee.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">12:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;">Lunch &mdash; and a real break. Let the morning settle.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">1:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;"><strong>Turn talk into decisions.</strong> Take each open issue and close it: one owner, one deadline, and the obligation to defend it. A conversation with no decision is just a nicer meeting.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">3:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;"><strong>Set the Standard.</strong> Name the bar you&rsquo;ll hold each other to &mdash; and what happens when it&rsquo;s missed. Accountability that&rsquo;s decided here is the only kind that survives the drive home.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">4:30</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;">Break, then something shared and off-script &mdash; a walk, a challenge, dinner out. The team needs to be a team, not just a meeting.</span></li>
      </ul>

      <p style="font-family:'Newsreader',serif;font-size:22px;color:#1B1810;margin:0 0 6px;">Day 3 &mdash; Commit &amp; make it stick <span style="font-size:15px;color:#8A7F6C;">(morning)</span></p>
      <ul style="list-style:none;padding:0;margin:0 0 4px;display:flex;flex-direction:column;gap:12px;">
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">8:30</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;"><strong>Lock the commitments.</strong> Read back every decision from Day 2. Each one gets an owner, a deadline, and a named place it will be checked.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">10:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;"><strong>Build the 30-day reinforcement.</strong> The block almost every agenda skips &mdash; and the one that decides whether any of this survives. Who checks what, when, and in which meeting.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">11:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;"><strong>Close out loud.</strong> Each person says their single commitment to the room. Said aloud, to peers, it&rsquo;s far harder to quietly drop.</span></li>
        <li style="display:flex;gap:16px;"><span style="flex:none;width:74px;font-weight:700;color:#C04A26;font-size:14.5px;">12:00</span><span style="font-size:15.5px;line-height:1.5;color:#3A372F;">Depart &mdash; with a plan, not just a feeling.</span></li>
      </ul>
    </div>
  </div>

  <!-- ADAPT -->
  <div id="adapt" style="max-width:920px;margin:44px auto 0;padding:0 32px;scroll-margin-top:90px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.2vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:16px;">Adapt it to your time</h2>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <div style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:24px 26px;">
        <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;margin-bottom:8px;">One day</p>
        <p style="font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.78);">Pick one outcome. Run the Flag reset, the honest conversation, and decisions in the morning; commitments and the 30-day plan after lunch. Skip nothing structural &mdash; just compress.</p>
      </div>
      <div style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:24px 26px;">
        <p style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;margin-bottom:8px;">Half day</p>
        <p style="font-size:15.5px;line-height:1.6;color:rgba(244,240,231,0.78);">Enough for exactly one thing: the honest conversation, turned into decisions and a reinforcement plan. Don&rsquo;t try to reset the whole Flag in three hours.</p>
      </div>
    </div>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-top:24px;">Whatever the length, the one block to defend is the last one. An offsite that ends without a reinforcement plan is the reason <a href={SLUGS.offsitesDontStick} style="color:#D98A5E;">most leadership offsites don&rsquo;t stick</a>.</p>
  </div>

  <!-- CTA -->
  <div style="max-width:920px;margin:44px auto 0;padding:0 32px;">
    <div style="background:linear-gradient(120deg,#211D15,#191610);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:38px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;">Want this agenda run for your team?</h2>
      <p style="margin-top:16px;font-size:17.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:60ch;">A <strong style="color:#F4F0E7;">Calibration Call</strong> is 15 minutes. Tell us the outcome you need and we&rsquo;ll shape the agenda &mdash; and the reinforcement that makes it last &mdash; around it, whether or not we facilitate it.</p>
      <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:26px;display:inline-flex;align-items:center;gap:9px;background:#C04A26;color:#fff;text-decoration:none;padding:16px 30px;border-radius:11px;font-weight:700;font-size:16.5px;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Book a Calibration Call <span style="font-size:18px;">&rarr;</span></a>
    </div>
  </div>

  <!-- STRAIGHT ANSWERS -->
  <div id="faq" style="max-width:920px;margin:56px auto 0;padding:0 32px;scroll-margin-top:90px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;margin-bottom:28px;">Straight answers</h2>
    <div style="display:flex;flex-direction:column;gap:22px;">
      <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:8px;">What should a leadership offsite agenda include?</h3><p style="font-size:16px;line-height:1.65;color:rgba(244,240,231,0.72);">Five blocks: name the one outcome; reset alignment on the two or three priorities that matter; hold the honest conversation the team avoids; turn it into decisions with an owner and deadline each; and build the 30-day reinforcement before anyone leaves. Meals and logistics fill the gaps &mdash; they aren&rsquo;t the agenda.</p></div>
      <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:8px;">How long should a leadership offsite be?</h3><p style="font-size:16px;line-height:1.65;color:rgba(244,240,231,0.72);">Two to three days for most executive teams: an arrival-and-reset evening, a full working day, and a half day to commit and plan reinforcement. One day works if the outcome is a single decision; past three days you hit diminishing returns unless it&rsquo;s a deliberately immersive experience.</p></div>
      <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:8px;">What&rsquo;s the biggest mistake in an offsite agenda?</h3><p style="font-size:16px;line-height:1.65;color:rgba(244,240,231,0.72);">Skipping the reinforcement block. Most agendas end with energy and no mechanism, so the work fades within a week. It only sticks if every decision leaves with an owner, a deadline, a place it&rsquo;s checked, and a 30-day rhythm to hold it.</p></div>
    </div>
  </div>

  <!-- RELATED -->
  <div style="max-width:920px;margin:60px auto 0;padding:0 32px 20px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Keep reading</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <a href={SLUGS.howToPlanRetreat} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">How to plan a leadership retreat</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The thinking behind every block of this agenda.</span>
      </a>
      <a href={SLUGS.offsitesDontStick} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Why leadership offsites don&rsquo;t stick</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The failure this agenda is built to avoid.</span>
      </a>
      <a href={SLUGS.executiveOffsite} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">How to plan an executive offsite</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The step-by-step guide this agenda plugs into.</span>
      </a>
      <a href={SLUGS.retreatFormats} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Retreat formats</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Match the format to the outcome you set.</span>
      </a>
    </div>
  </div>
    <ArticleEndCTA maxWidth={920} />
    <ShareRow title={title} maxWidth={920} />
  </article>

  <SiteFooter audience="teams" variant="slim" maxWidth={920} note="© 2026 Be Legendary. An agenda is a path to one outcome." />
</BaseLayout>
