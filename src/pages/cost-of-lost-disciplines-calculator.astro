---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CostCalculator from '../components/CostCalculator.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = 'Cost of Lost Disciplines Calculator | Be Legendary';
const description = 'Cost of Lost Disciplines Calculator: estimate what ineffective decision time costs your executive team each year — your own numbers times McKinsey\'s finding that ~58% of decision-making time runs ineffective.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.belegendary.org/resources/' },
    { '@type': 'ListItem', position: 3, name: 'Cost of Lost Disciplines Calculator', item: 'https://www.belegendary.org/cost-of-lost-disciplines-calculator/' },
  ] },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'How much does a dysfunctional executive team cost?', acceptedAnswer: { '@type': 'Answer', text: 'The cost rarely appears as a P&L line, which is why most teams never quantify it. What can be measured cleanly is decision time: McKinsey finds managers spend about 37% of their time making decisions and that roughly 58% of that time is used ineffectively. Applied to a leadership team\'s size, decision-meeting hours and loaded hourly cost, that typically runs into the hundreds of thousands of dollars a year — and this calculator computes it directly from your own numbers.' } },
    { '@type': 'Question', name: 'What is the cost of poor decision-making in a company?', acceptedAnswer: { '@type': 'Answer', text: 'McKinsey illustrates ineffective decision-making as costing a typical Fortune 500 company more than 530,000 days of lost management time a year — roughly $250M in labor. That is McKinsey\'s own illustration for a large enterprise, not a measured loss; this tool applies the same underlying figure — about 58% of decision-making time used ineffectively — to your own team\'s numbers.' } },
    { '@type': 'Question', name: 'How is the Cost of Lost Disciplines Calculator estimate produced?', acceptedAnswer: { '@type': 'Answer', text: 'It multiplies your own inputs — leadership headcount, average decision-meeting hours, loaded hourly cost — by one published figure: McKinsey\'s finding that about 58% of decision-making time is used ineffectively. There is no revenue-percentage conversion and no recovery assumption, because neither is established by the underlying research. Every number in the result is your arithmetic times one cited coefficient.' } },
  ] },
];
---
<BaseLayout title={title} description={description} path={SLUGS.costCalculator} ogTitle="The Cost of Lost Disciplines Calculator" ogDescription="Estimate what ineffective decision time is costing your leadership team — your own numbers, times McKinsey's published figure." schema={schema}>
  <SiteHeader audience="teams" logoHref="/" />

  <section style="position:relative;max-width:1140px;margin:0 auto;padding:80px 32px 40px;">
    <div style="position:absolute;top:-100px;right:-140px;width:520px;height:520px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:24px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.resources} style="color:inherit;text-decoration:none;">Resources</a><span>/</span><span style="color:#D98A5E;">Cost of Lost Disciplines Calculator</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Free research tool</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(34px,5.4vw,66px);line-height:1.02;letter-spacing:-0.02em;max-width:20ch;color:#FBF8F1;">What is a misaligned executive team costing you?</h1>
    <p style="margin-top:26px;font-size:clamp(18px,2.1vw,22px);line-height:1.52;max-width:60ch;color:rgba(244,240,231,0.82);">It rarely shows up on a P&amp;L line &mdash; which is exactly why most leaders never quantify it. You're about to. <strong style="color:#FBF8F1;">McKinsey finds managers spend ~37% of their time on decisions, and ~58% of that time runs ineffective.</strong> Put in your team's numbers for a grounded estimate &mdash; your own math, times <em>their</em> published figure.</p>
  </section>

  <CostCalculator />

  <!-- THE RESEARCH BEHIND IT -->
  <section style="background:#F4F0E7;color:#1B1810;padding:96px 32px;">
    <div style="max-width:1140px;margin:0 auto;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">The research behind the number</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,4vw,46px);line-height:1.05;letter-spacing:-0.015em;max-width:24ch;">We use their numbers, not ours. Here's why that matters.</h2>
      <p style="margin-top:22px;font-size:18px;line-height:1.62;color:#3A372F;max-width:62ch;">If we quoted our own statistics, you'd be right to discount them. So the calculator is built entirely on independent, published research. These are the studies underneath it:</p>

      <div class="bl-grid-collapse" style="margin-top:40px;display:grid;grid-template-columns:repeat(2,1fr);gap:18px;">
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:16px;padding:28px;">
          <p style="font-family:'Newsreader',serif;font-size:30px;color:#C04A26;line-height:1;">37% &middot; 58%</p>
          <p style="margin-top:12px;font-size:15.5px;line-height:1.55;color:#3A372F;">of a manager's time goes to decisions &mdash; and ~58% of that time runs ineffective. McKinsey illustrates the waste as ~530,000 days (~$250M) a year at a Fortune 500.</p>
          <p style="margin-top:12px;font-size:12.5px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#8A8578;"><a href="https://www.mckinsey.com/capabilities/people-and-organizational-performance/our-insights/decision-making-in-the-age-of-urgency" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-decoration-color:rgba(138,133,120,0.5);">McKinsey &middot; Decision making in the age of urgency &#8599;</a></p>
        </div>
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:16px;padding:28px;">
          <p style="font-family:'Newsreader',serif;font-size:30px;color:#C04A26;line-height:1;">58% &middot; 72%</p>
          <p style="margin-top:12px;font-size:15.5px;line-height:1.55;color:#3A372F;">Highly aligned companies grow revenue 58% faster and are 72% more profitable than misaligned peers &mdash; alignment is a P&amp;L lever, not a soft one.</p>
          <p style="margin-top:12px;font-size:12.5px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#8A8578;"><a href="https://lsaglobal.com/insights/proprietary-methodology/lsa-3x-organizational-alignment-model/" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-decoration-color:rgba(138,133,120,0.5);">LSA Global &middot; 3x Organizational Alignment Model &#8599;</a></p>
        </div>
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:16px;padding:28px;">
          <p style="font-family:'Newsreader',serif;font-size:30px;color:#C04A26;line-height:1;">48%</p>
          <p style="margin-top:12px;font-size:15.5px;line-height:1.55;color:#3A372F;">of organizations fail to achieve even half of their strategic objectives &mdash; the gap is execution, not the plan.</p>
          <p style="margin-top:12px;font-size:12.5px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#8A8578;"><a href="https://bridgesconsultancy.com/wp-content/uploads/2016/10/20-Years-of-Strategy-Implementation-Research-2.pdf" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-decoration-color:rgba(138,133,120,0.5);">Bridges Business Consultancy &middot; 2020 &#8599;</a></p>
        </div>
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:16px;padding:28px;">
          <p style="font-family:'Newsreader',serif;font-size:30px;color:#C04A26;line-height:1;">95%</p>
          <p style="margin-top:12px;font-size:15.5px;line-height:1.55;color:#3A372F;">of employees were unaware of or didn't understand their company's strategy &mdash; so effort scatters onto work that was never the priority.</p>
          <p style="margin-top:12px;font-size:12.5px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#8A8578;"><a href="https://hbr.org/2005/10/the-office-of-strategy-management" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-decoration-color:rgba(138,133,120,0.5);">Kaplan &amp; Norton &middot; HBR 2005 &#8599;</a></p>
        </div>
      </div>

      <p style="margin-top:26px;font-size:14px;line-height:1.6;color:#6B675E;max-width:80ch;">Method: the estimate is your own inputs &mdash; leadership headcount &times; decision-meeting hours &times; loaded rate &times; the share of that time that runs ineffective &times; 52 weeks. The default 58% share is McKinsey&rsquo;s published figure for how much decision-making time is typically ineffective; adjust it to your team. There is no revenue-percentage estimate and no recovery assumption &mdash; every figure is your arithmetic times one cited number, stated as a directional estimate, not a financial audit.</p>
    </div>
  </section>

  <!-- BRIDGE TO FLAG MODEL -->
  <section style="background:#15130E;color:#F4F0E7;padding:90px 32px;">
    <div style="max-width:900px;margin:0 auto;text-align:center;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.6vw,42px);line-height:1.08;letter-spacing:-0.015em;color:#FBF8F1;max-width:24ch;margin:0 auto;">A number tells you the cost. It doesn't tell you where it's leaking.</h2>
      <p style="margin-top:22px;font-size:18px;line-height:1.62;color:rgba(244,240,231,0.78);max-width:58ch;margin:22px auto 0;">That waste pools in one of four places first &mdash; the Decision, the Rhythm, the Standard, or the Learning. The <a href={SLUGS.flagModel} style="color:#E0744A;text-decoration:underline;">Flag Model</a> finds which one, and a <a href={CTA_URL} target="_blank" rel="noopener" style="color:#E0744A;text-decoration:underline;">Calibration Call</a> names it in 15 minutes.</p>
    </div>
  </section>

  <SiteFooter audience="teams" variant="slim" note="© 2026 Be Legendary · Estimates use third-party research; cited above." />
</BaseLayout>
