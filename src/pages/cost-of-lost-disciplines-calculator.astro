---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CostCalculator from '../components/CostCalculator.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = 'Cost of Lost Disciplines Calculator | Be Legendary';
const description = 'Cost of Lost Disciplines Calculator: estimate what decision chaos and misalignment cost your executive team each year, grounded in third-party research.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.belegendary.org/resources/' },
    { '@type': 'ListItem', position: 3, name: 'Cost of Lost Disciplines Calculator', item: 'https://www.belegendary.org/cost-of-lost-disciplines-calculator/' },
  ] },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'How much does a misaligned executive team cost?', acceptedAnswer: { '@type': 'Answer', text: 'Research suggests mid-market companies lose roughly 2.5% to 4% of annual revenue to decision chaos and misalignment combined. McKinsey finds managers spend about 37% of their time making decisions and more than half of that time is wasted; LSA Global finds highly aligned companies grow revenue 58% faster and are 72% more profitable than misaligned peers. For a $50M company, 2.5–4% is $1.25M to $2M a year.' } },
    { '@type': 'Question', name: 'What is the cost of poor decision-making in a company?', acceptedAnswer: { '@type': 'Answer', text: 'McKinsey estimates ineffective decision-making costs a typical Fortune 500 company around 530,000 days of lost management time a year — roughly $250M in labor. Scaled to a mid-market company, decision chaos alone tends to cost an estimated 1.5–2% of revenue.' } },
    { '@type': 'Question', name: 'How is the Cost of Lost Disciplines Calculator estimate produced?', acceptedAnswer: { '@type': 'Answer', text: 'It applies conservative, published research ranges to your own numbers. The revenue-based estimate uses 2.5–4% of revenue (the research range for combined decision chaos and misalignment). The meeting-waste figure is calculated directly from your leadership headcount, hours in meetings, loaded hourly cost, and the share of meeting time lost to re-litigation. We show the ranges and cite the sources rather than asserting false precision.' } },
  ] },
];
---
<BaseLayout title={title} description={description} path={SLUGS.costCalculator} ogTitle="The Cost of Lost Disciplines Calculator" ogDescription="Estimate what decision chaos and misalignment are costing your company — using conservative, third-party research ranges." schema={schema}>
  <SiteHeader audience="teams" logoHref="/" maxWidth={1140} links={[{ label: 'The Flag Model', href: SLUGS.flagModel }, { label: 'Field notes', href: SLUGS.fieldNotes }]} />

  <section style="position:relative;max-width:1140px;margin:0 auto;padding:80px 32px 40px;">
    <div style="position:absolute;top:-100px;right:-140px;width:520px;height:520px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:24px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.resources} style="color:inherit;text-decoration:none;">Resources</a><span>/</span><span style="color:#D98A5E;">Cost of Lost Disciplines Calculator</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Free research tool</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(34px,5.4vw,66px);line-height:1.02;letter-spacing:-0.02em;max-width:20ch;color:#FBF8F1;">What is a misaligned executive team costing you?</h1>
    <p style="margin-top:26px;font-size:clamp(18px,2.1vw,22px);line-height:1.52;max-width:60ch;color:rgba(244,240,231,0.82);">It rarely shows up on a P&amp;L line &mdash; which is exactly why most leaders never quantify it. You're about to. <strong style="color:#FBF8F1;">Published studies suggest mid-market companies lose 2.5&ndash;4% of revenue</strong> to decision chaos and misalignment alone. Put in your numbers for a grounded estimate &mdash; using <em>their</em> research, not ours.</p>
  </section>

  <CostCalculator />

  <!-- THE RESEARCH BEHIND IT -->
  <section style="background:#F4F0E7;color:#1B1810;padding:96px 32px;">
    <div style="max-width:1140px;margin:0 auto;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">The research behind the number</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,4vw,46px);line-height:1.05;letter-spacing:-0.015em;max-width:24ch;">We use their numbers, not ours. Here's why that matters.</h2>
      <p style="margin-top:22px;font-size:18px;line-height:1.62;color:#3A372F;max-width:62ch;">If we quoted our own statistics, you'd be right to discount them. So the calculator is built entirely on independent, published research. These are the studies underneath it:</p>

      <div class="bl-grid-collapse" style="margin-top:40px;display:grid;grid-template-columns:repeat(2,1fr);gap:18px;">
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:16px;padding:28px;">
          <p style="font-family:'Newsreader',serif;font-size:30px;color:#C04A26;line-height:1;">37%</p>
          <p style="margin-top:12px;font-size:15.5px;line-height:1.55;color:#3A372F;">of a manager's time goes to decision-making &mdash; and over half of it is wasted, costing a typical Fortune 500 ~530,000 days (~$250M) a year.</p>
          <p style="margin-top:12px;font-size:12.5px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#8A8578;"><a href="https://www.mckinsey.com/capabilities/people-and-organizational-performance/our-insights/decision-making-in-the-age-of-urgency" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-decoration-color:rgba(138,133,120,0.5);">McKinsey &middot; Decision making in the age of urgency &#8599;</a></p>
        </div>
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:16px;padding:28px;">
          <p style="font-family:'Newsreader',serif;font-size:30px;color:#C04A26;line-height:1;">58% &middot; 72%</p>
          <p style="margin-top:12px;font-size:15.5px;line-height:1.55;color:#3A372F;">Highly aligned companies grow revenue 58% faster and are 72% more profitable than misaligned peers &mdash; alignment is a P&amp;L lever, not a soft one.</p>
          <p style="margin-top:12px;font-size:12.5px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#8A8578;"><a href="https://lsaglobal.com/insights/proprietary-methodology/lsa-3x-organizational-alignment-model/" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-decoration-color:rgba(138,133,120,0.5);">LSA Global &middot; 3x Organizational Alignment Model &#8599;</a></p>
        </div>
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:16px;padding:28px;">
          <p style="font-family:'Newsreader',serif;font-size:30px;color:#C04A26;line-height:1;">67%</p>
          <p style="margin-top:12px;font-size:15.5px;line-height:1.55;color:#3A372F;">of well-formulated strategies fail in execution, not design &mdash; the gap is leadership focus, not the plan.</p>
          <p style="margin-top:12px;font-size:12.5px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#8A8578;"><a href="https://hbr.org/2017/11/executives-fail-to-execute-strategy-because-theyre-too-internally-focused" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-decoration-color:rgba(138,133,120,0.5);">Harvard Business Review &#8599;</a></p>
        </div>
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:16px;padding:28px;">
          <p style="font-family:'Newsreader',serif;font-size:30px;color:#C04A26;line-height:1;">95%</p>
          <p style="margin-top:12px;font-size:15.5px;line-height:1.55;color:#3A372F;">of employees don't understand their company's strategy &mdash; so effort scatters onto work that was never the priority.</p>
          <p style="margin-top:12px;font-size:12.5px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#8A8578;"><a href="https://fundingforgood.org/statistics-about-strategic-planning/" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-decoration-color:rgba(138,133,120,0.5);">Strategic-planning research compilation &#8599;</a></p>
        </div>
      </div>

      <p style="margin-top:26px;font-size:14px;line-height:1.6;color:#6B675E;max-width:80ch;">Method: the headline range applies the research figure of 2.5&ndash;4% of revenue (decision chaos ~1.5&ndash;2% per McKinsey scaling; misalignment ~1&ndash;2% per LSA Global) to your revenue. The meeting-waste figure is computed directly from your leadership headcount &times; meeting hours &times; loaded rate &times; wasted share &times; 52 weeks. Recovery assumes the research-supported 60&ndash;75% reversible over ~18 months. Figures are estimates, stated as ranges, and meant to inform a conversation &mdash; not to replace a financial audit.</p>
    </div>
  </section>

  <!-- BRIDGE TO FLAG MODEL -->
  <section style="background:#15130E;color:#F4F0E7;padding:90px 32px;">
    <div style="max-width:900px;margin:0 auto;text-align:center;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.6vw,42px);line-height:1.08;letter-spacing:-0.015em;color:#FBF8F1;max-width:24ch;margin:0 auto;">A number tells you the cost. It doesn't tell you where it's leaking.</h2>
      <p style="margin-top:22px;font-size:18px;line-height:1.62;color:rgba(244,240,231,0.78);max-width:58ch;margin:22px auto 0;">That waste pools in one of four places first &mdash; the Decision, the Rhythm, the Standard, or the Learning. The <a href={SLUGS.flagModel} style="color:#E0744A;text-decoration:underline;">Flag Model</a> finds which one, and a <a href={CTA_URL} target="_blank" rel="noopener" style="color:#E0744A;text-decoration:underline;">Calibration Call</a> names it in 15 minutes.</p>
    </div>
  </section>

  <SiteFooter audience="teams" variant="slim" note="© 2026 Be Legendary · Estimates use third-party research; cited above." />
</BaseLayout>
