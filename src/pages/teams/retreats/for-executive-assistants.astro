---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { SLUGS, CTA_URL } from '../../../lib/site';

const path = SLUGS.forExecutiveAssistants;
const title = "For Executive Assistants — Plan the Retreat | Be Legendary";
const description =
  "Planning your executive's leadership retreat? You bring the idea; we handle the venue, travel, experience and 30-day follow-up — white-glove, one contact.";

// JSON-LD — FAQPage (type preserved from the design).
const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How much work is this for me?', acceptedAnswer: { '@type': 'Answer', text: 'Very little. It starts with one conversation; from there we design it, handle every logistic, and bring you a plan to approve. You stay informed and in control without doing the legwork.' } },
      { '@type': 'Question', name: 'What do you handle versus what do I handle?', acceptedAnswer: { '@type': 'Answer', text: 'You tell us the team, the goal, the timing and budget, and any preferences. We handle everything else — venue, food, rooming, travel, agenda, facilitation, and the 30-day follow-up. You approve; we execute.' } },
      { '@type': 'Question', name: 'Can you work within our procurement and approval process?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — routinely. We provide the documentation your finance team needs and adapt to your preferred vendors and policies.' } },
      { '@type': 'Question', name: 'What does it cost?', acceptedAnswer: { '@type': 'Answer', text: 'A Focused retreat runs $25,000–$50,000; a Signature experiential retreat $35,000–$100,000; a fully bespoke retreat $75,000–$500,000+ — all turnkey, facilitation and 30-day reinforcement included.' } },
    ],
  },
];

const navLinks = [
  { label: 'Retreats', href: SLUGS.teamRetreats },
  { label: 'Case studies', href: SLUGS.caseStudies },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="website"
  ogTitle="For Executive Assistants — we'll make you look brilliant | Be Legendary"
  ogDescription={description}
  bodyBg="#EFE9DD"
  schema={schema}
>
  <SiteHeader audience="teams" variant="full" logoHref="/" links={navLinks} />

  <div style="background:#EFE9DD;color:#3A0A0C;font-family:'Hanken Grotesk',sans-serif;">

    <!-- ============ HERO ============ -->
    <section style="max-width:1000px;margin:0 auto;padding:64px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A6A64;margin-bottom:22px;display:flex;gap:8px;align-items:center;">
        <a href={SLUGS.teamRetreats} style="color:inherit;text-decoration:none;">Retreats</a><span>/</span><span style="color:#64010a;">For Executive Assistants</span>
      </nav>
      <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:20px;">For executive assistants &amp; chiefs of staff</p>
      <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(36px,5vw,60px);line-height:1.02;letter-spacing:-0.022em;color:#3A0A0C;max-width:20ch;">Planning your executive's retreat? We'll make you look brilliant.</h1>
      <p style="margin-top:24px;font-size:19px;line-height:1.6;color:#4A3A34;max-width:58ch;">You bring the idea. We handle everything else — the venue, the food, the travel, the experience, the follow-up — discreetly, flawlessly, with one point of contact. After 25 years and hundreds of luxury retreats, this is the part you don't have to worry about.</p>
      <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:30px;display:inline-flex;align-items:center;gap:9px;background:#C04A26;color:#fff;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;text-decoration:none;box-shadow:0 14px 34px -16px rgba(192,74,38,0.6);">Start with a 20-minute call <span>&rarr;</span></a>
    </section>

    <!-- ============ REFLECTS ON YOU ============ -->
    <section style="max-width:1000px;margin:72px auto 0;padding:0 32px;">
      <div style="background:#64010a;border-radius:20px;padding:48px 46px;">
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.2vw,36px);line-height:1.1;color:#FBF3E7;max-width:22ch;">Your principal remembers who pulled it off.</h2>
        <p style="margin-top:18px;font-size:17px;line-height:1.65;color:rgba(246,239,224,0.85);max-width:60ch;">A retreat that lands — the right place, flawless logistics, a team that comes back changed — reflects on the person who arranged it. That's you. Our entire job is to make the experience extraordinary and make you look like the person who knows exactly how to get the best. You'll never be surprised, never left chasing a detail, never wondering if it's handled. It's handled.</p>
      </div>
    </section>

    <!-- ============ HOW IT WORKS (4 steps) ============ -->
    <section style="max-width:1000px;margin:80px auto 0;padding:0 32px;">
      <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:28px;">How it works — four steps, most of them ours</p>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px;">
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;padding:30px 32px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;"><span style="font-family:'Newsreader',serif;font-size:16px;color:#F6EFE0;background:#64010a;width:32px;height:32px;border-radius:999px;display:flex;align-items:center;justify-content:center;">1</span><span style="font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#9A7A74;">You · 30 min</span></div>
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#3A0A0C;margin-bottom:8px;">Tell us the shape of it</h3>
          <p style="font-size:15px;line-height:1.6;color:#5A4A44;">The team, the goal, the rough timing and budget, and any preferences. Thirty minutes, no pressure.</p>
        </div>
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;padding:30px 32px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;"><span style="font-family:'Newsreader',serif;font-size:16px;color:#F6EFE0;background:#64010a;width:32px;height:32px;border-radius:999px;display:flex;align-items:center;justify-content:center;">2</span><span style="font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#9A7A74;">Us</span></div>
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#3A0A0C;margin-bottom:8px;">Three vetted venues</h3>
          <p style="font-size:15px;line-height:1.6;color:#5A4A44;">We come back with three venues that fit the outcome and budget. You and your principal simply choose the one that feels right.</p>
        </div>
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;padding:30px 32px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;"><span style="font-family:'Newsreader',serif;font-size:16px;color:#F6EFE0;background:#64010a;width:32px;height:32px;border-radius:999px;display:flex;align-items:center;justify-content:center;">3</span><span style="font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#9A7A74;">Us · You approve</span></div>
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#3A0A0C;margin-bottom:8px;">A complete proposal</h3>
          <p style="font-size:15px;line-height:1.6;color:#5A4A44;">Agenda, costs, every detail. Review it, share it with your principal, and say go.</p>
        </div>
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;padding:30px 32px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;"><span style="font-family:'Newsreader',serif;font-size:16px;color:#F6EFE0;background:#64010a;width:32px;height:32px;border-radius:999px;display:flex;align-items:center;justify-content:center;">4</span><span style="font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#9A7A74;">Us</span></div>
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#3A0A0C;margin-bottom:8px;">We run everything</h3>
          <p style="font-size:15px;line-height:1.6;color:#5A4A44;">Your team comes back changed — and you're the one who made it happen.</p>
        </div>
      </div>
      <p style="margin-top:22px;font-size:15px;line-height:1.6;color:#6B4A44;max-width:70ch;">And you stay as involved as you like — as hands-on or hands-off as you're comfortable with. Full visibility into progress at every step, and nothing moves without you knowing. On a bespoke retreat, you become our trusted insider — the one whose read on your principal makes every detail land exactly right.</p>
    </section>

    <!-- ============ WHAT WE HANDLE ============ -->
    <section style="max-width:1000px;margin:80px auto 0;padding:0 32px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,34px);line-height:1.1;color:#3A0A0C;max-width:24ch;margin-bottom:32px;">Everything that would normally land on your desk — on ours instead.</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(100,1,10,0.14);border:1px solid rgba(100,1,10,0.14);border-radius:16px;overflow:hidden;">
        <div style="background:#F6F1E7;padding:28px 26px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;color:#64010a;margin-bottom:8px;">Venues</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">Hand-curated four- and five-star lodges and estates we know are exceptional — and the relationships to secure them.</p></div>
        <div style="background:#F6F1E7;padding:28px 26px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;color:#64010a;margin-bottom:8px;">Food</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">Dining worth flying for, dietary needs handled quietly, every meal part of the experience.</p></div>
        <div style="background:#F6F1E7;padding:28px 26px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;color:#64010a;margin-bottom:8px;">Logistics</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">Transfers, rooming, schedules, contingencies — coordinated end to end so nothing falls through.</p></div>
        <div style="background:#F6F1E7;padding:28px 26px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;color:#64010a;margin-bottom:8px;">Facilitation</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">James Carter and team design and lead the experience around your executive's one outcome.</p></div>
        <div style="background:#F6F1E7;padding:28px 26px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;color:#64010a;margin-bottom:8px;">30-day follow-up</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">A month of reinforcement after, measured against a baseline — so the change actually sticks.</p></div>
        <div style="background:#F6F1E7;padding:28px 26px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;color:#64010a;margin-bottom:8px;">Procurement</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">We work within your travel, procurement, and approval processes and provide the documentation finance needs.</p></div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section style="max-width:840px;margin:80px auto 0;padding:0 32px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,34px);line-height:1.1;color:#3A0A0C;margin-bottom:8px;">After hundreds of luxury retreats, we know exactly what we're doing.</h2>
      <p style="font-size:16px;line-height:1.6;color:#5A4A44;margin-bottom:32px;max-width:60ch;">Twenty-five years, complete discretion, and a single point of contact who knows your account. We're used to working with executive assistants and chiefs of staff — and the sensitivity that comes with planning for a principal.</p>
      <div class="ea-faq" style="display:flex;flex-direction:column;">
        <div class="ea-faq-item" data-open="true" style="border-top:1px solid rgba(100,1,10,0.16);">
          <button class="ea-faq-btn" style="width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px;background:none;border:none;cursor:pointer;text-align:left;padding:24px 0;font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#3A0A0C;">
            <span>How much work is this for me?</span><span class="ea-faq-icon" style="flex:none;font-size:24px;font-weight:300;color:#C04A26;transition:transform .25s;transform:rotate(45deg);">+</span>
          </button>
          <div class="ea-faq-panel" style="overflow:hidden;transition:max-height .3s ease,opacity .25s;max-height:320px;opacity:1;"><p style="font-size:16px;line-height:1.65;color:#5A4A44;padding-bottom:24px;max-width:68ch;">Very little. It starts with one conversation; from there we design it, handle every logistic, and bring you a plan to approve. You stay informed and in control without doing the legwork.</p></div>
        </div>
        <div class="ea-faq-item" data-open="false" style="border-top:1px solid rgba(100,1,10,0.16);">
          <button class="ea-faq-btn" style="width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px;background:none;border:none;cursor:pointer;text-align:left;padding:24px 0;font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#3A0A0C;">
            <span>What do you handle versus what do I handle?</span><span class="ea-faq-icon" style="flex:none;font-size:24px;font-weight:300;color:#C04A26;transition:transform .25s;transform:rotate(0deg);">+</span>
          </button>
          <div class="ea-faq-panel" style="overflow:hidden;transition:max-height .3s ease,opacity .25s;max-height:0;opacity:0;"><p style="font-size:16px;line-height:1.65;color:#5A4A44;padding-bottom:24px;max-width:68ch;">You tell us the team, the goal, the timing and budget, and any preferences. We handle everything else — venue, food, rooming, travel, agenda, facilitation, and the 30-day follow-up. You approve; we execute.</p></div>
        </div>
        <div class="ea-faq-item" data-open="false" style="border-top:1px solid rgba(100,1,10,0.16);">
          <button class="ea-faq-btn" style="width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px;background:none;border:none;cursor:pointer;text-align:left;padding:24px 0;font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#3A0A0C;">
            <span>Can you work within our procurement and approval process?</span><span class="ea-faq-icon" style="flex:none;font-size:24px;font-weight:300;color:#C04A26;transition:transform .25s;transform:rotate(0deg);">+</span>
          </button>
          <div class="ea-faq-panel" style="overflow:hidden;transition:max-height .3s ease,opacity .25s;max-height:0;opacity:0;"><p style="font-size:16px;line-height:1.65;color:#5A4A44;padding-bottom:24px;max-width:68ch;">Yes — routinely. We provide the documentation your finance team needs and adapt to your preferred vendors and policies.</p></div>
        </div>
        <div class="ea-faq-item" data-open="false" style="border-top:1px solid rgba(100,1,10,0.16);">
          <button class="ea-faq-btn" style="width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px;background:none;border:none;cursor:pointer;text-align:left;padding:24px 0;font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#3A0A0C;">
            <span>Is it discreet?</span><span class="ea-faq-icon" style="flex:none;font-size:24px;font-weight:300;color:#C04A26;transition:transform .25s;transform:rotate(0deg);">+</span>
          </button>
          <div class="ea-faq-panel" style="overflow:hidden;transition:max-height .3s ease,opacity .25s;max-height:0;opacity:0;"><p style="font-size:16px;line-height:1.65;color:#5A4A44;padding-bottom:24px;max-width:68ch;">Completely discreet, with one point of contact start to finish — no handoffs, no call centers. You always know exactly who to reach, and they always know your account.</p></div>
        </div>
        <div class="ea-faq-item" data-open="false" style="border-top:1px solid rgba(100,1,10,0.16);">
          <button class="ea-faq-btn" style="width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px;background:none;border:none;cursor:pointer;text-align:left;padding:24px 0;font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#3A0A0C;">
            <span>What does it cost?</span><span class="ea-faq-icon" style="flex:none;font-size:24px;font-weight:300;color:#C04A26;transition:transform .25s;transform:rotate(0deg);">+</span>
          </button>
          <div class="ea-faq-panel" style="overflow:hidden;transition:max-height .3s ease,opacity .25s;max-height:0;opacity:0;"><p style="font-size:16px;line-height:1.65;color:#5A4A44;padding-bottom:24px;max-width:68ch;">A Focused retreat runs $25,000–$50,000; a Signature experiential retreat $35,000–$100,000; a fully bespoke retreat $75,000–$500,000+ — all turnkey, facilitation and 30-day reinforcement included. We scope it precisely on the first call.</p></div>
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section style="background:#64010a;color:#F6EFE0;margin-top:80px;">
      <div style="max-width:760px;margin:0 auto;padding:72px 32px;text-align:center;">
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,42px);line-height:1.08;letter-spacing:-0.02em;">Tell us what your executive needs.</h2>
        <p style="margin:18px auto 0;max-width:48ch;font-size:16.5px;line-height:1.6;color:#F0D9D2;">One short, no-pressure call. We'll tell you exactly how we'd make it happen — and make it easy for you from there.</p>
        <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:30px;display:inline-flex;background:#F6EFE0;color:#64010a;padding:16px 30px;border-radius:999px;font-weight:800;font-size:15.5px;text-decoration:none;">Book a Strategy Call &rarr;</a>
      </div>
    </section>

  </div>

  <SiteFooter audience="teams" variant="full" />
</BaseLayout>

<script>
  // FAQ accordion — single-open, mirrors the design's toggleFaq behavior.
  document.querySelectorAll('.ea-faq').forEach((wrap) => {
    const items = Array.from(wrap.querySelectorAll('.ea-faq-item'));
    const setState = (openIndex) => {
      items.forEach((item, i) => {
        const open = i === openIndex;
        item.setAttribute('data-open', String(open));
        const icon = item.querySelector('.ea-faq-icon');
        const panel = item.querySelector('.ea-faq-panel');
        if (icon) icon.style.transform = open ? 'rotate(45deg)' : 'rotate(0deg)';
        if (panel) {
          panel.style.maxHeight = open ? '320px' : '0';
          panel.style.opacity = open ? '1' : '0';
        }
      });
    };
    items.forEach((item, i) => {
      const btn = item.querySelector('.ea-faq-btn');
      btn?.addEventListener('click', () => {
        const isOpen = item.getAttribute('data-open') === 'true';
        setState(isOpen ? -1 : i);
      });
    });
  });
</script>
