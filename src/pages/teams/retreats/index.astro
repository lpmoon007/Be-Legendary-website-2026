---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { SLUGS, CTA_URL } from '../../../lib/site';

const path = SLUGS.teamRetreats;
const title = 'Team Retreats — Focused, Signature & Bespoke leadership retreats | Be Legendary';
const description =
  'Three ways to run a legendary retreat for your executive team: a content-led Focused retreat around one outcome, a Signature experiential retreat at a curated 4–5 star venue, or a fully bespoke retreat built around your team. Facilitated, outcome-driven, and reinforced for 30 days.';

// Ported from design; the reusable teams shell replaces the prototype header/footer.
const NAV_LINKS = [
  { label: 'Ways to Work Together', href: SLUGS.waysToWorkTogether },
  { label: 'Formats', href: SLUGS.retreatFormats },
  { label: 'Destinations', href: SLUGS.destinations },
  { label: 'Case studies', href: SLUGS.caseStudies },
];

// Signature format starting points (design's `formats` list).
const formats = [
  { name: 'Cabin Fever', desc: 'A remote lodge, close quarters, no escape hatch — forces a team to actually be together.', best: 'trust and candor', img: '/assets/lr-mining-lodge.webp', alt: 'A remote mining lodge in the mountains' },
  { name: 'Off-Road Immersion', desc: 'Real terrain, real adversity, shared. For teams that need to depend on each other under pressure.', best: 'interdependence', img: '/assets/dest-rubicon.webp', alt: 'A convoy of off-road vehicles on a mountain trail' },
  { name: 'Winter Survival', desc: 'Cold, stakes, interdependence — for breaking through stubborn divides and ego.', best: 'breaking divides', img: '/assets/cs-sanjuan.webp', alt: 'Snowy backcountry in the San Juan Mountains' },
  { name: 'Wilderness & Open Water', desc: 'River, alpine, or sailing — a crew with one heading, deep off-grid.', best: 'alignment & shared command', img: '/assets/cs-everglades.webp', alt: 'Kayaking through a wilderness waterway' },
  { name: 'Sailing Offsites', desc: 'A boat is your company compressed into a day. Powerful alone or inside a retreat.', best: 'command under pressure', img: '/assets/dest-sailing.webp', alt: 'A sailing yacht underway on open water' },
  { name: 'Five-Star Estate', desc: 'Space, beauty, room to think — remarkable food and the right table.', best: 'reflection & vision', img: '/assets/lr-lodge.webp', alt: 'A five-star mountain estate at golden hour' },
];

// Four-dimension dials (design's `dials` list).
const dials = [
  { name: 'Physical', lo: 'conference room', hi: '8,000m peak', pct: '45%' },
  { name: 'Emotional', lo: 'back-to-back slides', hi: 'life-changing day', pct: '60%' },
  { name: 'Mental', lo: 'passive', hi: 'total focus', pct: '55%' },
  { name: 'Spiritual', lo: 'surface', hi: 'who am I, really', pct: '50%' },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogTitle="Team Retreats — Focused, Signature & Bespoke | Be Legendary"
  ogDescription="You already know your team needs this. The only question is the right shape for it."
  bodyBg="#EFE9DD"
>
  <SiteHeader audience="teams" variant="full" logoHref="/" links={NAV_LINKS} />

  <div style="background:#EFE9DD;color:#3A0A0C;font-family:'Hanken Grotesk',sans-serif;">

    <!-- ============ HERO ============ -->
    <section style="max-width:1240px;margin:0 auto;padding:64px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A6A64;margin-bottom:22px;display:flex;gap:8px;align-items:center;">
        <a href="/" style="color:inherit;text-decoration:none;">For Teams</a><span>/</span><span style="color:#64010a;">Retreats</span>
      </nav>
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1.05fr 0.95fr;gap:48px;align-items:center;">
        <div>
          <p style="display:inline-flex;align-items:center;gap:9px;font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:22px;"><span style="width:7px;height:7px;border-radius:50%;background:#C04A26;"></span>Leadership retreats · CEOs &amp; their teams</p>
          <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(38px,5vw,64px);line-height:1.0;letter-spacing:-0.022em;color:#3A0A0C;max-width:15ch;">Three ways to run a <span style="font-style:italic;color:#C04A26;">legendary</span> retreat.</h1>
          <p style="margin-top:24px;font-size:18px;line-height:1.6;color:#4A3A34;max-width:46ch;">You already know your team needs this. The only question is the right shape for it. All three are fully facilitated, built around a real outcome, and reinforced for 30 days afterward — measurably.</p>
          <div style="margin-top:30px;display:flex;align-items:center;gap:18px;flex-wrap:wrap;">
            <a href={CTA_URL} target="_blank" rel="noopener" style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;box-shadow:0 14px 34px -16px rgba(192,74,38,0.6);">Book a Strategy Call <span>&rarr;</span></a>
            <a href="#tiers" style="color:#64010a;text-decoration:none;font-weight:700;font-size:15px;">See the three ways &darr;</a>
          </div>
        </div>
        <div style="position:relative;border-radius:16px;overflow:hidden;box-shadow:0 30px 60px -28px rgba(58,10,12,0.4);">
          <img src="/assets/lr-lodge.webp" alt="A five-star mountain lodge at dusk hosting an executive leadership retreat" width={1800} height={655} loading="lazy" style="width:100%;height:380px;object-fit:cover;display:block;">
          <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(58,10,12,0.55));"></div>
          <span style="position:absolute;bottom:16px;left:18px;font-size:12px;font-weight:600;letter-spacing:0.04em;color:#F6EFE0;">Signature · a hand-curated venue</span>
        </div>
      </div>
    </section>

    <!-- ============ THREE TIERS ============ -->
    <section id="tiers" style="max-width:1240px;margin:80px auto 0;padding:0 32px;">
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
        <!-- Focused -->
        <div style="background:#F6F1E7;color:#3A0A0C;border:1px solid rgba(100,1,10,0.14);border-radius:18px;padding:34px 30px;display:flex;flex-direction:column;">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#9A7A74;margin-bottom:14px;">Done anywhere</span>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;line-height:1.1;margin-bottom:6px;">Focused</h2>
          <p style="font-size:13.5px;font-weight:600;color:#C04A26;margin-bottom:14px;">One outcome, ready to run</p>
          <p style="font-size:15px;line-height:1.6;color:#5A4A44;margin-bottom:18px;">A content-led retreat around one of four focus areas — agenda ready to go, lightly tailored, at a luxury venue with remarkable food. The simplest, most accessible way in.</p>
          <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:22px;">
            <span style="font-size:14px;color:#4A3A34;display:flex;gap:9px;"><span style="color:#C04A26;">&#10003;</span> Curated 4–5 star venue &amp; food, anywhere</span>
            <span style="font-size:14px;color:#4A3A34;display:flex;gap:9px;"><span style="color:#C04A26;">&#10003;</span> Ready-built agenda, lightly tailored</span>
            <span style="font-size:14px;color:#4A3A34;display:flex;gap:9px;"><span style="color:#C04A26;">&#10003;</span> Lowest-lift, fastest way to a real retreat</span>
          </div>
          <div style="margin-top:auto;border-top:1px solid rgba(100,1,10,0.14);padding-top:16px;">
            <p style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#9A7A74;margin-bottom:4px;">Investment</p>
            <p style="font-family:'Newsreader',serif;font-size:24px;color:#3A0A0C;">$25,000–$50,000</p>
          </div>
        </div>
        <!-- Signature (featured, maroon) -->
        <div style="background:#64010a;color:#F6EFE0;border-radius:18px;padding:34px 30px;display:flex;flex-direction:column;box-shadow:0 30px 66px -26px rgba(58,10,12,0.55);position:relative;">
          <span style="position:absolute;top:-11px;left:30px;background:#C04A26;color:#fff;font-size:10.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:5px 12px;border-radius:999px;">Most chosen</span>
          <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#D99A88;margin-bottom:14px;">Ready to run</span>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;line-height:1.1;margin-bottom:6px;color:#FBF3E7;">Signature</h2>
          <p style="font-size:13.5px;font-weight:600;color:#E9A98F;margin-bottom:14px;">Experiential Leadership Retreats</p>
          <p style="font-size:15px;line-height:1.6;color:rgba(246,239,224,0.82);margin-bottom:18px;">Hand-curated four- and five-star venues, exceptional food, and a tested arc of activities — ready to go, with the content tailored to your outcome. A genuinely great retreat without the long design runway.</p>
          <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:22px;">
            <span style="font-size:14px;color:#F1E4D8;display:flex;gap:9px;"><span style="color:#E9A98F;">&#10003;</span> Curated 4–5 star lodges &amp; estates</span>
            <span style="font-size:14px;color:#F1E4D8;display:flex;gap:9px;"><span style="color:#E9A98F;">&#10003;</span> Faster to launch, lighter lift on your team</span>
            <span style="font-size:14px;color:#F1E4D8;display:flex;gap:9px;"><span style="color:#E9A98F;">&#10003;</span> A tailored content core — your real priorities</span>
          </div>
          <div style="margin-top:auto;border-top:1px solid rgba(246,239,224,0.2);padding-top:16px;">
            <p style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#D99A88;margin-bottom:4px;">Investment</p>
            <p style="font-family:'Newsreader',serif;font-size:24px;color:#FBF3E7;">$35,000–$100,000</p>
          </div>
        </div>
        <!-- Bespoke -->
        <div style="background:#F6F1E7;color:#3A0A0C;border:1px solid rgba(100,1,10,0.14);border-radius:18px;padding:34px 30px;display:flex;flex-direction:column;">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#9A7A74;margin-bottom:14px;">Built from scratch</span>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;line-height:1.1;margin-bottom:6px;">Bespoke</h2>
          <p style="font-size:13.5px;font-weight:600;color:#C04A26;margin-bottom:14px;">Designed around your team alone</p>
          <p style="font-size:15px;line-height:1.6;color:#5A4A44;margin-bottom:18px;">Everything — environment, activities, facilitation, the entire arc — engineered from nothing around your team and your one most-important outcome. This is what the case studies are made of.</p>
          <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:22px;">
            <span style="font-size:14px;color:#4A3A34;display:flex;gap:9px;"><span style="color:#C04A26;">&#10022;</span> Engineered to one measured outcome</span>
            <span style="font-size:14px;color:#4A3A34;display:flex;gap:9px;"><span style="color:#C04A26;">&#10022;</span> Pre-work sessions to scope before you travel</span>
            <span style="font-size:14px;color:#4A3A34;display:flex;gap:9px;"><span style="color:#C04A26;">&#10022;</span> For when the stakes are high and exact</span>
          </div>
          <div style="margin-top:auto;border-top:1px solid rgba(100,1,10,0.14);padding-top:16px;">
            <p style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#9A7A74;margin-bottom:4px;">Investment</p>
            <p style="font-family:'Newsreader',serif;font-size:24px;color:#3A0A0C;">$75,000–$500,000+</p>
          </div>
        </div>
      </div>
      <p style="text-align:center;margin-top:26px;font-size:15.5px;color:#6B4A44;">Not sure which fits? That's the first conversation — <a href={CTA_URL} target="_blank" rel="noopener" style="color:#C04A26;text-decoration:none;font-weight:600;">we'll tell you honestly</a>. Sometimes the right answer is the simpler one.</p>
    </section>

    <!-- ============ FOUR FOCUS AREAS ============ -->
    <section style="max-width:1240px;margin:72px auto 0;padding:0 32px;">
      <div style="background:#E7DECB;color:#3A0A0C;border-radius:20px;padding:44px 46px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Focused retreats · four focus areas</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,34px);line-height:1.12;max-width:24ch;margin-bottom:32px;">Each Focused retreat is built around one outcome, ready to run.</h2>
        <div class="bl-grid-collapse" style="display:grid;grid-template-columns:repeat(4,1fr);gap:18px;">
          <div style="border-top:2px solid #64010a;padding-top:16px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">01</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:19px;margin:6px 0 8px;">Relationship Building</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">Team connection, cross-silo trust, real camaraderie.</p></div>
          <div style="border-top:2px solid #64010a;padding-top:16px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">02</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:19px;margin:6px 0 8px;">Planning</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">Yearly tactical plan, strategic direction, vision alignment.</p></div>
          <div style="border-top:2px solid #64010a;padding-top:16px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">03</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:19px;margin:6px 0 8px;">Pain Points</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">The thorny issues — what to start, stop, and continue.</p></div>
          <div style="border-top:2px solid #64010a;padding-top:16px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">04</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:19px;margin:6px 0 8px;">Training &amp; Learning</h3><p style="font-size:14px;line-height:1.55;color:#5A4A44;">Skill development, new frameworks, capability building.</p></div>
        </div>
      </div>
    </section>

    <!-- ============ FORMATS ============ -->
    <section id="formats" style="max-width:1240px;margin:88px auto 0;padding:0 32px;">
      <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Signature formats</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.8vw,42px);line-height:1.08;color:#3A0A0C;max-width:22ch;">Ready-to-run starting points — each suited to a kind of outcome.</h2>
      <div class="bl-grid-collapse" style="margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px;">
        {formats.map((f) => (
          <a href={SLUGS.retreatFormats} style="display:flex;flex-direction:column;text-decoration:none;background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;overflow:hidden;transition:border-color .16s,box-shadow .16s;" onmouseover="this.style.borderColor='rgba(100,1,10,0.4)';this.style.boxShadow='0 16px 34px -20px rgba(58,10,12,0.4)'" onmouseout="this.style.borderColor='rgba(100,1,10,0.14)';this.style.boxShadow='none'">
            <img src={f.img} alt={f.alt} loading="lazy" style="height:120px;width:100%;object-fit:cover;display:block;" />
            <div style="padding:22px 24px 26px;">
              <h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:22px;color:#3A0A0C;margin-bottom:8px;">{f.name}</h3>
              <p style="font-size:14.5px;line-height:1.55;color:#5A4A44;margin-bottom:12px;">{f.desc}</p>
              <span style="font-size:12.5px;font-weight:600;color:#9A7A74;">Best for {f.best}</span>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top:24px;font-size:15px;color:#6B4A44;">Something else entirely — jungle, desert, horseback, alpine? If the outcome calls for it, we have a format for it, or we build one. <a href={CTA_URL} target="_blank" rel="noopener" style="color:#C04A26;text-decoration:none;font-weight:600;">Talk it through &rarr;</a></p>
    </section>

    <!-- ============ THE EXPERIENCE / FOUR-DIMENSION DIALS (maroon band) ============ -->
    <section id="dials" style="max-width:1240px;margin:88px auto 0;padding:0 32px;">
      <div class="bl-grid-collapse" style="background:#64010a;border-radius:20px;padding:48px 46px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;">
        <div>
          <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#E9A98F;margin-bottom:16px;">The experience · pick your level of Legendary</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,38px);line-height:1.1;color:#FBF3E7;margin-bottom:16px;">Every retreat lives somewhere on four dials.</h2>
          <p style="font-size:16.5px;line-height:1.65;color:rgba(246,239,224,0.82);">The further you push, the more a moment imprints — and the more deliberately it has to be designed. There are no wrong settings; there's only what your team needs. It's the same four-dimension read behind a leader's Shakubuku, tuned for a team.</p>
          <p style="margin-top:18px;font-size:14px;color:#D99A88;">Adventure when it serves the outcome. Comfort, beauty, and remarkable food when that does.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          {dials.map((d) => (
            <div>
              <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:8px;"><span style="font-weight:700;color:#FBF3E7;">{d.name}</span><span style="color:#D99A88;">{d.lo} → {d.hi}</span></div>
              <div style="position:relative;height:8px;background:rgba(246,239,224,0.16);border-radius:999px;">
                <div style={`position:absolute;left:0;top:0;bottom:0;width:${d.pct};background:#E9A98F;border-radius:999px;`}></div>
                <div style={`position:absolute;left:${d.pct};top:50%;transform:translate(-50%,-50%);width:18px;height:18px;border-radius:999px;background:#FBF3E7;border:3px solid #C04A26;`}></div>
              </div>
            </div>
          ))}
          <div style="margin-top:6px;background:rgba(246,239,224,0.1);border:1px solid rgba(246,239,224,0.2);border-radius:12px;padding:16px 18px;">
            <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#D99A88;margin-bottom:4px;">Example intensity · Elevated</p>
            <p style="font-size:14.5px;line-height:1.5;color:#F6EFE0;">Deep, honest work in a safe place — conversations that go where a conference room never lets them.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ HOW IT STARTS ============ -->
    <section style="max-width:1240px;margin:88px auto 0;padding:0 32px;">
      <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">How it starts</p>
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
        <div style="border-top:2px solid rgba(100,1,10,0.25);padding-top:20px;"><span style="font-family:'Newsreader',serif;font-size:22px;color:#C04A26;">01</span><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:23px;color:#3A0A0C;margin:8px 0 10px;">A conversation</h3><p style="font-size:15px;line-height:1.6;color:#5A4A44;">What should your people walk away feeling, thinking, saying — and the one outcome that matters most.</p></div>
        <div style="border-top:2px solid rgba(100,1,10,0.25);padding-top:20px;"><span style="font-family:'Newsreader',serif;font-size:22px;color:#C04A26;">02</span><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:23px;color:#3A0A0C;margin:8px 0 10px;">A recommendation</h3><p style="font-size:15px;line-height:1.6;color:#5A4A44;">We tell you honestly: Focused, Signature or Bespoke, which format, what it costs, and what it will and won't do.</p></div>
        <div style="border-top:2px solid rgba(100,1,10,0.25);padding-top:20px;"><span style="font-family:'Newsreader',serif;font-size:22px;color:#C04A26;">03</span><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:23px;color:#3A0A0C;margin:8px 0 10px;">We build &amp; deliver</h3><p style="font-size:15px;line-height:1.6;color:#5A4A44;">We handle everything through the retreat — and the 30-day reinforcement that makes it hold.</p></div>
      </div>
    </section>

    <!-- ============ CASE STUDIES TEASER ============ -->
    <section id="cases" style="max-width:1240px;margin:88px auto 0;padding:0 32px;">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:28px;">
        <div>
          <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Case studies</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,38px);line-height:1.1;color:#3A0A0C;">What bespoke looks like when the stakes are exact.</h2>
        </div>
        <a href={SLUGS.caseStudies} style="color:#C04A26;text-decoration:none;font-weight:700;font-size:15px;white-space:nowrap;">All case studies &rarr;</a>
      </div>
      <!-- named testimonial -->
      <figure style="margin:0 0 24px;background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-left:4px solid #64010a;border-radius:14px;padding:32px 38px;">
        <blockquote style="margin:0;font-family:'Newsreader',serif;font-style:italic;font-size:clamp(20px,2.4vw,27px);line-height:1.4;color:#3A0A0C;max-width:52ch;">“This truly resonated and will have a lasting influence on us as we work to create a technology organization where the best and brightest choose to be.”</blockquote>
        <figcaption style="margin-top:18px;display:flex;align-items:center;gap:12px;"><span style="width:30px;height:1px;background:#C8988E;"></span><span style="font-size:13px;font-weight:700;color:#64010a;">Larry Quinlan</span><span style="font-size:13px;color:#8A6A64;">Global CIO, Deloitte</span></figcaption>
      </figure>
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;">
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;overflow:hidden;">
