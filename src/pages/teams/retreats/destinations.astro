---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { SLUGS, CTA_URL } from '../../../lib/site';

const path = SLUGS.destinations;
const title = 'Leadership Retreat Destinations | Be Legendary';
const description =
  'Leadership retreat destinations we return to — from the San Juan Mountains to Moab to the Alaska backcountry. The destination always serves your outcome.';


const places = [
  { name: 'Moab, Utah', region: 'Utah', desc: 'Red-rock off-road country for the team that has to face real adversity together — and find out who it becomes under load.', img: '/assets/dest-moab.webp', alt: 'A vehicle threading a narrow red-rock slot canyon in the Moab, Utah backcountry.' },
  { name: 'Sierra Nevada', region: 'California', desc: 'One range, four seasons — winter-survival grit or five-star stillness, chosen for what the team needs to feel, not the view.', img: '/assets/dest-rubicon.webp', alt: 'A rig on the Rubicon Trail in the Sierra Nevada high country at dusk.' },
  { name: 'Great Basin Desert', region: 'Nevada', desc: 'Total signal blackout — for a team that has to strip everything away and rebuild how it depends on itself.', img: '/assets/offroad/las-vegas/lv-vista.webp', alt: 'A wide, empty desert vista in the Nevada Great Basin under an open sky.' },
  { name: 'Sedona, Arizona', region: 'Arizona', desc: 'For the reset: red-rock high desert that slows a frantic team down enough to think clearly again.', img: '/assets/dest-sedona.webp', alt: 'A vehicle on red slickrock with the Sedona, Arizona red-rock mesas behind it.' },
  { name: 'Napa Valley', region: 'California', desc: 'For board-level strategy and realignment — the comfort that lets a team stop bracing and actually think.', img: '/assets/dest-napa.webp', alt: 'A luxury wine-country resort ringed by vineyards and hills in Napa Valley at dusk.' },
  { name: 'Lake Tahoe', region: 'CA / NV', desc: 'For teams that need beauty and real challenge in the same day — granite and alpine water, an hour apart.', img: '/assets/dest-tahoe.webp', alt: 'A timber-frame alpine lodge glowing at dusk near Lake Tahoe.' },
  { name: 'Jackson Hole', region: 'Wyoming', desc: 'For high-stakes offsites where the setting has to match the moment — the Tetons, and rooms that hold hard conversations.', img: '/assets/dest-jackson.webp', alt: 'Two rocking chairs on a porch facing the snowcapped Teton peaks near Jackson Hole.' },
  { name: 'Montana', region: 'Montana', desc: 'For deep disconnection — remote rivers and ranches, far enough off the grid that a team can finally reconnect.', img: '/assets/dest-montana.webp', alt: 'A remote log-and-stone ranch lodge lit at dusk against Montana foothills, firepit glowing.' },
  { name: 'Death Valley', region: 'California', desc: 'Stark, elemental terrain that strips away the noise and forces a team back to what actually matters.', img: '/assets/dest-deathvalley.webp', alt: 'A rig crawling bare granite in the stark, elemental terrain around Death Valley.' },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogTitle="Destinations — where we run leadership retreats | Be Legendary"
  ogDescription="The destination always serves your outcome, never the reverse. A few places we keep coming back to."
  bodyBg="#EFE9DD"
>
  <SiteHeader audience="teams" variant="full" logoHref="/" />

  <div style="background:#EFE9DD;color:#3A0A0C;font-family:'Hanken Grotesk',sans-serif;">

    <!-- ============ HERO ============ -->
    <section style="max-width:1240px;margin:0 auto;padding:64px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A6A64;margin-bottom:22px;display:flex;gap:8px;align-items:center;">
        <a href={SLUGS.teamRetreats} style="color:inherit;text-decoration:none;">Retreats</a><span>/</span><span style="color:#64010a;">Destinations</span>
      </nav>
      <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">Destinations</p>
      <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(34px,4.6vw,58px);line-height:1.04;letter-spacing:-0.022em;color:#3A0A0C;max-width:20ch;">We could run a retreat almost anywhere. These are a few we love.</h1>
      <p style="margin-top:22px;font-size:19px;line-height:1.6;color:#4A3A34;max-width:62ch;">This isn't a catalog to pick from — the destination always serves your outcome, never the reverse. But people ask where we go, so here are a handful of places we keep coming back to, and why. Most of our work is across the United States, with select retreats in Central America and worldwide on request.</p>
      <p style="margin-top:14px;font-size:16px;line-height:1.55;color:#7A6A64;max-width:62ch;">Still shaping the whole thing? Start with <a href={SLUGS.howToPlanRetreat} style="color:#C04A26;text-decoration:underline;text-underline-offset:2px;">how to plan a leadership retreat that sticks</a>.</p>
    </section>

    <!-- ============ FEATURED (San Juans) ============ -->
    <section style="max-width:1240px;margin:48px auto 0;padding:0 32px;">
      <div class="bl-grid-collapse" style="background:#64010a;border-radius:20px;overflow:hidden;display:grid;grid-template-columns:1.1fr 0.9fr;">
        <div style="padding:48px 46px;display:flex;flex-direction:column;justify-content:center;">
          <span style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E9A98F;margin-bottom:14px;">Featured · Colorado</span>
          <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.2vw,38px);line-height:1.08;color:#FBF3E7;margin-bottom:14px;">The San Juan Mountains</h2>
          <p style="font-size:16.5px;line-height:1.65;color:rgba(246,239,224,0.85);">The most rugged, remote high country in the lower 48 — 14,000-foot peaks, old mining roads, and alpine wilderness that delivers in every season. Whatever your team needs — grit, exposure, awe, or total disconnection — this one range can give it. It's where we ran the winter-survival retreat that produced our largest measured change.</p>
          <a href={SLUGS.caseStudies} style="margin-top:22px;font-size:14.5px;font-weight:700;color:#F6EFE0;text-decoration:none;">See the San Juan case study &rarr;</a>
        </div>
        <img src="/assets/cs-sanjuan.webp" alt="The San Juan Mountains, Colorado backcountry" width={1050} height={1400} loading="lazy" style="width:100%;height:100%;min-height:300px;object-fit:cover;display:block;" />
      </div>
    </section>

    <!-- ============ GRID ============ -->
    <section style="max-width:1240px;margin:24px auto 0;padding:0 32px 40px;">
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;">
        {places.map((p) => (
          <a href={`${SLUGS.teamRetreats}#formats`} style="display:flex;flex-direction:column;text-decoration:none;background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;overflow:hidden;transition:box-shadow .16s;" onmouseover="this.style.boxShadow='0 16px 34px -22px rgba(58,10,12,0.4)'" onmouseout="this.style.boxShadow='none'">
            <img src={p.img} alt={p.alt} loading="lazy" style="height:130px;width:100%;object-fit:cover;display:block;" />
            <div style="padding:22px 24px;">
              <div style="display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:8px;"><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#3A0A0C;">{p.name}</h3><span style="font-size:11px;color:#9A7A74;">{p.region}</span></div>
              <p style="font-size:14px;line-height:1.55;color:#5A4A44;">{p.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ============ OFF-ROAD IMMERSION SPOTLIGHT ============ -->
    <section style="max-width:1240px;margin:34px auto 0;padding:0 32px;">
      <div style="background:#3A0A0C;color:#F6EFE0;border-radius:18px;padding:38px 44px;">
        <span style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;font-weight:700;">The Off-Road Immersion</span>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,30px);color:#F6EFE0;margin:8px 0 8px;max-width:24ch;">A single day where the terrain does the teaching.</h2>
        <p style="font-size:15.5px;line-height:1.6;color:#F0D9D2;max-width:66ch;margin-bottom:22px;">Two executives per Jeep, real off-road, and James turning what happens on the trail into the leadership conversation your team has been avoiding. We run it as a single day near major Western cities &mdash; fly in, drive out, back for dinner.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:22px;">
          {[['Las Vegas','las-vegas'],['Phoenix–Scottsdale','phoenix'],['Sedona','sedona'],['Denver–Boulder','denver'],['Los Angeles','los-angeles'],['Salt Lake City','salt-lake-city']].map(([label,id]) => (
            <a href={`${SLUGS.offRoadImmersion}#${id}`} style="font-size:13.5px;font-weight:600;color:#F6EFE0;background:rgba(246,239,224,0.08);border:1px solid rgba(246,239,224,0.2);border-radius:999px;padding:8px 15px;text-decoration:none;transition:background .16s;" onmouseover="this.style.background='rgba(246,239,224,0.16)'" onmouseout="this.style.background='rgba(246,239,224,0.08)'">{label}</a>
          ))}
        </div>
        <a href={SLUGS.offRoadImmersion} style="display:inline-flex;align-items:center;gap:9px;color:#E0744A;font-weight:800;font-size:15px;text-decoration:none;">Explore the Off-Road Immersion <span style="font-size:17px;">&rarr;</span></a>
      </div>
    </section>

    <!-- ============ WORLDWIDE ============ -->
    <section style="max-width:1240px;margin:24px auto 0;padding:0 32px;">
      <div style="background:#E7DECB;border-radius:18px;padding:38px 44px;display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap;">
        <div style="max-width:60ch;">
          <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:24px;color:#3A0A0C;margin-bottom:10px;">Somewhere farther afield?</h2>
          <p style="font-size:15.5px;line-height:1.6;color:#5A4A44;">Most of our work is across the United States, but the right outcome occasionally calls for somewhere else — from the deserts of the Middle East to remote corners of Central America. When it does, we build it. Tell us what you're after and we'll find the place that serves it.</p>
        </div>
        <a href={CTA_URL} target="_blank" rel="noopener" style="background:#C04A26;color:#fff;padding:15px 26px;border-radius:10px;font-weight:700;font-size:15px;text-decoration:none;white-space:nowrap;">Tell us the outcome &rarr;</a>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section style="background:#64010a;color:#F6EFE0;margin-top:72px;">
      <div style="max-width:760px;margin:0 auto;padding:72px 32px;text-align:center;">
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,42px);line-height:1.08;letter-spacing:-0.02em;">Not sure where? Start with the outcome.</h2>
        <p style="margin:18px auto 0;max-width:48ch;font-size:16.5px;line-height:1.6;color:#F0D9D2;">Tell us what you need your team to walk away with. We'll recommend the destination and format that gets them there.</p>
        <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:30px;display:inline-flex;background:#F6EFE0;color:#64010a;padding:16px 30px;border-radius:999px;font-weight:800;font-size:15.5px;text-decoration:none;">Book a Calibration Call &rarr;</a>
      </div>
    </section>

  </div>

  <SiteFooter audience="teams" variant="full" />
</BaseLayout>
