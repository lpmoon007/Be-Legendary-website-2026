---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { SLUGS, CTA_URL } from '../../../lib/site';

const path = SLUGS.waysToWorkTogether;
const title = 'Ways to Work Together — Focused, Signature & Bespoke';
const description =
  'Three ways to work together: a content-led Focused retreat, a Signature experiential retreat at a curated venue, or a fully bespoke retreat for your team.';

// JSON-LD — OfferCatalog of the three retreat tiers (types preserved from the design).
const schema = [
  {
    '@type': 'OfferCatalog',
    name: 'Be Legendary — Leadership Retreats',
    itemListElement: [
      { '@type': 'Offer', name: 'Focused Retreat', priceCurrency: 'USD', price: '25000', description: 'Content-led retreat around one focus area at a luxury venue.' },
      { '@type': 'Offer', name: 'Signature Retreat', priceCurrency: 'USD', price: '35000', description: 'Experiential leadership retreat at a curated 4-5 star venue with a tailored content core.' },
      { '@type': 'Offer', name: 'Bespoke Retreat', priceCurrency: 'USD', price: '75000', description: 'Fully bespoke retreat engineered around your team and one measured outcome.' },
    ],
  },
];

// Team-side full-shell links (mirror the design's nav).
const navLinks = [
  { label: 'Retreats', href: SLUGS.teamRetreats },
  { label: 'Case studies', href: SLUGS.caseStudies },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="website"
  ogTitle="Ways to Work Together — Focused, Signature & Bespoke | Be Legendary"
  ogDescription={description}
  bodyBg="#EFE9DD"
  schema={schema}
>
  <SiteHeader audience="teams" variant="full" logoHref="/" links={navLinks} />

  <div style="background:#EFE9DD;color:#3A0A0C;font-family:'Hanken Grotesk',sans-serif;">

    <!-- ============ HERO ============ -->
    <section style="max-width:1000px;margin:0 auto;padding:64px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A6A64;margin-bottom:22px;display:flex;gap:8px;align-items:center;">
        <a href={SLUGS.teamRetreats} style="color:inherit;text-decoration:none;">Retreats</a><span>/</span><span style="color:#64010a;">Ways to Work Together</span>
      </nav>
      <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">Ways to work together</p>
      <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(36px,5vw,60px);line-height:1.02;letter-spacing:-0.022em;color:#3A0A0C;max-width:16ch;">Three ways to run a legendary retreat.</h1>
      <p style="margin-top:22px;font-size:19px;line-height:1.6;color:#4A3A34;max-width:60ch;">You already know your team needs this. The only question is the right shape for it. All three are fully facilitated, built around a real outcome, and reinforced for 30 days afterward — measurably. What changes is how much is designed from scratch.</p>
    </section>

    <!-- ============ THREE TIERS DEEP ============ -->
    <section style="max-width:1000px;margin:52px auto 0;padding:0 32px;">
      <!-- Tier 1 · Focused (light) -->
      <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:20px;padding:38px 40px;margin-bottom:20px;">
        <div style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:36px;align-items:start;">
          <div>
            <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#9A7A74;">Done anywhere · one outcome, ready to run</span>
            <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:32px;line-height:1.05;margin:10px 0 6px;color:#3A0A0C;">Focused Retreats</h2>
            <p style="font-size:14.5px;font-weight:600;color:#C04A26;margin-bottom:16px;">The most accessible way in</p>
            <div style="border-top:1px solid rgba(100,1,10,0.14);padding-top:14px;">
              <p style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#C04A26;margin-bottom:4px;">Investment</p>
              <p style="font-family:'Newsreader',serif;font-size:26px;color:#3A0A0C;">$25,000–$50,000</p>
            </div>
          </div>
          <div>
            <p style="font-size:16.5px;line-height:1.7;color:#4A3A34;margin-bottom:20px;">A content-led retreat built around one of four focus areas, with an agenda ready to go and lightly tailored to your team. Hosted at a luxury venue with remarkable food, every detail handled — without the larger experiential immersion, which makes it the simplest, fastest way to a real retreat.</p>
            <div style="display:flex;flex-direction:column;gap:11px;">
              <span style="font-size:15px;color:#4A3A34;display:flex;gap:10px;align-items:flex-start;"><span style="color:#C04A26;flex:none;">✓</span> Curated 4–5 star venue &amp; remarkable food, anywhere</span>
              <span style="font-size:15px;color:#4A3A34;display:flex;gap:10px;align-items:flex-start;"><span style="color:#C04A26;flex:none;">✓</span> A ready-built agenda for one focus area, lightly tailored</span>
              <span style="font-size:15px;color:#4A3A34;display:flex;gap:10px;align-items:flex-start;"><span style="color:#C04A26;flex:none;">✓</span> The lowest-lift, fastest way to a real retreat</span>
            </div>
          </div>
        </div>
      </div>
      <!-- Tier 2 · Signature (dark) -->
      <div style="background:#64010a;border-radius:20px;padding:38px 40px;margin-bottom:20px;">
        <div style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:36px;align-items:start;">
          <div>
            <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E9A98F;">Most chosen · experiential leadership retreats</span>
            <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:32px;line-height:1.05;margin:10px 0 6px;color:#FBF3E7;">Signature Retreats</h2>
            <p style="font-size:14.5px;font-weight:600;color:#D99A88;margin-bottom:16px;">A tailored core, a tested arc</p>
            <div style="border-top:1px solid rgba(246,239,224,0.2);padding-top:14px;">
              <p style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#D99A88;margin-bottom:4px;">Investment</p>
              <p style="font-family:'Newsreader',serif;font-size:26px;color:#FBF3E7;">$35,000–$100,000</p>
            </div>
          </div>
          <div>
            <p style="font-size:16.5px;line-height:1.7;color:rgba(246,239,224,0.85);margin-bottom:20px;">Hand-curated four- and five-star venues, exceptional food, and a tested arc of activities — ready to go, with the content tailored to your outcome. The location and arc are proven; what we build around you is the content at the center — your real priorities, the specific conversations only your team needs to have.</p>
            <div style="display:flex;flex-direction:column;gap:11px;">
              <span style="font-size:15px;color:rgba(246,239,224,0.85);display:flex;gap:10px;align-items:flex-start;"><span style="color:#E9A98F;flex:none;">✓</span> Curated 4–5 star lodges &amp; estates, remarkable food</span>
              <span style="font-size:15px;color:rgba(246,239,224,0.85);display:flex;gap:10px;align-items:flex-start;"><span style="color:#E9A98F;flex:none;">✓</span> Faster to launch, lighter lift on your team</span>
              <span style="font-size:15px;color:rgba(246,239,224,0.85);display:flex;gap:10px;align-items:flex-start;"><span style="color:#E9A98F;flex:none;">✓</span> A tailored content core — your real priorities</span>
            </div>
          </div>
        </div>
      </div>
      <!-- Tier 3 · Bespoke (light) -->
      <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:20px;padding:38px 40px;margin-bottom:20px;">
        <div style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:36px;align-items:start;">
          <div>
            <span style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#9A7A74;">Built from scratch · designed around your team alone</span>
            <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:32px;line-height:1.05;margin:10px 0 6px;color:#3A0A0C;">Bespoke Retreats</h2>
            <p style="font-size:14.5px;font-weight:600;color:#C04A26;margin-bottom:16px;">This is what the case studies are made of</p>
            <div style="border-top:1px solid rgba(100,1,10,0.14);padding-top:14px;">
              <p style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#C04A26;margin-bottom:4px;">Investment</p>
              <p style="font-family:'Newsreader',serif;font-size:26px;color:#3A0A0C;">$75,000–$500,000+</p>
            </div>
          </div>
          <div>
            <p style="font-size:16.5px;line-height:1.7;color:#4A3A34;margin-bottom:20px;">Everything — environment, activities, facilitation, the entire arc — engineered from nothing around your team and your one most-important outcome. For when your stakes are high and exact, and the retreat has to be built around nothing but the result you need.</p>
            <div style="display:flex;flex-direction:column;gap:11px;">
              <span style="font-size:15px;color:#4A3A34;display:flex;gap:10px;align-items:flex-start;"><span style="color:#C04A26;flex:none;">✦</span> Engineered to one specific, measured outcome</span>
              <span style="font-size:15px;color:#4A3A34;display:flex;gap:10px;align-items:flex-start;"><span style="color:#C04A26;flex:none;">✦</span> Pre-work sessions to scope before you travel</span>
              <span style="font-size:15px;color:#4A3A34;display:flex;gap:10px;align-items:flex-start;"><span style="color:#C04A26;flex:none;">✦</span> For when the stakes are high and exact</span>
            </div>
          </div>
        </div>
      </div>
      <p style="text-align:center;margin-top:28px;font-size:16px;color:#6B4A44;">Not sure which fits? That's the first conversation. <a href={CTA_URL} target="_blank" rel="noopener" style="color:#C04A26;text-decoration:none;font-weight:600;">We'll tell you honestly</a> — sometimes the right answer is the simpler one.</p>
    </section>

    <!-- ============ FOUR FOCUS AREAS ============ -->
    <section style="max-width:1000px;margin:72px auto 0;padding:0 32px;">
      <div style="background:#E7DECB;border-radius:20px;padding:44px 46px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Focused retreats · four focus areas</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(23px,2.8vw,32px);line-height:1.12;max-width:26ch;margin-bottom:28px;">Each Focused retreat is built around one of these, with a ready agenda we tailor lightly.</h2>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:18px;">
          <div style="border-top:2px solid #64010a;padding-top:16px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">01</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;margin:6px 0 8px;">Relationship Building</h3><p style="font-size:13.5px;line-height:1.55;color:#5A4A44;">Team connection, cross-silo trust, real camaraderie.</p></div>
          <div style="border-top:2px solid #64010a;padding-top:16px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">02</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;margin:6px 0 8px;">Planning</h3><p style="font-size:13.5px;line-height:1.55;color:#5A4A44;">Yearly tactical plan, strategic direction, vision alignment.</p></div>
          <div style="border-top:2px solid #64010a;padding-top:16px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">03</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;margin:6px 0 8px;">Pain Points</h3><p style="font-size:13.5px;line-height:1.55;color:#5A4A44;">The thorny issues — what to start, stop, and continue.</p></div>
          <div style="border-top:2px solid #64010a;padding-top:16px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">04</span><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:18px;margin:6px 0 8px;">Training &amp; Learning</h3><p style="font-size:13.5px;line-height:1.55;color:#5A4A44;">Skill development, new frameworks, capability building.</p></div>
        </div>
      </div>
    </section>

    <!-- ============ GIVE-BACK NOTE ============ -->
    <section style="max-width:1000px;margin:40px auto 0;padding:0 32px;">
      <div style="border:1px solid rgba(100,1,10,0.2);border-radius:16px;padding:30px 34px;display:flex;gap:18px;align-items:center;flex-wrap:wrap;">
        <span style="font-family:'Newsreader',serif;font-style:italic;font-size:19px;line-height:1.4;color:#64010a;flex:1;min-width:280px;">Whichever you choose, your retreat sends a young person, 12–15, into a leadership workshop of their own — the same decision that changes your team gives one of them a first shot at leading.</span>
      </div>
    </section>

    <!-- ============ HOW IT STARTS ============ -->
    <section style="max-width:1000px;margin:64px auto 0;padding:0 32px;">
      <p style="font-size:12.5px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:24px;">How it starts</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
        <div style="border-top:2px solid rgba(100,1,10,0.25);padding-top:18px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">01</span><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:21px;color:#3A0A0C;margin:6px 0 8px;">A conversation</h3><p style="font-size:14.5px;line-height:1.6;color:#5A4A44;">Two questions: what should your people walk away feeling — and the one outcome that matters most.</p></div>
        <div style="border-top:2px solid rgba(100,1,10,0.25);padding-top:18px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">02</span><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:21px;color:#3A0A0C;margin:6px 0 8px;">A recommendation</h3><p style="font-size:14.5px;line-height:1.6;color:#5A4A44;">We tell you honestly: which tier, which format, what it costs, and what it will and won't do.</p></div>
        <div style="border-top:2px solid rgba(100,1,10,0.25);padding-top:18px;"><span style="font-family:'Newsreader',serif;font-size:20px;color:#C04A26;">03</span><h3 style="font-family:'Newsreader',serif;font-weight:400;font-size:21px;color:#3A0A0C;margin:6px 0 8px;">We build &amp; deliver</h3><p style="font-size:14.5px;line-height:1.6;color:#5A4A44;">We handle everything through the retreat — and the 30-day reinforcement that makes it hold.</p></div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section style="background:#64010a;color:#F6EFE0;margin-top:72px;">
      <div style="max-width:760px;margin:0 auto;padding:72px 32px;text-align:center;">
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,42px);line-height:1.08;letter-spacing:-0.02em;">Start with the outcome. We'll find the way.</h2>
        <p style="margin:18px auto 0;max-width:48ch;font-size:16.5px;line-height:1.6;color:#F0D9D2;">Fifteen minutes with James will tell you more than any brochure. No obligation.</p>
        <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:30px;display:inline-flex;background:#F6EFE0;color:#64010a;padding:16px 30px;border-radius:999px;font-weight:800;font-size:15.5px;text-decoration:none;">Book a Calibration Call &rarr;</a>
      </div>
    </section>

  </div>

  <SiteFooter audience="teams" variant="full" />
</BaseLayout>
