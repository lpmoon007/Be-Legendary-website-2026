---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, CTA_URL } from '../../../lib/site';
import imgCommandCenter from '../../../assets/executive-immersion/the-city/command-center.png';
import imgCityWakes from '../../../assets/executive-immersion/the-city/city-before-it-wakes.png';
import imgFoodRescue from '../../../assets/executive-immersion/the-city/human-network-food-rescue.png';
import imgLunch from '../../../assets/executive-immersion/the-city/impossible-lunch.png';
import imgTheater from '../../../assets/executive-immersion/the-city/public-reckoning.png';
import imgRooftop from '../../../assets/executive-immersion/the-city/rooftop.png';

// Timeline beats that carry a photo. Keyed to the label so the map stays legible.
// (The command-center shot anchors the hero, so it is not repeated here.)
const beatImage = {
  'The City Before It Wakes': { src: imgCityWakes, alt: 'Executives moving through a market district at dawn on foot, bikes and a city bus, the skyline behind them.' },
  'The Human Network': { src: imgFoodRescue, alt: 'Executives working with a hi-vis logistics worker over a city map at a food-rescue warehouse.' },
  'The Impossible Lunch': { src: imgLunch, alt: 'A long dining table set above the river skyline, with one empty chair set for an unexplained guest.' },
  'The Public Reckoning': { src: imgTheater, alt: 'An ornate theater with a full audience, an orchestra, and the day’s footage and data projected on a huge screen.' },
  'The Rooftop': { src: imgRooftop, alt: 'A rooftop dinner at sunset with the city skyline and a helicopter on the pad, one chair at the table left empty.' },
};

const path = SLUGS.eiCityNeverSleeps;
const title = 'One Crazy Day: The City Never Sleeps | Be Legendary';
const description =
  'A single engineered day where your executive team takes responsibility for a whole city — a citywide race, immersive theater, and a live model of your own organization.';

// Anonymized format example. No client names, quotes, or outcomes — this is a
// design of the experience itself, one of three Executive Immersion archetypes.
const schema = [
  { '@type': 'CreativeWork',
    name: 'One Crazy Day: The City Never Sleeps',
    description:
      'A single engineered day in which an executive team is given twelve hours to prevent a cascading failure across a major city — a citywide race, immersive theater, community contribution, live behavioral scoring, and luxury adventure that is revealed to be a working model of their own organization.',
    creator: { '@id': PERSON_ID },
    provider: { '@id': ORG_ID },
    about: ['Executive team development', 'Immersive leadership simulation', 'Decision-making under pressure', 'Organizational systems thinking'] },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'For Teams', item: `${SITE_URL}${SLUGS.teams}` },
    { '@type': 'ListItem', position: 3, name: 'Executive Immersion', item: `${SITE_URL}${SLUGS.executiveImmersion}` },
    { '@type': 'ListItem', position: 4, name: 'The City Never Sleeps', item: `${SITE_URL}${path}` },
  ] },
];

// The twelve hours, in order. Kept as data so the timeline stays easy to reorder.
const timeline = [
  { time: '4:00 a.m.', label: 'The Signal', body: 'Every executive wakes in the same hotel. At exactly four, the room television turns itself on: a countdown reading 12:00:00 and a recorded voice — "By sunset, one of the systems this city depends on will fail. You have twelve hours to prevent it." Outside each door: a black case with a city credential, a sealed transit card, a radio earpiece, one unexplained object, and a handwritten location. Each person reports alone, to a different corner of the hotel, and is collected one or two at a time into waiting black vehicles.' },
  { time: '4:30 a.m.', label: 'The Command Center', body: 'A converted hangar, soundstage, or museum hall — transformed into a credible municipal emergency-operations center. A twenty-foot digital city map, live feeds, status boards for energy, water, transit, food, shelter and medical, and workstations staffed by trained role-players following a script, not improvising chaos. The incident commander delivers the first briefing. A locked case can only be opened with the objects from everyone’s rooms combined. The first lesson lands immediately: no individual holds enough information.' },
  { time: '5:15 a.m.', label: 'The City Before It Wakes', body: 'Three teams, three transportation restrictions — public transit only, foot and bicycle, a limited-stop shuttle — dispatched to the hidden parts of a working city: a rail depot, a wholesale food market before opening, an emergency-management site. Each meets real professionals prepared in advance — a transit mechanic, a night-shift nurse, a shelter director. Every task (allocate scarce food, route supplies around a closure, decide which neighborhoods get service first) needs information another team is holding across the city.' },
  { time: '6:45 a.m.', label: 'The Moving Briefing', body: 'The group boards a chartered vintage railcar, ferry, or motor coach converted into a mobile briefing room — maps, screens, breakfast, an operations chief. As the city wakes outside the windows, the first major decision: a simulated power shortage forces them to protect only three of eight districts. The consequences appear live — people affected, financial cost, second-order effects. There is no perfect answer. The value is in how they frame it, who is heard, and which consequences they are willing to externalize.' },
  { time: '7:30 a.m.', label: 'The Human Network', body: 'A list of field experts scattered across the city, each holding a piece needed later — a building engineer, a paramedic, a public defender, a food-rescue coordinator, a student who helped build the day’s scoring system. All are participating through formal partnerships. To earn each piece of information, the executives must reach the location and do something genuinely useful: redesign a delivery route, record a ninety-second public message that neither conceals risk nor causes panic, shadow the invisible work that keeps a tower running.' },
  { time: '9:15 a.m.', label: 'The Exchange', body: 'A historic bank hall or trading floor, run live by professional auctioneers. Teams arrive holding different assets — money, information, time, access, decision rights. Up for trade: a helicopter transfer, a full city map, a thirty-minute extension, immunity from one consequence. Each team gets a black card with a known balance and a red card that appears unlimited. The only warning: "Every use of the red card transfers cost somewhere else." They are not told where. Hours later, every charge returns as a consequence.' },
  { time: '10:15 a.m.', label: 'The Vertical Mile', body: 'A tower or stadium under full private access. The apparent challenge is reaching the top by the approved stairs. Halfway up, a fork: one route continues toward the visible finish, the other leads to a community-service operation — assembling emergency kits, preparing meals for hospital families, building housing-transition kits. The scoring rewards climbing. Those who race ahead reach a dramatic rooftop first — and find they cannot leave until the work below is finished. The visible finish depends on the invisible work.' },
  { time: '11:30 a.m.', label: 'The Impossible Lunch', body: 'Transferred by helicopter, seaplane, or private railcar to a place that feels severed from the city — a rooftop garden, a decommissioned pier, an airport hangar. A Michelin-level chef has laid a table set for one more person than the number of participants. The empty chair is unexplained. Portions are deliberately scarce, and each seat holds an allocation choice: eat now, pool ingredients, bank for later, or give a share to the unknown guest. Then the guest arrives — a frontline employee, a customer, a stakeholder the leadership routinely affects but rarely includes in the room.' },
  { time: '12:45 p.m.', label: 'The Cascade', body: 'Split again and moved by three different modes, each team is handed authority over exactly one resource — and none has enough to act alone. Then the earlier decisions come back. The district they deprioritized can no longer support the next checkpoint. The time extension they bought delayed someone else. The red-card spending has created a deficit that must be settled. The group that raced ahead has to return and finish what it left. The uncertainty is real for the participants; every branch is controlled by production.' },
  { time: '2:00 p.m.', label: 'The Public Reckoning', body: 'The teams arrive at what they believe is another checkpoint — a theater. The curtain opens on an audience of employees, customers, community partners, family members, board members. The executives have ninety minutes and a full production team to build a live presentation answering four questions: what did we decide, who carried the consequences, what did it reveal about how we lead, and what must change. They cannot fall back on a polished corporate deck — the audience can see the behavioral data. Accountability without humiliation; patterns, not character.' },
  { time: '4:00 p.m.', label: 'The City Comes Back Online', body: 'One by one the city systems return to green and the countdown stops. The incident commander says the line the whole day was built toward: "The city was never the real system being tested." The map redraws itself as the client organization. Transportation becomes handoffs. Power becomes capital and capacity. Water becomes information flow. Emergency services become escalation and decision rights. Neighborhoods become business units, customers, employees. Every hour of the day was a working model of how they actually run.' },
  { time: '4:30 p.m.', label: 'The Final Decision', body: 'Two routes remain. Celebration — a rooftop, a helicopter arrival, a world-class dinner, the film of the day. Or Responsibility — a series of real, prearranged business conversations the organization surfaced in advance: a customer escalation, a stalled decision, a failed handoff, a commitment nobody owns. Choosing Responsibility does not cancel the celebration. It delays it. The message is exact: celebration follows responsibility. It does not replace it.' },
  { time: '6:30 p.m.', label: 'The Rooftop', body: 'The group arrives at an extraordinary final venue. Dinner is exceptional; the room is quiet enough to talk. The behavioral data is not a scorecard — the group examines which decisions created value, which transferred cost, where authority ran ahead of information, whose work stayed invisible. The eleventh chair is still at the table. It stands for the stakeholder who is usually absent when executive decisions are made. Each person answers one question before the day ends: who must be present in our thinking, even when they are not in the room?' },
];

const combination = [
  'Citywide race', 'Executive simulation', 'Immersive theater', 'Community contribution',
  'Behavioral assessment', 'Luxury adventure', 'Live media production', 'Real organizational intervention',
  'Public accountability', 'World-class hospitality', 'Operational problem-solving', 'Leadership development',
];

const guardrails = [
  'No rewards for speed, and no unsafe exertion',
  'No false medical, security, or criminal emergencies',
  'No uncontrolled contact with vulnerable people',
  'No deliberate dehydration or unsafe food restriction',
  'No illegal access and no unscheduled aviation',
  'No public embarrassment; scoring is never an employment evaluation',
  'No community partner used merely as an emotional reveal',
  'Production knows every route, location, and decision branch in advance',
];
---
<BaseLayout title={title} description={description} path={path} ogType="article" ogTitle="One Crazy Day: The City Never Sleeps" ogDescription={description} schema={schema} bodyBg="#0E0D0B">
  <SiteHeader audience="teams" variant="full" logoHref="/" />

  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <div style="font-family:'Hanken Grotesk',sans-serif;-webkit-font-smoothing:antialiased;background:#EFE9DD;color:#1C1A17;line-height:1.55;">

    <!-- HERO — 4 a.m., the countdown, cinematic dark; command-center establishing shot behind a scrim -->
    <section style="position:relative;overflow:hidden;background:#0E0D0B;color:#EFE9DD;">
      <Image src={imgCommandCenter} alt="Executives standing before a twenty-foot digital city map and a lit physical model inside a converted command center." width={1672} height={941} format="webp" quality={80} loading="eager" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(14,13,11,0.95) 0%,rgba(14,13,11,0.86) 44%,rgba(14,13,11,0.5) 100%);"></div>
      <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(14,13,11,0.85) 0%,transparent 42%);"></div>
      <div style="position:relative;max-width:900px;margin:0 auto;padding:64px 40px 56px;">
        <a href={SLUGS.executiveImmersion} style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#8C8375;text-decoration:none;">&larr; Executive Immersion</a>
        <div style="display:flex;align-items:center;gap:12px;margin:24px 0 22px;flex-wrap:wrap;">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#0E0D0B;background:#E0B973;padding:4px 9px;border-radius:4px;">One Crazy Day</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#8C8375;">The City Never Sleeps &middot; in development</span>
        </div>
        <p style="font-family:'IBM Plex Mono',monospace;font-size:clamp(24px,4.4vw,44px);letter-spacing:0.08em;color:#E0B973;margin-bottom:20px;">12:00:00 <span style="font-size:0.5em;letter-spacing:0.16em;color:#8C8375;">REMAINING</span></p>
        <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(34px,5vw,60px);line-height:1.03;letter-spacing:-0.02em;color:#FBF9F4;">The city is counting on you.</h1>
        <p style="margin-top:26px;font-size:21px;line-height:1.6;color:#CFC7B8;font-weight:500;max-width:60ch;">For one engineered day, your executive team is given twelve hours to prevent a cascading failure across a major city. They move through its hidden systems, meet the people who keep it running, and spend everything they have to hold it together &mdash; before discovering the city was built as a live model of their own organization.</p>
        <p style="margin-top:18px;font-size:15.5px;line-height:1.6;color:#8C8375;max-width:60ch;">Every element below is real and separately possible. No one who lives it will believe they all happened in a single day.</p>
      </div>
    </section>

    <!-- THE PREMISE + the impossible combination -->
    <section style="max-width:900px;margin:0 auto;padding:60px 40px 20px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);letter-spacing:-0.01em;max-width:22ch;">One continuous mission &mdash; not a day of activities.</h2>
      <p style="margin-top:18px;font-size:18px;line-height:1.75;color:#403B33;max-width:64ch;">The point of the day is the integration. Any one piece &mdash; a citywide race, an immersive-theater production, a community build, a behavioral read on the team &mdash; is achievable on its own. The impossibility comes from stitching all of them into one uninterrupted twelve hours, where every decision quietly moves something else. The participants keep asking how it was pulled off. The honest answer is always the same: through preparation, access, partnerships, production, and control &mdash; never through deception that creates real danger.</p>
      <div style="margin-top:30px;display:flex;flex-wrap:wrap;gap:9px;">
        {combination.map((c) => (
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.04em;color:#403B33;background:#F4EFE5;border:1px solid #E5DCCB;padding:7px 12px;border-radius:999px;">{c}</span>
        ))}
      </div>
    </section>

    <!-- THE TWELVE HOURS — vertical timeline -->
    <section style="max-width:900px;margin:0 auto;padding:44px 40px 20px;">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#64010a;margin-bottom:8px;">4 a.m. to sunset</div>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,44px);letter-spacing:-0.015em;">The twelve hours.</h2>

      <div style="margin-top:40px;position:relative;">
        <div style="position:absolute;left:9px;top:6px;bottom:6px;width:2px;background:linear-gradient(#E0B973,#E5DCCB);"></div>
        {timeline.map((t) => (
          <div style="position:relative;padding:0 0 40px 44px;">
            <div style="position:absolute;left:0;top:5px;width:20px;height:20px;border-radius:50%;background:#EFE9DD;border:2px solid #64010a;"></div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.08em;color:#64010a;">{t.time}</div>
            <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:24px;line-height:1.14;margin-top:6px;">{t.label}</h3>
            <p style="margin-top:12px;font-size:17px;line-height:1.72;color:#403B33;">{t.body}</p>
            {beatImage[t.label] && (
              <figure style="margin:18px 0 0;">
                <Image src={beatImage[t.label].src} alt={beatImage[t.label].alt} width={1672} height={941} format="webp" quality={80} loading="lazy" style="width:100%;height:auto;border-radius:14px;border:1px solid #E5DCCB;display:block;" />
              </figure>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- THE REVEAL — dark, the turn -->
    <section style="background:#15130E;color:#EFE9DD;margin-top:24px;">
      <div style="max-width:820px;margin:0 auto;padding:76px 40px;">
        <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#E0B973;margin-bottom:18px;">The reveal</div>
        <p style="font-family:'Newsreader',serif;font-style:italic;font-size:clamp(24px,3.4vw,36px);line-height:1.32;color:#FBF9F4;">&ldquo;The city was never the real system being tested.&rdquo;</p>
        <p style="margin-top:26px;font-size:18px;line-height:1.75;color:#CFC7B8;">The map redraws itself as the client organization. Transportation becomes handoffs. Power becomes capital and capacity. Water becomes information flow. Emergency services become escalation and decision rights. Neighborhoods become business units, geographies, customers, employees. The behavioral data from the day is overlaid on real organizational information gathered in advance &mdash; and the team sees that every hour was a working model of how they run.</p>
      </div>
    </section>

    <!-- THE FINAL DECISION -->
    <section style="max-width:900px;margin:0 auto;padding:64px 40px 24px;">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#64010a;margin-bottom:8px;">4:30 p.m.</div>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);letter-spacing:-0.01em;max-width:24ch;">Celebration follows responsibility. It does not replace it.</h2>
      <div class="bl-ocd-two" style="margin-top:30px;display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div style="background:#F4EFE5;border:1px solid #E5DCCB;border-radius:14px;padding:28px 30px;">
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8A8270;margin-bottom:10px;">Route one &middot; Celebration</div>
          <p style="font-size:16.5px;line-height:1.65;color:#403B33;">A rooftop, a helicopter arrival, a world-class dinner, the film of the day, awards. Everything the day has earned &mdash; available the moment it is chosen.</p>
        </div>
        <div style="background:#1C1A17;color:#EFE9DD;border-radius:14px;padding:28px 30px;">
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#E0B973;margin-bottom:10px;">Route two &middot; Responsibility</div>
          <p style="font-size:16.5px;line-height:1.65;color:#CFC7B8;">Real, prearranged conversations the organization surfaced in advance &mdash; a customer escalation, a stalled decision, a failed handoff, a commitment nobody owns. Listen, clarify, commit. Then the celebration follows.</p>
        </div>
      </div>
    </section>

    <!-- CREDIBILITY + GUARDRAILS -->
    <section style="background:#F4EFE5;border-top:1px solid #E5DCCB;border-bottom:1px solid #E5DCCB;margin-top:32px;">
      <div style="max-width:900px;margin:0 auto;padding:60px 40px;">
        <div class="bl-ocd-two" style="display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:start;">
          <div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#64010a;margin-bottom:12px;">Why it holds together</div>
            <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:28px;line-height:1.1;letter-spacing:-0.01em;">Extreme, without unmanaged risk.</h2>
            <p style="margin-top:16px;font-size:16.5px;line-height:1.7;color:#403B33;">The visible extravagance &mdash; the command center, the charters, the production &mdash; is not the hard part. The hard part is making a day feel spontaneous while every major variable is controlled. Participants experience genuine uncertainty. The operators never do.</p>
          </div>
          <div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#8A8270;margin-bottom:14px;">Operational guardrails</div>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:11px;">
              {guardrails.map((g) => (
                <li style="position:relative;padding-left:24px;font-size:15.5px;line-height:1.55;color:#403B33;">
                  <span style="position:absolute;left:0;top:1px;color:#64010a;font-weight:700;">&#10003;</span>{g}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <p style="margin-top:34px;font-size:14px;line-height:1.6;color:#8A8270;font-style:italic;max-width:70ch;">An anonymized example of the Executive Immersion format. It describes the experience itself; every engagement is engineered backward from a specific client organization and its real, agreed-upon issues.</p>
      </div>
    </section>

    <!-- EARNED MOTIF — the phrase participants land on, kept as a quote not a name -->
    <section style="background:#EFE9DD;">
      <div style="max-width:760px;margin:0 auto;padding:56px 40px 8px;text-align:center;">
        <p style="font-size:16px;line-height:1.6;color:#6B6358;">We call it Executive Immersion. By sunset, no one who has lived it reaches for that word.</p>
        <p style="margin-top:14px;font-family:'Newsreader',serif;font-style:italic;font-size:clamp(22px,3vw,32px);line-height:1.3;color:#1C1A17;">&ldquo;Man &mdash; that was one crazy day.&rdquo;</p>
      </div>
    </section>

    <!-- CTA -->
    <section style="position:relative;overflow:hidden;background:#64010a;color:#F6EFE0;">
      <div style="position:relative;max-width:760px;margin:0 auto;padding:72px 40px;text-align:center;">
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(28px,3.8vw,42px);line-height:1.08;letter-spacing:-0.02em;">What would your team learn about how they lead &mdash; in one impossible day?</h2>
        <p style="margin:18px auto 0;max-width:52ch;font-size:16.5px;line-height:1.6;color:#F0D9D2;">Every Executive Immersion is built backward from your organization. We start with a calibration call to find the one outcome worth engineering the day around.</p>
        <div style="margin-top:30px;display:flex;align-items:center;gap:14px;justify-content:center;flex-wrap:wrap;">
          <a href={CTA_URL} target="_blank" rel="noopener" style="background:#F6EFE0;color:#64010a;padding:16px 30px;border-radius:999px;font-weight:800;font-size:15.5px;text-decoration:none;">Book a Calibration Call &rarr;</a>
          <a href={SLUGS.executiveImmersion} style="padding:16px 26px;border-radius:999px;font-weight:700;font-size:15.5px;color:#F6EFE0;border:1px solid rgba(246,239,224,0.4);text-decoration:none;">All Executive Immersion formats &rarr;</a>
        </div>
      </div>
    </section>

  </div>

  <style>
    @media (max-width: 720px) {
      .bl-ocd-two { grid-template-columns: 1fr !important; }
    }
  </style>

  <SiteFooter audience="teams" variant="full" />
</BaseLayout>
