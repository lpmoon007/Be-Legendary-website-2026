---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PhotoSlot from '../../../components/ei/PhotoSlot.astro';
import { SITE_URL, ORG_ID, SLUGS, CTA_URL } from '../../../lib/site';
import imgEvergladesAirboats from '../../../assets/executive-immersion/everglades/everglades-airboats.png';
import imgEvergladesNav from '../../../assets/executive-immersion/everglades/everglades-navigation.png';
import imgReachFrontDoor from '../../../assets/executive-immersion/hub/reach-front-door.png';
import imgReachCharter from '../../../assets/executive-immersion/hub/reach-worth-a-charter.png';

const path = SLUGS.executiveImmersion;
const title = 'Executive Immersion — One Crazy Day, Built Where Your Team Already Is | Be Legendary';
const description = 'Executive Immersion: a single engineered day built from whatever is within reach of your executive team. Two formats — expedition and city. Run 250+ times as One Crazy Day.';

// Set once; drives the investment figure. Ported from the handoff `minimumFee` prop.
const minimumFee = '$35,000';

// FAQ — the buyer's own questions, answered plainly enough to forward. The
// first four came with the handoff; the last six were answered by James.
const faqs = [
  { q: 'What if weather or a cancelled flight kills the plan?', a: 'Every design ships with a named alternate for each segment that depends on weather, aircraft or water, and a decision time by which we switch. It has happened. It has never cost a day. Teams routinely rate the improvised version as the best part — which is, after all, the point of the exercise.' },
  { q: 'Can the CEO be a participant instead of the host?', a: "Yes — and they should be. James runs the day so the CEO doesn't have to. A CEO who is facilitating cannot be surprised, cannot struggle in front of the group, and cannot be seen needing help. Handing the day over is the most valuable thing they do all year." },
  { q: 'How does this connect to our actual business goals?', a: "The day is designed backwards from one business outcome you name in the first call — a strategy that has stalled, a merger of two cultures, a leadership group that won't disagree in public. Every segment earns its place against that outcome, and the closing hour converts the day into specific commitments with names on them." },
  { q: 'And what stops it evaporating by Friday?', a: "Each person leaves having committed, out loud and in front of the others, to one behaviour they will change. Thirty days later we measure that one behaviour — not satisfaction with the day. It's the difference between an experience and a change." },
  { q: 'How much lead time do you need?', a: 'It depends entirely on the complexity of the day and what the executive wants from it — that part is one hundred per cent client-dependent. A straightforward day can come together in a couple of weeks; a more elaborate one can take a few months. We tell you which it is on the first call.' },
  { q: 'How big can the group be?', a: "Up to twenty executives. The more people involved, the more complex the design and the longer the lead time — and beyond twenty the day stops doing what it does best and becomes more about bonding. That's fine if bonding is the outcome you want, and we'll tell you honestly when that's the case." },
  { q: 'What about physical ability and accessibility?', a: 'Tell us the limitations within the group and we design around them. Any limitation can be accommodated — every day is built so that no one is excluded or exposed.' },
  { q: 'Are we covered — insurance and liability?', a: 'Yes. We are fully covered and insured, and your risk team can have the details they need.' },
  { q: "Can you run this for a team that isn't English-speaking?", a: 'Yes. We have master facilitators fluent in Spanish, French and Arabic — fully fluent in our process, not translators brought in on the side.' },
  { q: 'How does pricing and the proposal work?', a: 'We start with interviews with the top executive, then deliver a proposal with three options, each with a price attached. The proposal itself is $5,000 — and that fee is fully credited toward whichever of the three experiences you choose. If you decide not to move forward, the proposal is yours to keep: take everything in it to another company, or run it yourself.' },
];

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Be Legendary', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'For Teams', item: `${SITE_URL}${SLUGS.teams}` },
    { '@type': 'ListItem', position: 3, name: 'Executive Immersion', item: `${SITE_URL}${path}` },
  ] },
  { '@type': 'Service', name: 'Executive Immersion', serviceType: 'Executive team offsite experience design and facilitation',
    provider: { '@id': ORG_ID }, areaServed: 'Worldwide',
    description: "A single engineered day for executive teams, designed around whatever is within reach of the team's own location. Flagship format: One Crazy Day." },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })) },
];
---
<BaseLayout title={title} description={description} path={path} ogType="website" ogTitle={title} ogDescription={description} schema={schema} bodyBg="#EFE9DD">
  <SiteHeader audience="teams" variant="full" logoHref="/" />

  <div style="background:#EFE9DD;color:#3A0A0C;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <!-- HERO -->
    <section style="max-width:1180px;margin:0 auto;padding:56px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A6A64;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href={SLUGS.teams} style="color:inherit;text-decoration:none;">For Teams</a><span>/</span><span style="color:#64010a;">Executive Immersion</span>
      </nav>
      <div class="ei-hero" style="display:grid;grid-template-columns:1.05fr 0.95fr;gap:48px;align-items:end;">
        <div>
          <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">Executive Immersion &nbsp;&middot;&nbsp; flagship format: One Crazy Day</p>
          <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(36px,5vw,62px);line-height:1.0;letter-spacing:-0.025em;color:#3A0A0C;max-width:22ch;">We don't fly your team to the experience. We build the experience where your team already is.</h1>
          <p style="margin-top:22px;font-size:19px;line-height:1.6;color:#4A3A34;max-width:52ch;">One day. Engineered end to end. Assembled from whatever is genuinely within reach of your executive team — their own front door, an hour's drive, or a short charter if that's the day they want. Two formats: the expedition and the city.</p>
          <div style="margin-top:30px;display:flex;gap:14px;flex-wrap:wrap;align-items:center;">
            <a href={CTA_URL} style="background:#64010a;color:#F6EFE0;text-decoration:none;padding:15px 26px;border-radius:10px;font-weight:700;font-size:15.5px;">Book a 30-minute design call</a>
            <a href="#how" style="color:#64010a;text-decoration:none;font-weight:600;font-size:15.5px;border-bottom:1px solid rgba(100,1,10,0.3);padding-bottom:2px;">See how a day gets built</a>
          </div>
        </div>
        <div style="border-radius:16px;overflow:hidden;box-shadow:0 26px 58px -30px rgba(58,10,12,0.5);">
          <PhotoSlot title="Hero image" note="An exec team mid-day, visibly working at something hard. Landscape, min 2000px wide." height={420} img="/assets/offroad/colorado/co-offroad-hero.webp" alt="An executive team and their vehicle paused on a high mountain trail above a vast valley." />
        </div>
      </div>
    </section>

    <!-- 250+ DAYS -->
    <section style="max-width:1180px;margin:52px auto 0;padding:0 32px;">
      <div class="ei-band" style="background:#64010a;border-radius:18px;padding:38px 44px;display:grid;grid-template-columns:auto 1fr;gap:44px;align-items:center;">
        <div style="flex:none;">
          <p style="font-family:'Newsreader',serif;font-size:64px;line-height:1;color:#F6EFE0;">250<span style="font-size:34px;">+</span></p>
          <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:rgba(246,239,224,0.62);margin-top:8px;">days run</p>
        </div>
        <p style="font-size:19px;line-height:1.62;color:#F0E4DA;max-width:64ch;">For years we called it <em style="font-style:italic;">One Crazy Day</em>, and we've run it more than 250 times — on coastlines, in deserts, out of city hotels, off the back of a chartered flight. Executive Immersion is the name for the whole category of work. One Crazy Day is still the format at the center of it.</p>
      </div>
    </section>

    <!-- CONFERENCE ROOM -->
    <section style="max-width:1180px;margin:80px auto 0;padding:0 32px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(30px,3.6vw,44px);line-height:1.08;letter-spacing:-0.02em;color:#3A0A0C;max-width:26ch;">A conference room can't produce the thing you're hoping for.</h2>
      <div class="ei-two" style="display:grid;grid-template-columns:1fr 1fr;gap:44px;margin-top:26px;">
        <p style="font-size:17.5px;line-height:1.68;color:#4A3A34;">Your executives are exceptionally good at the room. They know how to sound aligned, hold a position, and manage the impression they leave. Put the same nine people somewhere the script doesn't exist — where the plan changes, the weather turns, someone has to decide fast with incomplete information — and you find out who they actually are to each other.</p>
        <p style="font-size:17.5px;line-height:1.68;color:#4A3A34;">That is the whole mechanism. Not adventure for its own sake. A day built to simulate what executive life actually feels like, compressed into hours, in a place where none of them are the expert. What comes back to the office isn't a memory of a fun day. It's a group that has seen each other under load and can't un-see it.</p>
      </div>
    </section>

    <!-- THE GAME -->
    <section style="max-width:1180px;margin:66px auto 0;padding:0 32px;">
      <div class="ei-two" style="display:grid;grid-template-columns:0.8fr 1.2fr;gap:48px;align-items:start;border-top:1px solid rgba(100,1,10,0.16);padding-top:34px;">
        <p style="font-family:'Newsreader',serif;font-size:clamp(22px,2.6vw,30px);line-height:1.16;color:#3A0A0C;">Clients have been comparing this to <em style="font-style:italic;">The Game</em> for twenty years.</p>
        <div>
          <p style="font-size:17px;line-height:1.66;color:#4A3A34;margin-bottom:14px;">The 1997 film, where Michael Douglas's character is dropped into an elaborate constructed experience and can no longer tell what is staged and what is real — all of it engineered to make him value the relationships in his life. Executives who remember it tend to describe the day in exactly those terms, and it is a fair description of the ambition: an environment built around one person or one group, designed to change something they could not be talked into.</p>
          <p style="font-size:17px;line-height:1.66;color:#4A3A34;">Where the comparison stops: in the film nobody consents, nobody is safe, and the protagonist is deceived to the point of real harm. Your team knows they are in something designed. They know we built it. Nobody is endangered, humiliated, or lied to about anything that matters. The surprise is in the sequence, never in whether the day is under control.</p>
        </div>
      </div>
    </section>

    <!-- HOW A DAY GETS BUILT -->
    <section id="how" style="max-width:1180px;margin:84px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">How a day gets built</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.4vw,40px);line-height:1.1;color:#3A0A0C;max-width:30ch;margin-bottom:36px;">Four steps. You are never improvising, and neither are we.</h2>
      <div class="ei-grid4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:rgba(100,1,10,0.14);border-radius:14px;overflow:hidden;">
        <div style="background:#F6F1E7;padding:30px 26px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:14px;">01</p><h3 style="font-size:18px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">The outcome, first</h3><p style="font-size:15px;line-height:1.6;color:#4A3A34;">A 30-minute call with James and whoever owns the business problem. What has to be different on the Monday after. Not the activities — the outcome. Everything else is downstream of this answer.</p></div>
        <div style="background:#F6F1E7;padding:30px 26px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:14px;">02</p><h3 style="font-size:18px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">Reconnaissance</h3><p style="font-size:15px;line-height:1.6;color:#4A3A34;">We inventory what's actually reachable from where the team will be. Terrain, water, air, altitude, kitchens, workshops, people worth meeting. Most locations have far more in them than anyone local realizes.</p></div>
        <div style="background:#F6F1E7;padding:30px 26px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:14px;">03</p><h3 style="font-size:18px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">The design</h3><p style="font-size:15px;line-height:1.6;color:#4A3A34;">You get a run-of-show with real clock times, a named lead for every segment, transport, contingencies, and a cost that doesn't move. You approve a day, not a concept.</p></div>
        <div style="background:#F6F1E7;padding:30px 26px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:14px;">04</p><h3 style="font-size:18px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">The day, then the return</h3><p style="font-size:15px;line-height:1.6;color:#4A3A34;">We run it. James facilitates the meaning-making as it happens, not in a debrief bolted on at the end — and each person leaves with one behaviour they've committed to in front of the others.</p></div>
      </div>
      <div style="margin-top:22px;border-left:3px solid #C04A26;padding:4px 0 4px 22px;">
        <p style="font-size:16.5px;line-height:1.62;color:#4A3A34;max-width:76ch;"><strong style="font-weight:700;color:#3A0A0C;">If you're the one who has to book this:</strong> you will have a document to forward. Times, vendors, insurance, costs, and the sentence that explains to your CFO what the company is buying. Nobody has to trust a vibe.</p>
      </div>
    </section>

    <!-- THREE DEGREES OF REACH -->
    <section style="max-width:1180px;margin:88px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">Anywhere in the world</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.4vw,40px);line-height:1.1;color:#3A0A0C;max-width:30ch;margin-bottom:12px;">Three degrees of reach. You choose how far the day goes.</h2>
      <p style="font-size:17.5px;line-height:1.65;color:#4A3A34;max-width:64ch;margin-bottom:34px;">Some teams will charter a jet for a 45-minute flight because the day on the other end is worth it. Others want to walk out the front door of their own building. Both produce legendary days. The difference is budget and appetite, and both are entirely yours to set.</p>
      <div class="ei-grid3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;">
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;">
          <Image src={imgReachFrontDoor} alt="Executives walking a downtown sidewalk with a folded map, a black van alongside them." width={1672} height={941} format="webp" quality={80} loading="lazy" style="width:100%;height:170px;object-fit:cover;display:block;" />
          <div style="padding:26px 28px;"><p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A6A64;margin-bottom:10px;">Reach one</p><h3 style="font-family:'Newsreader',serif;font-size:26px;font-weight:400;color:#3A0A0C;margin-bottom:12px;">Out the front door</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">Everything happens on foot, by van, or on the water within the city the team is already in. No flights, no overnight, no travel approvals. The surprise is that it was all there the whole time.</p></div>
        </div>
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;">
          <PhotoSlot title="Within a drive" note="Terrain 90 minutes from a major city." height={170} img="/assets/offroad/colorado/co-front-range.webp" alt="A vehicle on a narrow shelf road high in the Colorado front range." />
          <div style="padding:26px 28px;"><p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A6A64;margin-bottom:10px;">Reach two</p><h3 style="font-family:'Newsreader',serif;font-size:26px;font-weight:400;color:#3A0A0C;margin-bottom:12px;">Within a drive</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">Ninety minutes buys a completely different landscape — coast, canyon, altitude, wilderness. The team leaves at dawn and is genuinely somewhere else by mid-morning. This is where most days land.</p></div>
        </div>
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;">
          <Image src={imgReachCharter} alt="Executives with duffel bags boarding a light helicopter on a desert airstrip at golden hour, mountains behind." width={1672} height={941} format="webp" quality={80} loading="lazy" style="width:100%;height:170px;object-fit:cover;display:block;" />
          <div style="padding:26px 28px;"><p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A6A64;margin-bottom:10px;">Reach three</p><h3 style="font-family:'Newsreader',serif;font-size:26px;font-weight:400;color:#3A0A0C;margin-bottom:12px;">Worth a charter</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">A 45-to-90-minute charter or helicopter opens terrain that exists nowhere near a major city. Expensive, and for the right team on the right year, the single best money they spend.</p></div>
        </div>
      </div>
    </section>

    <!-- THE PLATFORM — three formats -->
    <section style="max-width:1180px;margin:88px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">The One Crazy Day platform</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.4vw,40px);line-height:1.1;color:#3A0A0C;max-width:30ch;margin-bottom:12px;">Three expressions of the same design system.</h2>
      <p style="font-size:17.5px;line-height:1.65;color:#4A3A34;max-width:64ch;margin-bottom:34px;">They are not separate products. Each begins with a business outcome and then uses an extraordinary day to make the relevant leadership behaviour visible. Which one you want depends entirely on what is currently broken.</p>
      <div class="ei-grid3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;">
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.16);border-radius:16px;padding:34px 36px;">
          <p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A6A64;margin-bottom:10px;">Format one</p>
          <h3 style="font-family:'Newsreader',serif;font-size:29px;font-weight:400;color:#3A0A0C;margin-bottom:12px;">One Crazy Day: Expedition</h3>
          <p style="font-size:16px;line-height:1.62;color:#4A3A34;margin-bottom:16px;">Uncertainty, judgement, adaptability and execution under real pressure. For an established team that needs to see how it operates when the plan stops working.</p>
          <a href={SLUGS.eiExpedition} style="font-size:15px;font-weight:600;color:#64010a;text-decoration:none;border-bottom:1px solid rgba(100,1,10,0.3);padding-bottom:2px;">Read a full expedition day</a>
        </div>
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.16);border-radius:16px;padding:34px 36px;">
          <p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A6A64;margin-bottom:10px;">Format two</p>
          <h3 style="font-family:'Newsreader',serif;font-size:29px;font-weight:400;color:#3A0A0C;margin-bottom:12px;">One Crazy Day: City</h3>
          <p style="font-size:16px;line-height:1.62;color:#4A3A34;margin-bottom:16px;">Connection, values, culture and human impact. For a group that has to trust each other quickly, before difficult work begins — and for values that exist as language but not yet as behaviour.</p>
          <a href={SLUGS.eiCity} style="font-size:15px;font-weight:600;color:#64010a;text-decoration:none;border-bottom:1px solid rgba(100,1,10,0.3);padding-bottom:2px;">Read a full city day</a>
        </div>
        <div style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.16);border-radius:16px;padding:34px 36px;">
          <p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8A6A64;margin-bottom:10px;">Format three</p>
          <h3 style="font-family:'Newsreader',serif;font-size:29px;font-weight:400;color:#3A0A0C;margin-bottom:12px;">One Crazy Day: Ownership</h3>
          <p style="font-size:16px;line-height:1.62;color:#4A3A34;margin-bottom:16px;">Handoffs, ownership, initiative and purpose. For an organisation where every department reports progress, every person does their job, and the customer still does not get what was promised.</p>
          <a href={SLUGS.eiOwnership} style="font-size:15px;font-weight:600;color:#64010a;text-decoration:none;border-bottom:1px solid rgba(100,1,10,0.3);padding-bottom:2px;">Read a full ownership day</a>
        </div>
      </div>
      <div style="margin-top:26px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
        <p style="font-size:14px;font-weight:600;color:#7A5A54;margin-right:6px;">In development:</p>
        <span style="font-size:13.5px;color:#64010a;background:rgba(100,1,10,0.07);border:1px solid rgba(100,1,10,0.16);border-radius:999px;padding:6px 14px;">Innovation</span>
        <span style="font-size:13.5px;color:#64010a;background:rgba(100,1,10,0.07);border:1px solid rgba(100,1,10,0.16);border-radius:999px;padding:6px 14px;">Crisis</span>
        <span style="font-size:13.5px;color:#64010a;background:rgba(100,1,10,0.07);border:1px solid rgba(100,1,10,0.16);border-radius:999px;padding:6px 14px;">Customer</span>
        <span style="font-size:13.5px;color:#64010a;background:rgba(100,1,10,0.07);border:1px solid rgba(100,1,10,0.16);border-radius:999px;padding:6px 14px;">Legacy</span>
        <span style="font-size:13.5px;color:#64010a;background:rgba(100,1,10,0.07);border:1px solid rgba(100,1,10,0.16);border-radius:999px;padding:6px 14px;">Reinvention</span>
        <span style="font-size:13.5px;color:#64010a;background:rgba(100,1,10,0.07);border:1px solid rgba(100,1,10,0.16);border-radius:999px;padding:6px 14px;">The Merger</span>
        <a href={SLUGS.eiCityNeverSleeps} style="font-size:13.5px;color:#64010a;background:rgba(100,1,10,0.07);border:1px solid rgba(100,1,10,0.16);border-radius:999px;padding:6px 14px;text-decoration:none;">The City Never Sleeps &rarr;</a>
      </div>
      <div style="margin-top:30px;border-left:3px solid #C04A26;padding:6px 0 6px 24px;">
        <p style="font-family:'Newsreader',serif;font-size:clamp(21px,2.4vw,28px);line-height:1.32;color:#3A0A0C;max-width:50ch;">The product is not the activity. The product is accelerated truth.</p>
      </div>
    </section>

    <!-- EVERGLADES EXAMPLE -->
    <section style="background:#F6F1E7;margin-top:76px;padding:76px 0;border-top:1px solid rgba(100,1,10,0.14);border-bottom:1px solid rgba(100,1,10,0.14);">
      <div style="max-width:1180px;margin:0 auto;padding:0 32px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">A short example &nbsp;&middot;&nbsp; the Everglades, four hours</p>
        <div class="ei-two" style="display:grid;grid-template-columns:1.05fr 0.95fr;gap:48px;align-items:start;">
          <div>
            <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.4vw,42px);line-height:1.08;color:#3A0A0C;max-width:26ch;">They fought each other over a pile of garbage. Nobody had asked whether they were supposed to.</h2>
            <p style="margin-top:20px;font-size:17.5px;line-height:1.66;color:#4A3A34;">The team was in Miami. The company was in a hiring freeze and a pay freeze, and the executives needed to stop asking for more and start solving with what they already had. That was the brief. Everything below was designed backwards from it.</p>
          </div>
          <div style="border-radius:14px;overflow:hidden;box-shadow:0 22px 48px -28px rgba(58,10,12,0.45);">
            <Image src={imgEvergladesAirboats} alt="Executives stepping off airboats onto a dock at dawn, a guide briefing them, one holding a paper map." width={1672} height={941} format="webp" quality={80} loading="lazy" style="width:100%;height:300px;object-fit:cover;display:block;" />
          </div>
        </div>

        <div class="ei-grid4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:rgba(100,1,10,0.14);border-radius:14px;overflow:hidden;margin-top:44px;">
          <div style="background:#EFE9DD;padding:28px 26px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:12px;">Before dawn</p><p style="font-size:15.5px;line-height:1.6;color:#4A3A34;">Woken early. Deliberately not fed. Loaded onto airboats and taken deep into the Everglades — snakes, alligators, and a guide explaining in detail what else out there would happily kill them.</p></div>
          <div style="background:#EFE9DD;padding:28px 26px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:12px;">The hammock</p><p style="font-size:15.5px;line-height:1.6;color:#4A3A34;">The boats pull up at a hammock — a floating island of land owned by the Miccosukee tribe. On a small table sits a treasure chest. Inside, instructions: form your teams. The best survival structure built in 90 minutes gets to sleep at the five-star hotel tonight.</p></div>
          <div style="background:#EFE9DD;padding:28px 26px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:12px;">Ninety minutes</p><p style="font-size:15.5px;line-height:1.6;color:#4A3A34;">The hammock is strewn with shredded tarp, rope ends, broken plywood — garbage. Within seconds it stops being garbage and becomes resources. Three teams scavenge, and in some cases physically fight over scraps. We watch the whole thing through binoculars from a long way off.</p></div>
          <div style="background:#EFE9DD;padding:28px 26px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:12px;">The reckoning</p><p style="font-size:15.5px;line-height:1.6;color:#4A3A34;">We return. They are hungry, exhausted and furious, and quite certain they are not sleeping in a swamp. "Let's score these first." We score them. Then we ask what they had assumed.</p></div>
        </div>

        <div class="ei-two" style="display:grid;grid-template-columns:1fr 1fr;gap:44px;margin-top:44px;align-items:start;">
          <div>
            <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;line-height:1.15;color:#3A0A0C;margin-bottom:16px;">Two assumptions, never once questioned</h3>
            <div style="display:flex;flex-direction:column;">
              <div style="padding:18px 0;border-top:1px solid rgba(100,1,10,0.16);"><p style="font-size:16.5px;line-height:1.62;color:#4A3A34;"><strong style="font-weight:700;color:#3A0A0C;">That teams two and three lose their hotel.</strong> We never said that. They invented it, believed it, and competed on the strength of it. So what else are they inventing back at the office and treating as policy?</p></div>
              <div style="padding:18px 0;border-top:1px solid rgba(100,1,10,0.16);border-bottom:1px solid rgba(100,1,10,0.16);"><p style="font-size:16.5px;line-height:1.62;color:#4A3A34;"><strong style="font-weight:700;color:#3A0A0C;">That they had to be three teams at all.</strong> Nothing in the instructions forbade combining into one and every single person sleeping in that hotel. When the stakes are high, people take the rules as written and stop reading. Had anyone asked the question first, the entire day goes differently.</p></div>
            </div>
            <p style="font-size:16.5px;line-height:1.62;color:#4A3A34;margin-top:20px;">That is the lesson they had to arrive at themselves, hungry, standing on a hammock, having just fought a colleague over a piece of plywood. It is not a lesson that survives being said in a slide.</p>
          </div>
          <div>
            <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;line-height:1.15;color:#3A0A0C;margin-bottom:16px;">Then the second hammock</h3>
            <p style="font-size:16.5px;line-height:1.62;color:#4A3A34;margin-bottom:14px;">The airboats take them to another island where a five-star brunch is waiting under a canopy. Beside it, a real ShelterBox — the tent and kitchen that <a href="https://shelterbox.org" target="_blank" rel="noopener" style="color:#64010a;">shelterbox.org</a> ships into disaster zones. The activity they'd just failed was a post-hurricane survival scenario; we call it Shelter Box for that reason.</p>
            <p style="font-size:16.5px;line-height:1.62;color:#4A3A34;margin-bottom:14px;">They climb inside and examine the kitchen with the memory of their own miserable structure still fresh. The company donated one box per team, to deploy on the next disaster. That was the give-back, and it landed because they had earned the comparison.</p>
            <p style="font-size:16.5px;line-height:1.62;color:#4A3A34;">The debrief needed two questions. They ran with the rest of it themselves, straight through <em>what</em> and <em>so what</em> into <em>now what</em> — and the strategy session that followed happened right there at the brunch table, in the middle of the Everglades, with every brain in the group already switched on to the only question that mattered: what do we actually have, and what have we just been assuming?</p>
          </div>
        </div>

        <div class="ei-band" style="margin-top:38px;background:#64010a;border-radius:16px;padding:34px 40px;display:grid;grid-template-columns:auto 1fr;gap:40px;align-items:center;">
          <div style="flex:none;"><p style="font-family:'Newsreader',serif;font-size:52px;line-height:1;color:#F6EFE0;">~4<span style="font-size:26px;">hrs</span></p><p style="font-size:11.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(246,239,224,0.6);margin-top:8px;">total elapsed</p></div>
          <p style="font-size:17.5px;line-height:1.62;color:#F0E4DA;max-width:70ch;">This one was short — closer to four hours than a full day. Because the experience was that visceral, exhausting them further would have added nothing. An early start and no breakfast produced hunger and irritation that were completely authentic, which let us go straight to the meat. That's unusual. Most immersions run considerably longer, and intentionally so — the <a href={SLUGS.eiExpedition} style="color:#F6EFE0;">Sedona expedition</a> and the <a href={SLUGS.eiCity} style="color:#F6EFE0;">New York city day</a> both run dawn to well past dark.</p>
        </div>
      </div>
    </section>

    <!-- STRATEGIC VALUE -->
    <section style="max-width:1180px;margin:88px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">The strategic value</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.4vw,40px);line-height:1.1;color:#3A0A0C;max-width:30ch;margin-bottom:34px;">Three layers running at once. All three have to work.</h2>
      <div class="ei-grid3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:rgba(100,1,10,0.14);border-radius:14px;overflow:hidden;">
        <div style="background:#F6F1E7;padding:32px 34px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:12px;">Layer one</p><h3 style="font-size:19px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">The adventure</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">Visually exceptional, operationally credible, and memorable enough to justify the time and the investment. If this layer fails, nothing above it survives.</p></div>
        <div style="background:#F6F1E7;padding:32px 34px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:12px;">Layer two</p><h3 style="font-size:19px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">Behavioural exposure</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">The structure lets the team watch itself decide, share information, handle pressure, allocate scarce resources, absorb disruption, and trade individual standing against collective success.</p></div>
        <div style="background:#F6F1E7;padding:32px 34px;"><p style="font-family:'Newsreader',serif;font-size:15px;color:#C04A26;margin-bottom:12px;">Layer three</p><h3 style="font-size:19px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">Business transfer</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">The day only becomes valuable when what they saw converts into specific commitments about how this executive team will operate from Monday. That is the closing hour, and it is not optional.</p></div>
      </div>

      <div class="ei-two" style="margin-top:34px;display:grid;grid-template-columns:0.85fr 1.15fr;gap:48px;align-items:start;">
        <div>
          <h3 style="font-family:'Newsreader',serif;font-size:27px;font-weight:400;line-height:1.15;color:#3A0A0C;margin-bottom:14px;">What the closing debrief has to produce</h3>
          <p style="font-size:16.5px;line-height:1.62;color:#4A3A34;">Not a discussion of the day. Eight answers, written down, with names against them.</p>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0 40px;">
          <p style="font-size:16px;line-height:1.5;color:#4A3A34;padding:12px 0;border-top:1px solid rgba(100,1,10,0.16);">Which behaviours accelerated the group</p>
          <p style="font-size:16px;line-height:1.5;color:#4A3A34;padding:12px 0;border-top:1px solid rgba(100,1,10,0.16);">Which created avoidable delay</p>
          <p style="font-size:16px;line-height:1.5;color:#4A3A34;padding:12px 0;border-top:1px solid rgba(100,1,10,0.16);">Where information was withheld or badly distributed</p>
          <p style="font-size:16px;line-height:1.5;color:#4A3A34;padding:12px 0;border-top:1px solid rgba(100,1,10,0.16);">Which decisions protected the whole system</p>
          <p style="font-size:16px;line-height:1.5;color:#4A3A34;padding:12px 0;border-top:1px solid rgba(100,1,10,0.16);">When individual incentive undermined the mission</p>
          <p style="font-size:16px;line-height:1.5;color:#4A3A34;padding:12px 0;border-top:1px solid rgba(100,1,10,0.16);">Who became more effective once roles changed</p>
          <p style="font-size:16px;line-height:1.5;color:#4A3A34;padding:12px 0;border-top:1px solid rgba(100,1,10,0.16);border-bottom:1px solid rgba(100,1,10,0.16);">What these same patterns currently cost the business</p>
          <p style="font-size:16px;line-height:1.5;color:#4A3A34;padding:12px 0;border-top:1px solid rgba(100,1,10,0.16);border-bottom:1px solid rgba(100,1,10,0.16);">Which operating agreements the team adopts</p>
        </div>
      </div>

      <div style="margin-top:34px;border-left:3px solid #C04A26;padding:6px 0 6px 24px;">
        <p style="font-family:'Newsreader',serif;font-size:clamp(21px,2.4vw,28px);line-height:1.32;color:#3A0A0C;max-width:52ch;">The client does not buy an extraordinary day out. The client buys a controlled environment in which the executive team can see itself clearly.</p>
      </div>
    </section>

    <!-- THE INSTRUMENTS -->
    <section style="max-width:1180px;margin:88px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">The instruments</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.4vw,40px);line-height:1.1;color:#3A0A0C;max-width:32ch;margin-bottom:12px;">Almost every day is bespoke. A handful of instruments travel with us.</h2>
      <p style="font-size:17.5px;line-height:1.65;color:#4A3A34;max-width:64ch;margin-bottom:34px;">These are the pieces that reliably produce a specific effect regardless of where in the world we are. We describe them by what they do, not by what they are — because the surprise is a working part of the design, and your team shouldn't read the answer here first.</p>
      <div class="ei-two" style="display:grid;grid-template-columns:1fr 1fr;gap:2px;background:rgba(100,1,10,0.14);border-radius:14px;overflow:hidden;">
        <div style="background:#F6F1E7;padding:32px 34px;"><h3 style="font-size:19px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">The one nobody can do for you</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">A moment of real, chosen fear that each person must walk through alone while the others watch and support. Exactly like the job. Some people describe this one as life-changing years later, and they are not exaggerating.</p></div>
        <div style="background:#F6F1E7;padding:32px 34px;"><h3 style="font-size:19px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">The bottom of the pyramid</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">Executives live near the top of Maslow's hierarchy and have for a long time. Briefly returning them to shelter, sustenance and security is the fastest route to genuine perspective — and to gratitude that isn't performed.</p></div>
        <div style="background:#F6F1E7;padding:32px 34px;"><h3 style="font-size:19px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">Build something together, badly</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">A creation task with too little time, too few instructions and the wrong tools. It exposes how the group really organizes itself under constraint — and it is safe enough that nobody's career is on the line while they find out.</p></div>
        <div style="background:#F6F1E7;padding:32px 34px;"><h3 style="font-size:19px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">The one that isn't about them</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">Somewhere in the day, the team does something of real consequence for people nearby who have far less. It is the single most emotionally durable hour we run, and it quietly re-anchors why any of the work matters.</p></div>
        <div style="background:#F6F1E7;padding:32px 34px;"><h3 style="font-size:19px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">Nobody is the expert</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">A segment engineered so the org chart is useless — where the quietest person in the company is suddenly the most capable. Hierarchies that get interrupted once in a day tend to stay a little more permeable afterwards.</p></div>
        <div style="background:#F6F1E7;padding:32px 34px;"><h3 style="font-size:19px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">Unstructured on purpose</h3><p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">Deliberate empty space — a long drive, a slow meal, a wait. Almost every important conversation of the day happens in these gaps. They look like nothing on a run-of-show and they are load-bearing.</p></div>
      </div>
    </section>

    <!-- HOW WE RUN IT NOW (safeguards summary) -->
    <section style="max-width:1180px;margin:88px auto 0;padding:0 32px;">
      <div class="ei-two" style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.16);border-radius:16px;padding:38px 42px;display:grid;grid-template-columns:0.9fr 1.1fr;gap:48px;align-items:center;">
        <div>
          <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">How we run it now</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,2.8vw,34px);line-height:1.1;color:#3A0A0C;">Same emotional architecture. Considerably more control.</h2>
        </div>
        <div>
          <p style="font-size:17px;line-height:1.64;color:#4A3A34;margin-bottom:16px;">Every current design ships with a vetted community partner, a need that partner defined, consent for photography, clear boundaries around vulnerable people, pre-approved locations, a safety and communications protocol, and scoring that never rewards disruption. The emotional weight comes from genuine contribution — never from surprise access to somebody else's suffering.</p>
          <a href={SLUGS.eiCity} style="font-size:15.5px;font-weight:600;color:#64010a;text-decoration:none;border-bottom:1px solid rgba(100,1,10,0.3);padding-bottom:2px;">All nine safeguards in full</a>
        </div>
      </div>
    </section>

    <!-- FOUR CONVICTIONS -->
    <section style="max-width:1180px;margin:88px auto 0;padding:0 32px;">
      <div class="ei-two" style="display:grid;grid-template-columns:0.85fr 1.15fr;gap:52px;align-items:start;">
        <div>
          <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">What we believe about executives</p>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.2vw,38px);line-height:1.1;color:#3A0A0C;">Four convictions the whole day rests on.</h2>
          <p style="margin-top:16px;font-size:16.5px;line-height:1.62;color:#4A3A34;">These hold for every team we have ever run a day for. Everything else about the design is contingent.</p>
        </div>
        <div style="display:flex;flex-direction:column;">
          <div style="padding:22px 0;border-top:1px solid rgba(100,1,10,0.16);"><h3 style="font-size:18.5px;font-weight:700;color:#3A0A0C;margin-bottom:8px;">Adversity is the key</h3><p style="font-size:16.5px;line-height:1.62;color:#4A3A34;">Nothing bonds a group of high performers on a personal level like overcoming something real together. Not a trust fall. Something with actual stakes, actual discomfort, and actual doubt about the outcome.</p></div>
          <div style="padding:22px 0;border-top:1px solid rgba(100,1,10,0.16);"><h3 style="font-size:18.5px;font-weight:700;color:#3A0A0C;margin-bottom:8px;">Behaviour under load is the only real evidence</h3><p style="font-size:16.5px;line-height:1.62;color:#4A3A34;">How a team describes the way it operates and how it actually operates are different documents. Surveys, offsite discussions and self-assessment all capture the first. A day with real consequence in it is the only cheap way to see the second.</p></div>
          <div style="padding:22px 0;border-top:1px solid rgba(100,1,10,0.16);"><h3 style="font-size:18.5px;font-weight:700;color:#3A0A0C;margin-bottom:8px;">Intelligence is rarely the constraint</h3><p style="font-size:16.5px;line-height:1.62;color:#4A3A34;">Everyone in the room is capable, and most of them have emotional intelligence they simply do not deploy at work. The day puts them in positions where analysis will not get them through and the other capability is the only thing left.</p></div>
          <div style="padding:22px 0;border-top:1px solid rgba(100,1,10,0.16);border-bottom:1px solid rgba(100,1,10,0.16);"><h3 style="font-size:18.5px;font-weight:700;color:#3A0A0C;margin-bottom:8px;">Purpose changes what people will tolerate</h3><p style="font-size:16.5px;line-height:1.62;color:#4A3A34;">Hunger, fatigue and inconvenience are experienced as unfair right up until the moment a person can see who the effort was for. Nothing physical changes. What it costs them changes completely — which is why every day ends pointed at somebody other than the participants.</p></div>
        </div>
      </div>
    </section>

    <!-- PHOTO STRIP -->
    <section style="max-width:1180px;margin:88px auto 0;padding:0 32px;">
      <div class="ei-grid3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
        <Image src={imgEvergladesNav} alt="Executives heads-down over a paper map on a marsh boardwalk, working out a route." width={1672} height={941} format="webp" quality={80} loading="lazy" style="width:100%;height:260px;object-fit:cover;border-radius:12px;display:block;" />
        <PhotoSlot title="The place" note="Wide shot that shows how far from a conference room they are." height={260} img="/assets/sedona/sedona-vista.webp" alt="A wide view over the red-rock canyons around Sedona." />
        <PhotoSlot title="The debrief" note="James facilitating — the meaning-making moment." height={260} img="/assets/offroad/colorado/co-offroad-facilitation.webp" alt="A facilitator leading a debrief circle with an executive team in the mountains." />
      </div>
      <p style="font-size:13.5px;color:#8A6A64;margin-top:12px;">Every location is chosen after we know what the day has to accomplish — never before.</p>
    </section>

    <!-- FAQ -->
    <section style="max-width:1180px;margin:88px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:16px;">The questions you're going to be asked</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.4vw,40px);line-height:1.1;color:#3A0A0C;max-width:28ch;margin-bottom:34px;">Answers you can forward without editing.</h2>
      <div class="ei-two" style="display:grid;grid-template-columns:1fr 1fr;gap:2px;background:rgba(100,1,10,0.14);border-radius:14px;overflow:hidden;">
        {faqs.map((f) => (
          <div style="background:#F6F1E7;padding:32px 34px;">
            <h3 style="font-size:18.5px;font-weight:700;color:#3A0A0C;margin-bottom:10px;">&ldquo;{f.q}&rdquo;</h3>
            <p style="font-size:15.5px;line-height:1.62;color:#4A3A34;">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- INVESTMENT -->
    <section style="max-width:1180px;margin:88px auto 0;padding:0 32px;">
      <div class="ei-two" style="background:#F6F1E7;border:1px solid rgba(100,1,10,0.16);border-radius:18px;padding:46px 48px;display:grid;grid-template-columns:0.9fr 1.1fr;gap:52px;align-items:center;">
        <div>
          <p style="font-size:12px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#C04A26;margin-bottom:14px;">Investment</p>
          <p style="font-family:'Newsreader',serif;font-size:clamp(34px,4vw,50px);line-height:1.05;color:#3A0A0C;">Starts at {minimumFee}</p>
          <p style="font-size:15px;color:#7A5A54;margin-top:12px;">for the designed and facilitated day</p>
        </div>
        <div>
          <p style="font-size:17px;line-height:1.65;color:#4A3A34;margin-bottom:16px;">That's the floor, and it buys a day built entirely around your team from what's reachable on foot or by van. From there the number moves with exactly one thing: how far you decide to reach. Aircraft, remote terrain, specialist operators and unusual access all cost real money, and every one of them is your call, made with the price in front of you.</p>
          <p style="font-size:17px;line-height:1.65;color:#4A3A34;">What never varies is the design work and the facilitation. We won't run a cheaper day by running a thinner one.</p>
        </div>
      </div>
    </section>

    <!-- DESIGN CALL CTA -->
    <section id="design-call" style="background:#64010a;margin-top:92px;padding:84px 0;">
