---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE_URL, ORG_ID, PERSON_ID, SLUGS, CTA_URL } from '../../lib/site';

const path = SLUGS.luxuryExecutiveRetreat;
const title = 'Luxury Executive Retreats for Leaders | Be Legendary';
const description =
  'A luxury executive retreat should change the team, not just pamper it. How experiential retreats work, what they cost, and what separates the best.';

const canonical = new URL(path, SITE_URL).href;

// Article + FAQPage — schema types preserved from the design, enriched with
// entity @ids so the founder/org graph resolves.
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'Luxury & Experiential Executive Retreats for Leadership Teams',
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    about: ['luxury executive retreat', 'experiential leadership retreat', 'corporate retreat'],
    description:
      'How luxury and experiential executive retreats work, what they cost, and why the best ones pair five-star venues with genuine challenge.',
    mainEntityOfPage: `${canonical}#webpage`,
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is a luxury executive retreat?', acceptedAnswer: { '@type': 'Answer', text: 'A luxury executive retreat is an off-site for a leadership team held at a high-end venue with exceptional food, lodging and service. The best ones use that comfort as a setting for real work — a facilitated arc built around one outcome — rather than as the point itself. Be Legendary runs these as Signature retreats at hand-curated four- and five-star venues, from $35,000 to $100,000.' } },
      { '@type': 'Question', name: 'What is an experiential leadership retreat?', acceptedAnswer: { '@type': 'Answer', text: 'An experiential leadership retreat replaces slide decks with lived challenge — off-road, backcountry, open water, or an estate designed for deep work. The shared experience surfaces how a team actually operates under pressure, then a facilitator turns that into lasting change. It engages a team across four dimensions: physical, mental, emotional and spiritual.' } },
      { '@type': 'Question', name: 'How much does a luxury executive retreat cost?', acceptedAnswer: { '@type': 'Answer', text: "Be Legendary's team retreats range from $25,000 to $50,000 for a Focused retreat, $35,000 to $100,000 for a Signature experiential retreat, and $75,000 to $500,000+ for a fully bespoke build. The right tier depends on the outcome you need, not on how much you want to spend." } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogTitle="Luxury & Experiential Executive Retreats for Leadership Teams"
  ogDescription="Five-star comfort is the setting, not the point. The retreat has to change the team."
  bodyBg="#EFE9DD"
  schema={schema}
>
  <SiteHeader
    audience="teams"
    variant="slim"
    logoHref="/"
    contextLink={{ label: 'Book a Calibration Call', href: CTA_URL, external: true }}
  />

  <div style="background:#EFE9DD;color:#3A0A0C;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">

    <article>
    <header style="max-width:820px;margin:0 auto;padding:52px 32px 0;">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8A6A64;margin-bottom:22px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href="/" style="color:inherit;text-decoration:none;">For Teams</a><span>/</span><span style="color:#64010a;">Luxury Executive Retreat</span>
      </nav>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#3A0A0C;max-width:22ch;">A luxury executive retreat should change the team — not just pamper it.</h1>
      <div style="margin-top:28px;background:#F6F1E7;border-left:3px solid #64010a;border-radius:0 12px 12px 0;padding:24px 26px;">
        <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A6A64;margin-bottom:10px;">The short answer</p>
        <p style="font-size:18px;line-height:1.6;color:#4A3A34;">A luxury executive retreat is a leadership off-site at a high-end venue — exceptional food, lodging and service. The ones that are <em style="font-style:italic;">worth it</em> treat that comfort as the setting, not the point: a facilitated arc built around one real outcome, often with genuine experiential challenge. Five stars gets you a nice week. Five stars plus real work gets you a different team.</p>
      </div>
    </header>

    <!-- REFRAME -->
    <section style="max-width:820px;margin:44px auto 0;padding:0 32px;">
      <p style="font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">The trap of the beautiful off-site</p>
      <div style="font-size:19px;line-height:1.72;color:#4A3A34;">
        <p style="margin-bottom:22px;">Everyone remembers the venue. The lodge, the wine, the view. Two weeks later, nobody can name a single thing that <em style="font-style:italic;">changed.</em> That's the failure mode of the luxury retreat — spend a fortune on comfort and mistake a great time for a great outcome.</p>
        <p style="font-family:'Newsreader',serif;font-style:italic;font-size:24px;line-height:1.4;color:#3A0A0C;margin:34px 0;padding-left:22px;border-left:3px solid #64010a;">Comfort is a wonderful setting for hard work. It is a terrible substitute for it.</p>
        <p>The best experiential retreats use the five-star venue to earn trust and openness — then introduce real, shared challenge that surfaces how the team actually operates. The luxury lowers the guard; the challenge does the work. You come home with more than photos.</p>
      </div>
    </section>

    <!-- IMAGE + THREE TIERS TEASER -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <div style="border-radius:16px;overflow:hidden;box-shadow:0 24px 50px -28px rgba(58,10,12,0.4);margin-bottom:26px;">
        <img src="/assets/lr-lodge.webp" alt="A five-star mountain lodge at dusk hosting an executive leadership retreat" width={1800} height={655} loading="lazy" style="width:100%;height:280px;object-fit:cover;display:block;">
      </div>
      <p style="font-size:16.5px;line-height:1.65;color:#4A3A34;margin-bottom:20px;">Be Legendary runs three levels, so the spend matches the outcome — not the other way around:</p>
      <div style="display:flex;flex-direction:column;gap:12px;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:12px;padding:18px 22px;flex-wrap:wrap;"><div><span style="font-family:'Newsreader',serif;font-size:20px;color:#3A0A0C;">Focused</span> <span style="font-size:14px;color:#8A6A64;">— one outcome, ready to run, anywhere</span></div><span style="font-family:'Newsreader',serif;font-size:18px;color:#C04A26;">$25k–$50k</span></div>
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;background:#64010a;border-radius:12px;padding:18px 22px;flex-wrap:wrap;"><div><span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF3E7;">Signature</span> <span style="font-size:14px;color:#D99A88;">— experiential, curated venue</span></div><span style="font-family:'Newsreader',serif;font-size:18px;color:#E9A98F;">$35k–$100k</span></div>
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:12px;padding:18px 22px;flex-wrap:wrap;"><div><span style="font-family:'Newsreader',serif;font-size:20px;color:#3A0A0C;">Bespoke</span> <span style="font-size:14px;color:#8A6A64;">— engineered around your team</span></div><span style="font-family:'Newsreader',serif;font-size:18px;color:#C04A26;">$75k–$500k+</span></div>
      </div>
    </section>

    <!-- SOFT CTA -->
    <section style="max-width:820px;margin:52px auto 0;padding:0 32px;">
      <div style="background:#64010a;color:#F6EFE0;border-radius:18px;padding:40px 42px;text-align:center;">
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.4vw,36px);line-height:1.1;color:#FBF3E7;max-width:24ch;margin:0 auto 16px;">Start with the outcome. We'll find the way — and the venue.</h2>
        <p style="font-size:17px;line-height:1.6;color:rgba(246,239,224,0.82);max-width:48ch;margin:0 auto 28px;">Twenty minutes with James will tell you which level fits, what it costs, and what it will and won't do. No obligation.</p>
        <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;">
          <a href={SLUGS.teamRetreats} style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 28px;border-radius:10px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;">See the three ways to work <span>&rarr;</span></a>
          <a href={CTA_URL} target="_blank" rel="noopener" style="border:1px solid rgba(246,239,224,0.35);color:#F6EFE0;text-decoration:none;padding:16px 26px;border-radius:10px;font-weight:600;font-size:15.5px;">Book a Strategy Call</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section style="max-width:820px;margin:56px auto 0;padding:0 32px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#3A0A0C;margin-bottom:28px;">Straight answers</h2>
      <div style="display:flex;flex-direction:column;gap:24px;">
        <div><h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#3A0A0C;margin-bottom:8px;">What makes a retreat "experiential" rather than just a nice off-site?</h3><p style="font-size:16px;line-height:1.65;color:#5A4A44;">Shared, real challenge in place of slides — off-road, backcountry, open water, or an estate built for deep work. The experience surfaces how the team actually operates under pressure, and a facilitator turns that into change. The venue sets the stage; the experience does the work.</p></div>
        <div><h3 style="font-family:'Newsreader',serif;font-size:20px;font-weight:500;color:#3A0A0C;margin-bottom:8px;">How much should we budget?</h3><p style="font-size:16px;line-height:1.65;color:#5A4A44;">$25k–$50k for a Focused retreat, $35k–$100k for a Signature experiential one, and $75k–$500k+ for fully bespoke. The right tier is set by the outcome you need, not the size of the budget.</p></div>
      </div>
    </section>

    <!-- BRIDGE -->
    <section style="max-width:820px;margin:56px auto 0;padding:0 32px 90px;">
      <a href={SLUGS.teamRetreats} style="display:flex;align-items:center;justify-content:space-between;gap:20px;text-decoration:none;background:#F6F1E7;border:1px solid rgba(100,1,10,0.14);border-radius:14px;padding:26px 30px;flex-wrap:wrap;">
        <div>
          <p style="font-size:11.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:8px;">See it all</p>
          <p style="font-family:'Newsreader',serif;font-size:22px;color:#3A0A0C;">Formats, destinations, and real case studies.</p>
        </div>
        <span style="display:inline-flex;align-items:center;gap:9px;color:#3A0A0C;font-weight:700;font-size:15.5px;white-space:nowrap;">Explore Team Retreats <span>&rarr;</span></span>
      </a>
    </section>
    </article>

  </div>

  <SiteFooter audience="teams" variant="slim" />
</BaseLayout>
