---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BOOKING_URL, SLUGS, CONTACT_EMAIL } from '../lib/site';

const title = 'Book a Calibration Call | Be Legendary';
const description =
  'Book a 15-minute Calibration Call with James Carter. Run a short exercise that surfaces where your executive team stands — you leave with a concrete read, whether or not we work together.';

// The scheduler renders in an embedded iframe, so the page carries no unique
// crawlable body content — keep it out of the index (like /search/).
---
<BaseLayout title={title} description={description} path="/book/" noindex={true}>
  <SiteHeader audience="teams" logoHref="/" />

  <main style="max-width:1040px;margin:0 auto;padding:56px 32px 40px;">
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:0.82fr 1.18fr;gap:44px;align-items:start;">
      <!-- LEFT: the promise + what to expect -->
      <div>
        <p style="display:inline-flex;align-items:center;gap:9px;font-size:12.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">
          <span style="width:7px;height:7px;border-radius:50%;background:#C04A26;display:inline-block;"></span>Free · 15 minutes
        </p>
        <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(32px,4.6vw,50px);line-height:1.03;letter-spacing:-0.02em;color:#FBF8F1;">The Calibration Call</h1>
        <p style="margin-top:20px;font-size:17.5px;line-height:1.6;color:rgba(244,240,231,0.82);">Pick a time below. You'll run a short <strong style="color:#F4F0E7;">Choices</strong> exercise that surfaces priority misalignment in real time, then leave with a concrete read on where your team stands — <strong style="color:#F4F0E7;">whether or not we ever work together</strong>. It's a calibration, not a pitch.</p>

        <div style="margin-top:28px;background:#1B1810;border:1px solid rgba(244,240,231,0.12);border-radius:16px;padding:24px 26px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:14px;">What to expect</p>
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:13px;">
            <li style="display:flex;gap:12px;"><span style="flex:none;font-family:'Newsreader',serif;color:#C04A26;font-size:17px;line-height:1.3;">1</span><span style="font-size:15px;line-height:1.55;color:rgba(244,240,231,0.8);">15 minutes with James — video or phone, your choice.</span></li>
            <li style="display:flex;gap:12px;"><span style="flex:none;font-family:'Newsreader',serif;color:#C04A26;font-size:17px;line-height:1.3;">2</span><span style="font-size:15px;line-height:1.55;color:rgba(244,240,231,0.8);">A short exercise that shows where your team's flag has gone fuzzy.</span></li>
            <li style="display:flex;gap:12px;"><span style="flex:none;font-family:'Newsreader',serif;color:#C04A26;font-size:17px;line-height:1.3;">3</span><span style="font-size:15px;line-height:1.55;color:rgba(244,240,231,0.8);">You leave with a concrete read and the first move to make — no obligation.</span></li>
          </ul>
        </div>

        <p style="margin-top:20px;font-size:13.5px;line-height:1.5;color:rgba(244,240,231,0.55);">Prefer to write first? <a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Calibration Call — a question first')}`} style="color:#D98A5E;">Email us a question</a> and we'll point you to the right next step.</p>
      </div>

      <!-- RIGHT: the scheduler -->
      <div>
        <div style="background:#FBF8F1;border-radius:16px;padding:8px;box-shadow:0 30px 70px -34px rgba(0,0,0,0.6);">
          <iframe
            src={`${BOOKING_URL}?embed=true`}
            title="Book a Calibration Call with James Carter"
            loading="lazy"
            style="width:100%;min-height:720px;border:0;border-radius:10px;display:block;"
          ></iframe>
        </div>
        <p style="margin-top:14px;text-align:center;font-size:13.5px;color:rgba(244,240,231,0.55);">Calendar not loading? <a href={BOOKING_URL} target="_blank" rel="noopener" style="color:#D98A5E;">Open the scheduler in a new tab &rarr;</a></p>
      </div>
    </div>
  </main>

  <SiteFooter audience="teams" variant="slim" maxWidth={1040} note="© 2026 Be Legendary. A calibration, not a pitch." />
</BaseLayout>
