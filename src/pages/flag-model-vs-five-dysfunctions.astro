---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = "Flag Model vs The Five Dysfunctions of a Team: Trust Isn't Enough on Its Own | Be Legendary";
const description = "Lencioni's Five Dysfunctions rebuilds trust, conflict and commitment — the social contract of a team. The Flag Model installs the operating contract that keeps it from sliding back in 90 days. Here's how they work together.";

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.belegendary.org/resources/' },
    { '@type': 'ListItem', position: 3, name: 'Flag Model vs the Five Dysfunctions', item: 'https://www.belegendary.org/flag-model-vs-five-dysfunctions/' },
  ] },
  { '@type': 'Article', headline: 'Flag Model vs The Five Dysfunctions of a Team', datePublished: '2026-01-15', dateModified: '2026-06-16', author: { '@id': 'https://www.belegendary.org/#james' }, publisher: { '@id': 'https://www.belegendary.org/#org' }, mainEntityOfPage: 'https://www.belegendary.org/flag-model-vs-five-dysfunctions/', description: "How the Flag Model's operating disciplines complement Patrick Lencioni's Five Dysfunctions of a Team." },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'What is the difference between the Flag Model and the Five Dysfunctions of a Team?', acceptedAnswer: { '@type': 'Answer', text: "Lencioni's Five Dysfunctions is a diagnostic and a trust intervention — it rebuilds the social contract of a team: trust, healthy conflict, commitment, accountability and attention to results. The Flag Model installs the operating contract: decision rights, work-in-progress limits, enforceable standards and learning loops with owners and cadence. Lencioni fixes how a team feels and relates; the Flag Model fixes how it decides and executes. They are complementary." } },
    { '@type': 'Question', name: 'Does trust-building fix execution problems?', acceptedAnswer: { '@type': 'Answer', text: 'Trust is necessary but not sufficient. A team can rebuild trust and still drift back within 60 to 90 days if there are no durable operating rhythms — no decision register, no WIP limits, no standards with consequences. The Flag Model converts team-health norms into enforceable disciplines so the gains hold.' } },
    { '@type': 'Question', name: 'Should I use Lencioni or the Flag Model first?', acceptedAnswer: { '@type': 'Answer', text: "If the team has low trust or avoids conflict, start with Lencioni's work to rebuild the social contract. Then install the Flag Model to harden those norms into an operating system. Most executive teams benefit from both — Lencioni to unlock candor, the Flag Model to make candor produce repeatable execution." } },
  ] },
];
---
<BaseLayout
  title={title}
  description={description}
  path={SLUGS.vsFiveDysfunctions}
  ogType="article"
  ogTitle="Flag Model vs the Five Dysfunctions — social contract, meet operating contract"
  ogDescription="Lencioni rebuilds team health. The Flag Model turns it into a repeatable operating system. Use both."
  schema={schema}
>
  <Header maxWidth={920} links={[]} />

  <article>
  <!-- HERO -->
  <header style="position:relative;max-width:920px;margin:0 auto;padding:80px 32px 40px;">
    <div style="position:absolute;top:-100px;right:-160px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.resources} style="color:inherit;text-decoration:none;">Resources</a><span>/</span><span style="color:#D98A5E;">Flag Model vs Five Dysfunctions</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">Comparison</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(30px,4.6vw,54px);line-height:1.04;letter-spacing:-0.02em;color:#FBF8F1;">The Flag Model™ vs the Five Dysfunctions of a Team</h1>
    <p style="margin-top:18px;font-size:14px;color:rgba(244,240,231,0.55);">By <a href={SLUGS.about} style="color:#D98A5E;text-decoration:none;">James Carter</a> &middot; Updated June 2026</p>
    <div style="margin-top:30px;background:#211D15;border:1px solid rgba(192,74,38,0.35);border-left:3px solid #C04A26;border-radius:14px;padding:26px 28px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The short answer</p>
      <p style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:#FBF8F1;">Lencioni's Five Dysfunctions is the definitive map of a team's <strong>social contract</strong> &mdash; trust, healthy conflict, commitment, accountability, results. If you've done that work, you've built something most teams never have. The Flag Model installs the <strong>operating contract</strong> on top of it: the decision rights, focus limits, standards and learning loops that keep the trust you earned from quietly draining away in 90 days.</p>
    </div>
  </header>

  <!-- HERO-AFFIRM -->
  <div style="max-width:920px;margin:0 auto;padding:24px 32px 8px;">
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);">Doing Lencioni's work takes real courage. Sitting a team down to name the absence of trust, to invite conflict instead of avoiding it &mdash; most leaders never go there. You did. The honest catch nobody warns you about: team health is a <em>state</em>, not a system. Without something to hold it in place, the candor you unlocked fades back toward comfort within a quarter.</p>
  </div>

  <!-- TABLE -->
  <div style="max-width:920px;margin:0 auto;padding:36px 32px 8px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.2vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:24px;">Social contract, meet operating contract</h2>
    <div style="display:flex;flex-direction:column;gap:14px;">
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:0.8fr 1fr 1fr;gap:18px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:26px;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(244,240,231,0.45);align-self:center;">What it builds</p>
        <div><p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#E0744A;margin-bottom:8px;">Five Dysfunctions</p><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">Trust &rarr; conflict &rarr; commitment &rarr; accountability &rarr; results. How the team relates.</p></div>
        <div><p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#E0744A;margin-bottom:8px;">The Flag Model</p><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">Decisions, focus, standards, learning &mdash; with owners and cadence. How the team operates.</p></div>
      </div>
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:0.8fr 1fr 1fr;gap:18px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:26px;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(244,240,231,0.45);align-self:center;">How it's measured</p>
        <div><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">Self-report and facilitation &mdash; largely qualitative.</p></div>
        <div><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">Observable signals: decision latency, rework, broken commitments &mdash; tracked.</p></div>
      </div>
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:0.8fr 1fr 1fr;gap:18px;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:26px;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(244,240,231,0.45);align-self:center;">Best at</p>
        <div><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">Unsticking a new or fractured team; an offsite reset; rebuilding candor fast.</p></div>
        <div><p style="font-size:15.5px;line-height:1.5;color:rgba(244,240,231,0.82);">Making that candor durable &mdash; converting norms into repeatable execution.</p></div>
      </div>
    </div>
  </div>

  <!-- THE GAP -->
  <div style="max-width:920px;margin:0 auto;padding:44px 32px 8px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.2vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:16px;">Why team health slides back</h2>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:20px;">The Five Dysfunctions tells you <em>what</em> healthy looks like &mdash; trust, real debate, genuine commitment. What it deliberately doesn't prescribe is the machinery to keep it there: a decision register so commitments don't quietly reopen, WIP limits so focus survives the next shiny idea, standards with consequences so accountability outlasts the offsite glow. Without those, even a transformed team drifts back toward its old defaults within 60&ndash;90 days. That's not a failure of the model &mdash; it's the boundary of what a social intervention can do alone.</p>
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);">The Flag Model catches each Lencioni gain and hard-wires it: trust and candor become a Decision discipline; commitment becomes a focus discipline with a real &ldquo;done&rdquo;; peer accountability becomes a Standard with consequences; attention to results becomes a Learning loop that changes the system, not just the mood.</p>
  </div>

  <!-- STACK -->
  <div style="max-width:920px;margin:32px auto 0;padding:0 32px;">
    <div style="background:#F4F0E7;color:#1B1810;border-radius:18px;padding:34px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">Keep Lencioni. Make it last.</p>
      <p style="font-size:18px;line-height:1.62;color:#3A372F;margin-bottom:18px;">Social first, then operating. The two layer cleanly:</p>
      <ol style="margin:0;padding-left:22px;display:flex;flex-direction:column;gap:10px;font-size:16px;line-height:1.55;color:#3A372F;">
        <li><strong>Weeks 1&ndash;4 (Lencioni)</strong> &rarr; rebuild trust, normalize conflict, define how results outrank function.</li>
        <li><strong>Weeks 5&ndash;8 (Flag Model)</strong> &rarr; install decision rights, a focus limit, and a clear standard of &ldquo;done.&rdquo;</li>
        <li><strong>Weeks 9&ndash;12 (Flag Model)</strong> &rarr; add the consequence ladder and a monthly learning review that changes the playbook.</li>
        <li><strong>Ongoing</strong> &rarr; keep Lencioni's norms as the substrate; the Flag Model's cadence keeps them from eroding.</li>
      </ol>
    </div>
  </div>

  <!-- CTA -->
  <div style="max-width:920px;margin:36px auto 0;padding:0 32px;">
    <div style="background:linear-gradient(120deg,#211D15,#191610);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:38px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;">Turn the trust you built into execution that lasts.</h2>
      <p style="margin-top:16px;font-size:17.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:60ch;">A <strong style="color:#F4F0E7;">Calibration Call</strong> is 15 minutes, CEO only. You'll leave knowing which operating discipline will keep your team-health gains from sliding back &mdash; whether or not we work together.</p>
      <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:26px;display:inline-flex;align-items:center;gap:9px;background:#C04A26;color:#fff;text-decoration:none;padding:16px 30px;border-radius:11px;font-weight:700;font-size:16.5px;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Book a Calibration Call <span style="font-size:18px;">&rarr;</span></a>
    </div>
  </div>

  <!-- RELATED -->
  <div style="max-width:920px;margin:60px auto 0;padding:0 32px 20px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Keep reading</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <a href={SLUGS.vs4dx} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs 4DX</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Why your scoreboard says green when results say red.</span>
      </a>
      <a href={SLUGS.vsCoaching} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Flag Model vs executive coaching</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Developing the individual vs. the team's disciplines.</span>
      </a>
    </div>
  </div>
  </article>

  <Footer variant="slim" maxWidth={920} note="© 2026 Be Legendary. The Flag Model works alongside Lencioni's model." />
</BaseLayout>
