---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareRow from '../components/ShareRow.astro';
import ArticleEndCTA from '../components/ArticleEndCTA.astro';
import { CTA_URL, SLUGS } from '../lib/site';

const title = "Executive Team Initiatives Never Finish? | Be Legendary";
const description = "When a leadership team starts more than it finishes, nothing ships. Here's why busy teams stall, and the work-in-progress discipline that fixes it.";

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Field Notes', item: 'https://www.belegendary.org/field-notes/' },
    { '@type': 'ListItem', position: 3, name: 'Initiatives never finish', item: 'https://www.belegendary.org/executive-team-initiatives-never-finish/' },
  ] },
  { '@type': 'Article', headline: "Our initiatives never finish. Everyone's busy, nothing ships. Why?", datePublished: '2026-06-18', dateModified: '2026-06-18', author: { '@id': 'https://www.belegendary.org/#james' }, publisher: { '@id': 'https://www.belegendary.org/#org' }, mainEntityOfPage: 'https://www.belegendary.org/executive-team-initiatives-never-finish/', description: "When a leadership team starts more than it finishes, good strategies stall — not because they're wrong, but because nothing reaches the finish line. Here's why busy teams don't ship, and the work-in-progress discipline that fixes it." },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'Why does my team start projects but never finish them?', acceptedAnswer: { '@type': 'Answer', text: "Because the team has no discipline protecting the finish line. When new work can be added without anything else stopping, too many initiatives run at once and capacity spreads thin, so everything sits at 60% and nothing ships. The fix is a work-in-progress limit — a cap on live priorities and a one-in, one-out rule — plus a clear definition of 'done.'" } },
    { '@type': 'Question', name: 'How do I get my leadership team to actually ship?', acceptedAnswer: { '@type': 'Answer', text: "Limit how many major initiatives are active at once, require that nothing new starts until something finishes, and define what 'done' means before work begins. Fewer things in flight, each taken to completion, beats many things in progress. Three initiatives at 100% change the business; ten at 60% deliver nothing." } },
    { '@type': 'Question', name: 'Why is my team so busy but nothing gets done?', acceptedAnswer: { '@type': 'Answer', text: "Busyness and completion are different things. A team can be fully occupied and still ship nothing if it keeps starting work without finishing it. The problem is the Rhythm discipline — the protection of the finish line — not effort or talent. It's rebuilt with work-in-progress limits and a real standard for 'finished.'" } },
  ] },
];
---
<BaseLayout title={title} description={description} path={SLUGS.initiativesNeverFinish} ogType="article" ogTitle="Our initiatives never finish and everyone's busy. Why?" ogDescription="Starting is free. Finishing is the discipline. Here's how to protect the finish line." schema={schema}>
  <SiteHeader audience="teams" logoHref="/" />

  <article>
  <header style="position:relative;max-width:880px;margin:0 auto;padding:80px 32px 40px;">
    <div style="position:absolute;top:-100px;right:-160px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><a href={SLUGS.fieldNotes} style="color:inherit;text-decoration:none;">Field notes</a><span>/</span><span style="color:#D98A5E;">Initiatives never finish</span>
    </nav>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(32px,5vw,56px);line-height:1.03;letter-spacing:-0.02em;color:#FBF8F1;">Our initiatives never finish. Everyone's busy, nothing ships. Why?</h1>
    <p style="margin-top:18px;font-size:14px;color:rgba(244,240,231,0.55);">By <a href={SLUGS.about} style="color:#D98A5E;text-decoration:none;">James Carter</a> &middot; Updated June 2026</p>
    <div style="margin-top:30px;background:#211D15;border:1px solid rgba(192,74,38,0.35);border-left:3px solid #C04A26;border-radius:14px;padding:26px 28px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The short answer</p>
      <p class="bl-speakable" style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:#FBF8F1;">Because starting work is free and finishing it is the discipline most teams never build. When anything new can be added without something else stopping, capacity spreads across too many initiatives at once &mdash; ten things at 60% instead of three at 100% &mdash; so the team stays busy while nothing actually ships. This is the Rhythm discipline, and it's rebuilt with one rule: work-in-progress limits. One in, one out.</p>
    </div>
  </header>

  <div style="max-width:880px;margin:0 auto;padding:24px 32px 20px;">
    <p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;">Your team is busy. Genuinely, visibly busy. And yet quarter after quarter, the big initiatives are still &ldquo;in progress.&rdquo; The strategy deck from last January has the same three priorities &mdash; just with the dates moved. Nothing is failing, exactly. It's just not <em>finishing.</em></p><p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;">The reframe: <strong style="color:#FBF8F1;">starting is free; finishing is the discipline.</strong> Most teams have no trouble adding work. What they lack is the rule that protects the finish line &mdash; so every new idea gets bolted on, capacity spreads thinner, and everything moves at once, which means nothing arrives.</p><h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.1;letter-spacing:-0.015em;color:#FBF8F1;margin:44px 0 20px;">Why busy teams don't ship</h2><p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;"><strong style="color:#FBF8F1;">Too much work in progress.</strong> When everything is a priority, nothing is. Ten initiatives at 60% deliver zero value; three at 100% change the business.</p><p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;"><strong style="color:#FBF8F1;">No cost to starting.</strong> If a new project can be added without something else stopping, the list only grows. Saying yes feels like progress; it's usually the opposite.</p><p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;"><strong style="color:#FBF8F1;">No definition of done.</strong> If &ldquo;finished&rdquo; was never defined, work drifts toward 90% and stalls there &mdash; close enough to feel done, never closed enough to ship.</p><p style="font-size:18.5px;line-height:1.7;color:rgba(244,240,231,0.84);margin-bottom:24px;">This is the discipline beneath the research that two-thirds of strategies fail in execution, not design. The plans are fine. The teams just never built the rhythm to land them.</p>
  </div>

  <div style="max-width:880px;margin:24px auto 0;padding:0 32px;">
    <div style="background:#F4F0E7;color:#1B1810;border-radius:18px;padding:34px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;margin-bottom:12px;">The fix: protect the finish line</p>
      <p style="font-size:18px;line-height:1.62;color:#3A372F;">Install a work-in-progress limit on the leadership team's priorities: a hard cap on how many major initiatives are live at once, and a rule that nothing new starts until something finishes &mdash; <strong>one in, one out.</strong> Define &ldquo;done&rdquo; before work begins, so finishing is unambiguous. The default answer to the next shiny idea becomes &ldquo;not yet,&rdquo; and the work already in flight actually lands.</p>
    </div>
  </div>

  <div style="max-width:880px;margin:36px auto 0;padding:0 32px;">
    <div style="background:linear-gradient(120deg,#211D15,#191610);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:38px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3vw,32px);line-height:1.1;color:#FBF8F1;">See if the Rhythm is your team's first break point.</h2>
      <p style="margin-top:16px;font-size:17.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:60ch;">A Calibration Call is 15 minutes. You'll leave knowing whether the Rhythm &mdash; the discipline of finishing &mdash; is what's keeping your team busy but stalled, whether or not we work together.</p>
      <a href={CTA_URL} target="_blank" rel="noopener" style="margin-top:26px;display:inline-flex;align-items:center;gap:9px;background:#C04A26;color:#fff;text-decoration:none;padding:16px 30px;border-radius:11px;font-weight:700;font-size:16.5px;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Book a Calibration Call <span style="font-size:18px;">&rarr;</span></a>
    </div>
  </div>

  <div style="max-width:880px;margin:60px auto 0;padding:0 32px 20px;">
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:20px;">Keep reading</p>
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <a href={SLUGS.whyNotExecuting} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">Why isn't my executive team executing?</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">The four ways execution breaks — and how to spot which one is yours.</span>
      </a>
      <a href={SLUGS.eosOkrs} style="text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:14px;padding:24px;display:block;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.11)'">
        <span style="font-family:'Newsreader',serif;font-size:20px;color:#FBF8F1;">We did EOS and OKRs and behavior didn't change</span>
        <span style="display:block;margin-top:8px;font-size:14.5px;color:rgba(244,240,231,0.66);line-height:1.5;">Why frameworks don't stick when the Rhythm is broken.</span>
      </a>
    </div>
  </div>
    <ArticleEndCTA maxWidth={920} />
    <ShareRow title={title} maxWidth={920} />
</article>

  <SiteFooter audience="teams" variant="slim" maxWidth={880} note="© 2026 Be Legendary. Field notes on executive-team execution." />
</BaseLayout>
