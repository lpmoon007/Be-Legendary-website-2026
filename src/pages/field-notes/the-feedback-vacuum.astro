const description =
  'Your organization used to carry the truth upward. As AI removes the middle layers, that breaks — and most CEOs won’t name the feedback vacuum until a crisis hits.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Field Notes', item: 'https://www.belegendary.org/field-notes/' },
    { '@type': 'ListItem', position: 3, name: 'The Feedback Vacuum', item: `https://www.belegendary.org${path}` },
  ] },
  { '@type': 'Article',
    headline: 'The Feedback Vacuum: the executive-team crisis nobody is talking about yet',
    datePublished: '2026-08-01', dateModified: '2026-08-01',
    author: { '@id': 'https://www.belegendary.org/#james' },
    publisher: { '@id': 'https://www.belegendary.org/#org' },
    mainEntityOfPage: `https://www.belegendary.org${path}`,
    description: 'As AI replaces the coordinators, dispatchers and junior managers who carried organizational reality upward, executive teams are being left to run on information increasingly disconnected from the truth. A field report on the feedback vacuum forming in scaling companies right now.',
  },
];

const bodyP = 'font-size:18.5px;line-height:1.72;color:rgba(244,240,231,0.84);margin-bottom:26px;';
const h2 = "font-family:'Newsreader',serif;font-weight:500;font-size:clamp(26px,3.4vw,38px);line-height:1.12;letter-spacing:-0.015em;color:#FBF8F1;margin:52px 0 20px;";
---
<BaseLayout title={title} description={description} path={path} ogType="article" ogTitle="The Feedback Vacuum: the executive-team crisis nobody is talking about yet" ogDescription="Your organization used to carry the truth upward. As AI removes the middle layers, that chain is breaking — and the isolation feels like connection." schema={schema}>
  <SiteHeader audience="teams" logoHref="/" />

  <div style="background:#15130E;color:#F4F0E7;font-family:'Hanken Grotesk',sans-serif;overflow:hidden;">
