---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareRow from '../components/ShareRow.astro';
import ArticleEndCTA from '../components/ArticleEndCTA.astro';
import { CTA_URL, SLUGS, PERSON_ID, ORG_ID } from '../lib/site';

const PDF = '/assets/discover-your-inner-strength-james-carter.pdf';
const AMZN = 'https://www.amazon.com/Discover-Inner-Strength-James-Carter/dp/1600135129';

const title = "Discover Your Inner Strength: James Carter's Chapter (Free PDF) | Be Legendary";
const description =
  "Discover Your Inner Strength is a collaborative book featuring Brian Tracy, James Carter, Ken Blanchard and Stephen Covey. Read James's chapter, 'Licking the Sticky Wicket,' free — on the emotional strength that carries a leader through crisis.";

const faqs = [
  ['What is Discover Your Inner Strength?', 'Discover Your Inner Strength (Insight Publishing, 2009; ISBN 978-1-60013-512-5) is a collaborative book of interviews — "Cutting Edge Growth Strategies From The Industry\'s Leading Experts." James Carter, founder of Be Legendary, is featured on the cover alongside Brian Tracy, Ken Blanchard and Stephen Covey. His chapter is "Licking the Sticky Wicket."'],
  ['Did James Carter write Discover Your Inner Strength?', 'James co-authored it — he contributed the chapter "Licking the Sticky Wicket" and is one of the authors featured on the cover, alongside Brian Tracy, Ken Blanchard and Stephen Covey. It is one of several collaborative works he has contributed to, together with Roadmap to Success.'],
  ['What is James\'s chapter about?', 'It\'s about emotional strength — "performing during crisis or periods of stress, and being a rock for others and ourselves during emotional turbulence." He argues that emotional crisis is one of the great equalizers of life, that no one is immune, and that real strength comes from understanding yourself well enough to draw on specific examples when it counts.'],
  ['Can I download it for free?', 'Yes. James\'s chapter is free to read — download the PDF above. No form, no email. The full book is available on Amazon.'],
];

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Discover Your Inner Strength', item: 'https://www.belegendary.org/discover-your-inner-strength/' },
  ] },
  { '@type': 'Book', '@id': 'https://www.belegendary.org/discover-your-inner-strength/#book', name: 'Discover Your Inner Strength', alternateName: "Cutting Edge Growth Strategies From The Industry's Leading Experts", isbn: '978-1-60013-512-5', datePublished: '2009-10-30', numberOfPages: 256, publisher: { '@type': 'Organization', name: 'Insight Publishing' }, image: 'https://www.belegendary.org/assets/discover-your-inner-strength-cover.webp', author: [{ '@type': 'Person', name: 'Brian Tracy' }, { '@id': PERSON_ID }, { '@type': 'Person', name: 'Ken Blanchard' }, { '@type': 'Person', name: 'Stephen Covey' }], about: "A collaborative book of interviews. James Carter's chapter, \"Licking the Sticky Wicket,\" is on emotional strength and performing under crisis.", url: 'https://www.belegendary.org/discover-your-inner-strength/', sameAs: 'https://www.amazon.com/Discover-Inner-Strength-James-Carter/dp/1600135129' },
  { '@type': 'Article', headline: "Discover Your Inner Strength: James Carter's chapter, 'Licking the Sticky Wicket'",
    datePublished: '2026-07-24', dateModified: '2026-07-24',
    author: { '@id': PERSON_ID }, publisher: { '@id': ORG_ID },
    mainEntityOfPage: 'https://www.belegendary.org/discover-your-inner-strength/',
    description: "James Carter's chapter on emotional strength — performing under crisis and being a rock for others." },
  { '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<BaseLayout
  title={title}
  description={description}
  path={SLUGS.discoverInnerStrength}
  ogType="article"
  ogTitle="Discover Your Inner Strength — James Carter's chapter"
  ogDescription="A collaborative book with Tracy, Blanchard and Covey. Read James Carter's chapter, 'Licking the Sticky Wicket,' free."
  schema={schema}
  bodyBg="#100E0A"
>
  <SiteHeader audience="teams" logoHref="/" maxWidth={880} links={[{ label: 'The Flag Model', href: SLUGS.flagModel }, { label: 'For Leaders', href: SLUGS.leaders }, { label: 'About James', href: SLUGS.about }]} />

  <article>
  <!-- HERO -->
  <header style="position:relative;max-width:880px;margin:0 auto;padding:80px 32px 24px;">
    <div style="position:absolute;top:-100px;right:-160px;width:460px;height:460px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:26px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><span style="color:#D98A5E;">Discover Your Inner Strength</span>
    </nav>
    <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:18px;">The book &middot; James's chapter</p>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(34px,5.2vw,60px);line-height:1.03;letter-spacing:-0.02em;color:#FBF8F1;">Discover Your Inner Strength</h1>
    <p style="margin-top:16px;font-size:15px;font-style:italic;color:rgba(244,240,231,0.62);">Cutting Edge Growth Strategies From The Industry&rsquo;s Leading Experts</p>
    <p style="margin-top:10px;font-size:14px;color:rgba(244,240,231,0.55);"><a href={SLUGS.about} style="color:#D98A5E;text-decoration:none;">James Carter</a> &mdash; chapter &ldquo;Licking the Sticky Wicket&rdquo; &mdash; featured alongside <strong style="color:rgba(244,240,231,0.75);font-weight:600;">Brian Tracy</strong>, <strong style="color:rgba(244,240,231,0.75);font-weight:600;">Dr. Ken Blanchard</strong> and <strong style="color:rgba(244,240,231,0.75);font-weight:600;">Dr. Stephen Covey</strong> &middot; Insight Publishing, 2009</p>
    <div class="bl-speakable" style="margin-top:30px;background:#211D15;border:1px solid rgba(192,74,38,0.35);border-left:3px solid #C04A26;border-radius:14px;padding:26px 28px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;margin-bottom:12px;">The short version</p>
      <p style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:#FBF8F1;"><strong style="color:#FBF8F1;">Discover Your Inner Strength</strong> is a collaborative book of interviews with leading experts. James Carter&rsquo;s chapter, <strong style="color:#FBF8F1;">&ldquo;Licking the Sticky Wicket,&rdquo;</strong> is about the <em>emotional</em> strength that carries a leader through crisis &mdash; performing under stress, and being a rock for others when it counts. It&rsquo;s free to read.</p>
    </div>
    <div style="margin-top:24px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;">
      <a href={PDF} target="_blank" rel="noopener" style="background:#C04A26;color:#fff;text-decoration:none;padding:16px 30px;border-radius:11px;font-weight:700;font-size:16.5px;display:inline-flex;align-items:center;gap:9px;box-shadow:0 14px 40px -12px rgba(192,74,38,0.6);" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Read the chapter &mdash; free PDF <span style="font-size:16px;">&darr;</span></a>
      <a href={AMZN} target="_blank" rel="noopener" style="color:#D98A5E;text-decoration:none;font-weight:600;font-size:15px;border:1px solid rgba(217,138,94,0.4);padding:15px 24px;border-radius:11px;">The full book on Amazon &nearr;</a>
      <span style="font-size:13.5px;color:rgba(244,240,231,0.55);">Chapter is free &mdash; no email.</span>
    </div>
  </header>

  <!-- CONTEXT + COVER -->
  <div style="max-width:880px;margin:0 auto;padding:36px 32px 8px;">
    <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 210px;gap:34px;align-items:start;">
      <div>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.2vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:18px;">Strength, before it was a framework</h2>
        <p style="font-size:18.5px;line-height:1.72;color:rgba(244,240,231,0.84);">Long before FlagScore or a single Calibration Call, James was interviewed for <em>Discover Your Inner Strength</em> (Insight Publishing, 2009) &mdash; a collaborative volume where leading experts each set down their thinking, in the interview format led by David Wright. James is featured on the cover alongside <strong style="color:#FBF8F1;">Brian Tracy</strong>, <strong style="color:#FBF8F1;">Dr. Ken Blanchard</strong> and <strong style="color:#FBF8F1;">Dr. Stephen Covey</strong>. His chapter is about the thing every leadership model eventually rests on: the emotional strength to do the hard, honest thing under pressure.</p>
      </div>
      <a href={AMZN} target="_blank" rel="noopener" style="display:block;text-decoration:none;">
        <img src="/assets/discover-your-inner-strength-cover.webp" alt="Cover of Discover Your Inner Strength (Insight Publishing, 2009), featuring Brian Tracy, James Carter, Ken Blanchard, and Stephen Covey." width="540" height="810" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:8px;border:1px solid rgba(244,240,231,0.14);box-shadow:0 20px 44px -18px rgba(0,0,0,0.7);display:block;" />
        <span style="display:block;margin-top:10px;font-size:12.5px;color:rgba(244,240,231,0.5);text-align:center;">Tracy &middot; Carter &middot; Blanchard &middot; Covey</span>
      </a>
    </div>
    <figure style="margin:26px 0 4px;background:#15130E;border:1px solid rgba(244,240,231,0.1);border-left:3px solid #C04A26;border-radius:14px;padding:28px 30px;">
      <blockquote style="margin:0;font-family:'Newsreader',serif;font-style:italic;font-size:clamp(19px,2.4vw,25px);line-height:1.45;color:#FBF8F1;">&ldquo;The inner strength I focus upon is emotional strength &mdash; performing during crisis or periods of stress, and being a rock for others and ourselves during emotional turbulence. Emotional crisis is one of the great equalizers in life. No one is immune.&rdquo;</blockquote>
      <figcaption style="margin-top:16px;font-size:13.5px;color:#8A8578;">&mdash; James Carter, &ldquo;Licking the Sticky Wicket,&rdquo; in <em>Discover Your Inner Strength</em></figcaption>
    </figure>
  </div>

  <!-- WHAT IT GREW INTO -->
  <section style="background:#15130E;border-top:1px solid rgba(244,240,231,0.08);border-bottom:1px solid rgba(244,240,231,0.08);margin-top:40px;">
    <div style="max-width:880px;margin:0 auto;padding:56px 32px;">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:10px;">Where it leads</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.4vw,34px);line-height:1.1;color:#FBF8F1;margin-bottom:8px;">Inner strength is what the work asks of you.</h2>
      <p style="font-size:16.5px;line-height:1.6;color:rgba(244,240,231,0.72);max-width:60ch;margin-bottom:30px;">Choosing truth over comfort &mdash; the principle underneath the Flag Model &mdash; takes exactly the emotional strength this chapter is about. Here&rsquo;s where that idea lives today.</p>
      <div class="bl-grid-collapse" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">
        <a href={SLUGS.legendaryLeader} style="display:block;background:#211D15;border:1px solid rgba(244,240,231,0.12);border-radius:16px;padding:28px 30px;text-decoration:none;transition:border-color .16s;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.12)'">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;margin-bottom:10px;">For one leader</p>
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#FBF8F1;margin-bottom:8px;">The Legendary Leader</h3>
          <p style="font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.75);">The daily practice of building the inner strength to lead &mdash; and the mindset behind it.</p>
          <span style="display:inline-block;margin-top:14px;color:#D98A5E;font-weight:700;font-size:14.5px;">Explore &rarr;</span>
        </a>
        <a href={SLUGS.flagModel} style="display:block;background:#211D15;border:1px solid rgba(244,240,231,0.12);border-radius:16px;padding:28px 30px;text-decoration:none;transition:border-color .16s;" onmouseover="this.style.borderColor='rgba(192,74,38,0.5)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.12)'">
          <p style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#E0744A;margin-bottom:10px;">For an executive team</p>
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:22px;color:#FBF8F1;margin-bottom:8px;">The Flag Model</h3>
          <p style="font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.75);">Truth over comfort, made into a team discipline &mdash; and measured.</p>
          <span style="display:inline-block;margin-top:14px;color:#D98A5E;font-weight:700;font-size:14.5px;">See the framework &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- DOWNLOAD AGAIN -->
  <div style="max-width:880px;margin:44px auto 0;padding:0 32px;">
    <div style="background:linear-gradient(120deg,#211D15,#191610);border:1px solid rgba(192,74,38,0.4);border-radius:18px;padding:34px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;">
      <div style="max-width:46ch;">
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(22px,2.8vw,28px);line-height:1.12;color:#FBF8F1;margin-bottom:8px;">Read the chapter</h2>
        <p style="font-size:15.5px;line-height:1.55;color:rgba(244,240,231,0.75);">James Carter&rsquo;s &ldquo;Licking the Sticky Wicket&rdquo; from <em>Discover Your Inner Strength</em> &mdash; free, no email required.</p>
      </div>
      <a href={PDF} target="_blank" rel="noopener" style="background:#C04A26;color:#fff;text-decoration:none;padding:15px 28px;border-radius:11px;font-weight:700;font-size:16px;white-space:nowrap;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Download the PDF &darr;</a>
    </div>
  </div>

  <!-- FAQ -->
  <section style="max-width:880px;margin:52px auto 0;padding:0 32px 8px;">
    <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(24px,3.4vw,32px);line-height:1.1;color:#FBF8F1;margin-bottom:26px;">Straight answers</h2>
    <div style="display:flex;flex-direction:column;gap:22px;">
      {faqs.map(([q, a]) => (
        <div>
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;color:#FBF8F1;margin-bottom:8px;">{q}</h3>
          <p style="font-size:16.5px;line-height:1.66;color:rgba(244,240,231,0.76);">{a}</p>
        </div>
      ))}
    </div>
  </section>

  <ArticleEndCTA maxWidth={880} />
  <ShareRow title="Discover Your Inner Strength — James Carter's chapter" maxWidth={880} />
  </article>

  <SiteFooter audience="teams" />
</BaseLayout>
