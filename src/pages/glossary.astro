---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CTA_URL, SLUGS } from '../lib/site';
import ArticleEndCTA from '../components/ArticleEndCTA.astro';

const title = 'Glossary: The Flag Model & FlagScore Terms | Be Legendary';
const description = 'Plain definitions of the Be Legendary vocabulary: the Flag Model, its five components, FlagScore, the Calibration Call, ELFS and Truth Over Comfort.';

const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.belegendary.org/' },
    { '@type': 'ListItem', position: 2, name: 'Glossary', item: 'https://www.belegendary.org/glossary/' },
  ] },
  { '@type': 'DefinedTermSet', '@id': 'https://www.belegendary.org/glossary/#set', name: 'Be Legendary Glossary', description: "The vocabulary of the Flag Model and Be Legendary's executive-team work.", hasDefinedTerm: [
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#flag-model', name: 'The Flag Model', description: 'A leadership-execution framework. At its center is the Flag — the 2 to 3 priorities everything serves. Four disciplines hold it upright: the Decision, the Rhythm, the Standard and the Learning. The governing principle is Truth Over Comfort. Remove one discipline and the flag tilts; remove two and it falls.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#flag', name: 'The Flag', description: 'The center of the Flag Model: the 2 to 3 priorities everything serves, defined precisely enough that any decision can be tested against them. When the Flag is vague it is shredded by exceptions and the team loses alignment to drift.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#decision', name: 'The Decision', description: 'The discipline of committing: a call gets made, it sticks, and it does not route back to the CEO to be re-litigated. When it breaks, the team is lost to chaos and the CEO becomes the bottleneck. Rebuilt with the 4Ds — Owner, Data, Deadline, Defend.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#rhythm', name: 'The Rhythm', description: 'The discipline of finishing: work gets completed, not just started. When it breaks, the team is lost to sprawl — initiatives roll over quarter after quarter. Rebuilt with work-in-progress limits: one in, one out.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#standard', name: 'The Standard', description: 'The discipline of holding the bar: the team names a missed commitment in the room rather than tolerating it. When it breaks, the team is lost to avoidance because candor feels like conflict.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#learning', name: 'The Learning', description: 'The discipline of examining misses and changing because of them. When it breaks, the team is lost to stagnation and the same mistake returns under a new name. Rebuilt with after-action reviews that end in a changed rule or process.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#truth-over-comfort', name: 'Truth Over Comfort', description: 'The governing principle beneath all four disciplines of the Flag Model: the willingness to choose the truthful, harder path over the comfortable one — paid daily, or not at all.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#flagscore', name: 'FlagScore', description: "Be Legendary's composite measure of an executive team's health across the five components of the Flag Model. It turns 'we feel stuck' into a tracked read that moves quarter over quarter.", inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#calibration-call', name: 'Calibration Call', description: 'A 15-minute conversation, in which a short exercise surfaces where an executive team actually stands. The participant leaves with a concrete read on their team\'s first break point — whether or not they engage further. It is a calibration, not a sales pitch.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#elfs', name: 'Executive Leadership Failure Simulation (ELFS)', description: 'A solo CEO pressure simulation with an individual debrief and written report showing where the leader chose comfort over truth — the low-risk way to experience the diagnostic before a team runs it.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#performance-partnership', name: 'Performance Partnership', description: 'The ongoing engagement through which the Flag Model is installed over time, with progress measured by FlagScore movement across quarters. A relationship, not a workshop.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#break-point', name: 'Break point', description: 'The single discipline an executive team is most likely to lose first under pressure. Teams rarely fail at all five components at once — they fail at one first, and that one pulls the others down.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#4ds', name: 'The 4Ds', description: "The decision protocol that rebuilds the Decision discipline: every decision gets an Owner, the Data it rests on, a Deadline, and the duty to Defend it — so a call sticks without the CEO's sign-off.", inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#alignment', name: 'Leadership team alignment', description: 'A shared, tested commitment to the same few priorities and the same action — not agreement. A team can disagree in the room and still be aligned once the call is made, because alignment is committed action, not identical opinions.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#disagree-and-commit', name: 'Disagree and commit', description: 'The practice that makes alignment possible: surface the real disagreement, decide, then commit to the decision fully — even the people who argued against it. It is what separates alignment (committed action) from agreement (identical opinion).', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#strategy-execution-gap', name: 'Strategy execution gap', description: 'The distance between the strategy a leadership team sets and the work it actually delivers. It is a behavior problem, not a planning one: the disciplines that turn a decision into finished work erode until the plan outpaces the doing.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#accountability', name: 'Leadership team accountability', description: 'A leadership team holding itself to its own commitments, where a miss is named in the room and carries a real consequence. Without it, the bar quietly drops to the level of the most tolerated behavior.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#operating-cadence', name: 'Operating cadence', description: 'The regular rhythm — usually a weekly leadership meeting — where priorities are reviewed, commitments are checked, and one hard issue is decided. It is how the Rhythm discipline turns decisions into finished work.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#executive-offsite', name: 'Executive offsite', description: 'A focused working session, usually one to two days, built to make a specific set of decisions and align the leadership team. Distinct from a leadership retreat, which is longer and more immersive, optimizing for reset as well as decisions.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#high-performing-team', name: 'High-performing leadership team', description: 'A leadership team in which all five components of the Flag Model hold: it is aligned on a few priorities, decides and commits, finishes on a cadence, holds a real standard, and learns from its misses.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
    { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/glossary/#followership', name: 'Followership', description: 'The counterpart to leadership: how team members choose to follow — with commitment and candor, or with compliance and quiet resistance. Execution depends on followership as much as on leadership.', inDefinedTermSet: 'https://www.belegendary.org/glossary/#set' },
  ] },
];
---
<BaseLayout title={title} description={description} path={SLUGS.glossary} ogType="website" ogTitle="Be Legendary Glossary — the Flag Model vocabulary, defined" ogDescription="Plain definitions of the Flag Model, the five components, FlagScore, the Calibration Call, ELFS, and Truth Over Comfort." schema={schema}>
  <SiteHeader audience="teams" logoHref="/" maxWidth={1040} links={[{ label: 'The Flag Model', href: SLUGS.flagModel }, { label: 'Resources', href: SLUGS.resources }]} />

  <header style="position:relative;max-width:1040px;margin:0 auto;padding:80px 32px 44px;">
    <div style="position:absolute;top:-100px;right:-140px;width:460px;height:460px;background:radial-gradient(circle,rgba(192,74,38,0.16),transparent 62%);pointer-events:none;"></div>
    <nav aria-label="Breadcrumb" style="font-size:13px;color:rgba(244,240,231,0.5);margin-bottom:24px;display:flex;gap:8px;align-items:center;">
      <a href="/" style="color:inherit;text-decoration:none;">Be Legendary</a><span>/</span><span style="color:#D98A5E;">Glossary</span>
    </nav>
    <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(36px,5.4vw,64px);line-height:1.02;letter-spacing:-0.02em;max-width:18ch;color:#FBF8F1;">The Be Legendary glossary.</h1>
    <p style="margin-top:24px;font-size:clamp(17px,2vw,21px);line-height:1.54;max-width:60ch;color:rgba(244,240,231,0.82);">Plain definitions of the vocabulary behind the work &mdash; the Flag Model™, its five components, and the tools that measure and rebuild them. No jargon for its own sake; every term earns its place.</p>
  </header>

  <nav aria-label="Glossary index" style="max-width:1040px;margin:0 auto;padding:0 32px 8px;">
    <div style="display:flex;flex-wrap:wrap;gap:9px;">
      <a href="#flag-model" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">The Flag Model</a>
      <a href="#flag" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">The Flag</a>
      <a href="#decision" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">The Decision</a>
      <a href="#rhythm" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">The Rhythm</a>
      <a href="#standard" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">The Standard</a>
      <a href="#learning" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">The Learning</a>
      <a href="#truth-over-comfort" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Truth Over Comfort</a>
      <a href="#flagscore" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">FlagScore™</a>
      <a href="#calibration-call" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Calibration Call</a>
      <a href="#elfs" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">ELFS</a>
      <a href="#performance-partnership" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Performance Partnership</a>
      <a href="#break-point" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Break point</a>
      <a href="#the-4ds" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">The 4Ds</a>
      <a href="#alignment" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Alignment</a>
      <a href="#disagree-and-commit" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Disagree &amp; commit</a>
      <a href="#strategy-execution-gap" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Strategy execution gap</a>
      <a href="#accountability" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Accountability</a>
      <a href="#operating-cadence" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Operating cadence</a>
      <a href="#executive-offsite" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Executive offsite</a>
      <a href="#high-performing-team" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">High-performing team</a>
      <a href="#followership" style="font-size:13.5px;font-weight:600;color:#E0744A;text-decoration:none;background:#1B1810;border:1px solid rgba(244,240,231,0.12);padding:8px 14px;border-radius:999px;">Followership</a>
    </div>
  </nav>

  <main style="max-width:1040px;margin:0 auto;padding:36px 32px 20px;display:flex;flex-direction:column;gap:14px;">

    <article id="flag-model" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">The Flag Model</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">A leadership-execution framework. At its center is the Flag &mdash; the 2 to 3 priorities everything serves. Four disciplines hold it upright: the Decision, the Rhythm, the Standard and the Learning. The governing principle is Truth Over Comfort. Remove one discipline and the flag tilts; remove two and it falls. <a href={SLUGS.flagModel} style="color:#E0744A;text-decoration:underline;">See the full framework &rarr;</a></p>
    </article>

    <article id="flag" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">The Flag</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The center of the Flag Model: the 2 to 3 priorities everything serves, defined precisely enough that any decision can be tested against them. When the Flag is vague, it gets shredded by exceptions &mdash; every team makes a reasonable case for its own priority &mdash; and the team loses alignment to drift.</p>
    </article>

    <article id="decision" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">The Decision</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The discipline of committing: a call gets made, it sticks, and it doesn't route back to the CEO to be re-litigated a week later. When it breaks, the team is lost to chaos and the CEO becomes the bottleneck for their own company. Rebuilt with the 4Ds &mdash; Owner, Data, Deadline, Defend.</p>
    </article>

    <article id="rhythm" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">The Rhythm</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The discipline of finishing: work gets completed, not just started. When it breaks, the team is lost to sprawl &mdash; everyone is busy, nothing ships, and initiatives roll over quarter after quarter. Rebuilt with work-in-progress limits: one in, one out.</p>
    </article>

    <article id="standard" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">The Standard</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The discipline of holding the bar: the team names a missed commitment in the room rather than tolerating it. When it breaks, the team is lost to avoidance &mdash; candor feels like conflict, so the hard conversation happens in the hallway, if at all.</p>
    </article>

    <article id="learning" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">The Learning</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The discipline of examining misses and changing because of them. When it breaks, the team is lost to stagnation &mdash; nothing gets looked at, and the same mistake returns next quarter under a new name. Rebuilt with after-action reviews that end in a changed rule or process within 30 days.</p>
    </article>

    <article id="truth-over-comfort" style="background:#211D15;border:1px solid rgba(192,74,38,0.35);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Truth Over Comfort</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The governing principle beneath all four disciplines: the willingness to choose the truthful, harder path over the comfortable one. Every discipline breaks the same way underneath &mdash; comfort is always available and always reasonable-sounding. Truth over comfort is the price of entry, paid daily or not at all.</p>
    </article>

    <article id="flagscore" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">FlagScore</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">Be Legendary's composite measure of an executive team's health across the five components of the Flag Model. It turns "we feel stuck" into a tracked read that moves quarter over quarter &mdash; the team's vitals, measured rather than asserted.</p>
    </article>

    <article id="calibration-call" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Calibration Call</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">A 15-minute conversation, in which a short exercise surfaces where an executive team actually stands. The participant leaves with a concrete read on their team's first break point &mdash; whether or not they ever engage further. It's a calibration, not a pitch. <a href={CTA_URL} target="_blank" rel="noopener" style="color:#E0744A;text-decoration:underline;">Book one &rarr;</a></p>
    </article>

    <article id="elfs" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Executive Leadership Failure Simulation (ELFS)</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">A solo CEO pressure simulation with an individual debrief and a written report showing where the leader chose comfort over truth &mdash; the low-risk way to experience the diagnostic before a full team runs it. After the first reference, simply "ELFS." <a href={SLUGS.elfs} style="color:#E0744A;text-decoration:underline;">Read the full ELFS page &rarr;</a></p>
    </article>

    <article id="performance-partnership" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Performance Partnership</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The ongoing engagement through which the Flag Model is installed over time, with progress measured by FlagScore movement across quarters. A relationship, not a workshop &mdash; the disciplines are built to hold after the work ends.</p>
    </article>

    <article id="break-point" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Break point</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The single discipline an executive team is most likely to lose first under pressure. Teams rarely fail at all five components at once &mdash; they fail at one first, and that one quietly pulls the others down with it. <a href={SLUGS.breakPointAssessment} style="color:#E0744A;text-decoration:underline;">Find yours &rarr;</a></p>
    </article>

    <article id="the-4ds" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">The 4Ds</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The decision protocol that rebuilds the Decision discipline: every decision gets an <strong>Owner</strong>, the <strong>Data</strong> it rests on, a <strong>Deadline</strong>, and the duty to <strong>Defend</strong> it &mdash; so a call sticks without the CEO's sign-off.</p>
    </article>

    <article id="alignment" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Leadership team alignment</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">A shared, tested commitment to the same few priorities and the same action &mdash; <em>not</em> agreement. A team can disagree in the room and still be aligned once the call is made, because alignment is committed action, not identical opinions. <a href={SLUGS.alignLeadershipTeam} style="color:#E0744A;text-decoration:underline;">How to align a leadership team &rarr;</a></p>
    </article>

    <article id="disagree-and-commit" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Disagree and commit</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The practice that makes alignment possible: surface the real disagreement, decide, then commit to the decision fully &mdash; even the people who argued against it. It&rsquo;s what separates alignment (committed action) from agreement (identical opinion). <a href={SLUGS.alignLeadershipTeam} style="color:#E0744A;text-decoration:underline;">More on alignment &rarr;</a></p>
    </article>

    <article id="strategy-execution-gap" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Strategy execution gap</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The distance between the strategy a leadership team sets and the work it actually delivers. It&rsquo;s a behavior problem, not a planning one: the disciplines that turn a decision into finished work erode until the plan outpaces the doing. <a href={SLUGS.strategyExecutionGap} style="color:#E0744A;text-decoration:underline;">Read the full guide &rarr;</a></p>
    </article>

    <article id="accountability" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Leadership team accountability</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">A leadership team holding itself to its own commitments, where a miss is named in the room and carries a real consequence. Without it, the bar quietly drops to the level of the most tolerated behavior. <a href={SLUGS.howToAccountable} style="color:#E0744A;text-decoration:underline;">How to hold your team accountable &rarr;</a></p>
    </article>

    <article id="operating-cadence" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Operating cadence</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The regular rhythm &mdash; usually a weekly leadership meeting &mdash; where priorities are reviewed, commitments are checked, and one hard issue is decided. It&rsquo;s how the Rhythm discipline turns decisions into finished work. <a href={SLUGS.executiveTeamMeeting} style="color:#E0744A;text-decoration:underline;">How to run the meeting &rarr;</a></p>
    </article>

    <article id="executive-offsite" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Executive offsite</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">A focused working session, usually one to two days, built to make a specific set of decisions and align the leadership team. Distinct from a leadership retreat, which is longer and more immersive &mdash; optimizing for reset as well as decisions. <a href={SLUGS.executiveOffsite} style="color:#E0744A;text-decoration:underline;">How to plan one &rarr;</a></p>
    </article>

    <article id="high-performing-team" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">High-performing leadership team</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">A leadership team in which all five components of the Flag Model hold: it&rsquo;s aligned on a few priorities, decides and commits, finishes on a cadence, holds a real standard, and learns from its misses. <a href={SLUGS.highPerformingTeam} style="color:#E0744A;text-decoration:underline;">How to build one &rarr;</a></p>
    </article>

    <article id="followership" style="background:#1B1810;border:1px solid rgba(244,240,231,0.11);border-radius:16px;padding:30px 34px;scroll-margin-top:90px;">
      <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:26px;color:#FBF8F1;">Followership</h2>
      <p style="margin-top:12px;font-size:16.5px;line-height:1.62;color:rgba(244,240,231,0.82);max-width:72ch;">The counterpart to leadership: how team members choose to follow &mdash; with commitment and candor, or with compliance and quiet resistance. Execution depends on followership as much as on leadership. <a href={SLUGS.followership} style="color:#E0744A;text-decoration:underline;">More on followership &rarr;</a></p>
    </article>

  </main>

