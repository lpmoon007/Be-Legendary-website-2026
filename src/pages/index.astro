---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LowCommitmentCTA from '../components/LowCommitmentCTA.astro';
import FlagDiagram from '../components/FlagDiagram.astro';
import Faq from '../components/Faq.astro';
import PressStrip from '../components/PressStrip.astro';
import ResultsBand from '../components/ResultsBand.astro';
import Testimonials from '../components/Testimonials.astro';
import TrustedBy from '../components/TrustedBy.astro';
import { TESTIMONIALS } from '../lib/testimonials';
import { Image } from 'astro:assets';
import imgJames from '../assets/james.jpg';
import imgLdol from '../assets/book-ldol.png';
import imgDiscover from '../assets/book-discover.jpg';
import imgRoadmap from '../assets/book-roadmap.png';
import imgOneGreatIdea from '../assets/book-onegreatidea.jpg';
import { CTA_URL, SLUGS, ORG_NODE, PERSON_NODE, WEBSITE_NODE } from '../lib/site';

// Title and description lead with what buyers actually search for and buy
// (executive retreats, a fast read on the leadership team). The Flag Model is
// the method underneath, explained lower on the page and on /flag-model/.
const title = 'Executive Retreats & Leadership Team Performance | Be Legendary';
const description = "Executive retreats and a 90-minute live read on your leadership team, each built around one real outcome and reinforced for 30 days so the change sticks. Book a call.";

const schema = [
  // Identity nodes reuse the canonical definitions in src/lib/site.ts so the
  // home page can never drift from what every inner page emits.
  WEBSITE_NODE,
  ORG_NODE,
  PERSON_NODE,
  { '@type': 'Book', '@id': 'https://www.belegendary.org/#book', name: 'Lost Disciplines of Leadership', author: { '@id': 'https://www.belegendary.org/#james' }, about: 'Why leaders and teams know what to do and still fail to do it — and the disciplines that close the gap.' },
  { '@type': 'Book', '@id': 'https://www.belegendary.org/discover-your-inner-strength/#book', name: 'Discover Your Inner Strength', isbn: '978-1-60013-512-5', datePublished: '2009-10-30', publisher: { '@type': 'Organization', name: 'Insight Publishing' }, image: 'https://www.belegendary.org/assets/discover-your-inner-strength-cover.webp', url: 'https://www.belegendary.org/discover-your-inner-strength/', author: [{ '@type': 'Person', name: 'Brian Tracy' }, { '@id': 'https://www.belegendary.org/#james' }, { '@type': 'Person', name: 'Ken Blanchard' }, { '@type': 'Person', name: 'Stephen Covey' }], sameAs: 'https://www.amazon.com/Discover-Inner-Strength-James-Carter/dp/1600135129' },
  { '@type': 'Book', '@id': 'https://www.belegendary.org/roadmap-to-success/#book', name: 'Roadmap to Success', isbn: '978-1-60013-921-5', datePublished: '2012', publisher: { '@type': 'Organization', name: 'Insight Publishing' }, author: [{ '@id': 'https://www.belegendary.org/#james' }, { '@type': 'Person', name: 'Deepak Chopra' }, { '@type': 'Person', name: 'Ken Blanchard' }], about: "A collaborative book; James Carter is featured on the cover alongside Deepak Chopra and Ken Blanchard, with the chapter \"Be Legendary.\"", url: 'https://www.belegendary.org/roadmap-to-success/', sameAs: 'https://www.amazon.com/Roadmap-Success-Dr-Deepak-Chopra-ebook/dp/B00BJAM0SA' },
  { '@type': 'DefinedTerm', '@id': 'https://www.belegendary.org/#flagmodel', name: 'The Flag Model', description: 'A leadership-execution framework with five components: a center (the Flag — the 2 to 3 operational priorities everything serves) and four disciplines that hold it upright — the Decision, the Rhythm, the Standard and the Learning — governed by the principle Truth Over Comfort.', inDefinedTermSet: 'Be Legendary' },
  { '@type': 'Service', '@id': 'https://www.belegendary.org/#partnership', name: 'Performance Partnership', provider: { '@id': 'https://www.belegendary.org/#org' }, serviceType: 'Executive team performance engagement', description: 'The engagement through which the Flag Model is installed over time, measured by FlagScore movement across quarters.' },
  { '@type': 'Service', '@id': 'https://www.belegendary.org/#retreats', name: 'Executive Leadership Retreats', provider: { '@id': 'https://www.belegendary.org/#org' }, serviceType: 'Executive leadership retreat', url: 'https://www.belegendary.org/teams/retreats/', description: 'Facilitated multi-day executive retreats built around one real outcome and reinforced for 30 days. Focused, Signature and Bespoke tiers, from $25,000.' },
  { '@type': 'Service', '@id': 'https://www.belegendary.org/#teamlfs', name: 'Team LFS — Leadership Failure Simulation', provider: { '@id': 'https://www.belegendary.org/#org' }, serviceType: 'Executive-team behavioral read', url: 'https://www.belegendary.org/teams/team-lfs/', description: 'A 90-minute live session for up to 8 executives that shows how the leadership team actually performs under pressure, with an individual read for each executive and a team map of where it breaks.' },
  { '@type': 'Service', '@id': 'https://www.belegendary.org/#elfs', name: 'Executive Leadership Failure Simulation (ELFS)', provider: { '@id': 'https://www.belegendary.org/#org' }, serviceType: 'Executive diagnostic simulation', description: 'A solo CEO pressure simulation — where do you break first? — with an individual debrief and written report. The low-risk way to experience the diagnostic before an engagement; fees apply toward the full team engagement if you move forward.' },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'How much does an executive retreat cost?', acceptedAnswer: { '@type': 'Answer', text: 'Be Legendary executive retreats run from $25,000 to $50,000 for a Focused retreat, $35,000 to $100,000 for a Signature experiential retreat, and $75,000 and up for a fully bespoke build. Every tier includes facilitation and 30 days of reinforcement afterward. Group size, destination and length set the final number.' } },
    { '@type': 'Question', name: 'How quickly will we see a difference?', acceptedAnswer: { '@type': 'Answer', text: 'Inside the first session. A Team LFS gives each executive and the team a read on how they actually perform under pressure within about 90 minutes, and a retreat ends with specific commitments the team practices for the next 30 days. Longer engagements exist for teams that want to go further, but none of them are required to get value from the first step.' } },
    { '@type': 'Question', name: "Why isn't my executive team executing?", acceptedAnswer: { '@type': 'Answer', text: "Because the problem usually isn't strategy, intelligence, or effort — it's discipline. Teams know what to do and still don't do it when comfort is easier than truth. The Flag Model locates which of four disciplines has broken down so you can rebuild that one, instead of buying another framework." } },
    { '@type': 'Question', name: "We did EOS and OKRs and behavior didn't change. Why?", acceptedAnswer: { '@type': 'Answer', text: 'Frameworks like EOS and OKRs assume a team that can already commit, complete, and hold each other accountable. If those disciplines are missing, the framework sits on a poster and behavior stays the same. The work is rebuilding the disciplines underneath, not installing another framework on top.' } },
    { '@type': 'Question', name: 'What is the Flag Model?', acceptedAnswer: { '@type': 'Answer', text: 'The Flag Model is a leadership-execution framework. At its center is the Flag — the 2 to 3 priorities everything serves. Four disciplines hold it upright: the Decision, the Rhythm, the Standard and the Learning. The governing principle is Truth Over Comfort. Remove one discipline and the flag tilts; remove two and it falls.' } },
    { '@type': 'Question', name: "My executives can't make a decision without me. Why?", acceptedAnswer: { '@type': 'Answer', text: "That's the Decision discipline lost to chaos: the team can't commit, so every call routes back to you. The fix is a decision protocol — owner, data, deadline, and the obligation to defend it — that lets a decision stick without your sign-off." } },
    { '@type': 'Question', name: 'What happens on a Calibration Call?', acceptedAnswer: { '@type': 'Answer', text: "It's a 15-minute conversation. You'll run a short Choices exercise that surfaces priority misalignment in real time, and you'll leave with a concrete read on where your team stands — whether or not we work together. It's a calibration, not a pitch." } },
  ] },
  // Client testimonials as Review nodes (entity/GEO value; Google won't render
  // stars for first-party org reviews, so no AggregateRating is claimed).
  ...TESTIMONIALS.map((t) => ({
    '@type': 'Review',
    itemReviewed: { '@id': 'https://www.belegendary.org/#org' },
    author: { '@type': 'Person', name: t.name },
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    reviewBody: t.quote,
  })),
];

const faqs = [
  { q: 'How much does an executive retreat cost?', a: 'Our executive retreats run from $25,000 to $50,000 for a Focused retreat, $35,000 to $100,000 for a Signature experiential retreat, and $75,000 and up for a fully bespoke build. Every tier includes facilitation and 30 days of reinforcement afterward. Group size, destination and length set the final number.' },
  { q: 'How quickly will we see a difference?', a: 'Inside the first session. A Team LFS gives each executive and the team a read on how they actually perform under pressure within about 90 minutes, and a retreat ends with specific commitments the team practices for the next 30 days. Longer engagements exist for teams that want to go further, but none of them are required to get value from the first step.' },
  { q: "Why isn't my executive team executing?", a: "Because the problem usually isn't strategy, intelligence, or effort — it's discipline. Teams know what to do and still don't do it when comfort is easier than truth. The Flag Model™ locates which of four disciplines has broken down, so you rebuild that one instead of buying another framework." },
  { q: "We did EOS and OKRs and behavior didn't change. Why?", a: 'Frameworks like EOS and OKRs assume a team that can already commit, complete, and hold each other accountable. If those disciplines are missing, the framework lives on a poster and behavior stays the same. The work is rebuilding the disciplines underneath — not installing another framework on top.' },
  { q: 'What is the Flag Model?', a: "It's a leadership-execution framework. At the center is the Flag — the 2 to 3 priorities everything serves. Four disciplines hold it upright: the Decision, the Rhythm, the Standard, and the Learning. The governing principle is Truth Over Comfort. Remove one discipline and the flag tilts; remove two and it falls." },
  { q: 'What happens on a Calibration Call?', a: "It's 15 minutes. You'll run a short Choices exercise that surfaces priority misalignment in real time, and you'll leave with a concrete read on where your team stands — whether or not we work together. It's a calibration, not a pitch." },
  { q: 'Is this just another framework or coach?', a: "No. You start with something concrete: a retreat or a 90-minute live read on your team. Each one ends with specific commitments, reinforced for 30 days. If the team wants to go further, we rebuild the specific discipline that broke over a 90-day Sprint or a 12-month Performance Partnership. The Flag Model is the method underneath, not a poster we hand you." },
];

// In-page nav mirrors the design's primary nav: section anchors plus real
// routes (Resources → hub, Retreats → team retreats). The CTA button and the
// For Teams/For Leaders toggle are supplied by SiteHeader.
const homeLinks = [
  { label: 'Executive Retreats', href: SLUGS.teamRetreats },
  {
    label: 'How we work together',
    href: SLUGS.howWeWorkTogether,
    children: [
      { label: 'Leadership Failure Simulation', href: SLUGS.teamLfs, desc: 'Like a flight simulator, for your leadership team' },
      { label: 'Executive Immersion', href: SLUGS.executiveImmersion, desc: 'One high-stakes day, engineered for your team' },
      { label: 'Leadership Retreat', href: SLUGS.teamRetreats, desc: 'Multi-day, fully off-site' },
      { label: 'Discipline Sprint', href: `${SLUGS.howWeWorkTogether}#discipline-sprint`, desc: 'A focused 90-day behavioral improvement' },
      { label: 'Performance Partnership', href: `${SLUGS.howWeWorkTogether}#performance-partnership`, desc: '12-month engagement, 10×-return guarantee' },
      { label: 'Pricing', href: SLUGS.pricing, desc: 'Every way in, with real prices' },
      { label: 'How we work together', href: SLUGS.howWeWorkTogether, divider: true },
    ],
  },
  {
    label: 'Resources',
    href: SLUGS.resources,
    children: [
      { label: 'Field Notes', href: SLUGS.fieldNotes },
      { label: 'Research Notes', href: SLUGS.researchNotes },
      { label: 'Case studies', href: SLUGS.caseStudies },
      { label: 'All resources', href: SLUGS.resources, divider: true },
    ],
  },
  {
    label: 'About',
    href: SLUGS.aboutIndex,
    children: [
      { label: 'About Be Legendary', href: SLUGS.aboutIndex },
      { label: 'James Carter', href: SLUGS.about },
      { label: 'Press', href: SLUGS.press },
      { label: 'Contact', href: SLUGS.contact },
    ],
  },
];
---
<BaseLayout title={title} description={description} path="/" siteGraph={false} ogTitle="Executive retreats that still show up 30 days later" ogDescription="Start with an executive retreat or a 90-minute live read on your leadership team. Either way you leave with a real result, reinforced for 30 days." schema={schema}>
  <SiteHeader audience="teams" variant="full" maxWidth={1200} logoHref="#top" links={homeLinks} />

  <!-- HERO -->
  <style>
    .bl-hero-full {
      position: relative;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      min-height: min(90vh, 880px);
      display: flex;
      align-items: center;
      overflow: hidden;
      background: #100E0A;
    }
    .bl-hero-full__bg {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 74%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 24%);
              mask-image: linear-gradient(90deg, transparent 0%, #000 24%);
      z-index: 0;
    }
    .bl-hero-full__scrim {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(90deg, rgba(16,14,10,0.96) 0%, rgba(16,14,10,0.90) 26%, rgba(16,14,10,0.48) 54%, rgba(16,14,10,0.04) 76%),
        linear-gradient(0deg, rgba(16,14,10,0.5) 0%, rgba(16,14,10,0) 42%);
    }
    .bl-hero-full__inner {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 104px 32px;
    }
    .bl-hero-full__copy { max-width: 600px; }
    @media (max-width: 860px) {
      .bl-hero-full { min-height: auto; }
      .bl-hero-full__bg { width: 100%; object-position: 72% center; -webkit-mask-image: none; mask-image: none; }
      .bl-hero-full__scrim {
        background: linear-gradient(180deg, rgba(16,14,10,0.93) 0%, rgba(16,14,10,0.76) 42%, rgba(16,14,10,0.52) 72%, rgba(16,14,10,0.74) 100%);
      }
      .bl-hero-full__inner { padding: 72px 24px 84px; }
      .bl-hero-full__copy { max-width: 100%; }
    }
  </style>
  <section id="top" class="bl-hero-full">
    <img
      class="bl-hero-full__bg"
      src="/assets/lr-lodge.webp"
      alt="A timber-and-stone mountain lodge lit up at dusk, the kind of private venue where an executive team steps away from operations to work on how it leads together."
      width="1800" height="655" loading="eager" fetchpriority="high" decoding="async"
    />
    <div class="bl-hero-full__scrim"></div>
    <div class="bl-hero-full__inner">
      <div class="bl-hero-full__copy">
        <p style="display:inline-flex;align-items:center;gap:9px;font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D98A5E;margin-bottom:28px;">
          <span style="width:7px;height:7px;border-radius:50%;background:#C04A26;display:inline-block;"></span>Executive retreats &middot; Leadership team performance
        </p>
        <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(38px,5.2vw,72px);line-height:1.05;letter-spacing:-0.025em;max-width:19ch;color:#FBF8F1;text-shadow:0 2px 30px rgba(0,0,0,0.35);">
          Executive retreats that still show up in how your team works <span style="font-style:italic;color:#E0744A;">30 days later.</span>
        </h1>
        <p style="margin-top:30px;font-size:clamp(17px,1.95vw,22px);line-height:1.55;max-width:48ch;color:rgba(244,240,231,0.86);font-weight:400;">
          Take your leadership team off-site around the one thing it needs to change, or spend 90 minutes seeing exactly how your executives perform under pressure. Either way, your team leaves with a real result, and we reinforce it for 30 days so it survives the trip home.
        </p>
        <div style="margin-top:38px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;">
          <a href={`${SLUGS.teamRetreats}#inquire`} style="background:#C04A26;color:#fff;text-decoration:none;padding:17px 32px;border-radius:11px;font-weight:700;font-size:17px;display:inline-flex;align-items:center;gap:9px;box-shadow:0 14px 40px -12px rgba(192,74,38,0.6);" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Plan an executive retreat <span style="font-size:18px;">&rarr;</span></a>
          <a href={CTA_URL} target="_blank" rel="noopener" style="border:1px solid rgba(244,240,231,0.32);color:#F4F0E7;text-decoration:none;padding:17px 28px;border-radius:11px;font-weight:600;font-size:16px;backdrop-filter:blur(2px);" onmouseover="this.style.borderColor='rgba(244,240,231,0.65)'" onmouseout="this.style.borderColor='rgba(244,240,231,0.32)'">Book a free 15-minute call</a>
        </div>
        <p style="margin-top:18px;font-size:13.5px;color:rgba(244,240,231,0.6);max-width:40ch;line-height:1.4;">Retreats from $25K. Planning for your CEO? <a href={SLUGS.forExecutiveAssistants} style="color:#E0744A;text-decoration:none;">Start here &rarr;</a></p>
      </div>
    </div>
  </section>

  <PressStrip />

  <section style="background:#15130E;color:#F4F0E7;">
    <ResultsBand variant="dark" maxWidth={1080} />
  </section>

  <!-- TWO WAYS TO START: the first win -->
  <section id="start" class="bl-section-pad" style="background:#F4F0E7;color:#1B1810;padding:100px 32px;">
    <div style="max-width:1200px;margin:0 auto;">
      <div style="max-width:62ch;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">Two ways to start</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(30px,4.2vw,50px);line-height:1.04;letter-spacing:-0.02em;">Start with a win your team can feel this quarter.</h2>
        <p style="margin-top:22px;font-size:18px;line-height:1.6;color:#56524A;">Both are complete on their own. Each one ends with specific commitments, and we follow up for 30 days so the change holds once everyone is back at their desks.</p>
      </div>
      <div class="bl-grid-collapse" style="margin-top:44px;display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch;">
        <article style="background:#1B1810;color:#F4F0E7;border-radius:22px;overflow:hidden;display:flex;flex-direction:column;">
          <img src="/assets/lr-mining-lodge.webp" alt="An executive team snowshoeing up to a remote backcountry lodge in the San Juan Mountains" width="1500" height="1125" loading="lazy" decoding="async" style="width:100%;height:260px;flex:0 0 260px;object-fit:cover;object-position:50% 60%;display:block;" />
          <div style="padding:36px 38px 40px;display:flex;flex-direction:column;flex:1;">
            <p style="font-size:12.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E0744A;">Executive retreats &middot; multi-day, off-site</p>
            <h3 style="margin-top:12px;font-family:'Newsreader',serif;font-weight:500;font-size:32px;line-height:1.08;color:#FBF8F1;">Take the team away. Bring a different team back.</h3>
            <p style="margin-top:16px;font-size:16.5px;line-height:1.6;color:rgba(244,240,231,0.82);">A facilitated retreat built around the one outcome your team needs, at a private venue or somewhere demanding enough to show how the team really works. We handle venue, travel, food and facilitation, then run 30 days of reinforcement afterward.</p>
            <ul style="margin-top:18px;padding:0;list-style:none;display:grid;gap:8px;font-size:15px;color:rgba(244,240,231,0.78);">
              <li><strong style="color:#F4F0E7;">Focused</strong> &middot; ready to run, one outcome &middot; $25K&ndash;$50K</li>
              <li><strong style="color:#F4F0E7;">Signature</strong> &middot; experiential formats &middot; $35K&ndash;$100K</li>
              <li><strong style="color:#F4F0E7;">Bespoke</strong> &middot; built from scratch &middot; $75K+</li>
            </ul>
            <div style="margin-top:auto;padding-top:28px;display:flex;flex-wrap:wrap;gap:18px;align-items:center;">
              <a href={`${SLUGS.teamRetreats}#inquire`} style="background:#C04A26;color:#fff;text-decoration:none;padding:15px 26px;border-radius:11px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;" onmouseover="this.style.background='#9E3A1C'" onmouseout="this.style.background='#C04A26'">Check dates for your team <span>&rarr;</span></a>
              <a href={SLUGS.teamRetreats} style="color:#E0744A;text-decoration:none;font-weight:700;font-size:15.5px;">See the three retreat options &rarr;</a>
            </div>
          </div>
        </article>
        <article style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.10);border-radius:22px;padding:40px 38px;display:flex;flex-direction:column;">
          <p style="font-size:12.5px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#C04A26;">Team LFS &middot; 90 minutes</p>
          <h3 style="margin-top:12px;font-family:'Newsreader',serif;font-weight:500;font-size:32px;line-height:1.08;">See how your leadership team actually performs under pressure.</h3>
          <p style="margin-top:16px;font-size:16.5px;line-height:1.6;color:#56524A;">Your executives work through a live crisis built from your company's own reality, each on their own device, while every message, decision and silence is captured. It is genuinely engaging to play, and what comes out of it is evidence, not opinion.</p>
          <ul style="margin-top:18px;padding:0;list-style:none;display:grid;gap:10px;font-size:15.5px;color:#3D3A33;">
            <li style="padding-left:18px;position:relative;"><span style="position:absolute;left:0;color:#C04A26;">&bull;</span>An individual read for each executive, backed by what they actually did</li>
            <li style="padding-left:18px;position:relative;"><span style="position:absolute;left:0;color:#C04A26;">&bull;</span>A team map showing where coordination broke down and why</li>
            <li style="padding-left:18px;position:relative;"><span style="position:absolute;left:0;color:#C04A26;">&bull;</span>A debrief the same day, and 30-day commitments for each person</li>
          </ul>
          <p style="margin-top:18px;font-size:14.5px;color:#6B675E;">Up to 8 executives &middot; at your offsite or virtually &middot; $28K&ndash;$35K, with half credited toward whatever you do next.</p>
          <div style="margin-top:auto;padding-top:26px;display:flex;flex-wrap:wrap;gap:18px;align-items:center;">
            <a href={SLUGS.teamLfs} style="background:#1B1810;color:#FBF8F1;text-decoration:none;padding:15px 26px;border-radius:11px;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:9px;" onmouseover="this.style.background='#000'" onmouseout="this.style.background='#1B1810'">See how it works <span>&rarr;</span></a>
            <a href={SLUGS.elfs} style="color:#C04A26;text-decoration:none;font-weight:700;font-size:15.5px;">Try it solo first (ELFS) &rarr;</a>
          </div>
        </article>
      </div>
      <p style="margin-top:22px;font-size:15px;color:#6B675E;">Want both? Team LFS runs inside a retreat, so the experience and the evidence happen in the same trip.</p>
    </div>
  </section>

  <!-- AFTER THE FIRST WIN -->
  <section id="work" class="bl-section-pad" style="background:#EFE9DD;color:#1B1810;padding:100px 32px;">
    <div style="max-width:1200px;margin:0 auto;">
      <div style="max-width:62ch;">
        <p style="font-size:13px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C04A26;margin-bottom:18px;">What happens after the first win</p>
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:clamp(30px,4.2vw,50px);line-height:1.04;letter-spacing:-0.02em;">Go as far as the results justify.</h2>
        <p style="margin-top:22px;font-size:18px;line-height:1.6;color:#56524A;">Most teams start with one experience. The ones that want more go deeper, one step at a time, and only when the first step has paid off.</p>
      </div>
      <div class="bl-grid-collapse" style="margin-top:48px;display:grid;grid-template-columns:repeat(3,1fr);gap:22px;">
        <div style="background:#FBF8F1;border:1px solid rgba(27,24,16,0.09);border-radius:18px;padding:34px;">
          <span style="font-family:'Newsreader',serif;font-size:34px;color:#C04A26;">01</span>
          <h3 style="margin-top:14px;font-size:22px;font-weight:700;">Start</h3>
