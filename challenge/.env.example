# ─── Supabase ────────────────────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon / public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role key — SERVER ONLY, never expose

# ─── Twilio ──────────────────────────────────────────────────────────────────
# console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token               # used for outbound send AND inbound signature validation
TWILIO_PHONE_NUMBER=+13035551234                # your Twilio number in E.164

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://challenge.belegendary.org

# Shared secret the scheduler (Supabase Edge Function / pg_cron) sends to /api/send
# so the endpoint can't be triggered by the public. Generate with: openssl rand -hex 32
CRON_SECRET=replace_with_a_long_random_string
